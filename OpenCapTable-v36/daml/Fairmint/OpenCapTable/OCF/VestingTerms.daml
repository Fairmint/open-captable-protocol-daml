-- OCF VESTING_TERMS record: the graph of vesting conditions and triggers that a security's vesting follows.
module Fairmint.OpenCapTable.OCF.VestingTerms where

import qualified DA.Set as Set
import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)

template VestingTerms
  with
    context : Context
    ocf_data : VestingTermsOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateVestingTermsOcfData ocf_data

    interface instance OcfObject for VestingTerms where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeVestingTerms
        object_id = ocf_data.id
        security_ids = []

-- Object - Vesting Terms
-- Object describing the terms under which a security vests
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/VestingTerms.schema.json
data VestingTermsOcfData = VestingTermsOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Allocation/rounding type for the vesting schedule
    allocation_type : OcfAllocationType
    -- Detailed description of the vesting schedule
    description : Text
    -- Concise name for the vesting schedule
    name : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Conditions and triggers that describe the graph of vesting schedules and events
    -- minItems: 1
    vesting_conditions : [OcfVestingCondition]
  deriving (Eq, Show)

validateVestingTermsOcfData : VestingTermsOcfData -> Bool
validateVestingTermsOcfData d =
  d.id /= "" &&
  not (null d.vesting_conditions) &&
  all validateOcfVestingCondition d.vesting_conditions &&
  validateOcfVestingConditionGraph d.vesting_conditions

-- Enum - Allocation Type
-- Enumeration of allocation types for vesting terms. Using an example of 18 shares split across 4 tranches, each allocation type results in a different schedule.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/AllocationType.schema.json
data OcfAllocationType
  = OcfAllocationTypeCumulativeRounding
  | OcfAllocationTypeCumulativeRoundDown
  | OcfAllocationTypeFrontLoaded
  | OcfAllocationTypeBackLoaded
  | OcfAllocationTypeFrontLoadedToSingleTranche
  | OcfAllocationTypeBackLoadedToSingleTranche
  | OcfAllocationTypeFractional
  deriving (Eq, Show)

-- Enum - Vesting Day of Month
-- Enumeration representing a vesting "day of month". Handles overflow for months with fewer days and start-day behavior.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/VestingDayOfMonth.schema.json
data OcfVestingDayOfMonth
  = OcfVestingDayOfMonth01 | OcfVestingDayOfMonth02 | OcfVestingDayOfMonth03 | OcfVestingDayOfMonth04
  | OcfVestingDayOfMonth05 | OcfVestingDayOfMonth06 | OcfVestingDayOfMonth07 | OcfVestingDayOfMonth08
  | OcfVestingDayOfMonth09 | OcfVestingDayOfMonth10 | OcfVestingDayOfMonth11 | OcfVestingDayOfMonth12
  | OcfVestingDayOfMonth13 | OcfVestingDayOfMonth14 | OcfVestingDayOfMonth15 | OcfVestingDayOfMonth16
  | OcfVestingDayOfMonth17 | OcfVestingDayOfMonth18 | OcfVestingDayOfMonth19 | OcfVestingDayOfMonth20
  | OcfVestingDayOfMonth21 | OcfVestingDayOfMonth22 | OcfVestingDayOfMonth23 | OcfVestingDayOfMonth24
  | OcfVestingDayOfMonth25 | OcfVestingDayOfMonth26 | OcfVestingDayOfMonth27 | OcfVestingDayOfMonth28
  | OcfVestingDayOfMonth29OrLastDayOfMonth
  | OcfVestingDayOfMonth30OrLastDayOfMonth
  | OcfVestingDayOfMonth31OrLastDayOfMonth
  | OcfVestingDayOfMonthVestingStartDayOrLastDayOfMonth
  deriving (Eq, Show)

-- Primitive - Vesting Period Type (Days/Months)
-- Abstract type for periods of time; concrete days/months variants below.
-- OCF (primitive): https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/types/vesting/VestingPeriod.schema.json
-- OCF (days):      https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingPeriodInDays.schema.json
-- OCF (months):    https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingPeriodInMonths.schema.json
data OcfVestingPeriod =
    OcfVestingPeriodDays with
      -- Required fields (alphabetical)
      ---------------------------------
      -- The quantity of days for the period; e.g., 30
      length_ : Int
      -- The number of times this vesting period triggers
      occurrences : Int

      -- Optional fields (alphabetical)
      ---------------------------------
      -- 1-indexed installment at which a cliff applies; <2 treated as no cliff
      cliff_installment : Optional Int
  | OcfVestingPeriodMonths with
      -- Required fields (alphabetical)
      ---------------------------------
      -- The calendar day of the month to award vesting (with overflow rules)
      day_of_month : OcfVestingDayOfMonth
      -- The quantity of months for the period; e.g., 3
      length_ : Int
      -- The number of times this vesting period triggers
      occurrences : Int

      -- Optional fields (alphabetical)
      ---------------------------------
      -- 1-indexed installment at which a cliff applies; <2 treated as no cliff
      cliff_installment : Optional Int
  deriving (Eq, Show)

validateOcfVestingPeriod : OcfVestingPeriod -> Bool
validateOcfVestingPeriod p =
  case p of
    OcfVestingPeriodDays{length_=periodLength, occurrences, cliff_installment} ->
      periodLength >= 0 && occurrences >= 1 && (case cliff_installment of None -> True; Some ci -> ci >= 0)
    OcfVestingPeriodMonths{length_=periodLength, occurrences, day_of_month, cliff_installment} ->
      let _ = day_of_month in -- enum validated by type
      periodLength >= 0 && occurrences >= 1 && (case cliff_installment of None -> True; Some ci -> ci >= 0)

-- Primitive - Vesting Condition Trigger Type and specific triggers
-- OCF (primitive): https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/types/vesting/VestingConditionTrigger.schema.json
-- OCF (start):     https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingStartTrigger.schema.json
-- OCF (absolute):  https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingScheduleAbsoluteTrigger.schema.json
-- OCF (relative):  https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingScheduleRelativeTrigger.schema.json
-- OCF (event):     https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingEventTrigger.schema.json
data OcfVestingTrigger =
    -- Triggers at the vesting commencement date
    OcfVestingStartTrigger
  | -- Triggers on an absolute date
    OcfVestingScheduleAbsoluteTrigger with
      -- The date on which this condition triggers
      date : Date
  | -- Triggers after a period relative to another condition
    OcfVestingScheduleRelativeTrigger with
      -- The span of time that must have elapsed since `relative_to_condition_id`
      period : OcfVestingPeriod
      -- Reference to the vesting condition ID to which the period is relative
      relative_to_condition_id : Text
  | -- Triggers when a particular unscheduled event occurs
    OcfVestingEventTrigger
  deriving (Eq, Show)

validateOcfVestingTrigger : OcfVestingTrigger -> Bool
validateOcfVestingTrigger t =
  case t of
    OcfVestingStartTrigger -> True
    OcfVestingScheduleAbsoluteTrigger{date} -> let _ = date in True
    -- `relative_to_condition_id` is a plain OCF string: the register does not resolve it
    OcfVestingScheduleRelativeTrigger{period} -> validateOcfVestingPeriod period
    OcfVestingEventTrigger -> True

-- Type - Vesting Condition Portion
-- If specified, the fractional part of the whole that vests (e.g., 25:100).
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingConditionPortion.schema.json
data OcfVestingConditionPortion = OcfVestingConditionPortion
  with
    -- Required fields (mathematical order, not alphabetical)
    ---------------------------------

    -- Portion numerator (e.g., 25)
    numerator : Decimal
    -- Portion denominator (e.g., 100)
    denominator : Decimal

    -- Optional fields (alphabetical)
    ---------------------------------

    -- If true, the ratio applies to the amount not yet vested; if false or absent (OCF default
    -- false), to the security's whole quantity
    remainder : Optional Bool
  deriving (Eq, Show)

-- Type - Vesting Condition
-- Describes condition/trigger to be satisfied for vesting to occur
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/vesting/VestingCondition.schema.json
data OcfVestingCondition = OcfVestingCondition
  with
    -- Reference identifier for this condition (unique within the vesting terms)
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Describes how this vesting condition is met
    trigger : OcfVestingTrigger

    -- Arrays (alphabetical)
    ---------------------------------

    -- List of ALL VestingCondition IDs that can trigger after this one
    next_condition_ids : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Detailed description of the condition
    description : Optional Text
    -- If specified, the fractional part of the whole security that vests
    portion : Optional OcfVestingConditionPortion
    -- If specified, the fixed amount of the whole security to vest
    quantity : Optional Decimal
  deriving (Eq, Show)

-- OCF's oneOf: exactly one of portion or quantity. Their numbers are signed OCF Numerics, which the
-- register stores and never computes with, so a zero denominator or a negative quantity is valid.
validateExactlyOnePortionOrQuantity : Optional OcfVestingConditionPortion -> Optional Decimal -> Bool
validateExactlyOnePortionOrQuantity portion quantity =
  case (portion, quantity) of
    (Some _, None) -> True
    (None, Some _) -> True
    _ -> False

-- OCF: `id` has minLength 1 and `next_condition_ids` is uniqueItems.
validateOcfVestingCondition : OcfVestingCondition -> Bool
validateOcfVestingCondition c =
  c.id /= "" &&
  validateExactlyOnePortionOrQuantity c.portion c.quantity &&
  validateOcfVestingTrigger c.trigger &&
  not (hasDuplicateTexts c.next_condition_ids)

vestingConditionIds : [OcfVestingCondition] -> [Text]
vestingConditionIds conditions = map (\condition -> condition.id) conditions

hasDuplicateTexts : [Text] -> Bool
hasDuplicateTexts texts = hasDuplicateTextsSeen Set.empty texts

hasDuplicateTextsSeen : Set.Set Text -> [Text] -> Bool
hasDuplicateTextsSeen seen remaining = case remaining of
  [] -> False
  text :: rest ->
    Set.member text seen || hasDuplicateTextsSeen (Set.insert text seen) rest

-- Condition IDs are unique within the terms, so a condition ID names one condition. OCF's prose
-- intends the conditions to form a graph closed under `next_condition_ids` and
-- `relative_to_condition_id` and free of cycles, but its schema does not require it and the register
-- never walks the graph, so closure, self-references and cycles are left to the SDK.
validateOcfVestingConditionGraph : [OcfVestingCondition] -> Bool
validateOcfVestingConditionGraph conditions = not (hasDuplicateTexts (vestingConditionIds conditions))
