-- Fairmint OCF extension TX_STOCK_HOLD record: shares of a stock security put on hold; a hold says shares are on hold, never "held": OCF uses "holds" for ownership.
module Fairmint.OpenCapTable.OCF.StockHold where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Stock (OcfHoldType(..))

template StockHold
  with
    context : Context
    ocf_data : StockHoldOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockHoldOcfData ocf_data

    interface instance OcfObject for StockHold where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxStockHold
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Stock Hold Transaction
-- Object describing shares of a stock security put on hold, for a register settlement or a stop
-- transfer. It follows OCF's primitive pattern: Object, Transaction, SecurityTransaction and the
-- Hold primitive (hold_type, reference, reason_text).
-- Fairmint OCF extension: objects/transactions/hold/StockHold.schema.json
data StockHoldOcfData = StockHoldOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the hold was placed
    date : Date
    -- Why the shares are on hold: OcfHoldTypeRegisterSettlement | OcfHoldTypeStopTransfer
    hold_type : OcfHoldType
    -- Reason for the hold; unstructured text
    reason_text : Text
    -- The settlement ID for a REGISTER_SETTLEMENT hold, or the stop's case or order reference
    reference : Text
    -- Identifier for the stock security whose shares are on hold
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Number of shares on hold: Some (> 0) iff REGISTER_SETTLEMENT; a STOP_TRANSFER hold has none
    -- and puts the whole security on hold
    quantity : Optional Decimal
  deriving (Eq, Show)

validateStockHoldOcfData : StockHoldOcfData -> Bool
validateStockHoldOcfData d =
  d.id /= "" &&
  d.reason_text /= "" &&
  d.reference /= "" &&
  d.security_id /= "" &&
  validateNonEmptyStringsArray d.comments &&
  -- A settlement hold names a positive quantity; a stop names none
  (case (d.hold_type, d.quantity) of
    (OcfHoldTypeRegisterSettlement, Some q) -> q > 0.0
    (OcfHoldTypeRegisterSettlement, None) -> False
    (OcfHoldTypeStopTransfer, None) -> True
    (OcfHoldTypeStopTransfer, Some _) -> False)
