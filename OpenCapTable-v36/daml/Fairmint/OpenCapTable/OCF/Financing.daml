-- OCF FINANCING record: a financing event and the issuances, by object ID, that belong to it.
module Fairmint.OpenCapTable.OCF.Financing where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template Financing
  with
    context : Context
    ocf_data : FinancingOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure
      validateContext context &&
      validateFinancingOcfData ocf_data

    interface instance OcfObject for Financing where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeFinancing
        object_id = ocf_data.id
        security_ids = []

-- Object - Financing
-- Object describing a financing
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/Financing.schema.json
data FinancingOcfData = FinancingOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the financing event occurred
    date : Date
    -- Name for the financing
    name : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Object IDs (not security IDs) of the stock, warrant, convertible and equity compensation
    -- issuances that belong to the financing
    -- minItems: 1
    issuance_ids : [Text]
  deriving (Eq, Show)

validateFinancingOcfData : FinancingOcfData -> Bool
validateFinancingOcfData d =
  d.id /= "" &&
  -- OCF sets no minimum length on the name or on comments, and v34 accepted empty ones
  -- Required arrays per schema
  not (null d.issuance_ids) &&
  validateNonEmptyStringsArray d.issuance_ids
