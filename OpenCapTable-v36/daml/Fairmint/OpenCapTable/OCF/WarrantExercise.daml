-- OCF TX_WARRANT_EXERCISE record: a whole warrant exercised under one of its exercise triggers into resulting securities.
module Fairmint.OpenCapTable.OCF.WarrantExercise where

import DA.List (dedup)
import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template WarrantExercise
  with
    context : Context
    ocf_data : WarrantExerciseOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateWarrantExerciseOcfData ocf_data

    interface instance OcfObject for WarrantExercise where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxWarrantExercise
        object_id = ocf_data.id
        security_ids = dedup ([ocf_data.security_id] <> ocf_data.resulting_security_ids)

-- Object - Warrant Exercise Transaction
-- Object describing a warrant exercise transaction. OCF gives it no quantity and no balance
-- security: an exercise takes the whole warrant.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/exercise/WarrantExercise.schema.json
data WarrantExerciseOcfData = WarrantExerciseOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Identifier for the security (warrant) being exercised
    security_id : Text
    -- ID of the warrant's exercise trigger that resulted in this exercise
    trigger_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Identifier for the security (or securities) that resulted from the exercise
    resulting_security_ids : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Unstructured text description of consideration provided in exchange for security exercise
    consideration_text : Optional Text
  deriving (Eq, Show)

validateWarrantExerciseOcfData : WarrantExerciseOcfData -> Bool
validateWarrantExerciseOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.trigger_id /= "" &&
  -- Optional Text values, if present, must be non-empty
  validateOptionalText d.consideration_text &&
  -- Arrays element validation (resulting_security_ids required per Exercise base schema)
  validateNonEmptyStringsArray d.comments &&
  validateNonEmptyStringsArray d.resulting_security_ids &&
  not (null d.resulting_security_ids)
