-- Fairmint OCF extension TX_STOCK_HOLD_CANCELLATION record: a stock hold ended, whole, without its shares moving; a hold says shares are on hold, never "held": OCF uses "holds" for ownership.
module Fairmint.OpenCapTable.OCF.StockHoldCancellation where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template StockHoldCancellation
  with
    context : Context
    ocf_data : StockHoldCancellationOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockHoldCancellationOcfData ocf_data

    interface instance OcfObject for StockHoldCancellation where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxStockHoldCancellation
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Stock Hold Cancellation Transaction
-- Object describing the end of a stock hold: the trade is not executed, a stop is lifted, the hold
-- was placed in error, a new stop cancels it, or a split voids it. No quantity: a hold ends whole.
-- It follows OCF's primitive pattern: Object, Transaction, SecurityTransaction and the
-- HoldCancellation primitive (hold_id, reason_text).
-- Fairmint OCF extension: objects/transactions/hold/StockHoldCancellation.schema.json
data StockHoldCancellationOcfData = StockHoldCancellationOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the hold was canceled
    date : Date
    -- Identifier of the TX_STOCK_HOLD this cancels
    hold_id : Text
    -- Reason for the cancellation; unstructured text
    reason_text : Text
    -- Identifier for the stock security whose shares were on hold
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateStockHoldCancellationOcfData : StockHoldCancellationOcfData -> Bool
validateStockHoldCancellationOcfData d =
  d.id /= "" &&
  d.hold_id /= "" &&
  d.reason_text /= "" &&
  d.security_id /= "" &&
  validateNonEmptyStringsArray d.comments
