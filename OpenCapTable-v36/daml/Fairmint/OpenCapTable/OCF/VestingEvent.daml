-- OCF TX_VESTING_EVENT record: an unscheduled vesting event on a security, under a condition of its vesting terms.
module Fairmint.OpenCapTable.OCF.VestingEvent where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template VestingEvent
  with
    context : Context
    ocf_data : VestingEventOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateVestingEventOcfData ocf_data

    interface instance OcfObject for VestingEvent where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxVestingEvent
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Vesting Event Transaction
-- Object describing the transaction of a non-schedule-driven vesting event associated with a security
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/vesting/VestingEvent.schema.json
data VestingEventOcfData = VestingEventOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Identifier for the security experiencing the vesting event
    security_id : Text
    -- Reference to the id of a VestingCondition in this security's VestingTerms
    -- This condition should have a trigger type of VESTING_EVENT
    vesting_condition_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateVestingEventOcfData : VestingEventOcfData -> Bool
validateVestingEventOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.vesting_condition_id /= "" &&
  -- Arrays element validation
  validateNonEmptyStringsArray d.comments
