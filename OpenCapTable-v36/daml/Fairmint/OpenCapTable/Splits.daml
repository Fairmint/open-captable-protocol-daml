-- Lazy application of a class's recorded splits to one stock state at its next event.
module Fairmint.OpenCapTable.Splits
  ( applySplits
  , scaleTranches
  , uncountedSplits
  ) where

import Fairmint.OpenCapTable.Numeric (scaleByRatio)
import Fairmint.OpenCapTable.State
import Fairmint.OpenCapTable.Types.Stock (OcfRatio)
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting(..))

-- | Brings a state to an event dated `d`. A split touches no stock state when it is recorded;
-- each state applies it at its next event instead. The state's `split_epoch` counts the class's
-- splits it has applied, always a prefix of the class's list (splits are appended in date order and
-- never removed), and its quantity is in their units. The state catches up on every split it has
-- not counted that is dated on or before max(d, last_event_date), in the order recorded: a split
-- dated after its last event, a second split on a date it has already counted one on, and a split
-- recorded after its last event but dated on or before it (its quantity was written before the
-- split existed). Each split is applied once, by its place in the list, never by a date comparison
-- with the state's last event, scaling the quantity, the tranches (cumulatively) and the snapshot
-- with the shared floor function. Afterwards the epoch is the number of the class's splits dated on
-- or before the state's last event, which the date checks of terminal events, output issuances,
-- draws and restatements rely on. Hold quantities are never scaled: a split voids a settlement hold
-- instead (its split epoch falls behind). The result is dated max(d, last_event_date): vesting
-- starts and events may be backdated.
applySplits : [RecordedSplit] -> Date -> StockSecurity -> Either Text StockSecurity
applySplits splits d s = do
  let newLast = max d s.last_event_date
      target = splitsOnOrBefore splits newLast
  -- Unreachable while splits are append-only and dated in order; kept so that a state never
  -- reads as having applied a split its class does not date on or before its last event.
  if s.split_epoch > target
    then Left ("split epoch " <> show s.split_epoch <> " of security " <> s.security_id <> " is ahead of the "
      <> show target <> " splits of its class dated on or before " <> show newLast)
    else pure ()
  scaled <- foldl (\acc sp -> acc >>= applyOne sp) (Right s) (uncountedSplits s.split_epoch target splits)
  pure scaled with
    last_event_date = newLast
    split_epoch = target

-- | The splits a state at `epoch` has not counted, up to the class's first `target`, in the order
-- recorded.
uncountedSplits : Int -> Int -> [RecordedSplit] -> [RecordedSplit]
uncountedSplits epoch target = take (target - epoch) . drop epoch

applyOne : RecordedSplit -> StockSecurity -> Either Text StockSecurity
applyOne sp s = do
  let quantity' = scaleByRatio sp.ratio s.quantity
  if quantity' <= 0.0
    then Left ("split " <> sp.split_id <> " floors security " <> s.security_id
      <> " to zero; retire the fraction with a record dated before the split")
    else pure ()
  vesting' <- case s.vesting of
    StockVestingTranches ts -> case scaleTranches sp.ratio ts of
      -- A schedule that vests nothing stays one; a schedule that vested something must not vanish.
      [] | not (null ts) -> Left ("split " <> sp.split_id <> " floors every vesting tranche of security " <> s.security_id <> " to zero")
      ts' -> Right (StockVestingTranches ts')
    other -> Right other
  pure s with
    quantity = quantity'
    vesting = vesting'
    snapshot = fmap (\snap -> snap with vested = scaleByRatio sp.ratio snap.vested) s.snapshot
    accelerated_since_snapshot = fmap (scaleByRatio sp.ratio) s.accelerated_since_snapshot

-- | Scales tranches cumulatively: the running totals are scaled and floored, then differenced, and
-- tranches that floor to zero are dropped. So the scaled schedule never vests more by any date
-- than the floor of the scaled original.
scaleTranches : OcfRatio -> [OcfVesting] -> [OcfVesting]
scaleTranches r ts =
  let runningTotal acc t = case acc of
        [] -> [t.amount]
        total :: _ -> (total + t.amount) :: acc
      cumulative = reverse (foldl runningTotal [] ts)
      scaled = map (scaleByRatio r) cumulative
      amounts = zipWith (-) scaled (0.0 :: scaled)
  in filter (\t -> t.amount > 0.0) (zipWith (\t a -> t with amount = a) ts amounts)
