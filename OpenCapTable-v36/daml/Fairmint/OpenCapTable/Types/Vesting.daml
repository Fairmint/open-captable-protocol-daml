-- Vesting tranche, termination window and compensation types matching OCF; used by the stock, warrant and equity compensation issuances.
module Fairmint.OpenCapTable.Types.Vesting where

-- =============================================================================
-- VESTING AND EQUITY COMPENSATION TYPES
-- =============================================================================
-- Types for vesting tranches, termination windows, and equity compensation.

-- Enum - Period Type
-- Unit of time for period values
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/PeriodType.schema.json
data OcfPeriodType
  = OcfPeriodTypeDays
  | OcfPeriodTypeMonths
  | OcfPeriodTypeYears
  deriving (Eq, Show)

-- Enum - Termination Window Type
-- Type of termination scenario
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/TerminationWindowType.schema.json
data OcfTerminationWindowType
  = OcfTerminationWindowTypeVoluntaryOther
  | OcfTerminationWindowTypeVoluntaryGoodCause
  | OcfTerminationWindowTypeVoluntaryRetirement
  | OcfTerminationWindowTypeInvoluntaryOther
  | OcfTerminationWindowTypeInvoluntaryDeath
  | OcfTerminationWindowTypeInvoluntaryDisability
  | OcfTerminationWindowTypeInvoluntaryWithCause
  deriving (Eq, Show)

-- Type - Termination Window
-- Type representation of the window in which an equity compensation may be exercised after a termination
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/TerminationWindow.schema.json
data OcfTerminationWindow = OcfTerminationWindow
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Number of units in the termination window
    period : Int
    -- Unit of time for the termination window
    period_type : OcfPeriodType
    -- Reason for termination window
    reason : OcfTerminationWindowType
  deriving (Eq, Show)

validateOcfTerminationWindow : OcfTerminationWindow -> Bool
validateOcfTerminationWindow w = w.period >= 0

-- Type - Vesting
-- One vesting tranche: an amount that vests on a date
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Vesting.schema.json
data OcfVesting = OcfVesting
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Number of shares, units, or amount vesting
    amount : Decimal
    -- Date when vesting occurs
    date : Date
  deriving (Eq, Show)

validateOcfVesting : OcfVesting -> Bool
validateOcfVesting v = v.amount > (0.0)

ocfVestingAmountTotal : [OcfVesting] -> Decimal
ocfVestingAmountTotal = foldl (\total vesting -> total + vesting.amount) 0.0

validateOcfVestingsWithinQuantity : Decimal -> [OcfVesting] -> Bool
validateOcfVestingsWithinQuantity quantity vestings =
  ocfVestingAmountTotal vestings <= quantity

-- Enum - Compensation Type
-- Equity compensation instrument type
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/CompensationType.schema.json
data OcfCompensationType
  = OcfCompensationTypeOptionNso
  | OcfCompensationTypeOptionIso
  | OcfCompensationTypeOption
  | OcfCompensationTypeRsu
  | OcfCompensationTypeCsar
  | OcfCompensationTypeSsar
  deriving (Eq, Show)
