-- Money amounts and validation for OCF monetary fields; shared wherever prices or cash amounts are recorded.
module Fairmint.OpenCapTable.Types.Monetary where

-- =============================================================================
-- MONETARY TYPES
-- =============================================================================
-- The OCF money type. Tax identifiers and addresses live in Types/Contact.daml.

import qualified DA.Text as Text
import Fairmint.Shared.TypeHelpers (validateRequiredText)

-- Type - Monetary
-- Type representation of a money amount and currency
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Monetary.schema.json
data OcfMonetary = OcfMonetary
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Amount of money in the given currency
    amount : Decimal
    -- Three-letter ISO currency code
    currency : Text
  deriving (Eq, Show)

validateOcfMonetary : OcfMonetary -> Bool
validateOcfMonetary monetary =
  monetary.amount >= (0.0) &&
  validateRequiredText monetary.currency &&
  Text.length monetary.currency == 3
