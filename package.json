{
  "name": "@fairmint/open-captable-protocol-daml-js",
  "version": "0.4.0",
  "description": "Open CapTable Protocol (OpenCapTable-v35, with OpenCapTableApi-v01 and OpenCapTableDeliveryProof-v01) DAML contracts with generated JavaScript bindings. Other Fairmint DAML packages live in @fairmint/daml-js.",
  "keywords": [
    "daml",
    "opencaptable",
    "blockchain",
    "smart-contracts",
    "fairmint"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fairmint/open-captable-protocol-daml"
  },
  "license": "Apache-2.0",
  "author": "Fairmint",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./ocp-factory-contract-id.json": {
      "types": "./generated/ocp-factory-contract-id.json.d.ts",
      "default": "./generated/ocp-factory-contract-id.json"
    },
    "./opencaptable.dar": "./published-dars/OpenCapTable.dar",
    "./openCapTableDarPath": {
      "types": "./lib/openCapTableDarPath.d.ts",
      "default": "./lib/openCapTableDarPath.js"
    },
    "./opencaptable-api.dar": "./published-dars/OpenCapTableApi.dar",
    "./opencaptable-delivery-proof.dar": "./published-dars/OpenCapTableDeliveryProof.dar"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "ocp-factory-contract-id.json": [
        "./generated/ocp-factory-contract-id.json.d.ts"
      ],
      "openCapTableDarPath": [
        "./lib/openCapTableDarPath.d.ts"
      ]
    }
  },
  "files": [
    "lib/**",
    "generated/ocp-factory-contract-id.json",
    "generated/ocp-factory-contract-id.json.d.ts",
    "published-dars/OpenCapTable.dar",
    "published-dars/OpenCapTableApi.dar",
    "published-dars/OpenCapTableDeliveryProof.dar",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "backup-dar": "canton-dev-tools backup-dar",
    "prebuild": "npm run generate-captable && npm run prepare-build",
    "build": "cd generated/build && PATH=\"$HOME/.dpm/bin:$PATH\" dpm build --all",
    "build:npm-runtime-lib": "tsc -p tsconfig.npm-runtime.json",
    "build:ts": "tsc",
    "check:dar-version-policy": "canton-dev-tools check-dar-version-policy",
    "check:schema-gaps": "tsx scripts/schema-gap-checker/check-schema-gaps.ts",
    "check-upgrade-compat": "canton-dev-tools check-upgrade-compat",
    "clean": "npm run prepare-build && for pkg in $(node -p \"require('yaml').parse(require('fs').readFileSync('generated/build/multi-package.yaml', 'utf8')).packages.join(' ')\"); do (cd generated/build/$pkg && PATH=\"$HOME/.dpm/bin:$PATH\" dpm clean); done",
    "codegen": "npm run build && canton-dev-tools codegen-js && canton-dev-tools bundle-dependencies && canton-dev-tools create-root-index && tsx scripts/bundle-local-packages.ts && canton-dev-tools fix-splice-refs --target lib && npm run build:ts && tsx scripts/stage-npm-opencaptable-dar.ts && npm run build:npm-runtime-lib",
    "create-factory:ocp": "npm run codegen && tsx scripts/create-ocp-factory.ts --network devnet",
    "fix": "npm run lint:fix && npm run format:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate:test-vectors": "tsx scripts/test-vectors/test-vectors.ts --write",
    "generate-captable": "tsx scripts/codegen/generate-captable.ts",
    "lint": "eslint .",
    "lint:daml": "if [ ! -f generated/build/multi-package.yaml ]; then npm run prepare-build || exit 1; fi; EXIT_CODE=0; for pkg in $(node -p \"require('yaml').parse(require('fs').readFileSync('generated/build/multi-package.yaml', 'utf8')).packages.join(' ')\"); do echo \"Linting $pkg...\"; (cd generated/build/$pkg && PATH=\"$HOME/.dpm/bin:$PATH\" dpm damlc lint) || EXIT_CODE=1; done; exit $EXIT_CODE",
    "lint:fix": "eslint . --fix",
    "package:manifest": "npm run package:prep && npm pack --dry-run --json --ignore-scripts > /tmp/npm-pack.json 2>/dev/null && jq -r '.[0].files[].path' /tmp/npm-pack.json | sort | canton-dev-tools collapse-manifest > generated/npm-manifest.txt",
    "package:prep": "npm run codegen",
    "package:publish": "npm run package:manifest && npm publish",
    "prepare-build": "canton-dev-tools prepare-build",
    "prepare-release": "canton-dev-tools prepare-release --changelog-repo Fairmint/open-captable-protocol-daml",
    "release:detect-factory-need": "tsx scripts/detect-factory-need.ts",
    "release:parse-tag": "tsx scripts/parse-release-tag.ts",
    "preremove-participant-dar": "npm run sync-splice-dars",
    "remove-participant-dar": "tsx scripts/remove-participant-dar.ts",
    "sync-splice-dars": "canton-dev-tools sync-splice-dars",
    "pretest": "npm run generate-captable",
    "test": "npm run prepare-build && cd generated/build && PATH=\"$HOME/.dpm/bin:$PATH\" dpm build --all && cd Test && PATH=\"$HOME/.dpm/bin:$PATH\" dpm test --show-coverage --color",
    "test:codegen": "tsx --test scripts/codegen/generate-captable.test.ts",
    "test:dar-version-policy": "tsx scripts/test/dar-version-policy.test.ts",
    "test:factory-recovery": "tsx --test scripts/create-ocp-factory.test.ts",
    "test:imports": "tsx scripts/test-imports.ts",
    "test:schema-gaps": "tsx --test scripts/schema-gap-checker/check-schema-gaps.test.ts",
    "test:vectors": "tsx scripts/test-vectors/test-vectors.ts",
    "update-version": "canton-dev-tools codegen-js --skip-dpm",
    "upgrade-package": "tsx scripts/upgrade-package.ts",
    "upload-dar": "tsx scripts/upload-dar.ts",
    "verify-dars": "canton-dev-tools verify-dars",
    "verify-merged-lib": "tsx scripts/verify-merged-lib-runtime.ts",
    "verify-package": "tsx scripts/verify-package-imports.ts && npm run verify-merged-lib && npm run test:imports",
    "vet-package-allow-incompatible-upgrade": "tsx scripts/vet-package-allow-incompatible-upgrade.ts"
  },
  "dependencies": {
    "@daml/ledger": "2.10.4",
    "@daml/types": "3.5.2",
    "@fairmint/canton-node-sdk": "0.0.266"
  },
  "devDependencies": {
    "@fairmint/canton-dev-tools": "0.1.7",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/utils": "8.66.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "handlebars": "4.7.9",
    "prettier": "3.9.6",
    "prettier-plugin-jsdoc": "1.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.7",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@daml/ledger": "2.10.4",
    "@daml/types": "3.5.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "cantonDevTools": {
    "darVersionPolicyWatchPaths": [
      "scripts/codegen/",
      "package.json"
    ],
    "damlJsBundle": "./daml-js-bundle.json",
    "codegenPublishSuffixes": {
      "OpenCapTable-v35": null
    }
  }
}
