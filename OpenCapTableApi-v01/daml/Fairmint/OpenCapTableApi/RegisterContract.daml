-- Reader interface implemented by the cap table anchor and its state contracts in OpenCapTable-v35.
module Fairmint.OpenCapTableApi.RegisterContract where

-- Kind of register contract.
data RegisterKind
  = RegisterKindCapTable
  | RegisterKindStockSecurity
  | RegisterKindStockClassEpoch
  | RegisterKindOcfIdShard
  deriving (Eq, Ord, Show, Enum, Bounded)

-- What a reader needs to index a register contract. `key` is the anchor's cap table ID, a stock
-- security's security ID, an epoch's stock class ID or a shard's bit prefix. Readers index a
-- contract only if its template is OpenCapTable-v35's and its signatories are the cap table's
-- issuer, system operator and transfer agent: any package can implement this interface.
data RegisterContractView = RegisterContractView
  with
    -- The cap table the contract belongs to
    cap_table_id : Text
    -- Which register contract this is
    kind : RegisterKind
    -- The contract's key within its kind and cap table
    key : Text
  deriving (Eq, Show)

-- No choices: an interface choice would run the implementer's code with the exerciser's authority.
interface RegisterContract where
  viewtype RegisterContractView
