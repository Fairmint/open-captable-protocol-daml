-- Reader interface implemented by every OCF record template of an OpenCapTable-v35 register.
module Fairmint.OpenCapTableApi.OcfObject where

-- What a reader needs to index an OCF record without decoding its payload. Readers index a
-- contract only if its template is OpenCapTable-v35's and its signatories are the cap table's
-- issuer, system operator and transfer agent: any package can implement this interface. An
-- interface package can never be upgraded, so the view holds only builtin types, and a new object
-- type in a later OpenCapTable-v35 needs no new interface.
data OcfObjectView = OcfObjectView
  with
    -- The cap table the record belongs to
    cap_table_id : Text
    -- The record's OCF `object_type` string, such as "TX_STOCK_ISSUANCE"
    object_type : Text
    -- The record's OCF object ID
    object_id : Text
    -- Every security ID the record names, deduplicated
    security_ids : [Text]
  deriving (Eq, Show)

-- No choices: an interface choice would run the implementer's code with the exerciser's authority.
interface OcfObject where
  viewtype OcfObjectView
