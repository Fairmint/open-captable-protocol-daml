-- System-operator factory that gives each cap table its ID from a counter and authorizes an issuer, with its pinned transfer agent, to create it.
module Fairmint.OpenCapTable.OcpFactory where

import DA.Action (unless)
import qualified DA.Text as T
import Fairmint.OpenCapTable.IssuerAuthorization (IssuerAuthorization(..))
import Fairmint.OpenCapTable.Types.Core (Context(..), validateContext)

-- | Consumed by each authorization, so the counter only grows and each `cap_table_id`
-- (`<factory_id>-<n>`) is issued once by this factory. Uniqueness across factories is the system
-- operator's to keep, with a duplicate-anchor detector.
template OcpFactory
  with
    system_operator : Party
    -- Non-empty, with no ':' (derived IDs are a cap table ID, a colon and a hash)
    factory_id : Text
    -- The number the next cap table gets; starts at 1
    next_cap_table_number : Int
  where
    signatory system_operator

    ensure
      factory_id /= "" &&
      not (T.isInfixOf ":" factory_id) &&
      next_cap_table_number >= 1

    -- | Takes the next cap table ID and creates the authorization that pins the issuer's TA: a
    -- party other than the issuer and the system operator, so the issuer cannot name itself.
    choice OcpFactory_AuthorizeIssuer : OcpFactory_AuthorizeIssuerResult
      with
        issuer : Party
        transfer_agent : Party
      controller system_operator
      do
        let context = Context with
              cap_table_id = factory_id <> "-" <> show next_cap_table_number
              issuer
              system_operator
              transfer_agent
        unless (validateContext context)
          (abort "the issuer, the system operator and the transfer agent must be three distinct parties")
        authorization <- create IssuerAuthorization with context; ta_accepted = False
        factory <- create this with next_cap_table_number = next_cap_table_number + 1
        pure OcpFactory_AuthorizeIssuerResult with
          factory
          authorization
          cap_table_id = context.cap_table_id

data OcpFactory_AuthorizeIssuerResult = OcpFactory_AuthorizeIssuerResult
  with
    factory : ContractId OcpFactory
    authorization : ContractId IssuerAuthorization
    cap_table_id : Text
  deriving (Eq, Show)
