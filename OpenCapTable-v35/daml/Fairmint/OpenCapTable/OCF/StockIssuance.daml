-- OCF TX_STOCK_ISSUANCE record: shares of a stock class issued to a stakeholder, with their price, legends and vesting.
module Fairmint.OpenCapTable.OCF.StockIssuance where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)
import Fairmint.OpenCapTable.Types.Stock (OcfSecurityExemption, OcfShareNumberRange, validateOcfSecurityExemption, validateOcfShareNumberRange)
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting, validateOcfVesting, validateOcfVestingsWithinQuantity)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template StockIssuance
  with
    context : Context
    ocf_data : StockIssuanceOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure
      validateContext context &&
      validateStockIssuanceOcfData ocf_data

    interface instance OcfObject for StockIssuance where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxStockIssuance
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Stock Issuance Transaction
-- Object describing a stock issuance transaction by the issuer and held by a stakeholder
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/issuance/StockIssuance.schema.json
data StockIssuanceOcfData = StockIssuanceOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- A custom ID for this security (e.g. CS-1.)
    custom_id : Text
    -- Date on which the transaction occurred
    date : Date
    -- Quantity of shares issued
    quantity : Decimal
    -- Identifier for the security by which it can be referenced by other transaction objects
    security_id : Text
    -- Price per share paid for the stock
    share_price : OcfMonetary
    -- Identifier for the stakeholder that holds legal title to this security
    stakeholder_id : Text
    -- Identifier of the stock class of the issued security
    stock_class_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- List of security law exemptions (and applicable jurisdictions) for this security
    security_law_exemptions : [OcfSecurityExemption]
    -- Share number ranges (if any) associated with this issuance
    share_numbers_issued : [OcfShareNumberRange]
    -- Stock legends that apply to this issuance. OCF requires the field but sets no minItems, so an
    -- empty array conforms.
    stock_legend_ids : [Text]
    -- Vesting schedule entries associated directly with this issuance. OCF sets minItems: 1 when the
    -- field is present; an empty array stands for an absent field.
    vestings : [OcfVesting]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Date of board approval for the security
    board_approval_date : Optional Date
    -- Unstructured text description of consideration provided in exchange for security issuance
    consideration_text : Optional Text
    -- Cost basis for the shares issued
    cost_basis : Optional OcfMonetary
    -- Type of stock issuance (e.g., RSA, founders stock)
    issuance_type : Optional OcfStockIssuanceType
    -- Identifier for the stock plan, if applicable
    stock_plan_id : Optional Text
    -- Date on which the stockholders approved the security
    stockholder_approval_date : Optional Date
    -- Reference to vesting terms object, if used instead of inline vestings
    vesting_terms_id : Optional Text
  deriving (Eq, Show)

-- Enum - Stock Issuance Type
-- Issuance types that draw attention to a unique aspect of a stock issuance (e.g. is it an RSA)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/StockIssuanceType.schema.json
data OcfStockIssuanceType
  = OcfStockIssuanceTypeRsa
  | OcfStockIssuanceTypeFoundersStock
  deriving (Eq, Show)

validateStockIssuanceOcfData : StockIssuanceOcfData -> Bool
validateStockIssuanceOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.custom_id /= "" &&
  d.stakeholder_id /= "" &&
  d.stock_class_id /= "" &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  all validateOcfSecurityExemption d.security_law_exemptions &&
  all validateOcfShareNumberRange d.share_numbers_issued &&
  all validateOcfVesting d.vestings &&
  validateOcfVestingsWithinQuantity d.quantity d.vestings &&
  validateNonEmptyStringsArray d.comments &&
  -- Legend IDs are non-empty; an empty list conforms to OCF
  validateNonEmptyStringsArray d.stock_legend_ids &&
  -- Required amounts
  validateOcfMonetary d.share_price &&
  d.quantity > (0.0) &&
  -- Optional Text values, if present, must be non-empty
  validateOptionalText d.consideration_text &&
  validateOptionalText d.stock_plan_id &&
  validateOptionalText d.vesting_terms_id
