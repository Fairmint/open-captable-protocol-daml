-- OCF CE_STAKEHOLDER_STATUS record: a change in a stakeholder's activity status.
module Fairmint.OpenCapTable.OCF.StakeholderStatusChangeEvent where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.OCF.Stakeholder (OcfStakeholderStatusType)

template StakeholderStatusChangeEvent
  with
    context : Context
    ocf_data : StakeholderStatusChangeEventOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStakeholderStatusChangeEventOcfData ocf_data

    interface instance OcfObject for StakeholderStatusChangeEvent where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeCeStakeholderStatus
        object_id = ocf_data.id
        security_ids = []

-- Object - Stakeholder Status Change Event
-- Object describing a change in stakeholder activity status
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/change_event/StakeholderStatusChangeEvent.schema.json
data StakeholderStatusChangeEventOcfData = StakeholderStatusChangeEventOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the change event occurred
    date : Date
    -- New activity status for the stakeholder
    new_status : OcfStakeholderStatusType
    -- Identifier for the stakeholder subject to this change
    stakeholder_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateStakeholderStatusChangeEventOcfData : StakeholderStatusChangeEventOcfData -> Bool
validateStakeholderStatusChangeEventOcfData d =
  d.id /= "" &&
  d.stakeholder_id /= "" &&
  validateNonEmptyStringsArray d.comments
