-- OCF TX_EQUITY_COMPENSATION_RELEASE record: shares of an RSU or other equity compensation released and settled into resulting securities.
module Fairmint.OpenCapTable.OCF.EquityCompensationRelease where

import DA.List (dedup)
import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template EquityCompensationRelease
  with
    context : Context
    ocf_data : EquityCompensationReleaseOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateEquityCompensationReleaseOcfData ocf_data

    interface instance OcfObject for EquityCompensationRelease where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxEquityCompensationRelease
        object_id = ocf_data.id
        security_ids = dedup ([ocf_data.security_id] <> ocf_data.resulting_security_ids)

-- Object - Equity Compensation Release Transaction
-- Object describing RSU/restricted stock release/settlement
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/release/EquityCompensationRelease.schema.json
data EquityCompensationReleaseOcfData = EquityCompensationReleaseOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Quantity of shares released
    quantity : Decimal
    -- Price used to determine value at release
    release_price : OcfMonetary
    -- Identifier for the security being released
    security_id : Text
    -- Settlement date for the released shares
    settlement_date : Date

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Identifiers for new securities issued as result of release
    resulting_security_ids : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Description of consideration provided in exchange for release
    consideration_text : Optional Text
  deriving (Eq, Show)

validateEquityCompensationReleaseOcfData : EquityCompensationReleaseOcfData -> Bool
validateEquityCompensationReleaseOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.quantity > 0.0 &&
  validateOcfMonetary d.release_price &&
  not (null d.resulting_security_ids) &&
  validateNonEmptyStringsArray d.comments &&
  validateNonEmptyStringsArray d.resulting_security_ids &&
  validateOptionalText d.consideration_text
