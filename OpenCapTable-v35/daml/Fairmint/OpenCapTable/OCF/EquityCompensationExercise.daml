-- OCF TX_EQUITY_COMPENSATION_EXERCISE record: shares of an option or SAR exercised into resulting securities.
module Fairmint.OpenCapTable.OCF.EquityCompensationExercise where

import DA.List (dedup)
import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template EquityCompensationExercise
  with
    context : Context
    ocf_data : EquityCompensationExerciseOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateEquityCompensationExerciseOcfData ocf_data

    interface instance OcfObject for EquityCompensationExercise where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxEquityCompensationExercise
        object_id = ocf_data.id
        security_ids = dedup ([ocf_data.security_id] <> ocf_data.resulting_security_ids)

-- Object - Equity Compensation Exercise Transaction
-- Object describing equity compensation exercise transaction
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/exercise/EquityCompensationExercise.schema.json
data EquityCompensationExerciseOcfData = EquityCompensationExerciseOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Quantity of shares exercised
    quantity : Decimal
    -- Identifier for the security (stock, plan security, warrant, or convertible) by which it can be referenced by other transaction objects
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Security Exercise - Resulting Security ID Array
    -- Identifier for the security (or securities) that resulted from the exercise
    resulting_security_ids : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Unstructured text description of consideration provided in exchange for security exercise
    consideration_text : Optional Text
  deriving (Eq, Show)

validateEquityCompensationExerciseOcfData : EquityCompensationExerciseOcfData -> Bool
validateEquityCompensationExerciseOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  -- An exercise takes a positive quantity
  d.quantity > 0.0 &&
  -- Optional Text values, if present, must be non-empty
  validateOptionalText d.consideration_text &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  validateNonEmptyStringsArray d.comments &&
  validateNonEmptyStringsArray d.resulting_security_ids
