-- OCF TX_VESTING_START record: the start (commencement) of a security's vesting schedule, under a condition of its vesting terms.
module Fairmint.OpenCapTable.OCF.VestingStart where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template VestingStart
  with
    context : Context
    ocf_data : VestingStartOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateVestingStartOcfData ocf_data

    interface instance OcfObject for VestingStart where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxVestingStart
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Vesting Start Transaction
-- Object describing the transaction of vesting schedule start / commencement associated with a security
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/vesting/VestingStart.schema.json
data VestingStartOcfData = VestingStartOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Identifier for the security whose vesting is starting
    security_id : Text
    -- Reference to the id of a VestingCondition in this security's VestingTerms
    -- This condition should have a trigger type of VESTING_START_DATE
    vesting_condition_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateVestingStartOcfData : VestingStartOcfData -> Bool
validateVestingStartOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.vesting_condition_id /= "" &&
  -- Arrays element validation
  validateNonEmptyStringsArray d.comments
