-- OCF ISSUER record: the company whose cap table this is; one per cap table, created with the cap table.
module Fairmint.OpenCapTable.OCF.Issuer where

import qualified DA.Text as Text
import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateOcfCountryCode, validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Contact (OcfAddress, OcfEmail, OcfPhone, OcfTaxID, validateOcfAddress, validateOcfEmail, validateOcfPhone, validateOcfTaxID)
import Fairmint.OpenCapTable.Types.Stock (OcfInitialSharesAuthorized(..))
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template Issuer
  with
    context : Context
    ocf_data : IssuerOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateIssuerOcfData ocf_data

    interface instance OcfObject for Issuer where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeIssuer
        object_id = ocf_data.id
        security_ids = []

-- Object - Issuer
-- Object describing the issuer of the cap table (the company whose cap table this is)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/Issuer.schema.json
data IssuerOcfData = IssuerOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- The country where the issuer company was legally formed (ISO 3166-1 alpha-2)
    country_of_formation : Text
    -- Date of formation
    formation_date : Date
    -- Legal name of the issuer
    legal_name : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- The tax ids for this issuer company
    tax_ids : [OcfTaxID]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- The headquarters address of the issuing company
    address : Optional OcfAddress
    -- The text name of the subdivision where the issuer was formed, if the code is not available
    country_subdivision_name_of_formation : Optional Text
    -- The code for the state, province, or subdivision where the issuer was legally formed
    country_subdivision_of_formation : Optional Text
    -- Doing Business As name
    dba : Optional Text
    -- A work email that the issuer company can be reached at
    email : Optional OcfEmail
    -- The initial number of shares authorized for this issuer
    initial_shares_authorized : Optional OcfInitialSharesAuthorized
    -- A phone number that the issuer company can be reached at
    phone : Optional OcfPhone
  deriving (Eq, Show)

validateIssuerOcfData : IssuerOcfData -> Bool
validateIssuerOcfData d =
  d.id /= "" &&
  validateOcfLegalName d.legal_name &&
  validateOcfCountryCode d.country_of_formation &&
  optional True validateOcfCountrySubdivisionCode d.country_subdivision_of_formation &&
  -- Subdivision code and subdivision name must not both be present (schema anyOf logic)
  (case (d.country_subdivision_of_formation, d.country_subdivision_name_of_formation) of
    (Some _, Some _) -> False
    _ -> True) &&
  optional True validateOcfEmail d.email &&
  optional True validateOcfPhone d.phone &&
  optional True validateOcfAddress d.address &&
  validateOptionalText d.country_subdivision_name_of_formation &&
  validateOptionalText d.dba &&
  validateNonEmptyStringsArray d.comments &&
  all validateOcfTaxID d.tax_ids &&
  (case d.initial_shares_authorized of
    None -> True
    Some (OcfInitialSharesNumeric n) -> n >= (0.0)
    Some (OcfInitialSharesEnum _) -> True)

validateOcfCountrySubdivisionCode : Text -> Bool
validateOcfCountrySubdivisionCode subdivisionCode =
  subdivisionCode /= "" &&
  Text.length subdivisionCode >= 1 &&
  Text.length subdivisionCode <= 3

validateOcfLegalName : Text -> Bool
validateOcfLegalName name =
  name /= ""
