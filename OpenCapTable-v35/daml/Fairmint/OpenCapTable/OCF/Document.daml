-- OCF DOCUMENT record: a document's checksum and location, and the OCF objects it relates to.
module Fairmint.OpenCapTable.OCF.Document where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateOcfMd5, validateNonEmptyStringsArray)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template Document
  with
    context : Context
    ocf_data : DocumentOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure
      validateContext context &&
      validateDocumentOcfData ocf_data

    interface instance OcfObject for Document where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeDocument
        object_id = ocf_data.id
        security_ids = []

-- Object - Document
-- Object describing a document
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/Document.schema.json
data DocumentOcfData = DocumentOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- MD5 hash of the document contents (32-character hex)
    md5 : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- References to related OCF objects
    related_objects : [OcfObjectReference]

    -- Optional fields (alphabetical; OCF oneOf: exactly one is required)
    ---------------------------------

    -- Relative file path to the document within the OCF bundle
    path : Optional Text
    -- External URI to the document (used when the file is hosted elsewhere)
    uri : Optional Text
  deriving (Eq, Show)

validateDocumentOcfData : DocumentOcfData -> Bool
validateDocumentOcfData d =
  d.id /= "" &&
  validateOcfMd5 d.md5 &&
  validateOptionalText d.path &&
  validateOptionalText d.uri &&
  -- oneOf: exactly one of path and uri
  (case (d.path, d.uri) of
    (Some _, None) -> True
    (None, Some _) -> True
    _ -> False) &&
  validateNonEmptyStringsArray d.comments &&
  all validateOcfObjectReference d.related_objects

-- Type - Object Reference
-- A type representing a reference to any kind of OCF object. `OcfObjectType` has no
-- TX_PLAN_SECURITY_* aliases: writers normalize them to TX_EQUITY_COMPENSATION_*.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/ObjectReference.schema.json
data OcfObjectReference = OcfObjectReference
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Identifier of the referenced object
    object_id : Text
    -- Type of the referenced object
    object_type : OcfObjectType
  deriving (Eq, Show)

-- Validator specific to Document-related object references
validateOcfObjectReference : OcfObjectReference -> Bool
validateOcfObjectReference r = r.object_id /= ""
