-- OCF TX_STOCK_CLASS_SPLIT record: a split of every share of a stock class by a ratio.
module Fairmint.OpenCapTable.OCF.StockClassSplit where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Stock (OcfRatio, validateOcfRatio)

template StockClassSplit
  with
    context : Context
    ocf_data : StockClassSplitOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockClassSplitOcfData ocf_data

    interface instance OcfObject for StockClassSplit where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxStockClassSplit
        object_id = ocf_data.id
        security_ids = []

-- Object - Stock Class Split Transaction
-- Object describing a split of a stock class. It names the class (StockClassTransaction), not a
-- security.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/split/StockClassSplit.schema.json
data StockClassSplitOcfData = StockClassSplitOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Ratio of new shares to old shares
    -- For 2-for-1 split the numerator is 2 and the denominator is 1
    split_ratio : OcfRatio
    -- Identifier for the stock class being split
    stock_class_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateStockClassSplitOcfData : StockClassSplitOcfData -> Bool
validateStockClassSplitOcfData d =
  d.id /= "" &&
  d.stock_class_id /= "" &&
  validateOcfRatio d.split_ratio &&
  -- Arrays element validation
  validateNonEmptyStringsArray d.comments
