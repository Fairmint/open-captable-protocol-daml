-- OCF TX_STOCK_CONSOLIDATION record: stock securities combined into one resulting security.
module Fairmint.OpenCapTable.OCF.StockConsolidation where

import DA.List (dedup)
import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template StockConsolidation
  with
    context : Context
    ocf_data : StockConsolidationOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockConsolidationOcfData ocf_data

    interface instance OcfObject for StockConsolidation where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxStockConsolidation
        object_id = ocf_data.id
        security_ids = dedup (ocf_data.security_ids <> [ocf_data.resulting_security_id])

-- Object - Stock Consolidation Transaction
-- Object describing a consolidation of stock positions
-- Note: This transaction uses security_ids (plural, array) instead of security_id (single)
-- and resulting_security_id (single) instead of resulting_security_ids (array)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/consolidation/StockConsolidation.schema.json
data StockConsolidationOcfData = StockConsolidationOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Identifier for the single resulting security from consolidation
    resulting_security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Identifiers for the securities being consolidated
    -- minItems: 1
    security_ids : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Reason for the consolidation; unstructured text
    reason_text : Optional Text
  deriving (Eq, Show)

validateStockConsolidationOcfData : StockConsolidationOcfData -> Bool
validateStockConsolidationOcfData d =
  d.id /= "" &&
  d.resulting_security_id /= "" &&
  -- Optional Text values, if present, must be non-empty
  validateOptionalText d.reason_text &&
  -- Arrays element validation (security_ids required per Consolidation base schema)
  validateNonEmptyStringsArray d.comments &&
  validateNonEmptyStringsArray d.security_ids &&
  not (null d.security_ids)
