-- OCF TX_EQUITY_COMPENSATION_ACCEPTANCE record: a stakeholder's acceptance of an equity compensation security issued to them.
module Fairmint.OpenCapTable.OCF.EquityCompensationAcceptance where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template EquityCompensationAcceptance
  with
    context : Context
    ocf_data : EquityCompensationAcceptanceOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateEquityCompensationAcceptanceOcfData ocf_data

    interface instance OcfObject for EquityCompensationAcceptance where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxEquityCompensationAcceptance
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Equity Compensation Acceptance Transaction
-- Object describing an equity compensation acceptance transaction
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/acceptance/EquityCompensationAcceptance.schema.json
data EquityCompensationAcceptanceOcfData = EquityCompensationAcceptanceOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Identifier for the security (stock, plan security, warrant, or convertible) by which it can be referenced by other transaction objects. Note that while this identifier is created with an issuance object, it should be different than the issuance object's `id` field which identifies the issuance transaction object itself. All future transactions on the security (e.g. acceptance, transfer, cancel, etc.) must reference this `security_id` to qualify which security the transaction applies to.
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateEquityCompensationAcceptanceOcfData : EquityCompensationAcceptanceOcfData -> Bool
validateEquityCompensationAcceptanceOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  validateNonEmptyStringsArray d.comments
