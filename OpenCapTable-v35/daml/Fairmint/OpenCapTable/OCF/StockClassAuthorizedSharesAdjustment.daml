-- OCF TX_STOCK_CLASS_AUTHORIZED_SHARES_ADJUSTMENT record: a change to the number of shares authorized for a stock class.
module Fairmint.OpenCapTable.OCF.StockClassAuthorizedSharesAdjustment where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template StockClassAuthorizedSharesAdjustment
  with
    context : Context
    ocf_data : StockClassAuthorizedSharesAdjustmentOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockClassAuthorizedSharesAdjustmentOcfData ocf_data

    interface instance OcfObject for StockClassAuthorizedSharesAdjustment where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxStockClassAuthorizedSharesAdjustment
        object_id = ocf_data.id
        security_ids = []

-- Object - Stock Class Authorized Shares Adjustment Transaction
-- Object describing an event to change the number of authorized shares of a stock class
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/adjustment/StockClassAuthorizedSharesAdjustment.schema.json
data StockClassAuthorizedSharesAdjustmentOcfData = StockClassAuthorizedSharesAdjustmentOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- New total number of authorized shares for the stock class
    new_shares_authorized : Decimal
    -- Identifier for the stock class
    stock_class_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Date of board approval for the transaction
    board_approval_date : Optional Date
    -- Date on which the stockholders approved the transaction
    stockholder_approval_date : Optional Date
  deriving (Eq, Show)

validateStockClassAuthorizedSharesAdjustmentOcfData : StockClassAuthorizedSharesAdjustmentOcfData -> Bool
validateStockClassAuthorizedSharesAdjustmentOcfData d =
  d.id /= "" &&
  d.stock_class_id /= "" &&
  d.new_shares_authorized >= (0.0) &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  validateNonEmptyStringsArray d.comments
