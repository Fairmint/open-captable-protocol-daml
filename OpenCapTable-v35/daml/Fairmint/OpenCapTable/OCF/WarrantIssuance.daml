-- OCF TX_WARRANT_ISSUANCE record: a warrant issued to a stakeholder, with its exercise triggers, price and vesting.
module Fairmint.OpenCapTable.OCF.WarrantIssuance where

import DA.List (unique)
import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)
import Fairmint.OpenCapTable.Types.Stock (OcfQuantitySourceType, OcfSecurityExemption, ocfQuantityUpperBound, validateOcfSecurityExemption)
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting, validateOcfVesting, validateOcfVestingsWithinQuantity)
import Fairmint.OpenCapTable.Types.Conversion (OcfConversionTrigger, validateOcfConversionTrigger, validateOcfConversionTriggerWithinExpiration)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template WarrantIssuance
  with
    context : Context
    ocf_data : WarrantIssuanceOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure
      validateContext context &&
      validateWarrantIssuanceOcfData ocf_data

    interface instance OcfObject for WarrantIssuance where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxWarrantIssuance
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Warrant Issuance Transaction
-- Object describing warrant issuance transaction by the issuer and held by a stakeholder
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/issuance/WarrantIssuance.schema.json
data WarrantIssuanceOcfData = WarrantIssuanceOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- A custom ID for this security (e.g. CN-1.)
    custom_id : Text
    -- Date on which the transaction occurred
    date : Date
    -- Actual purchase price of the warrant (sum up purported value of all consideration, including in-kind)
    purchase_price : OcfMonetary
    -- Identifier for the security (stock, plan security, warrant, or convertible) by which it can be referenced by other transaction objects
    security_id : Text
    -- Identifier for the stakeholder that holds legal title to this security
    stakeholder_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- Warrant Issuance - Exercise Trigger Array
    -- In event the Warrant can convert due to trigger events (e.g. Maturity, Next Qualified Financing, Change of Control, at Election of Holder), what are the terms?
    -- OCF requires the field but sets no minItems, so an empty array conforms.
    exercise_triggers : [OcfConversionTrigger]
    -- List of security law exemptions (and applicable jurisdictions) for this security
    security_law_exemptions : [OcfSecurityExemption]
    -- Warrant Issuance - Vestings Array
    -- List of exact vesting dates and amounts for this security. When `vestings` array is present then `vesting_terms_id` may be ignored.
    -- OCF sets minItems: 1 when the field is present; an empty array stands for an absent field.
    vestings : [OcfVesting]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Date of board approval for the security
    board_approval_date : Optional Date
    -- Unstructured text description of consideration provided in exchange for security issuance
    consideration_text : Optional Text
    -- The exercise price of the warrant
    exercise_price : Optional OcfMonetary
    -- Quantity of shares the warrant is exercisable for
    quantity : Optional Decimal
    -- If quantity is provided, use this to specify where the number came from - e.g. was it a fixed value from the instrument (`INSTRUMENT_FIXED`), a human estimate (`HUMAN_ESTIMATED`), etc. If quantity is provided and this field is not, this is assumed to be `UNSPECIFIED`
    quantity_source : Optional OcfQuantitySourceType
    -- Date on which the stockholders approved the security
    stockholder_approval_date : Optional Date
    -- Identifier of the VestingTerms to which this security is subject. If neither `vesting_terms_id` or `vestings` are present then the security is fully vested on issuance.
    vesting_terms_id : Optional Text
    -- What is expiration date of the warrant (if applicable)
    -- This may not be necessary as it can be expressed with the exercise_triggers
    warrant_expiration_date : Optional Date
  deriving (Eq, Show)

validateWarrantIssuanceOcfData : WarrantIssuanceOcfData -> Bool
validateWarrantIssuanceOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.custom_id /= "" &&
  d.stakeholder_id /= "" &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  all validateOcfSecurityExemption d.security_law_exemptions &&
  validateNonEmptyStringsArray d.comments &&
  -- Required amounts and lists
  -- quantity is optional per schema; exercise_price is optional per schema, and valid when present
  validateOcfMonetary d.purchase_price &&
  optional True validateOcfMonetary d.exercise_price &&
  validateOptionalText d.consideration_text &&
  -- Trigger IDs are unique within the warrant, and each trigger carries the fields its type needs
  unique (map (\trigger -> trigger.trigger_id) d.exercise_triggers) &&
  all validateOcfConversionTrigger d.exercise_triggers &&
  -- The warrant expires on or after its issuance date, and no trigger date falls after the expiration
  optional True (\expiration -> expiration >= d.date) d.warrant_expiration_date &&
  all
    (\trigger -> validateOcfConversionTriggerWithinExpiration d.warrant_expiration_date trigger.end_date trigger.trigger_date)
    d.exercise_triggers &&
  validateOptionalText d.vesting_terms_id &&
  all validateOcfVesting d.vestings &&
  -- Vestings stay within the quantity only when it is a fixed or maximum instrument quantity
  (case ocfQuantityUpperBound d.quantity d.quantity_source of
     Some quantity -> validateOcfVestingsWithinQuantity quantity d.vestings
     None -> True)
