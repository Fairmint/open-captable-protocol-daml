-- OCF STAKEHOLDER record: a person or institution on the cap table, with its name, contacts and relationships to the issuer.
module Fairmint.OpenCapTable.OCF.Stakeholder where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Contact (OcfAddress, OcfEmail, OcfPhone, OcfTaxID, validateOcfAddress, validateOcfEmail, validateOcfPhone, validateOcfTaxID)
import Fairmint.OpenCapTable.Types.Stakeholder (OcfStakeholderRelationshipType)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template Stakeholder
  with
    context : Context
    ocf_data : StakeholderOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStakeholderOcfData ocf_data

    interface instance OcfObject for Stakeholder where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeStakeholder
        object_id = ocf_data.id
        security_ids = []

-- Object - Stakeholder
-- Object describing a stakeholder in the issuer's cap table
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/Stakeholder.schema.json
data StakeholderOcfData = StakeholderOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Stakeholder's name
    name : OcfName
    -- Stakeholder type (Individual or Institution)
    stakeholder_type : OcfStakeholderType

    -- Arrays (alphabetical)
    ---------------------------------

    -- Mailing or legal addresses
    addresses : [OcfAddress]
    -- Unstructured comments
    comments : [Text]
    -- Current relationship(s) to issuer
    current_relationships : [OcfStakeholderRelationshipType]
    -- Tax identification numbers
    tax_ids : [OcfTaxID]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- The contact info for an individual stakeholder
    contact_info : Optional OcfContactInfoWithoutName
    -- Current employment/engagement status
    current_status : Optional OcfStakeholderStatusType
    -- Issuer's internal ID
    issuer_assigned_id : Optional Text
    -- The primary contact info for an institutional stakeholder
    primary_contact : Optional OcfContactInfo
  deriving (Eq, Show)

validateStakeholderOcfData : StakeholderOcfData -> Bool
validateStakeholderOcfData d =
  d.id /= "" &&
  validateOcfName d.name &&
  -- Optional text values, if present, must be non-empty
  validateOptionalText d.issuer_assigned_id &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  all validateOcfAddress d.addresses &&
  validateNonEmptyStringsArray d.comments &&
  all validateOcfTaxID d.tax_ids &&
  -- Optional contact infos
  optional True validateOcfContactInfo d.primary_contact &&
  optional True validateOcfContactInfoWithoutName d.contact_info

-- Type - Name
-- Type representation of a name
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Name.schema.json
data OcfName = OcfName
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Full legal name
    legal_name : Text

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Given name
    first_name : Optional Text
    -- Family name
    last_name : Optional Text
  deriving (Eq, Show)

validateOcfName : OcfName -> Bool
validateOcfName n =
  n.legal_name /= "" &&
  validateOptionalText n.first_name &&
  validateOptionalText n.last_name

-- Type - Contact Info
-- Type representation of a primary contact person for a stakeholder (e.g. a fund)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/ContactInfo.schema.json
data OcfContactInfo = OcfContactInfo
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Contact name (OCF requires it in both branches of its anyOf)
    name : OcfName

    -- Arrays (alphabetical)
    ---------------------------------

    -- Email addresses
    emails : [OcfEmail]
    -- Phone numbers
    phone_numbers : [OcfPhone]
  deriving (Eq, Show)

validateOcfContactInfo : OcfContactInfo -> Bool
validateOcfContactInfo info =
  validateOcfName info.name &&
  all validateOcfPhone info.phone_numbers &&
  all validateOcfEmail info.emails &&
  -- anyOf requirement: at least one of phone_numbers or emails must be non-empty
  (not (null info.phone_numbers) || not (null info.emails))

-- Type - Contact Info Without Name
-- Type representation of the contact info for an individual stakeholder
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/ContactInfoWithoutName.schema.json
data OcfContactInfoWithoutName = OcfContactInfoWithoutName
  with
    -- Arrays (alphabetical)
    ---------------------------------

    -- Email addresses
    emails : [OcfEmail]
    -- Phone numbers
    phone_numbers : [OcfPhone]
  deriving (Eq, Show)

validateOcfContactInfoWithoutName : OcfContactInfoWithoutName -> Bool
validateOcfContactInfoWithoutName info =
  all validateOcfPhone info.phone_numbers &&
  all validateOcfEmail info.emails &&
  -- anyOf requirement: at least one of phone_numbers or emails must be non-empty
  (not (null info.phone_numbers) || not (null info.emails))

-- Enum - Stakeholder Type
-- Type of stakeholder (individual or institution)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/StakeholderType.schema.json
data OcfStakeholderType
  = OcfStakeholderTypeIndividual
  | OcfStakeholderTypeInstitution
  deriving (Eq, Show)

-- Enum - Stakeholder Status Type
-- Activity status of a stakeholder
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/StakeholderStatusType.schema.json
data OcfStakeholderStatusType
  = OcfStakeholderStatusTypeActive
  | OcfStakeholderStatusTypeLeaveOfAbsence
  | OcfStakeholderStatusTypeTerminationVoluntaryOther
  | OcfStakeholderStatusTypeTerminationVoluntaryGoodCause
  | OcfStakeholderStatusTypeTerminationVoluntaryRetirement
  | OcfStakeholderStatusTypeTerminationInvoluntaryOther
  | OcfStakeholderStatusTypeTerminationInvoluntaryDeath
  | OcfStakeholderStatusTypeTerminationInvoluntaryDisability
  | OcfStakeholderStatusTypeTerminationInvoluntaryWithCause
  deriving (Eq, Show)
