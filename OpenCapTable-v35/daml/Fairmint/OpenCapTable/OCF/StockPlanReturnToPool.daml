-- OCF TX_STOCK_PLAN_RETURN_TO_POOL record: shares of a cancelled plan security returned to its stock plan's pool.
module Fairmint.OpenCapTable.OCF.StockPlanReturnToPool where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template StockPlanReturnToPool
  with
    context : Context
    ocf_data : StockPlanReturnToPoolOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockPlanReturnToPoolOcfData ocf_data

    interface instance OcfObject for StockPlanReturnToPool where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeTxStockPlanReturnToPool
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Stock Plan Return to Pool Transaction
-- Object describing return of cancelled shares to stock plan pool
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/return_to_pool/StockPlanReturnToPool.schema.json
data StockPlanReturnToPoolOcfData = StockPlanReturnToPoolOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Quantity of shares returned to the pool
    quantity : Decimal
    -- Reason for the return to pool
    reason_text : Text
    -- Identifier for the security whose shares are being returned
    security_id : Text
    -- Identifier for the stock plan receiving the returned shares
    stock_plan_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateStockPlanReturnToPoolOcfData : StockPlanReturnToPoolOcfData -> Bool
validateStockPlanReturnToPoolOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.stock_plan_id /= "" &&
  d.quantity > 0.0 &&
  d.reason_text /= "" &&
  validateNonEmptyStringsArray d.comments
