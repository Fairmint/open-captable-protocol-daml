-- OCF TX_STOCK_REPURCHASE record: shares of a stock security bought back by the issuer, with any remainder on a balance security.
module Fairmint.OpenCapTable.OCF.StockRepurchase where

import DA.List (dedup)
import DA.Optional (optionalToList)
import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template StockRepurchase
  with
    context : Context
    ocf_data : StockRepurchaseOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockRepurchaseOcfData ocf_data

    interface instance OcfObject for StockRepurchase where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxStockRepurchase
        object_id = ocf_data.id
        security_ids = dedup ([ocf_data.security_id] <> optionalToList ocf_data.balance_security_id)

-- Object - Stock Repurchase Transaction
-- Object describing a stock repurchase transaction
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/repurchase/StockRepurchase.schema.json
data StockRepurchaseOcfData = StockRepurchaseOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Repurchase price per share of the stock
    price : OcfMonetary
    -- Number of shares of stock repurchased
    quantity : Decimal
    -- Identifier for the security (stock) being repurchased
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Identifier for the security that holds the remainder balance (for partial repurchases)
    balance_security_id : Optional Text
    -- Unstructured text description of consideration provided in exchange for security repurchase
    consideration_text : Optional Text
  deriving (Eq, Show)

validateStockRepurchaseOcfData : StockRepurchaseOcfData -> Bool
validateStockRepurchaseOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.quantity > 0.0 &&
  validateOcfMonetary d.price &&
  -- Optional Text values, if present, must be non-empty
  validateOptionalText d.balance_security_id &&
  validateOptionalText d.consideration_text &&
  -- Arrays element validation
  validateNonEmptyStringsArray d.comments
