-- OCF CE_STAKEHOLDER_RELATIONSHIP record: a stakeholder's relationship to the issuer started or ended.
module Fairmint.OpenCapTable.OCF.StakeholderRelationshipChangeEvent where

import DA.Optional (isSome)
import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Stakeholder (OcfStakeholderRelationshipType)

template StakeholderRelationshipChangeEvent
  with
    context : Context
    ocf_data : StakeholderRelationshipChangeEventOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStakeholderRelationshipChangeEventOcfData ocf_data

    interface instance OcfObject for StakeholderRelationshipChangeEvent where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeCeStakeholderRelationship
        object_id = ocf_data.id
        security_ids = []

-- Object - Stakeholder Relationship Change Event
-- Object describing a change in stakeholder-issuer relationship
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/change_event/StakeholderRelationshipChangeEvent.schema.json
data StakeholderRelationshipChangeEventOcfData = StakeholderRelationshipChangeEventOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the change event occurred
    date : Date
    -- Identifier for the stakeholder subject to this change
    stakeholder_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]

    -- Optional fields (alphabetical; OCF anyOf: at least one is required)
    ---------------------------------

    -- Relationship that ended on the change date
    relationship_ended : Optional OcfStakeholderRelationshipType
    -- Relationship that started on the change date
    relationship_started : Optional OcfStakeholderRelationshipType
  deriving (Eq, Show)

validateStakeholderRelationshipChangeEventOcfData : StakeholderRelationshipChangeEventOcfData -> Bool
validateStakeholderRelationshipChangeEventOcfData d =
  d.id /= "" &&
  d.stakeholder_id /= "" &&
  validateNonEmptyStringsArray d.comments &&
  -- anyOf: at least one of relationship_started or relationship_ended must be present
  (isSome d.relationship_started || isSome d.relationship_ended)
