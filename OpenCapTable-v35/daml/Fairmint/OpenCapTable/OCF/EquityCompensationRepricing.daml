-- OCF TX_EQUITY_COMPENSATION_REPRICING record: a new exercise price for an equity compensation security.
module Fairmint.OpenCapTable.OCF.EquityCompensationRepricing where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)

template EquityCompensationRepricing
  with
    context : Context
    ocf_data : EquityCompensationRepricingOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateEquityCompensationRepricingOcfData ocf_data

    interface instance OcfObject for EquityCompensationRepricing where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxEquityCompensationRepricing
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Equity Compensation Repricing Transaction
-- Object describing option repricing for underwater options
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/repricing/EquityCompensationRepricing.schema.json
data EquityCompensationRepricingOcfData = EquityCompensationRepricingOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- New exercise price after repricing
    new_exercise_price : OcfMonetary
    -- Identifier for the security being repriced
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateEquityCompensationRepricingOcfData : EquityCompensationRepricingOcfData -> Bool
validateEquityCompensationRepricingOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  validateOcfMonetary d.new_exercise_price &&
  validateNonEmptyStringsArray d.comments
