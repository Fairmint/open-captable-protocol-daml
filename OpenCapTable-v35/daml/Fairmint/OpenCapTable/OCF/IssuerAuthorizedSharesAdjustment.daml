-- OCF TX_ISSUER_AUTHORIZED_SHARES_ADJUSTMENT record: a change to the number of shares the issuer is authorized to issue.
module Fairmint.OpenCapTable.OCF.IssuerAuthorizedSharesAdjustment where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template IssuerAuthorizedSharesAdjustment
  with
    context : Context
    ocf_data : IssuerAuthorizedSharesAdjustmentOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateIssuerAuthorizedSharesAdjustmentOcfData ocf_data

    interface instance OcfObject for IssuerAuthorizedSharesAdjustment where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxIssuerAuthorizedSharesAdjustment
        object_id = ocf_data.id
        security_ids = []

-- Object - Issuer Authorized Shares Adjustment Transaction
-- Object describing an event to change the number of authorized shares at the issuer level.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/adjustment/IssuerAuthorizedSharesAdjustment.schema.json
data IssuerAuthorizedSharesAdjustmentOcfData = IssuerAuthorizedSharesAdjustmentOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Identifier for the issuer
    issuer_id : Text
    -- The new number of shares authorized for this issuer as of the event of this transaction
    new_shares_authorized : Decimal

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Date on which the board approved the change to the issuer
    board_approval_date : Optional Date
    -- Date on which the stockholders approved the change to the issuer
    stockholder_approval_date : Optional Date
  deriving (Eq, Show)

validateIssuerAuthorizedSharesAdjustmentOcfData : IssuerAuthorizedSharesAdjustmentOcfData -> Bool
validateIssuerAuthorizedSharesAdjustmentOcfData d =
  d.id /= "" &&
  d.issuer_id /= "" &&
  d.new_shares_authorized >= (0.0) &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  validateNonEmptyStringsArray d.comments
