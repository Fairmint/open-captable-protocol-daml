-- OCF STOCK_PLAN record: an equity incentive plan, its share pool and the stock classes it draws on.
module Fairmint.OpenCapTable.OCF.StockPlan where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template StockPlan
  with
    context : Context
    ocf_data : StockPlanOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure
      validateContext context &&
      validateStockPlanOcfData ocf_data

    interface instance OcfObject for StockPlan where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeStockPlan
        object_id = ocf_data.id
        security_ids = []

-- Object - Stock Plan
-- Object describing a stock plan created by the issuer
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/StockPlan.schema.json
data StockPlanOcfData = StockPlanOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Initial number of shares reserved for the plan
    initial_shares_reserved : Decimal
    -- Human-friendly name of the plan
    plan_name : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
    -- List of stock class ids associated with this plan
    -- minItems: 1
    stock_class_ids : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Date of board approval for the plan
    board_approval_date : Optional Date
    -- Default cancellation behavior if not specified at the security level
    default_cancellation_behavior : Optional OcfStockPlanCancellationBehaviorType
    -- Date of stockholder approval for the plan
    stockholder_approval_date : Optional Date
  deriving (Eq, Show)

-- Enum - Stock Plan Cancellation Behavior Type
-- What happens to a plan's reserved shares when a security issued from it is cancelled
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/StockPlanCancellationBehaviorType.schema.json
data OcfStockPlanCancellationBehaviorType
  = OcfStockPlanCancellationBehaviorTypeRetire
  | OcfStockPlanCancellationBehaviorTypeReturnToPool
  | OcfStockPlanCancellationBehaviorTypeHoldAsCapitalStock
  | OcfStockPlanCancellationBehaviorTypeDefinedPerPlanSecurity
  deriving (Eq, Show)

validateStockPlanOcfData : StockPlanOcfData -> Bool
validateStockPlanOcfData d =
  d.id /= "" &&
  d.initial_shares_reserved >= (0.0) &&
  d.plan_name /= "" &&
  -- Arrays element validation (allow empty arrays where schema does not require minItems)
  validateNonEmptyStringsArray d.comments &&
  -- Required arrays per schema
  not (null d.stock_class_ids) &&
  validateNonEmptyStringsArray d.stock_class_ids
