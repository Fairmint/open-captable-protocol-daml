-- OCF TX_VESTING_ACCELERATION record: shares of a security that vest ahead of its schedule.
module Fairmint.OpenCapTable.OCF.VestingAcceleration where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template VestingAcceleration
  with
    context : Context
    ocf_data : VestingAccelerationOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateVestingAccelerationOcfData ocf_data

    interface instance OcfObject for VestingAcceleration where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxVestingAcceleration
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Vesting Acceleration Transaction
-- Object describing an acceleration of vesting, in which additional shares vest ahead of the schedule
-- specified in security's vesting terms
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/vesting/VestingAcceleration.schema.json
data VestingAccelerationOcfData = VestingAccelerationOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Number of shares vesting ahead of schedule
    quantity : Decimal
    -- Reason for the acceleration; unstructured text
    reason_text : Text
    -- Identifier for the security whose vesting is being accelerated
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateVestingAccelerationOcfData : VestingAccelerationOcfData -> Bool
validateVestingAccelerationOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.quantity > 0.0 &&
  d.reason_text /= "" &&
  -- Arrays element validation
  validateNonEmptyStringsArray d.comments
