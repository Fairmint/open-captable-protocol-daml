-- OCF STOCK_LEGEND_TEMPLATE record: the text of a stock legend that stock issuances can carry.
module Fairmint.OpenCapTable.OCF.StockLegendTemplate where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template StockLegendTemplate
  with
    context : Context
    ocf_data : StockLegendTemplateOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateStockLegendTemplateOcfData ocf_data

    interface instance OcfObject for StockLegendTemplate where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeStockLegendTemplate
        object_id = ocf_data.id
        security_ids = []

-- Object - Stock Legend Template
-- Object describing a stock legend template
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/StockLegendTemplate.schema.json
data StockLegendTemplateOcfData = StockLegendTemplateOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Name for the stock legend template
    name : Text
    -- The full text of the stock legend
    text : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateStockLegendTemplateOcfData : StockLegendTemplateOcfData -> Bool
validateStockLegendTemplateOcfData d =
  d.id /= "" &&
  d.name /= "" &&
  d.text /= "" &&
  validateNonEmptyStringsArray d.comments
