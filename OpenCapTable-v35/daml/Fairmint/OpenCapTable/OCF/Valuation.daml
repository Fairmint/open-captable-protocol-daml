-- OCF VALUATION record: a price per share for a stock class, such as a 409A valuation, from its effective date.
module Fairmint.OpenCapTable.OCF.Valuation where

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..), ocfObjectTypeValue)
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)
import Fairmint.Shared.TypeHelpers (validateOptionalText)

template Valuation
  with
    context : Context
    ocf_data : ValuationOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateValuationOcfData ocf_data

    interface instance OcfObject for Valuation where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = ocfObjectTypeValue OcfObjectTypeValuation
        object_id = ocf_data.id
        security_ids = []

-- Object - Valuation
-- Object describing a valuation used in the cap table
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/Valuation.schema.json
data ValuationOcfData = ValuationOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which this valuation is first valid
    effective_date : Date
    -- Valued price per share
    price_per_share : OcfMonetary
    -- Identifier of the stock class for this valuation
    stock_class_id : Text
    -- Seam for supporting different types of valuations in future versions
    valuation_type : OcfValuationType

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Date on which board approved the valuation. This is essential for 409A valuations, in particular, which require the Board to approve the valuation.
    board_approval_date : Optional Date
    -- Entity which provided the valuation
    provider : Optional Text
    -- This optional field tracks when the stockholders approved the valuation.
    stockholder_approval_date : Optional Date
  deriving (Eq, Show)

validateValuationOcfData : ValuationOcfData -> Bool
validateValuationOcfData d =
  d.id /= "" &&
  d.stock_class_id /= "" &&
  validateOcfMonetary d.price_per_share &&
  validateNonEmptyStringsArray d.comments &&
  validateOptionalText d.provider

-- Enum - Valuation Type
-- Enumeration of valuation types
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/ValuationType.schema.json
data OcfValuationType
  = OcfValuationType409a
  deriving (Eq, Show)
