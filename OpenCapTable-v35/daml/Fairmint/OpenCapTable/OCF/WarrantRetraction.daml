-- OCF TX_WARRANT_RETRACTION record: a warrant's issuance withdrawn, for example one the stakeholder never accepted.
module Fairmint.OpenCapTable.OCF.WarrantRetraction where

import Fairmint.OpenCapTableApi.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTableApi.OcfObject (OcfObject, OcfObjectView(..))
import Fairmint.OpenCapTable.Types.Core (Context, validateContext)
import Fairmint.OpenCapTable.Types.Validation (validateNonEmptyStringsArray)

template WarrantRetraction
  with
    context : Context
    ocf_data : WarrantRetractionOcfData
  where
    signatory context.issuer, context.system_operator, context.transfer_agent

    ensure validateContext context && validateWarrantRetractionOcfData ocf_data

    interface instance OcfObject for WarrantRetraction where
      view = OcfObjectView with
        cap_table_id = context.cap_table_id
        object_type = OcfObjectTypeTxWarrantRetraction
        object_id = ocf_data.id
        security_ids = [ocf_data.security_id]

-- Object - Warrant Retraction Transaction
-- Object describing a retraction of a warrant security
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/objects/transactions/retraction/WarrantRetraction.schema.json
data WarrantRetractionOcfData = WarrantRetractionOcfData
  with
    -- Identifier for the object
    id : Text

    -- Required fields (alphabetical)
    ---------------------------------

    -- Date on which the transaction occurred
    date : Date
    -- Reason for the retraction
    reason_text : Text
    -- Identifier for the security (stock, plan security, warrant, or convertible) by which it can be referenced by other transaction objects. Note that while this identifier is created with an issuance object, it should be different than the issuance object's `id` field which identifies the issuance transaction object itself. All future transactions on the security (e.g. acceptance, transfer, cancel, etc.) must reference this `security_id` to qualify which security the transaction applies to.
    security_id : Text

    -- Arrays (alphabetical)
    ---------------------------------

    -- Unstructured text comments related to and stored for the object
    comments : [Text]
  deriving (Eq, Show)

validateWarrantRetractionOcfData : WarrantRetractionOcfData -> Bool
validateWarrantRetractionOcfData d =
  d.id /= "" &&
  d.security_id /= "" &&
  d.reason_text /= "" &&
  validateNonEmptyStringsArray d.comments
