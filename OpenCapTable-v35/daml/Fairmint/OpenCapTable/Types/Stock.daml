-- Stock types shared across OCF records: class type, ratio, exemption, share range, authorized shares, quantity source and hold type.
module Fairmint.OpenCapTable.Types.Stock where

-- =============================================================================
-- STOCK TYPES
-- =============================================================================
-- Stock-related types and enums.

import Fairmint.Shared.TypeHelpers (validateRequiredText)

-- Enum - Stock Class Type
-- Type of stock class (common or preferred)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/StockClassType.schema.json
data OcfStockClassType
  = OcfStockClassTypeCommon
  | OcfStockClassTypePreferred
  deriving (Eq, Show)

-- Type - Ratio
-- Type representing a mathematical ratio
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Ratio.schema.json
data OcfRatio = OcfRatio
  with
    -- Required fields (mathematical order, not alphabetical)
    ---------------------------------

    -- Numerator of the ratio (> 0)
    numerator : Decimal
    -- Denominator of the ratio (> 0)
    denominator : Decimal
  deriving (Eq, Show)

validateOcfRatio : OcfRatio -> Bool
validateOcfRatio r = r.numerator > (0.0) && r.denominator > (0.0)

-- Type - Security Exemption
-- Type representation of a security law exemption and the jurisdiction it applies in
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/SecurityExemption.schema.json
data OcfSecurityExemption = OcfSecurityExemption
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Description of the exemption relied upon
    description : Text
    -- Jurisdiction where the exemption applies
    jurisdiction : Text
  deriving (Eq, Show)

validateOcfSecurityExemption : OcfSecurityExemption -> Bool
validateOcfSecurityExemption e = validateRequiredText e.description && validateRequiredText e.jurisdiction

-- Type - Share Number Range
-- Type representing a range of share certificate numbers
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/ShareNumberRange.schema.json
data OcfShareNumberRange = OcfShareNumberRange
  with
    -- Required fields (mathematical order, not alphabetical)
    ---------------------------------

    -- Starting share number in the range (must be > 0)
    starting_share_number : Decimal
    -- Ending share number in the range (>= starting)
    ending_share_number : Decimal
  deriving (Eq, Show)

validateOcfShareNumberRange : OcfShareNumberRange -> Bool
validateOcfShareNumberRange r = r.starting_share_number > (0.0) && r.ending_share_number >= r.starting_share_number

-- Enum - Authorized Shares
-- Special values for initial_shares_authorized ("NOT APPLICABLE" or "UNLIMITED")
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/AuthorizedShares.schema.json
data OcfAuthorizedShares
  = OcfAuthorizedSharesNotApplicable
  | OcfAuthorizedSharesUnlimited
  deriving (Eq, Show)

-- Type - Initial Shares Authorized
-- The `initial_shares_authorized` value of an Issuer or StockClass: a number or an enum value
-- (OCF `oneOf [AuthorizedShares, Numeric]`)
data OcfInitialSharesAuthorized
  = OcfInitialSharesNumeric Decimal
  | OcfInitialSharesEnum OcfAuthorizedShares
  deriving (Eq, Show)

-- Enum - Quantity Source Type
-- Source of quantity values
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/QuantitySourceType.schema.json
data OcfQuantitySourceType
  = OcfQuantitySourceTypeHumanEstimated
  | OcfQuantitySourceTypeMachineEstimated
  | OcfQuantitySourceTypeUnspecified
  | OcfQuantitySourceTypeInstrumentFixed
  | OcfQuantitySourceTypeInstrumentMax
  | OcfQuantitySourceTypeInstrumentMin
  deriving (Eq, Show)

-- Only fixed and maximum instrument quantities are upper bounds. Minimum,
-- estimated, unspecified, and absent sources do not cap what may vest.
ocfQuantityUpperBound : Optional Decimal -> Optional OcfQuantitySourceType -> Optional Decimal
ocfQuantityUpperBound quantity quantitySource =
  case quantitySource of
    Some OcfQuantitySourceTypeInstrumentFixed -> quantity
    Some OcfQuantitySourceTypeInstrumentMax -> quantity
    _ -> None

-- Enum - Hold Type
-- Why a stock security's shares are on hold: a register settlement (a trade's shares, drawn when
-- it settles) or a stop transfer (a case or order that stops the whole security moving)
-- Fairmint OCF extension: enums/HoldType.schema.json
data OcfHoldType
  = OcfHoldTypeRegisterSettlement
  | OcfHoldTypeStopTransfer
  deriving (Eq, Ord, Show)
