-- Conversion mechanisms, rights and triggers for stock classes, convertibles and warrants, in OCF's shapes; shared by the corresponding OCF records.
module Fairmint.OpenCapTable.Types.Conversion where

-- =============================================================================
-- CONVERSION TYPES
-- =============================================================================
-- All conversion mechanism types for convertible securities, warrants, and stock.

import DA.Optional (isNone, isSome)
import DA.List (sortOn)
import Fairmint.Shared.TypeHelpers (validateOptionalText, validateRequiredText)
import Fairmint.OpenCapTable.Types.Validation (maxStoredReferences, validateOcfPercentage)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary, validateOcfMonetary)
import Fairmint.OpenCapTable.Types.Stock (OcfRatio, validateOcfRatio)

-- =============================================================================
-- INTEREST AND COMPOUNDING TYPES
-- =============================================================================

-- Enum - Interest Payout Type
-- Interest payout method (deferred or cash)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/InterestPayoutType.schema.json
data OcfInterestPayoutType
  = OcfInterestPayoutTypeDeferred
  | OcfInterestPayoutTypeCash
  deriving (Eq, Show)

-- Enum - Compounding Type
-- Interest compounding style
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/CompoundingType.schema.json
data OcfCompoundingType
  = OcfCompoundingTypeCompounding
  | OcfCompoundingTypeSimple
  deriving (Eq, Show)

-- Enum - Day Count Type
-- Day count convention for interest accrual
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/DayCountType.schema.json
data OcfDayCountType
  = OcfDayCountTypeActual365
  | OcfDayCountType30360
  deriving (Eq, Show)

-- Enum - Rounding Type
-- Rounding method for numeric values
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/RoundingType.schema.json
data OcfRoundingType
  = OcfRoundingTypeCeiling
  | OcfRoundingTypeFloor
  | OcfRoundingTypeNormal
  deriving (Eq, Show)

-- Enum - Conversion Timing Type
-- Pre-money or post-money conversion timing
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/ConversionTimingType.schema.json
data OcfConversionTimingType
  = OcfConversionTimingTypePreMoney
  | OcfConversionTimingTypePostMoney
  deriving (Eq, Show)

-- Enum - Accrual Period Type
-- Time period unit for interest accrual
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/AccrualPeriodType.schema.json
data OcfAccrualPeriodType
  = OcfAccrualPeriodTypeDaily
  | OcfAccrualPeriodTypeMonthly
  | OcfAccrualPeriodTypeQuarterly
  | OcfAccrualPeriodTypeSemiAnnual
  | OcfAccrualPeriodTypeAnnual
  deriving (Eq, Show)

-- Type - Interest Rate
-- An interest rate and the period it accrues over
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/InterestRate.schema.json
data OcfInterestRate = OcfInterestRate
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Start date when interest begins accruing
    accrual_start_date : Date
    -- Annual interest rate (0-1 decimal)
    rate : Decimal

    -- Optional fields (alphabetical)
    ---------------------------------

    -- End date when interest stops accruing
    accrual_end_date : Optional Date
  deriving (Eq, Show)

validateOcfInterestRate : OcfInterestRate -> Bool
validateOcfInterestRate r =
  validateOcfPercentage r.rate &&
  optional True (\endDate -> endDate >= r.accrual_start_date) r.accrual_end_date

validateSortedOcfInterestRateSchedule : [OcfInterestRate] -> Bool
validateSortedOcfInterestRateSchedule rates = case rates of
  [] -> True
  [rate] -> validateOcfInterestRate rate
  current :: next :: rest ->
    validateOcfInterestRate current &&
    current.accrual_start_date < next.accrual_start_date &&
    optional True (\endDate -> endDate < next.accrual_start_date) current.accrual_end_date &&
    validateSortedOcfInterestRateSchedule (next :: rest)

validateOcfInterestRateSchedule : [OcfInterestRate] -> Bool
validateOcfInterestRateSchedule rates =
  validateSortedOcfInterestRateSchedule (sortOn (\rate -> rate.accrual_start_date) rates)

-- =============================================================================
-- CAPITALIZATION DEFINITION TYPES
-- =============================================================================

-- Type - Capitalization Definition
-- The securities, stock classes and stock plans that make up the capitalization a conversion is computed against
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/CapitalizationDefinition.schema.json
data OcfCapitalizationDefinition = OcfCapitalizationDefinition
  with
    -- Arrays (alphabetical)
    ---------------------------------

    -- Security IDs to exclude from the capitalization definition calculation
    exclude_security_ids : [Text]
    -- Security IDs to include in the capitalization definition calculation
    include_security_ids : [Text]
    -- Stock class IDs to include
    include_stock_class_ids : [Text]
    -- Stock plan IDs to include
    include_stock_plans_ids : [Text]
  deriving (Eq, Show)

validateOcfCapitalizationDefinition : OcfCapitalizationDefinition -> Bool
validateOcfCapitalizationDefinition d =
  all validateRequiredText d.exclude_security_ids &&
  all validateRequiredText d.include_security_ids &&
  all validateRequiredText d.include_stock_class_ids &&
  all validateRequiredText d.include_stock_plans_ids

-- Policy cap (not OCF validity; see Types/Validation.daml): each ID list of a capitalization
-- definition stores at most `maxStoredReferences` IDs.
capitalizationDefinitionWithinCaps : OcfCapitalizationDefinition -> Bool
capitalizationDefinitionWithinCaps d =
  all (\ids -> length ids <= maxStoredReferences)
    [d.exclude_security_ids, d.include_security_ids, d.include_stock_class_ids, d.include_stock_plans_ids]

-- Type - Capitalization Definition Rules
-- Which share counts a conversion's capitalization includes
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/CapitalizationDefinitionRules.schema.json
data OcfCapitalizationDefinitionRules = OcfCapitalizationDefinitionRules
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Include the shares reserved for increasing option plans beyond the amount needed for any promised options
    include_additional_option_pool_topup : Bool
    -- Include the shares issued for any new share subscriptions that are part of the conversion event
    include_new_money : Bool
    -- Include the shares reserved for increasing option plans to cover all promised options
    include_option_pool_topup_for_promised_options : Bool
    -- Include the shares issued for converting all other convertibles converted in the same conversion event
    include_other_converting_securities : Bool
    -- Include all outstanding options
    include_outstanding_options : Bool
    -- Include all outstanding share issuances
    include_outstanding_shares : Bool
    -- Include all options that have been reserved but not issued yet
    include_outstanding_unissued_options : Bool
    -- Include the shares issued for converting this security
    include_this_security : Bool
  deriving (Eq, Show)

-- =============================================================================
-- CONVERSION MECHANISM TYPES
-- =============================================================================

-- Type - Ratio Conversion Mechanism
-- Conversion mechanism using a ratio (e.g., preferred to common stock conversion)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/RatioConversionMechanism.schema.json
data OcfRatioConversionMechanism = OcfRatioConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Effective conversion price per share
    conversion_price : OcfMonetary
    -- Conversion ratio (one share converts to this many target shares)
    ratio : OcfRatio
    -- How fractional shares are rounded
    rounding_type : OcfRoundingType
  deriving (Eq, Show)

validateOcfRatioConversionMechanism : OcfRatioConversionMechanism -> Bool
validateOcfRatioConversionMechanism m =
  validateOcfMonetary m.conversion_price &&
  validateOcfRatio m.ratio

-- Type - Custom Conversion Mechanism
-- A conversion described in free text
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/CustomConversionMechanism.schema.json
data OcfCustomConversionMechanism = OcfCustomConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Description of how the conversion works
    custom_conversion_description : Text
  deriving (Eq, Show)

validateOcfCustomConversionMechanism : OcfCustomConversionMechanism -> Bool
validateOcfCustomConversionMechanism m = validateRequiredText m.custom_conversion_description

-- Type - Fixed Amount Conversion Mechanism
-- A conversion into a fixed number of shares
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/FixedAmountConversionMechanism.schema.json
data OcfFixedAmountConversionMechanism = OcfFixedAmountConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Number of shares the security converts into
    converts_to_quantity : Decimal
  deriving (Eq, Show)

validateOcfFixedAmountConversionMechanism : OcfFixedAmountConversionMechanism -> Bool
validateOcfFixedAmountConversionMechanism m = m.converts_to_quantity > (0.0)

-- Type - Percent Capitalization Conversion Mechanism
-- A conversion into a fixed percentage of the capitalization
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/PercentCapitalizationConversionMechanism.schema.json
data OcfPercentCapitalizationConversionMechanism = OcfPercentCapitalizationConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Percentage of the capitalization the security converts into (0-1 decimal)
    converts_to_percent : Decimal

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Reference capitalization definition ID
    capitalization_definition : Optional Text
    -- Rules controlling capitalization computations
    capitalization_definition_rules : Optional OcfCapitalizationDefinitionRules
  deriving (Eq, Show)

validateOcfPercentCapitalizationConversionMechanism : OcfPercentCapitalizationConversionMechanism -> Bool
validateOcfPercentCapitalizationConversionMechanism m =
  m.converts_to_percent > (0.0) && m.converts_to_percent <= (1.0 : Decimal) &&
  validateOptionalText m.capitalization_definition

-- Type - Share Price Based Conversion Mechanism
-- A conversion at a price per share, optionally discounted
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/SharePriceBasedConversionMechanism.schema.json
data OcfSharePriceBasedConversionMechanism = OcfSharePriceBasedConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Description of the share-price mechanism
    description : Text

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Whether a discount is applied
    discount : Optional Bool
    -- Absolute discount amount
    discount_amount : Optional OcfMonetary
    -- Discount percent (0-1 decimal)
    discount_percentage : Optional Decimal
  deriving (Eq, Show)

-- OCF's `oneOf` over (discount, discount_percentage, discount_amount): a true discount carries
-- exactly one of the two; a false discount carries at most one; an absent discount satisfies
-- every branch's `const`, so it carries neither (one present would match two branches, both
-- present none).
validateOcfSharePriceBasedConversionMechanism : OcfSharePriceBasedConversionMechanism -> Bool
validateOcfSharePriceBasedConversionMechanism m =
  m.description /= "" &&
  optional True validateOcfPercentage m.discount_percentage &&
  optional True validateOcfMonetary m.discount_amount &&
  case (m.discount, m.discount_percentage, m.discount_amount) of
    (Some True, Some _, None) -> True
    (Some True, None, Some _) -> True
    (Some True, _, _) -> False
    (Some False, Some _, Some _) -> False
    (Some False, _, _) -> True
    (None, None, None) -> True
    (None, _, _) -> False

-- Enum - Valuation Based Formula Type
-- Formula for valuation-based conversion
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/ValuationBasedFormulaType.schema.json
data OcfValuationBasedFormulaType
  = OcfValuationBasedFormulaTypeFixed
  | OcfValuationBasedFormulaTypeActual
  | OcfValuationBasedFormulaTypeCap
  deriving (Eq, Show)

-- Type - Valuation Based Conversion Mechanism
-- A conversion priced from a valuation
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/ValuationBasedConversionMechanism.schema.json
data OcfValuationBasedConversionMechanism = OcfValuationBasedConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Valuation type used in the conversion formula
    valuation_type : OcfValuationBasedFormulaType

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Reference capitalization definition ID
    capitalization_definition : Optional Text
    -- Rules controlling capitalization computations
    capitalization_definition_rules : Optional OcfCapitalizationDefinitionRules
    -- Valuation amount (currency) used by the formula; required for FIXED and CAP
    valuation_amount : Optional OcfMonetary
  deriving (Eq, Show)

validateOcfValuationBasedConversionMechanism : OcfValuationBasedConversionMechanism -> Bool
validateOcfValuationBasedConversionMechanism m =
  (case m.valuation_type of
    OcfValuationBasedFormulaTypeActual -> optional True validateOcfMonetary m.valuation_amount
    OcfValuationBasedFormulaTypeCap -> optional False validateOcfMonetary m.valuation_amount
    OcfValuationBasedFormulaTypeFixed -> optional False validateOcfMonetary m.valuation_amount) &&
  validateOptionalText m.capitalization_definition

-- Type - SAFE Conversion Mechanism
-- The conversion of a simple agreement for future equity
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/SAFEConversionMechanism.schema.json
data OcfSAFEConversionMechanism = OcfSAFEConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Whether most-favored-nation (MFN) applies
    conversion_mfn : Bool

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Reference capitalization definition ID
    capitalization_definition : Optional Text
    -- Rules controlling capitalization computations
    capitalization_definition_rules : Optional OcfCapitalizationDefinitionRules
    -- Conversion discount percent (0-1 decimal)
    conversion_discount : Optional Decimal
    -- Pre-money or post-money conversion timing
    conversion_timing : Optional OcfConversionTimingType
    -- Valuation cap for conversion
    conversion_valuation_cap : Optional OcfMonetary
    -- Exit multiple ratio
    exit_multiple : Optional OcfRatio
  deriving (Eq, Show)

validateOcfSAFEConversionMechanism : OcfSAFEConversionMechanism -> Bool
validateOcfSAFEConversionMechanism m =
  optional True (\d -> d >= (0.0) && d < (1.0 : Decimal)) m.conversion_discount &&
  optional True validateOcfMonetary m.conversion_valuation_cap &&
  optional True validateOcfRatio m.exit_multiple &&
  validateOptionalText m.capitalization_definition

-- Type - Note Conversion Mechanism
-- The conversion of a convertible note, with its interest terms
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_mechanisms/NoteConversionMechanism.schema.json
data OcfNoteConversionMechanism = OcfNoteConversionMechanism
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Type of compounding for accruing interest
    compounding_type : OcfCompoundingType
    -- Day count convention for interest accrual
    day_count_convention : OcfDayCountType
    -- Period over which interest accrues
    interest_accrual_period : OcfAccrualPeriodType
    -- Interest payout method
    interest_payout : OcfInterestPayoutType

    -- Arrays (alphabetical)
    ---------------------------------

    -- Interest rates applicable to the note
    interest_rates : [OcfInterestRate]

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Reference capitalization definition ID
    capitalization_definition : Optional Text
    -- Rules controlling capitalization computations
    capitalization_definition_rules : Optional OcfCapitalizationDefinitionRules
    -- Conversion discount percent (0-1 decimal)
    conversion_discount : Optional Decimal
    -- Whether most-favored-nation (MFN) applies
    conversion_mfn : Optional Bool
    -- Valuation cap for conversion
    conversion_valuation_cap : Optional OcfMonetary
    -- Exit multiple ratio
    exit_multiple : Optional OcfRatio
  deriving (Eq, Show)

validateOcfNoteConversionMechanism : OcfNoteConversionMechanism -> Bool
validateOcfNoteConversionMechanism m =
  validateOcfInterestRateSchedule m.interest_rates &&
  optional True (\d -> d >= (0.0) && d < (1.0 : Decimal)) m.conversion_discount &&
  optional True validateOcfMonetary m.conversion_valuation_cap &&
  optional True validateOcfRatio m.exit_multiple &&
  validateOptionalText m.capitalization_definition

-- =============================================================================
-- CONVERSION RIGHT TYPES
-- =============================================================================
-- OCF's `type` constant of each right (CONVERTIBLE_CONVERSION_RIGHT, WARRANT_CONVERSION_RIGHT,
-- STOCK_CLASS_CONVERSION_RIGHT) is implied by the record type, so no right stores it.

-- Enum - Conversion Trigger Type
-- Type of conversion trigger
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/ConversionTriggerType.schema.json
data OcfConversionTriggerType
  = OcfConversionTriggerTypeAutomaticOnCondition
  | OcfConversionTriggerTypeAutomaticOnDate
  | OcfConversionTriggerTypeElectiveInRange
  | OcfConversionTriggerTypeElectiveOnCondition
  | OcfConversionTriggerTypeElectiveAtWill
  | OcfConversionTriggerTypeUnspecified
  deriving (Eq, Show)

-- Enum - Convertible Type
-- Type of convertible instrument
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/ConvertibleType.schema.json
data OcfConvertibleType
  = OcfConvertibleTypeNote
  | OcfConvertibleTypeSafe
  | OcfConvertibleTypeConvertibleSecurity
  deriving (Eq, Show)

-- The mechanisms a warrant conversion right allows, in OCF's order
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_rights/WarrantConversionRight.schema.json
data OcfWarrantConversionMechanism
  = OcfWarrantMechanismCustom OcfCustomConversionMechanism
  | OcfWarrantMechanismPercentCapitalization OcfPercentCapitalizationConversionMechanism
  | OcfWarrantMechanismFixedAmount OcfFixedAmountConversionMechanism
  | OcfWarrantMechanismValuationBased OcfValuationBasedConversionMechanism
  | OcfWarrantMechanismPpsBased OcfSharePriceBasedConversionMechanism
  deriving (Eq, Show)

validateOcfWarrantConversionMechanism : OcfWarrantConversionMechanism -> Bool
validateOcfWarrantConversionMechanism mechanism =
  case mechanism of
    OcfWarrantMechanismCustom m -> validateOcfCustomConversionMechanism m
    OcfWarrantMechanismPercentCapitalization m -> validateOcfPercentCapitalizationConversionMechanism m
    OcfWarrantMechanismFixedAmount m -> validateOcfFixedAmountConversionMechanism m
    OcfWarrantMechanismValuationBased m -> validateOcfValuationBasedConversionMechanism m
    OcfWarrantMechanismPpsBased m -> validateOcfSharePriceBasedConversionMechanism m

-- Type - Warrant Conversion Right
-- How a warrant converts when one of its exercise triggers is met
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_rights/WarrantConversionRight.schema.json
data OcfWarrantConversionRight = OcfWarrantConversionRight
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Conversion mechanism used by the warrant
    conversion_mechanism : OcfWarrantConversionMechanism

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Whether this converts only in a future round
    converts_to_future_round : Optional Bool
    -- Stock class ID to which this converts
    converts_to_stock_class_id : Optional Text
  deriving (Eq, Show)

validateOcfWarrantConversionRight : OcfWarrantConversionRight -> Bool
validateOcfWarrantConversionRight right =
  validateOcfWarrantConversionMechanism right.conversion_mechanism &&
  validateOptionalText right.converts_to_stock_class_id

-- The mechanisms a convertible conversion right allows, in OCF's order
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_rights/ConvertibleConversionRight.schema.json
data OcfConvertibleConversionMechanism
  = OcfConvMechSAFE OcfSAFEConversionMechanism
  | OcfConvMechNote OcfNoteConversionMechanism
  | OcfConvMechCustom OcfCustomConversionMechanism
  | OcfConvMechPercentCapitalization OcfPercentCapitalizationConversionMechanism
  | OcfConvMechFixedAmount OcfFixedAmountConversionMechanism
  deriving (Eq, Show)

validateOcfConvertibleConversionMechanism : OcfConvertibleConversionMechanism -> Bool
validateOcfConvertibleConversionMechanism mechanism =
  case mechanism of
    OcfConvMechSAFE m -> validateOcfSAFEConversionMechanism m
    OcfConvMechNote m -> validateOcfNoteConversionMechanism m
    OcfConvMechCustom m -> validateOcfCustomConversionMechanism m
    OcfConvMechPercentCapitalization m -> validateOcfPercentCapitalizationConversionMechanism m
    OcfConvMechFixedAmount m -> validateOcfFixedAmountConversionMechanism m

-- Type - Convertible Conversion Right
-- How a convertible converts when one of its conversion triggers is met
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_rights/ConvertibleConversionRight.schema.json
data OcfConvertibleConversionRight = OcfConvertibleConversionRight
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Conversion mechanism used by the convertible
    conversion_mechanism : OcfConvertibleConversionMechanism

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Whether this converts only in a future round
    converts_to_future_round : Optional Bool
    -- Stock class ID to which this converts
    converts_to_stock_class_id : Optional Text
  deriving (Eq, Show)

validateOcfConvertibleConversionRight : OcfConvertibleConversionRight -> Bool
validateOcfConvertibleConversionRight right =
  validateOcfConvertibleConversionMechanism right.conversion_mechanism &&
  validateOptionalText right.converts_to_stock_class_id

-- Type - Stock Class Conversion Right
-- How shares of a stock class convert into another stock class; OCF allows only a ratio mechanism
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/conversion_rights/StockClassConversionRight.schema.json
data OcfStockClassConversionRight = OcfStockClassConversionRight
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Ratio mechanism by which the shares convert
    conversion_mechanism : OcfRatioConversionMechanism

    -- Optional fields (alphabetical)
    ---------------------------------

    -- Whether the class may convert into a future, as-yet-undetermined stock class
    converts_to_future_round : Optional Bool
    -- Identifier of the existing stock class to which this converts
    converts_to_stock_class_id : Optional Text
  deriving (Eq, Show)

validateOcfStockClassConversionRight : OcfStockClassConversionRight -> Bool
validateOcfStockClassConversionRight right =
  validateOcfRatioConversionMechanism right.conversion_mechanism &&
  validateOptionalText right.converts_to_stock_class_id

-- =============================================================================
-- CONVERSION TRIGGER
-- =============================================================================

-- Any of the three conversion rights, as a conversion trigger's `conversion_right` allows
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/types/conversion_rights/ConversionRight.schema.json
data OcfAnyConversionRight
  = OcfRightConvertible OcfConvertibleConversionRight
  | OcfRightWarrant OcfWarrantConversionRight
  | OcfRightStockClass OcfStockClassConversionRight
  deriving (Eq, Show)

validateOcfAnyConversionRight : OcfAnyConversionRight -> Bool
validateOcfAnyConversionRight right =
  case right of
    OcfRightConvertible convertibleRight -> validateOcfConvertibleConversionRight convertibleRight
    OcfRightWarrant warrantRight -> validateOcfWarrantConversionRight warrantRight
    OcfRightStockClass stockClassRight -> validateOcfStockClassConversionRight stockClassRight

-- The fields each trigger type requires and forbids (OCF's concrete trigger schemas each set
-- `additionalProperties: false`), with an ELECTIVE_IN_RANGE window that starts on or before it ends.
validateOcfConversionTriggerFields : OcfConversionTriggerType -> Optional Date -> Optional Date -> Optional Text -> Optional Date -> Bool
validateOcfConversionTriggerFields triggerType startDate endDate triggerCondition triggerDate =
  let hasCondition = optional False validateRequiredText triggerCondition
      noCondition = isNone triggerCondition
      noTriggerDate = isNone triggerDate
      hasStartDate = isSome startDate
      hasEndDate = isSome endDate
      hasValidRange = case (startDate, endDate) of
        (Some start, Some end) -> start <= end
        _ -> False
      noRange = isNone startDate && isNone endDate
   in case triggerType of
        OcfConversionTriggerTypeAutomaticOnDate ->
          isSome triggerDate && noCondition && noRange
        OcfConversionTriggerTypeAutomaticOnCondition ->
          hasCondition && noTriggerDate && noRange
        OcfConversionTriggerTypeElectiveOnCondition ->
          hasCondition && noTriggerDate && noRange
        OcfConversionTriggerTypeElectiveInRange ->
          hasStartDate && hasEndDate && hasValidRange && noCondition && noTriggerDate
        OcfConversionTriggerTypeElectiveAtWill ->
          noCondition && noTriggerDate && noRange
        OcfConversionTriggerTypeUnspecified ->
          noCondition && noTriggerDate && noRange

-- A trigger's dates fall on or before the instrument's expiration date, when it has one: an
-- AUTOMATIC_ON_DATE trigger's date and an ELECTIVE_IN_RANGE window's end (its start is on or
-- before its end). v34 checked this at the root (CapTable.daml.template:1095-1111).
validateOcfConversionTriggerWithinExpiration : Optional Date -> Optional Date -> Optional Date -> Bool
validateOcfConversionTriggerWithinExpiration expirationDate endDate triggerDate =
  optional True
    (\expiration -> optional True (<= expiration) endDate && optional True (<= expiration) triggerDate)
    expirationDate

-- Type - Conversion Trigger
-- When, and by which conversion right, a security converts
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/types/conversion_triggers/ConversionTrigger.schema.json
data OcfConversionTrigger = OcfConversionTrigger
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Conversion right that will be applied when triggered
    conversion_right : OcfAnyConversionRight
    -- Identifier for this trigger (unique within parent)
    trigger_id : Text
    -- Type of trigger (automatic, elective, etc.)
    type_ : OcfConversionTriggerType

    -- Optional fields (alphabetical)
    ---------------------------------

    -- End date for elective conversion window (ELECTIVE_IN_RANGE triggers)
    end_date : Optional Date
    -- Human-friendly nickname for the trigger
    nickname : Optional Text
    -- Start date for elective conversion window (ELECTIVE_IN_RANGE triggers)
    start_date : Optional Date
    -- Condition text that must be satisfied for conversion
    trigger_condition : Optional Text
    -- Date when automatic trigger occurs
    trigger_date : Optional Date
    -- Long-form description of the trigger
    trigger_description : Optional Text
  deriving (Eq, Show)

validateOcfConversionTrigger : OcfConversionTrigger -> Bool
validateOcfConversionTrigger t =
  validateRequiredText t.trigger_id &&
  validateOptionalText t.nickname &&
  validateOptionalText t.trigger_description &&
  validateOptionalText t.trigger_condition &&
  validateOcfAnyConversionRight t.conversion_right &&
  validateOcfConversionTriggerFields t.type_ t.start_date t.end_date t.trigger_condition t.trigger_date
