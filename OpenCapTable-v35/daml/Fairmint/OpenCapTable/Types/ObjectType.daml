-- OCF object types that an OpenCapTable-v35 register stores. The enum lives in this package, which is upgraded, not in the reader interfaces' package, which never can be: their views carry the OCF strings.
module Fairmint.OpenCapTable.Types.ObjectType where

-- Enum - Object Type
-- OCF's values in OCF order, without the seven TX_PLAN_SECURITY_* aliases, which writers
-- normalize to TX_EQUITY_COMPENSATION_*; then the Fairmint hold extension (TX_STOCK_HOLD,
-- TX_STOCK_HOLD_CANCELLATION). New values are appended, so the enum stays upgrade-compatible.
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/ObjectType.schema.json
data OcfObjectType
  = OcfObjectTypeIssuer
  | OcfObjectTypeStakeholder
  | OcfObjectTypeStockClass
  | OcfObjectTypeStockLegendTemplate
  | OcfObjectTypeStockPlan
  | OcfObjectTypeValuation
  | OcfObjectTypeVestingTerms
  | OcfObjectTypeFinancing
  | OcfObjectTypeDocument
  | OcfObjectTypeCeStakeholderRelationship
  | OcfObjectTypeCeStakeholderStatus
  | OcfObjectTypeTxIssuerAuthorizedSharesAdjustment
  | OcfObjectTypeTxStockClassConversionRatioAdjustment
  | OcfObjectTypeTxStockClassAuthorizedSharesAdjustment
  | OcfObjectTypeTxStockClassSplit
  | OcfObjectTypeTxStockPlanPoolAdjustment
  | OcfObjectTypeTxStockPlanReturnToPool
  | OcfObjectTypeTxConvertibleAcceptance
  | OcfObjectTypeTxConvertibleCancellation
  | OcfObjectTypeTxConvertibleConversion
  | OcfObjectTypeTxConvertibleIssuance
  | OcfObjectTypeTxConvertibleRetraction
  | OcfObjectTypeTxConvertibleTransfer
  | OcfObjectTypeTxEquityCompensationAcceptance
  | OcfObjectTypeTxEquityCompensationCancellation
  | OcfObjectTypeTxEquityCompensationExercise
  | OcfObjectTypeTxEquityCompensationIssuance
  | OcfObjectTypeTxEquityCompensationRelease
  | OcfObjectTypeTxEquityCompensationRetraction
  | OcfObjectTypeTxEquityCompensationTransfer
  | OcfObjectTypeTxEquityCompensationRepricing
  | OcfObjectTypeTxStockAcceptance
  | OcfObjectTypeTxStockCancellation
  | OcfObjectTypeTxStockConversion
  | OcfObjectTypeTxStockIssuance
  | OcfObjectTypeTxStockReissuance
  | OcfObjectTypeTxStockConsolidation
  | OcfObjectTypeTxStockRepurchase
  | OcfObjectTypeTxStockRetraction
  | OcfObjectTypeTxStockTransfer
  | OcfObjectTypeTxWarrantAcceptance
  | OcfObjectTypeTxWarrantCancellation
  | OcfObjectTypeTxWarrantExercise
  | OcfObjectTypeTxWarrantIssuance
  | OcfObjectTypeTxWarrantRetraction
  | OcfObjectTypeTxWarrantTransfer
  | OcfObjectTypeTxVestingAcceleration
  | OcfObjectTypeTxVestingStart
  | OcfObjectTypeTxVestingEvent
  | OcfObjectTypeTxStockHold
  | OcfObjectTypeTxStockHoldCancellation
  deriving (Eq, Ord, Show, Enum, Bounded)

-- The OCF `object_type` string of each constructor.
ocfObjectTypeValue : OcfObjectType -> Text
ocfObjectTypeValue t = case t of
  OcfObjectTypeIssuer -> "ISSUER"
  OcfObjectTypeStakeholder -> "STAKEHOLDER"
  OcfObjectTypeStockClass -> "STOCK_CLASS"
  OcfObjectTypeStockLegendTemplate -> "STOCK_LEGEND_TEMPLATE"
  OcfObjectTypeStockPlan -> "STOCK_PLAN"
  OcfObjectTypeValuation -> "VALUATION"
  OcfObjectTypeVestingTerms -> "VESTING_TERMS"
  OcfObjectTypeFinancing -> "FINANCING"
  OcfObjectTypeDocument -> "DOCUMENT"
  OcfObjectTypeCeStakeholderRelationship -> "CE_STAKEHOLDER_RELATIONSHIP"
  OcfObjectTypeCeStakeholderStatus -> "CE_STAKEHOLDER_STATUS"
  OcfObjectTypeTxIssuerAuthorizedSharesAdjustment -> "TX_ISSUER_AUTHORIZED_SHARES_ADJUSTMENT"
  OcfObjectTypeTxStockClassConversionRatioAdjustment -> "TX_STOCK_CLASS_CONVERSION_RATIO_ADJUSTMENT"
  OcfObjectTypeTxStockClassAuthorizedSharesAdjustment -> "TX_STOCK_CLASS_AUTHORIZED_SHARES_ADJUSTMENT"
  OcfObjectTypeTxStockClassSplit -> "TX_STOCK_CLASS_SPLIT"
  OcfObjectTypeTxStockPlanPoolAdjustment -> "TX_STOCK_PLAN_POOL_ADJUSTMENT"
  OcfObjectTypeTxStockPlanReturnToPool -> "TX_STOCK_PLAN_RETURN_TO_POOL"
  OcfObjectTypeTxConvertibleAcceptance -> "TX_CONVERTIBLE_ACCEPTANCE"
  OcfObjectTypeTxConvertibleCancellation -> "TX_CONVERTIBLE_CANCELLATION"
  OcfObjectTypeTxConvertibleConversion -> "TX_CONVERTIBLE_CONVERSION"
  OcfObjectTypeTxConvertibleIssuance -> "TX_CONVERTIBLE_ISSUANCE"
  OcfObjectTypeTxConvertibleRetraction -> "TX_CONVERTIBLE_RETRACTION"
  OcfObjectTypeTxConvertibleTransfer -> "TX_CONVERTIBLE_TRANSFER"
  OcfObjectTypeTxEquityCompensationAcceptance -> "TX_EQUITY_COMPENSATION_ACCEPTANCE"
  OcfObjectTypeTxEquityCompensationCancellation -> "TX_EQUITY_COMPENSATION_CANCELLATION"
  OcfObjectTypeTxEquityCompensationExercise -> "TX_EQUITY_COMPENSATION_EXERCISE"
  OcfObjectTypeTxEquityCompensationIssuance -> "TX_EQUITY_COMPENSATION_ISSUANCE"
  OcfObjectTypeTxEquityCompensationRelease -> "TX_EQUITY_COMPENSATION_RELEASE"
  OcfObjectTypeTxEquityCompensationRetraction -> "TX_EQUITY_COMPENSATION_RETRACTION"
  OcfObjectTypeTxEquityCompensationTransfer -> "TX_EQUITY_COMPENSATION_TRANSFER"
  OcfObjectTypeTxEquityCompensationRepricing -> "TX_EQUITY_COMPENSATION_REPRICING"
  OcfObjectTypeTxStockAcceptance -> "TX_STOCK_ACCEPTANCE"
  OcfObjectTypeTxStockCancellation -> "TX_STOCK_CANCELLATION"
  OcfObjectTypeTxStockConversion -> "TX_STOCK_CONVERSION"
  OcfObjectTypeTxStockIssuance -> "TX_STOCK_ISSUANCE"
  OcfObjectTypeTxStockReissuance -> "TX_STOCK_REISSUANCE"
  OcfObjectTypeTxStockConsolidation -> "TX_STOCK_CONSOLIDATION"
  OcfObjectTypeTxStockRepurchase -> "TX_STOCK_REPURCHASE"
  OcfObjectTypeTxStockRetraction -> "TX_STOCK_RETRACTION"
  OcfObjectTypeTxStockTransfer -> "TX_STOCK_TRANSFER"
  OcfObjectTypeTxWarrantAcceptance -> "TX_WARRANT_ACCEPTANCE"
  OcfObjectTypeTxWarrantCancellation -> "TX_WARRANT_CANCELLATION"
  OcfObjectTypeTxWarrantExercise -> "TX_WARRANT_EXERCISE"
  OcfObjectTypeTxWarrantIssuance -> "TX_WARRANT_ISSUANCE"
  OcfObjectTypeTxWarrantRetraction -> "TX_WARRANT_RETRACTION"
  OcfObjectTypeTxWarrantTransfer -> "TX_WARRANT_TRANSFER"
  OcfObjectTypeTxVestingAcceleration -> "TX_VESTING_ACCELERATION"
  OcfObjectTypeTxVestingStart -> "TX_VESTING_START"
  OcfObjectTypeTxVestingEvent -> "TX_VESTING_EVENT"
  OcfObjectTypeTxStockHold -> "TX_STOCK_HOLD"
  OcfObjectTypeTxStockHoldCancellation -> "TX_STOCK_HOLD_CANCELLATION"

-- The constructor for an OCF `object_type` string, as a reader maps an interface view back.
ocfObjectTypeFromValue : Text -> Optional OcfObjectType
ocfObjectTypeFromValue v = find (\t -> ocfObjectTypeValue t == v) [minBound .. maxBound]
