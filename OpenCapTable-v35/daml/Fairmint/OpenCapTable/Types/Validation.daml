-- Reusable validators for arrays, country codes, percentages and checksums, plus the record-size policy caps; keeps ensure clauses short on OCF records.
module Fairmint.OpenCapTable.Types.Validation where

-- =============================================================================
-- SHARED VALIDATION HELPERS
-- =============================================================================
-- Validation functions and constants used across multiple OCF type modules.

import qualified DA.Text as Text
import qualified DA.Crypto.Text as CryptoText
import Fairmint.Shared.TypeHelpers (validateRequiredText)

-- Shared Text array validator
-- Ensures no element is an empty string; empty arrays are allowed
validateNonEmptyStringsArray : [Text] -> Bool
validateNonEmptyStringsArray xs = all validateRequiredText xs

-- Country code
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/CountryCode.schema.json
validCountryCodes : [Text]
validCountryCodes =
  [ "AF", "AX", "AL", "DZ", "AS", "AD", "AO", "AI", "AQ", "AG"
  , "AR", "AM", "AW", "AU", "AT", "AZ", "BS", "BH", "BD", "BB"
  , "BY", "BE", "BZ", "BJ", "BM", "BT", "BO", "BQ", "BA", "BW"
  , "BV", "BR", "IO", "BN", "BG", "BF", "BI", "CV", "KH", "CM"
  , "CA", "KY", "CF", "TD", "CL", "CN", "CX", "CC", "CO", "KM"
  , "CG", "CD", "CK", "CR", "CI", "HR", "CU", "CW", "CY", "CZ"
  , "DK", "DJ", "DM", "DO", "EC", "EG", "SV", "GQ", "ER", "EE"
  , "SZ", "ET", "FK", "FO", "FJ", "FI", "FR", "GF", "PF", "TF"
  , "GA", "GM", "GE", "DE", "GH", "GI", "GR", "GL", "GD", "GP"
  , "GU", "GT", "GG", "GN", "GW", "GY", "HT", "HM", "VA", "HN"
  , "HK", "HU", "IS", "IN", "ID", "IR", "IQ", "IE", "IM", "IL"
  , "IT", "JM", "JP", "JE", "JO", "KZ", "KE", "KI", "KP", "KR"
  , "KW", "KG", "LA", "LV", "LB", "LS", "LR", "LY", "LI", "LT"
  , "LU", "MO", "MG", "MW", "MY", "MV", "ML", "MT", "MH", "MQ"
  , "MR", "MU", "YT", "MX", "FM", "MD", "MC", "MN", "ME", "MS"
  , "MA", "MZ", "MM", "NA", "NR", "NP", "NL", "NC", "NZ", "NI"
  , "NE", "NG", "NU", "NF", "MK", "MP", "NO", "OM", "PK", "PW"
  , "PS", "PA", "PG", "PY", "PE", "PH", "PN", "PL", "PT", "PR"
  , "QA", "RE", "RO", "RU", "RW", "BL", "SH", "KN", "LC", "MF"
  , "PM", "VC", "WS", "SM", "ST", "SA", "SN", "RS", "SC", "SL"
  , "SG", "SX", "SK", "SI", "SB", "SO", "ZA", "GS", "SS", "ES"
  , "LK", "SD", "SR", "SJ", "SE", "CH", "SY", "TW", "TJ", "TZ"
  , "TH", "TL", "TG", "TK", "TO", "TT", "TN", "TR", "TM", "TC"
  , "TV", "UG", "UA", "AE", "GB", "US", "UM", "UY", "UZ", "VU"
  , "VE", "VN", "VG", "VI", "WF", "EH", "YE", "ZM", "ZW"
  ]

validateOcfCountryCode : Text -> Bool
validateOcfCountryCode countryCode =
  Text.length countryCode == 2 && countryCode `elem` validCountryCodes

-- Percentage
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Percentage.schema.json
validateOcfPercentage : Decimal -> Bool
validateOcfPercentage p = p >= (0.0) && p <= 1.0

-- MD5
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Md5.schema.json
validateOcfMd5 : Text -> Bool
validateOcfMd5 md5 =
  let n = Text.length md5 in
  n == 32 && CryptoText.isHex md5

-- =============================================================================
-- POLICY CAPS
-- =============================================================================
-- Record-size caps the register enforces in `ensure`. They are Fairmint policy, not OCF
-- validity, so they stay out of the `validate<Name>OcfData` functions: each bounds the size of a
-- stored record, so every transaction that reads or writes it stays within the view limit.

-- References stored per record: a document's related objects, a financing's issuance IDs and
-- each ID list of a capitalization definition. A larger record is created and then extended by
-- restatements.
maxStoredReferences : Int
maxStoredReferences = 1000

-- Stock classes per stock plan, each checked when the plan is written.
maxStockPlanClasses : Int
maxStockPlanClasses = 16

-- Explicit vesting tranches per issuance or stock security. A longer schedule stays on vesting
-- terms plus a snapshot.
maxVestingTranches : Int
maxVestingTranches = 1500
