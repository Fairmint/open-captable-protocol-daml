-- OCF contact types (phone, email, address and tax ID) and their validators; used by the Issuer and Stakeholder records.
module Fairmint.OpenCapTable.Types.Contact where

-- =============================================================================
-- CONTACT, ADDRESS AND TAX ID TYPES
-- =============================================================================
-- Types for phone numbers, email addresses, postal addresses and tax identifiers.

import qualified DA.Text as Text
import Fairmint.Shared.TypeHelpers (validateOptionalText, validateRequiredText)
import Fairmint.OpenCapTable.Types.Validation (validateOcfCountryCode)

-- Enum - Phone Type
-- Type of phone number (home, mobile, business, other)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/PhoneType.schema.json
data OcfPhoneType
  = OcfPhoneTypeHome
  | OcfPhoneTypeMobile
  | OcfPhoneTypeBusiness
  | OcfPhoneTypeOther
  deriving (Eq, Show)

-- Type - Phone
-- Type representation of a phone number
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Phone.schema.json
data OcfPhone = OcfPhone
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- The phone number (e.g., E.164 formatted string)
    phone_number : Text
    -- Type of phone number (e.g., home, mobile, business, other)
    phone_type : OcfPhoneType
  deriving (Eq, Show)

validateOcfPhone : OcfPhone -> Bool
validateOcfPhone phone = validateRequiredText phone.phone_number

-- Enum - Email Type
-- Type of e-mail address
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/EmailType.schema.json
data OcfEmailType
  = OcfEmailTypePersonal
  | OcfEmailTypeBusiness
  | OcfEmailTypeOther
  deriving (Eq, Show)

-- Type - Email
-- Type representation of an email address
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Email.schema.json
data OcfEmail = OcfEmail
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- A valid e-mail address
    email_address : Text
    -- Type of e-mail address (e.g. personal or business)
    email_type : OcfEmailType
  deriving (Eq, Show)

validateOcfEmail : OcfEmail -> Bool
validateOcfEmail email =
  validateRequiredText email.email_address &&
  Text.length email.email_address >= 3 &&
  Text.isInfixOf "@" email.email_address

-- Type - Tax ID
-- Type representation of a tax identifier and issuing country
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/TaxID.schema.json
data OcfTaxID = OcfTaxID
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Country code where the tax ID is issued (ISO 3166-1 alpha-2)
    country : Text
    -- Tax identification string
    tax_id : Text
  deriving (Eq, Show)

validateOcfTaxID : OcfTaxID -> Bool
validateOcfTaxID taxId = validateRequiredText taxId.tax_id && validateOcfCountryCode taxId.country

-- Enum - Address Type
-- Type of address (legal, contact, or other)
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/enums/AddressType.schema.json
data OcfAddressType
  = OcfAddressTypeLegal
  | OcfAddressTypeContact
  | OcfAddressTypeOther
  deriving (Eq, Show)

-- Type - Address
-- Type representation of an address
-- OCF: https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Address.schema.json
data OcfAddress = OcfAddress
  with
    -- Required fields (alphabetical)
    ---------------------------------

    -- Type of address (legal, contact, or other)
    address_type : OcfAddressType
    -- Country code (ISO 3166-1 alpha-2)
    country : Text

    -- Optional fields (alphabetical)
    ---------------------------------

    -- City name
    city : Optional Text
    -- Country subdivision/state/province code
    country_subdivision : Optional Text
    -- Postal or ZIP code
    postal_code : Optional Text
    -- Street address and suite/apartment
    street_suite : Optional Text
  deriving (Eq, Show)

validateOcfAddress : OcfAddress -> Bool
validateOcfAddress address =
  validateRequiredText address.country &&
  validateOcfCountryCode address.country &&
  validateOptionalText address.city &&
  validateOptionalText address.country_subdivision &&
  validateOptionalText address.postal_code &&
  validateOptionalText address.street_suite
