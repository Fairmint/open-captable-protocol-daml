-- Core cap table context shared by every OpenCapTable-v35 register contract.
module Fairmint.OpenCapTable.Types.Core where

-- The cap table a register contract belongs to and the three parties that sign it, each with a
-- separate key: the issuer, Fairmint's system operator and the transfer agent (TA).
data Context = Context
  with
    -- "<factory_id>-<n>", from the OcpFactory counter
    cap_table_id : Text
    issuer : Party
    system_operator : Party
    transfer_agent : Party
  deriving (Eq, Show)

-- A context is valid when it names a cap table and three distinct parties.
validateContext : Context -> Bool
validateContext c =
  c.cap_table_id /= "" &&
  c.issuer /= c.system_operator &&
  c.issuer /= c.transfer_agent &&
  c.system_operator /= c.transfer_agent

-- The signatories of every register contract.
registerSignatories : Context -> [Party]
registerSignatories c = [c.issuer, c.system_operator, c.transfer_agent]
