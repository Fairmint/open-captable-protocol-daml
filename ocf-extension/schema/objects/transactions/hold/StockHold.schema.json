{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/Fairmint/open-captable-protocol-daml/main/ocf-extension/schema/objects/transactions/hold/StockHold.schema.json",
  "title": "Object - Stock Hold Transaction",
  "description": "Fairmint OCF extension. Object describing a hold on a stock security. A hold is open until a TX_STOCK_HOLD_CANCELLATION names it or its security is consumed, and a REGISTER_SETTLEMENT hold is void from the date of a later split of its class.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/objects/Object.schema.json"
    },
    {
      "$ref": "https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/objects/transactions/Transaction.schema.json"
    },
    {
      "$ref": "https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/primitives/objects/transactions/SecurityTransaction.schema.json"
    },
    {
      "$ref": "https://raw.githubusercontent.com/Fairmint/open-captable-protocol-daml/main/ocf-extension/schema/primitives/objects/transactions/hold/Hold.schema.json"
    }
  ],
  "properties": {
    "object_type": {
      "const": "TX_STOCK_HOLD"
    },
    "quantity": {
      "description": "Quantity of vested shares on hold; required for REGISTER_SETTLEMENT and absent for STOP_TRANSFER, which holds the whole security",
      "$ref": "https://raw.githubusercontent.com/Open-Cap-Table-Coalition/Open-Cap-Format-OCF/6d8c93227de64fc014fe0a215af208f4a5432542/schema/types/Numeric.schema.json"
    },
    "id": {},
    "comments": {},
    "security_id": {},
    "date": {},
    "hold_type": {},
    "reference": {},
    "reason_text": {}
  },
  "oneOf": [
    {
      "properties": { "hold_type": { "const": "REGISTER_SETTLEMENT" } },
      "required": ["quantity"]
    },
    {
      "properties": { "hold_type": { "const": "STOP_TRANSFER" } },
      "not": { "required": ["quantity"] }
    }
  ],
  "additionalProperties": false
}
