-- One-time proof that an OpenCapTable-v35 settlement delivered shares; the buyer's acceptance pays only by redeeming it.
module Fairmint.OpenCapTableDeliveryProof.DeliveryProof where

import DA.List (dedup, sort)
import qualified DA.Text as T

-- A price per share the settlement's draws were made at.
data DeliveredPrice = DeliveredPrice
  with
    -- Price per share
    amount : Decimal
    -- ISO 4217 currency code
    currency : Text
  deriving (Eq, Ord, Show)

-- Created only by OpenCapTable-v35's `CapTable_Settle`, one per settlement, in the transaction
-- that writes the delivery's OCF records. It carries the delivered terms and no lot detail, so the
-- buyer does not learn how many lots the trade drew. The acceptance that pays the seller checks it
-- against the accepted terms and its signers against the terms' issuer, system operator and
-- transfer agent, then redeems it in the same transaction. This package depends on no other
-- Fairmint package, so holder packages can depend on it without vetting the register.
template DeliveryProof
  with
    issuer : Party
    system_operator : Party
    transfer_agent : Party
    -- The cap table the shares were delivered on
    cap_table_id : Text
    -- The settlement's reference
    settlement_id : Text
    -- The stakeholder that received the shares
    buyer_stakeholder_id : Text
    -- The stakeholder that delivered the shares
    seller_stakeholder_id : Text
    -- The stock class delivered
    stock_class_id : Text
    -- Total quantity delivered
    quantity : Decimal
    -- The distinct prices per share of the draws, sorted (one for a desk trade)
    share_prices : [DeliveredPrice]
  where
    signatory issuer, system_operator, transfer_agent

    ensure
      issuer /= system_operator &&
      issuer /= transfer_agent &&
      system_operator /= transfer_agent &&
      cap_table_id /= "" &&
      settlement_id /= "" &&
      buyer_stakeholder_id /= "" &&
      seller_stakeholder_id /= "" &&
      buyer_stakeholder_id /= seller_stakeholder_id &&
      stock_class_id /= "" &&
      quantity > 0.0 &&
      not (null share_prices) &&
      share_prices == dedup (sort share_prices) &&
      all validDeliveredPrice share_prices

    -- Consumes the proof. The acceptance that pays exercises it with the issuer's authority, which
    -- its own body holds.
    choice DeliveryProof_Redeem : DeliveryProof
      controller issuer
      do
        pure this

validDeliveredPrice : DeliveredPrice -> Bool
validDeliveredPrice p = p.amount >= 0.0 && T.length p.currency == 3
