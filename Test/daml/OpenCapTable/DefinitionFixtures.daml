-- =============================================================================
-- BOOKS
-- =============================================================================

-- | A new cap table holding these records, written in one batch.
bookWith : [OcfRecordData] -> Script Env
bookWith ds = do
  env <- setupEnv
  _ <- applyRecords env ds
  pure env
