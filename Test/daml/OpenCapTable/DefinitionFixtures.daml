-- Shared fixtures for the definition-record tests (stakeholders, issuer, classes, plans, legends, valuations, documents, financings, vesting terms): typed reads of any OCF record from the ACS and minimal instrument issuances.
module OpenCapTable.DefinitionFixtures where

import DA.Assert ((===))
import DA.Foldable (mapA_)
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Types.Core (Context)
import Fairmint.OpenCapTable.Types.Conversion
import Fairmint.OpenCapTable.Types.Vesting (OcfCompensationType(..))
import Fairmint.OpenCapTable.OCF.ConvertibleIssuance (ConvertibleIssuanceOcfData(..), OcfConvertibleConversionTrigger(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationIssuance (EquityCompensationIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.WarrantIssuance (WarrantIssuanceOcfData(..))
import OpenCapTable.Harness

-- =============================================================================
-- READING RECORDS
-- =============================================================================

-- | The context and payload of the active record with this object ID, read from the ACS by its
-- template-typed contract ID.
recordOf : Env -> Text -> Script (Context, OcfRecordData)
recordOf env objectId = do
  rcid <- recordCidOf env objectId
  found <- case rcid of
    OcfRecordCidConvertibleAcceptance c -> fmap (\r -> (r.context, OcfRecordDataConvertibleAcceptance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidConvertibleCancellation c -> fmap (\r -> (r.context, OcfRecordDataConvertibleCancellation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidConvertibleConversion c -> fmap (\r -> (r.context, OcfRecordDataConvertibleConversion r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidConvertibleIssuance c -> fmap (\r -> (r.context, OcfRecordDataConvertibleIssuance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidConvertibleRetraction c -> fmap (\r -> (r.context, OcfRecordDataConvertibleRetraction r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidConvertibleTransfer c -> fmap (\r -> (r.context, OcfRecordDataConvertibleTransfer r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidDocument c -> fmap (\r -> (r.context, OcfRecordDataDocument r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationAcceptance c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationAcceptance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationCancellation c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationCancellation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationExercise c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationExercise r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationIssuance c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationIssuance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationRelease c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationRelease r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationRepricing c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationRepricing r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationRetraction c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationRetraction r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidEquityCompensationTransfer c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationTransfer r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidFinancing c -> fmap (\r -> (r.context, OcfRecordDataFinancing r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidIssuer c -> fmap (\r -> (r.context, OcfRecordDataIssuer r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidIssuerAuthorizedSharesAdjustment c -> fmap (\r -> (r.context, OcfRecordDataIssuerAuthorizedSharesAdjustment r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStakeholder c -> fmap (\r -> (r.context, OcfRecordDataStakeholder r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStakeholderRelationshipChangeEvent c -> fmap (\r -> (r.context, OcfRecordDataStakeholderRelationshipChangeEvent r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStakeholderStatusChangeEvent c -> fmap (\r -> (r.context, OcfRecordDataStakeholderStatusChangeEvent r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockAcceptance c -> fmap (\r -> (r.context, OcfRecordDataStockAcceptance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockCancellation c -> fmap (\r -> (r.context, OcfRecordDataStockCancellation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockClass c -> fmap (\r -> (r.context, OcfRecordDataStockClass r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockClassAuthorizedSharesAdjustment c -> fmap (\r -> (r.context, OcfRecordDataStockClassAuthorizedSharesAdjustment r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockClassConversionRatioAdjustment c -> fmap (\r -> (r.context, OcfRecordDataStockClassConversionRatioAdjustment r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockClassSplit c -> fmap (\r -> (r.context, OcfRecordDataStockClassSplit r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockConsolidation c -> fmap (\r -> (r.context, OcfRecordDataStockConsolidation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockConversion c -> fmap (\r -> (r.context, OcfRecordDataStockConversion r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockHold c -> fmap (\r -> (r.context, OcfRecordDataStockHold r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockHoldCancellation c -> fmap (\r -> (r.context, OcfRecordDataStockHoldCancellation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockIssuance c -> fmap (\r -> (r.context, OcfRecordDataStockIssuance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockLegendTemplate c -> fmap (\r -> (r.context, OcfRecordDataStockLegendTemplate r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockPlan c -> fmap (\r -> (r.context, OcfRecordDataStockPlan r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockPlanPoolAdjustment c -> fmap (\r -> (r.context, OcfRecordDataStockPlanPoolAdjustment r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockPlanReturnToPool c -> fmap (\r -> (r.context, OcfRecordDataStockPlanReturnToPool r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockReissuance c -> fmap (\r -> (r.context, OcfRecordDataStockReissuance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockRepurchase c -> fmap (\r -> (r.context, OcfRecordDataStockRepurchase r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockRetraction c -> fmap (\r -> (r.context, OcfRecordDataStockRetraction r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidStockTransfer c -> fmap (\r -> (r.context, OcfRecordDataStockTransfer r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidValuation c -> fmap (\r -> (r.context, OcfRecordDataValuation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidVestingAcceleration c -> fmap (\r -> (r.context, OcfRecordDataVestingAcceleration r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidVestingEvent c -> fmap (\r -> (r.context, OcfRecordDataVestingEvent r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidVestingStart c -> fmap (\r -> (r.context, OcfRecordDataVestingStart r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidVestingTerms c -> fmap (\r -> (r.context, OcfRecordDataVestingTerms r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidWarrantAcceptance c -> fmap (\r -> (r.context, OcfRecordDataWarrantAcceptance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidWarrantCancellation c -> fmap (\r -> (r.context, OcfRecordDataWarrantCancellation r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidWarrantExercise c -> fmap (\r -> (r.context, OcfRecordDataWarrantExercise r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidWarrantIssuance c -> fmap (\r -> (r.context, OcfRecordDataWarrantIssuance r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidWarrantRetraction c -> fmap (\r -> (r.context, OcfRecordDataWarrantRetraction r.ocf_data)) <$> queryContractId env.transfer_agent c
    OcfRecordCidWarrantTransfer c -> fmap (\r -> (r.context, OcfRecordDataWarrantTransfer r.ocf_data)) <$> queryContractId env.transfer_agent c
  case found of
    Some r -> pure r
    None -> fail ("record " <> objectId <> " is not visible to the transfer agent")

recordDataOf : Env -> Text -> Script OcfRecordData
recordDataOf env objectId = snd <$> recordOf env objectId

objectIdOf : Env -> OcfRecordData -> Text
objectIdOf env d = (recordView env.ctx d).object_id

-- | The book holds exactly one active record under the data's object ID, with exactly this payload,
-- in this cap table's context.
expectRecord : Env -> OcfRecordData -> Script ()
expectRecord env expected = do
  (ctx, d) <- recordOf env (objectIdOf env expected)
  ctx === env.ctx
  d === expected

expectRecords : Env -> [OcfRecordData] -> Script ()
expectRecords env = mapA_ (expectRecord env)

expectNoRecord : Env -> Text -> Script ()
expectNoRecord env objectId = hasRecord env objectId >>= (=== False)

-- =============================================================================
-- VALIDATORS AND THE LEDGER
-- =============================================================================

-- | The record's validator accepts it, the ledger writes it, and the book then holds it unchanged.
accept : Show a => Env -> (a -> Bool) -> (a -> OcfRecordData) -> a -> Script ()
accept env validate wrap d = do
  assertMsg ("the validator refused " <> show d) (validate d)
  _ <- applyRecords env [wrap d]
  expectRecord env (wrap d)

-- | The record's validator refuses it, and so does the ledger, by the template's `ensure`.
refuse : Show a => Env -> (a -> Bool) -> (a -> OcfRecordData) -> a -> Script ()
refuse env validate wrap d = do
  assertMsg ("the validator accepted " <> show d) (not (validate d))
  applyRecordsFails env "precondition" [wrap d]

