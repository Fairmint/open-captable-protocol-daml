--   accept env validateFinancingOcfData OcfRecordDataFinancing ((financingData "FIN_EMPTY_TEXT" ["STOCK_FIN"]) with name = "")
--   accept env validateFinancingOcfData OcfRecordDataFinancing ((financingData "FIN_EMPTY_COMMENT" ["STOCK_FIN"]) with comments = [""])

-- v34 testFinancing_DuplicateIssuanceIdsRemainSchemaValid.
test_financing_duplicate_issuance_ids : Script ()
test_financing_duplicate_issuance_ids = do
  env <- bookWith financingRecords
  accept env validateFinancingOcfData OcfRecordDataFinancing (financingData "FIN_DUP" ["STOCK_FIN", "STOCK_FIN"])

-- v34 testFinancing_CrossFamilyIssuanceIdCollisionFails: v35 claims object IDs across all types and
-- security IDs across all instruments, so the ambiguous financing reference cannot arise.
test_financing_issuance_ids_are_unique_across_instruments : Script ()
test_financing_issuance_ids_are_unique_across_instruments = do
  env <- bookWith financingRecords
  applyRecordsFails env "ID already used: STOCK_FIN" [OcfRecordDataWarrantIssuance (warrantIssuance "STOCK_FIN" "SEC_WARRANT_FIN_COLLISION" "SH_FIN")]
  applyRecordsFails env "security ID already used: SEC_STOCK_FIN" [OcfRecordDataWarrantIssuance (warrantIssuance "WARRANT_FIN" "SEC_STOCK_FIN" "SH_FIN")]
  applyRecordsFails env "ID already used: CONV_TWIN"
    [ OcfRecordDataConvertibleIssuance (convertibleIssuance "CONV_TWIN" "SEC_CONV_1" "SH_FIN")
    , OcfRecordDataEquityCompensationIssuance (equityCompensationIssuance "CONV_TWIN" "SEC_EQ_1" "SH_FIN")
    ]
  expectNoRecord env "CONV_TWIN"

-- v34 testFinancing_EditCanReferenceSameBatchIssuance (v35 writes the issuance first, then restates
-- the financing) and the delete half of testFinancing_DeleteLastFinancingCollapsesMapToNone.
test_financing_edit_and_delete : Script ()
test_financing_edit_and_delete = do
  env <- bookWith (financingRecords <> [OcfRecordDataFinancing (financingData "FIN_EDIT" ["STOCK_FIN"])])
  restateOpsFails env "Financing issuance not found: STOCK_FIN_EDIT_2"
    [RestateEdit (OcfRecordDataFinancing (financingData "FIN_EDIT" ["STOCK_FIN", "STOCK_FIN_EDIT_2"]))]
  _ <- applyRecords env [stockFin "STOCK_FIN_EDIT_2" "SEC_STOCK_FIN_EDIT_2"]
  let edited = (financingData "FIN_EDIT" ["STOCK_FIN", "STOCK_FIN_EDIT_2"]) with name = "Series A-1"; date = d2024
  _ <- restateOps env [RestateEdit (OcfRecordDataFinancing edited)]
  expectRecord env (OcfRecordDataFinancing edited)
  restateOpsFails env "precondition" [RestateEdit (OcfRecordDataFinancing (edited with issuance_ids = []))]
  _ <- restateOps env [RestateDelete "FIN_EDIT"]
  expectNoRecord env "FIN_EDIT"
  -- The ID is free again.
  _ <- applyRecords env [OcfRecordDataFinancing (financingData "FIN_EDIT" ["STOCK_FIN_EDIT_2"])]
  expectRecord env (OcfRecordDataFinancing (financingData "FIN_EDIT" ["STOCK_FIN_EDIT_2"]))

-- A transaction checks at most 100 polymorphic references; a financing stores at most 1000.
test_financing_reference_caps : Script ()
test_financing_reference_caps = do
  env <- bookWith financingRecords
  let fin id n = OcfRecordDataFinancing (financingData id (replicate n "STOCK_FIN"))
  applyRecordsFails env "more than 100 polymorphic references" [fin "FIN_101" 101]
  _ <- applyRecords env [fin "FIN_BIG" 100]
  restateOpsFails env "more than 100 polymorphic references" [RestateEdit (fin "FIN_BIG" 201)]
  _ <- foldlA (\_ n -> do
      _ <- restateOps env [RestateEdit (fin "FIN_BIG" n)]
      pure ())
    () [200, 300 .. 1000]
  expectRecord env (fin "FIN_BIG" 1000)
  restateOpsFails env "has 1001 financing issuance IDs; at most 1000" [RestateEdit (fin "FIN_BIG" 1001)]
