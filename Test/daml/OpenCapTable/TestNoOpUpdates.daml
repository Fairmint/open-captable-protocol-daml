module OpenCapTable.TestNoOpUpdates where

import Fairmint.OpenCapTable.OCF.Document
import Fairmint.OpenCapTable.OCF.Issuer
import Fairmint.OpenCapTable.OCF.Stakeholder
import qualified Fairmint.OpenCapTable.CapTable as CT
import Fairmint.OpenCapTable.Types.Monetary (OcfAddress(..), OcfAddressType(..))
import Fairmint.OpenCapTable.Types.Stock (OcfInitialSharesAuthorized(..))
import OpenCapTable.Setup
import OpenCapTable.TestHelpers
import Daml.Script
import DA.Date
import DA.Time

-- Issuer payload created by setupTestOcp. Context / ContractIds are not compared.
originalIssuerData : IssuerOcfData
originalIssuerData = IssuerOcfData with
  id = "ISSUER_1"
  legal_name = "TestIssuer Inc."
  formation_date = time (DA.Date.date 2020 Jan 15) 12 0 0
  country_of_formation = "US"
  dba = None
  country_subdivision_of_formation = None
  country_subdivision_name_of_formation = None
  tax_ids = []
  email = None
  phone = None
  address = None
  initial_shares_authorized = Some (OcfInitialSharesNumeric 1000.0)
  comments = []

defaultDocument : Text -> DocumentOcfData
defaultDocument documentId = DocumentOcfData with
  id = documentId
  path = Some "/docs/original.pdf"
  uri = None
  md5 = "0123456789abcdef0123456789abcdef"
  related_objects = []
  comments = []

legalAddress : OcfAddress
legalAddress = OcfAddress with
  address_type = OcfAddressTypeLegal
  street_suite = Some "2 Main St"
  city = Some "SF"
  country_subdivision = Some "CA"
  country = "US"
  postal_code = Some "94105"

-- Identical stakeholder replacement, including addresses, must fail.
testIdenticalStakeholderUpdateRejected = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let stakeholderData = (defaultStakeholder "STKH_NOOP" "Alice") with
        addresses = [legalAddress]
  (capTable', _) <- setupStakeholderWith issuer cap_table stakeholderData
  submitMustFail issuer do
    exerciseCmd capTable' CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditStakeholder stakeholderData]
      deletes = []
  pure ()

-- A real stakeholder change (address update) must succeed.
testStakeholderAddressChangeSucceeds = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let stakeholderData = (defaultStakeholder "STKH_ADDR" "Alice") with
        addresses = [legalAddress]
  (capTable', _) <- setupStakeholderWith issuer cap_table stakeholderData
  let updatedAddress = legalAddress with street_suite = Some "3 Market St"
  result <- submit issuer do
    exerciseCmd capTable' CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditStakeholder (stakeholderData with addresses = [updatedAddress])]
      deletes = []
  case result.editedCids of
    [CT.CidStakeholder _] -> pure ()
    _ -> assertFail "Expected exactly one stakeholder edit"

-- Identical document replacement must fail.
testIdenticalDocumentUpdateRejected = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let documentData = defaultDocument "DOC_NOOP"
  created <- submit issuer do
    exerciseCmd cap_table CT.UpdateCapTable with
      creates = [CT.OcfCreateDocument documentData]
      edits = []
      deletes = []
  submitMustFail issuer do
    exerciseCmd created.updatedCapTableCid CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditDocument documentData]
      deletes = []
  pure ()

-- A real document change must succeed.
testDocumentChangeSucceeds = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let documentData = defaultDocument "DOC_EDIT"
  created <- submit issuer do
    exerciseCmd cap_table CT.UpdateCapTable with
      creates = [CT.OcfCreateDocument documentData]
      edits = []
      deletes = []
  result <- submit issuer do
    exerciseCmd created.updatedCapTableCid CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditDocument (documentData with path = Some "/docs/updated.pdf")]
      deletes = []
  case result.editedCids of
    [CT.CidDocument _] -> pure ()
    _ -> assertFail "Expected exactly one document edit"

-- Identical stock class replacement must fail.
testIdenticalStockClassUpdateRejected = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let stockClassData = defaultStockClass "SC_NOOP"
  (capTable', _) <- setupStockClassWith issuer cap_table stockClassData
  submitMustFail issuer do
    exerciseCmd capTable' CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditStockClass stockClassData]
      deletes = []
  pure ()

-- A real stock class change must succeed.
testStockClassChangeSucceeds = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let stockClassData = defaultStockClass "SC_EDIT"
  (capTable', _) <- setupStockClassWith issuer cap_table stockClassData
  result <- submit issuer do
    exerciseCmd capTable' CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditStockClass (stockClassData with name = "Updated Common Stock")]
      deletes = []
  case result.editedCids of
    [CT.CidStockClass _] -> pure ()
    _ -> assertFail "Expected exactly one stock class edit"

-- Identical issuer replacement must fail.
testIdenticalIssuerUpdateRejected = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  submitMustFail issuer do
    exerciseCmd cap_table CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditIssuer originalIssuerData]
      deletes = []
  pure ()

-- A real issuer change must succeed.
testIssuerChangeSucceeds = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  result <- submit issuer do
    exerciseCmd cap_table CT.UpdateCapTable with
      creates = []
      edits = [CT.OcfEditIssuer (originalIssuerData with legal_name = "TestIssuer Updated Inc.")]
      deletes = []
  case result.editedCids of
    [CT.CidIssuer _] -> pure ()
    _ -> assertFail "Expected exactly one issuer edit"

-- Mixed batch: one real edit plus one identical replacement aborts the entire UpdateCapTable.
testMixedBatchIdenticalEditRejected = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let stakeholderData = defaultStakeholder "STKH_MIX" "Alice"
  let stockClassData = defaultStockClass "SC_MIX"
  created <- submit issuer do
    exerciseCmd cap_table CT.UpdateCapTable with
      creates =
        [ CT.OcfCreateStakeholder stakeholderData
        , CT.OcfCreateStockClass stockClassData
        ]
      edits = []
      deletes = []
  submitMustFail issuer do
    exerciseCmd created.updatedCapTableCid CT.UpdateCapTable with
      creates = []
      edits =
        [ CT.OcfEditStakeholder (stakeholderData with name = OcfName with legal_name = "Alice Updated", first_name = None, last_name = None)
        , CT.OcfEditStockClass stockClassData
        ]
      deletes = []
  pure ()

-- Mixed batch: two genuine payload edits succeed together.
testMixedBatchTwoRealEditsSucceeds = script do
  TestOcp{issuer, cap_table} <- setupTestOcp
  let stakeholderData = defaultStakeholder "STKH_MIX2" "Alice"
  let stockClassData = defaultStockClass "SC_MIX2"
  created <- submit issuer do
    exerciseCmd cap_table CT.UpdateCapTable with
      creates =
        [ CT.OcfCreateStakeholder stakeholderData
        , CT.OcfCreateStockClass stockClassData
        ]
      edits = []
      deletes = []
  result <- submit issuer do
    exerciseCmd created.updatedCapTableCid CT.UpdateCapTable with
      creates = []
      edits =
        [ CT.OcfEditStakeholder (stakeholderData with name = OcfName with legal_name = "Alice Updated", first_name = None, last_name = None)
        , CT.OcfEditStockClass (stockClassData with name = "Updated Common Stock")
        ]
      deletes = []
  case result.editedCids of
    [CT.CidStakeholder _, CT.CidStockClass _] -> pure ()
    [CT.CidStockClass _, CT.CidStakeholder _] -> pure ()
    _ -> assertFail "Expected stakeholder and stock class edits"
