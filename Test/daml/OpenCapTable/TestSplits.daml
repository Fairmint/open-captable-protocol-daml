-- Splits: recorded on a frozen class epoch, applied lazily to each state at its next event, with the units rule, rounding, and voided settlement holds.
module OpenCapTable.TestSplits where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.Apply hiding (applyOperation)
import Fairmint.OpenCapTable.Update (UpdateOperation(..))
import Fairmint.OpenCapTable.Holds hiding (placeHolds, cancelHolds, settle)
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.State
import Fairmint.OpenCapTable.Types.Stock (OcfHoldType(..))
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting(..))
import Fairmint.OpenCapTable.OCF.StockAcceptance (StockAcceptanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockCancellation (StockCancellationOcfData(..))
import Fairmint.OpenCapTable.OCF.StockReissuance (StockReissuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockRetraction (StockRetractionOcfData(..))
import Fairmint.OpenCapTable.OCF.StockTransfer (StockTransferOcfData(..))
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import OpenCapTable.Harness
import OpenCapTable.TestRestate (restatementOf)

splitDay : Date
splitDay = D.date 2025 D.Jan 10

freeze : Env -> Text -> Script ()
freeze env cls = do
  _ <- updateOps env [UpdateFreezeClass cls]
  pure ()

unfreeze : Env -> Text -> Script ()
unfreeze env cls = do
  _ <- updateOps env [UpdateUnfreezeClass cls]
  pure ()

-- Records a split in one update: freeze, record, unfreeze.
recordSplit : Env -> Text -> Text -> Decimal -> Decimal -> Date -> Script ()
recordSplit env id cls n d dt = do
  _ <- updateOps env
    [ UpdateFreezeClass cls
    , UpdateCreate (ApplyRecord (OcfRecordDataStockClassSplit (split id cls n d dt)))
    , UpdateUnfreezeClass cls
    ]
  pure ()

acceptance : Text -> Text -> Date -> OcfRecordData
acceptance id sec d = OcfRecordDataStockAcceptance StockAcceptanceOcfData with id; date = d; security_id = sec; comments = []

test_splits_need_a_frozen_epoch : Script ()
test_splits_need_a_frozen_epoch = do
  env <- standardBook
  applyRecordsFails env "must be frozen" [OcfRecordDataStockClassSplit (split "SPLIT-1" "CLS-A" 2.0 1.0 splitDay)]
  freeze env "CLS-A"
  -- While frozen, no write that creates or changes a stock state in the class commits.
  applyRecordsFails env "is frozen" [OcfRecordDataStockIssuance (issuance "S-NEW" "SH-A" "CLS-A" 1.0 splitDay)]
  applyRecordsFails env "is frozen" [acceptance "ACC-1" "S-A1" splitDay]
  updateOpsFails env "already frozen" [UpdateFreezeClass "CLS-A"]
  _ <- applyRecords env [OcfRecordDataStockClassSplit (split "SPLIT-1" "CLS-A" 2.0 1.0 splitDay)]
  (_, e) <- epochOf env "CLS-A"
  e.frozen === True
  map (.split_id) e.splits === ["SPLIT-1"]
  unfreeze env "CLS-A"
  updateOpsFails env "is not frozen" [UpdateUnfreezeClass "CLS-A"]

test_splits_dates_strictly_increase : Script ()
test_splits_dates_strictly_increase = do
  env <- standardBook
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  freeze env "CLS-A"
  -- A split dated before the latest one would apply out of order to states that applied it; two on
  -- one date (OCF allows them) apply in the order recorded.
  applyRecordsFails env "dated on or after the class's latest recorded split" [OcfRecordDataStockClassSplit (split "SPLIT-2" "CLS-A" 2.0 1.0 (D.addDays splitDay (-1)))]
  _ <- applyRecords env [OcfRecordDataStockClassSplit (split "SPLIT-2" "CLS-A" 3.0 1.0 splitDay)]
  _ <- applyRecords env [OcfRecordDataStockClassSplit (split "SPLIT-3" "CLS-A" 3.0 1.0 (D.addDays splitDay 1))]
  (_, e) <- epochOf env "CLS-A"
  map (.split_id) e.splits === ["SPLIT-1", "SPLIT-2", "SPLIT-3"]
  unfreeze env "CLS-A"
  -- A lot applies both same-day splits at its next event: 400 x 2 x 3.
  _ <- applyRecords env [OcfRecordDataStockAcceptance StockAcceptanceOcfData with id = "ACC-SAME-DAY"; date = splitDay; security_id = "S-A2"; comments = []]
  (.quantity) <$> stateOf env "S-A2" >>= (=== 2400.0)

-- A split touches no state; each state applies it at its next event, dated on or after it.
test_splits_applied_lazily : Script ()
test_splits_applied_lazily = do
  env <- standardBook
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  s <- stateOf env "S-A1"
  s.quantity === 600.0
  s.split_epoch === 0
  -- An event dated before the split leaves it unapplied.
  _ <- applyRecords env [acceptance "ACC-0" "S-A1" (D.addDays splitDay (-1))]
  s0 <- stateOf env "S-A1"
  s0.quantity === 600.0
  s0.split_epoch === 0
  -- An event dated on the split's day applies it (the units rule: records dated D or later are post-split).
  _ <- applyRecords env [acceptance "ACC-1" "S-A1" splitDay]
  s1 <- stateOf env "S-A1"
  s1.quantity === 1200.0
  s1.split_epoch === 1
  s2 <- stateOf env "S-A2"
  s2.quantity === 400.0

-- An issuance dated on or after a split is already in post-split units.
test_splits_issuance_on_split_day_is_post_split : Script ()
test_splits_issuance_on_split_day_is_post_split = do
  env <- standardBook
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  _ <- applyRecords env [OcfRecordDataStockIssuance (issuance "S-NEW" "SH-A" "CLS-A" 10.0 splitDay)]
  s <- stateOf env "S-NEW"
  s.split_epoch === 1
  _ <- applyRecords env [acceptance "ACC-N" "S-NEW" (D.addDays splitDay 5)]
  s' <- stateOf env "S-NEW"
  s'.quantity === 10.0

test_splits_floor_quantities_and_tranches : Script ()
test_splits_floor_quantities_and_tranches = do
  env <- standardBook
  let tranches = [(OcfVesting with amount = 40.0; date = D.date 2024 D.Jun 1), (OcfVesting with amount = 60.0; date = D.date 2025 D.Jun 1)]
  _ <- applyRecords env [OcfRecordDataStockIssuance ((issuance "S-T" "SH-A" "CLS-A" 100.0 d2024) with vestings = tranches)]
  recordSplit env "SPLIT-1" "CLS-A" 2.0 3.0 splitDay
  _ <- applyRecords env [acceptance "ACC-T" "S-T" splitDay]
  s <- stateOf env "S-T"
  -- 100 × 2/3 floors to 66.6666666666; cumulative tranches 40 → 26.6666666666, 100 → 66.6666666666.
  s.quantity === 66.6666666666
  s.vesting === StockVestingTranches
    [ OcfVesting with amount = 26.6666666666; date = D.date 2024 D.Jun 1
    , OcfVesting with amount = 40.0; date = D.date 2025 D.Jun 1
    ]

-- A schedule of only zero tranches vests nothing, and a split keeps it vesting nothing; a schedule
-- that vested something and floors to nothing is refused.
test_splits_keep_an_empty_schedule_empty : Script ()
test_splits_keep_an_empty_schedule_empty = do
  env <- standardBook
  _ <- applyRecords env
    [ OcfRecordDataStockIssuance ((issuance "S-Z" "SH-A" "CLS-A" 100.0 d2024) with vestings = [OcfVesting with amount = 0.0; date = d2024])
    , OcfRecordDataStockIssuance ((issuance "S-SMALL" "SH-A" "CLS-A" 100.0 d2024) with vestings = [OcfVesting with amount = 0.0000000001; date = d2024])
    ]
  recordSplit env "SPLIT-1" "CLS-A" 1.0 10.0 splitDay
  _ <- applyRecords env [acceptance "ACC-Z" "S-Z" splitDay]
  s <- stateOf env "S-Z"
  s.quantity === 10.0
  s.vesting === StockVestingTranches []
  applyRecordsFails env "floors every vesting tranche of security S-SMALL to zero" [acceptance "ACC-SMALL" "S-SMALL" splitDay]

test_splits_reverse_split_to_zero_fails_closed : Script ()
test_splits_reverse_split_to_zero_fails_closed = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockIssuance (issuance "S-TINY" "SH-A" "CLS-A" 0.0000000001 d2024)]
  recordSplit env "SPLIT-1" "CLS-A" 1.0 10.0 splitDay
  applyRecordsFails env "floors security S-TINY to zero" [acceptance "ACC-X" "S-TINY" splitDay]

-- A settlement hold placed before a split can never be drawn on or after the split's date.
test_splits_void_settlement_holds : Script ()
test_splits_void_settlement_holds = do
  env <- standardBook
  let holdDay = D.date 2025 D.Jan 5
      laterDay = D.date 2025 D.Jan 12
  onDate holdDay
  lot <- settlementLot env "S-A1" 100.0
  [h] <- placeHolds env OcfHoldTypeRegisterSettlement "T-1" holdDay [lot]
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  onDate laterDay
  draw <- drawLot env "S-A1" 100.0 1.0 []
  buyer <- SettleBuyerExisting <$> stakeholderCidOf env "SH-B"
  -- The cost bases are now those of the post-split lot; the hold is void either way.
  settleFails env "voided hold" "T-1" laterDay buyer [SettleDraw draw with balance_cost_basis = Some (usd 1100.0)]
  -- The voided hold occupies the lot's settlement-hold slot until the TA cancels it.
  lot' <- settlementLot env "S-A1" 10.0
  placeHoldsFails env "already carries a settlement hold" OcfHoldTypeRegisterSettlement "T-2" laterDay [lot']
  _ <- cancelHolds env laterDay [CancelHold with security_id = "S-A1"; hold_id = h.hold_id; reason_text = "voided by SPLIT-1"]
  s <- stateOf env "S-A1"
  s.quantity === 1200.0
  lot'' <- settlementLot env "S-A1" 200.0
  _ <- placeHolds env OcfHoldTypeRegisterSettlement "T-2" laterDay [lot'']
  pure ()

-- A split recorded on or before a lot's last event (here, the day its holds were placed) is one the
-- lot has not counted, so the lot counts it at its next event, a hold cancellation included: the
-- stopped lot's stop is lifted in the split's units. A restatement in the split's units brings a
-- held lot current too, carrying its holds; its settlement hold is then void, as any split voids
-- one, and the TA cancels it.
test_splits_held_lot_counts_a_split_on_its_last_event_date : Script ()
test_splits_held_lot_counts_a_split_on_its_last_event_date = do
  env <- standardBook
  let holdDay = D.date 2025 D.Jan 5
      laterDay = D.date 2025 D.Jan 12
  onDate holdDay
  lot <- settlementLot env "S-A1" 100.0
  [h] <- placeHolds env OcfHoldTypeRegisterSettlement "T-1" holdDay [lot]
  [stop] <- placeHolds env OcfHoldTypeStopTransfer "CASE-1" holdDay [stopLot "S-A2"]
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 holdDay
  _ <- cancelHolds env holdDay [CancelHold with security_id = "S-A2"; hold_id = stop.hold_id; reason_text = "order lifted"]
  s2 <- stateOf env "S-A2"
  (s2.split_epoch, s2.quantity, s2.holds) === (1, 800.0, [])
  s1 <- stateOf env "S-A1"
  s1.split_epoch === 0
  _ <- restateOps env [RestateSetState ((restatementOf s1) with quantity = s1.quantity * 2.0)]
  s1' <- stateOf env "S-A1"
  (s1'.split_epoch, s1'.quantity, map (.hold_id) s1'.holds) === (1, s1.quantity * 2.0, [h.hold_id])
  onDate laterDay
  draw <- drawLot env "S-A1" 100.0 1.0 []
  buyer <- SettleBuyerExisting <$> stakeholderCidOf env "SH-B"
  settleFails env "voided hold" "T-1" laterDay buyer [SettleDraw draw]
  _ <- cancelHolds env laterDay [CancelHold with security_id = "S-A1"; hold_id = h.hold_id; reason_text = "voided by SPLIT-1"]
  lot' <- settlementLot env "S-A1" 200.0
  _ <- placeHolds env OcfHoldTypeRegisterSettlement "T-2" laterDay [lot']
  pure ()

test_splits_reissuance_names_its_split : Script ()
test_splits_reissuance_names_its_split = do
  env <- standardBook
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  let r = StockReissuanceOcfData with
        id = "REISS-1"
        date = splitDay
        security_id = "S-A2"
        comments = []
        resulting_security_ids = ["S-A2-R"]
        reason_text = None
        split_transaction_id = Some "SPLIT-1"
      out q = (issuance "S-A2-R" "SH-A" "CLS-A" q splitDay) with id = "ISS-S-A2-R"
  -- The split applies first, so the post-split lot holds 800.
  _ <- applyOps env [ApplyStockReissuance with reissuance = r; resulting = [out 800.0]]
  s <- stateOf env "S-A2-R"
  s.quantity === 800.0
  s.split_epoch === 1

test_splits_reissuance_split_must_exist_in_class : Script ()
test_splits_reissuance_split_must_exist_in_class = do
  env <- standardBook
  let r = StockReissuanceOcfData with
        id = "REISS-1"
        date = splitDay
        security_id = "S-A2"
        comments = []
        resulting_security_ids = ["S-A2-R"]
        reason_text = None
        split_transaction_id = Some "SPLIT-NONE"
  applyOpsFails env "split not found: SPLIT-NONE"
    [ApplyStockReissuance with reissuance = r; resulting = [(issuance "S-A2-R" "SH-A" "CLS-A" 400.0 splitDay) with id = "ISS-S-A2-R"]]

test_splits_at_most_64 : Script ()
test_splits_at_most_64 = do
  env <- standardBook
  freeze env "CLS-A"
  _ <- applyRecords env (map (\i -> OcfRecordDataStockClassSplit (split ("SPLIT-" <> show i) "CLS-A" 1.0 1.0 (D.addDays splitDay i))) [1 .. 64])
  applyRecordsFails env "already has 64 splits" [OcfRecordDataStockClassSplit (split "SPLIT-65" "CLS-A" 1.0 1.0 (D.addDays splitDay 65))]

-- In one update, a split is recorded before any stock state change: a state applies the split at
-- its next event, so an event written ahead of the split record would miss it. Recorded first, the
-- split reaches an event later in the same update.
test_splits_come_first_in_an_update : Script ()
test_splits_come_first_in_an_update = do
  env <- standardBook
  let sp = OcfRecordDataStockClassSplit (split "SPLIT-1" "CLS-A" 2.0 1.0 splitDay)
      later = D.addDays splitDay 1
  updateOpsFails env "freeze stock class CLS-A before any stock state change in this update"
    [ UpdateCreate (ApplyRecord (acceptance "ACC-1" "S-A1" later))
    , UpdateFreezeClass "CLS-A"
    , UpdateCreate (ApplyRecord sp)
    , UpdateUnfreezeClass "CLS-A"
    ]
  _ <- updateOps env
    [ UpdateFreezeClass "CLS-A"
    , UpdateCreate (ApplyRecord sp)
    , UpdateUnfreezeClass "CLS-A"
    , UpdateCreate (ApplyRecord (acceptance "ACC-1" "S-A1" later))
    ]
  (.quantity) <$> stateOf env "S-A1" >>= (=== 1200.0)
  -- A lot created and wholly retracted earlier in the update counts as a change too.
  let ret = StockRetractionOcfData with id = "RET-N"; date = later; reason_text = "x"; security_id = "S-N"; comments = []
  updateOpsFails env "freeze stock class CLS-A before any stock state change in this update"
    [ UpdateCreate (ApplyRecord (OcfRecordDataStockIssuance (issuance "S-N" "SH-A" "CLS-A" 100.0 splitDay)))
    , UpdateCreate (ApplyRecord (OcfRecordDataStockRetraction ret))
    , UpdateFreezeClass "CLS-A"
    , UpdateCreate (ApplyRecord (OcfRecordDataStockClassSplit (split "SPLIT-2" "CLS-A" 2.0 1.0 later)))
    , UpdateUnfreezeClass "CLS-A"
    ]

-- A terminal event may be backdated past the state's last event only within its split epoch: its
-- quantity is in the units of its own date.
test_splits_bound_backdated_terminal_events : Script ()
test_splits_bound_backdated_terminal_events = do
  env <- standardBook
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  _ <- applyRecords env [acceptance "ACC-AFTER" "S-A2" (D.addDays splitDay 10)]
  let ret d = OcfRecordDataStockRetraction StockRetractionOcfData with id = "RET-S-A2"; date = d; reason_text = ""; security_id = "S-A2"; comments = []
  applyRecordsFails env "precedes a split of stock class CLS-A dated on or before the last event on security S-A2" [ret (D.addDays splitDay (-1))]
  -- After the split, before the lot's last event: the same split epoch.
  _ <- applyRecords env [ret (D.addDays splitDay 1)]
  hasState env "S-A2" >>= (=== False)

-- =============================================================================
-- SPLITS A LOT HAS NOT COUNTED
-- =============================================================================

-- Two splits on one date with an event on a lot between them: the lot counted the first at that
-- event and counts the second at its next one. A lot catches up on every split of its class it has
-- not counted, by its split epoch, so each applies exactly once, in the order recorded, and a later
-- transfer moves the lot in the units of both.
test_splits_same_date_split_after_an_event_on_that_date : Script ()
test_splits_same_date_split_after_an_event_on_that_date = do
  env <- standardBook
  let later = D.addDays splitDay 2
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  _ <- applyRecords env [acceptance "ACC-1" "S-A1" splitDay]
  s1 <- stateOf env "S-A1"
  (s1.quantity, s1.split_epoch, s1.last_event_date) === (1200.0, 1, splitDay)
  recordSplit env "SPLIT-2" "CLS-A" 3.0 1.0 splitDay
  let t = StockTransferOcfData with
        id = "TR-1"; date = later; security_id = "S-A1"; quantity = 1000.0
        resulting_security_ids = ["S-A1-T"]; balance_security_id = Some "S-A1-B"
        comments = []; consideration_text = None
      out q = (issuance "S-A1-T" "SH-B" "CLS-A" q later) with id = "ISS-S-A1-T"
      bal q = (issuance "S-A1-B" "SH-A" "CLS-A" q later) with id = "ISS-S-A1-B"
  -- 600 x 2 x 3 = 3600: a balance in the units of the first split only is refused.
  applyOpsFails env "balance S-A1-B must hold the remaining 2600.0"
    [ApplyStockTransfer with transfer = t; resulting = [out 1000.0]; balance = Some (bal 200.0)]
  _ <- applyOps env [ApplyStockTransfer with transfer = t; resulting = [out 1000.0]; balance = Some (bal 2600.0)]
  hasState env "S-A1" >>= (=== False)
  b <- stateOf env "S-A1-B"
  (b.quantity, b.split_epoch) === (2600.0, 2)
  -- Counted once: a later event applies neither split again.
  _ <- applyRecords env [acceptance "ACC-B" "S-A1-B" (D.addDays later 1)]
  (.quantity) <$> stateOf env "S-A1-B" >>= (=== 2600.0)
  -- A lot with no event between the two splits applies both at once, to the same units.
  _ <- applyRecords env [acceptance "ACC-2" "S-A2" later]
  s2 <- stateOf env "S-A2"
  (s2.quantity, s2.split_epoch) === (2400.0, 2)

-- A split dated on a lot's last event date, recorded after that event: the lot's quantity was
-- written before the split existed, so the lot counts the split at its next event, a cancellation
-- or a hold placement as much as any other.
test_splits_split_dated_on_a_lots_last_event_date : Script ()
test_splits_split_dated_on_a_lots_last_event_date = do
  env <- standardBook
  let later = D.addDays splitDay 1
  _ <- applyRecords env [acceptance "ACC-1" "S-A1" splitDay, acceptance "ACC-2" "S-A2" splitDay]
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  -- Recording the split touches no state.
  s1 <- stateOf env "S-A1"
  (s1.quantity, s1.split_epoch) === (600.0, 0)
  let c q balance = StockCancellationOcfData with
        id = "CXL-1"; date = later; security_id = "S-A1"; quantity = q; reason_text = "Forfeit"
        balance_security_id = balance; comments = []
  applyOpsFails env "event quantity 1201.0 exceeds the 1200.0 of security S-A1"
    [ApplyStockCancellation with cancellation = c 1201.0 None; balance = None]
  _ <- applyOps env [ApplyStockCancellation with
    cancellation = c 200.0 (Some "S-A1-B")
    balance = Some ((issuance "S-A1-B" "SH-A" "CLS-A" 1000.0 later) with id = "ISS-S-A1-B")]
  b <- stateOf env "S-A1-B"
  (b.quantity, b.split_epoch) === (1000.0, 1)
  onDate later
  lot <- settlementLot env "S-A2" 800.0
  _ <- placeHolds env OcfHoldTypeRegisterSettlement "T-1" later [lot]
  s2 <- stateOf env "S-A2"
  (s2.quantity, s2.split_epoch, map (.split_epoch) s2.holds) === (800.0, 1, [1])

-- A settlement hold placed between two splits on one date counted the first: the second voids it,
-- as any split does. The lot is never stuck: the TA cancels the void hold, which counts the second
-- split, and places a new one in its units.
test_splits_same_date_split_voids_a_hold_placed_between : Script ()
test_splits_same_date_split_voids_a_hold_placed_between = do
  env <- standardBook
  let later = D.addDays splitDay 2
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  onDate splitDay
  lot <- settlementLot env "S-A1" 1200.0
  [h] <- placeHolds env OcfHoldTypeRegisterSettlement "T-1" splitDay [lot]
  recordSplit env "SPLIT-2" "CLS-A" 3.0 1.0 splitDay
  onDate later
  draw <- drawLot env "S-A1" 1200.0 1.0 []
  buyer <- SettleBuyerExisting <$> stakeholderCidOf env "SH-B"
  settleFails env "voided hold" "T-1" later buyer [SettleDraw draw]
  _ <- cancelHolds env later [CancelHold with security_id = "S-A1"; hold_id = h.hold_id; reason_text = "voided by SPLIT-2"]
  s <- stateOf env "S-A1"
  (s.quantity, s.split_epoch, s.holds) === (3600.0, 2, [])
  lot' <- settlementLot env "S-A1" 3600.0
  _ <- placeHolds env OcfHoldTypeRegisterSettlement "T-2" later [lot']
  pure ()

-- A terminal event is still refused across a split epoch after the lot catches up: a split dated
-- before the lot's last event (and after the class's latest split) is one the lot has not counted,
-- and a terminal event dated before it would be in other units.
test_splits_catch_up_keeps_backdated_terminal_events_in_epoch : Script ()
test_splits_catch_up_keeps_backdated_terminal_events_in_epoch = do
  env <- standardBook
  recordSplit env "SPLIT-1" "CLS-A" 2.0 1.0 splitDay
  _ <- applyRecords env [acceptance "ACC-AFTER" "S-A2" (D.addDays splitDay 10)]
  recordSplit env "SPLIT-2" "CLS-A" 3.0 1.0 (D.addDays splitDay 5)
  let ret d = OcfRecordDataStockRetraction StockRetractionOcfData with id = "RET-S-A2"; date = d; reason_text = ""; security_id = "S-A2"; comments = []
      c q = StockCancellationOcfData with
        id = "CXL-S-A2"; date = D.addDays splitDay 6; security_id = "S-A2"; quantity = q; reason_text = "Forfeit"
        balance_security_id = None; comments = []
  applyRecordsFails env "precedes a split of stock class CLS-A dated on or before the last event on security S-A2" [ret (D.addDays splitDay 3)]
  -- After both splits, before the lot's last event: 400 x 2 x 3.
  applyOpsFails env "event quantity 2401.0 exceeds the 2400.0 of security S-A2"
    [ApplyStockCancellation with cancellation = c 2401.0; balance = None]
  _ <- applyOps env [ApplyStockCancellation with cancellation = c 2400.0; balance = None]
  hasState env "S-A2" >>= (=== False)

-- Vesting tranches scale exactly once per split, in the order recorded, whether a lot counts two
-- same-date splits at one event or at two: flooring makes the order matter (1:3 then 3:1 floors).
test_splits_same_date_splits_scale_tranches_once_in_order : Script ()
test_splits_same_date_splits_scale_tranches_once_in_order = do
  env <- standardBook
  let tranches = [(OcfVesting with amount = 40.0; date = D.date 2024 D.Jun 1), (OcfVesting with amount = 60.0; date = D.date 2025 D.Jun 1)]
      later = D.addDays splitDay 2
  _ <- applyRecords env
    [ OcfRecordDataStockIssuance ((issuance "S-X" "SH-A" "CLS-A" 100.0 d2024) with vestings = tranches)
    , OcfRecordDataStockIssuance ((issuance "S-Y" "SH-A" "CLS-A" 100.0 d2024) with vestings = tranches)
    ]
  recordSplit env "SPLIT-1" "CLS-A" 1.0 3.0 splitDay
  _ <- applyRecords env [acceptance "ACC-X1" "S-X" splitDay]
  x1 <- stateOf env "S-X"
  x1.quantity === 33.3333333333
  recordSplit env "SPLIT-2" "CLS-A" 3.0 1.0 splitDay
  _ <- applyRecords env [acceptance "ACC-X2" "S-X" later, acceptance "ACC-Y" "S-Y" later]
  x <- stateOf env "S-X"
  y <- stateOf env "S-Y"
  let expected = StockVestingTranches
        [ OcfVesting with amount = 39.9999999999; date = D.date 2024 D.Jun 1
        , OcfVesting with amount = 60.0; date = D.date 2025 D.Jun 1
        ]
  (x.quantity, x.split_epoch, x.vesting) === (99.9999999999, 2, expected)
  (y.quantity, y.split_epoch, y.vesting) === (x.quantity, x.split_epoch, x.vesting)
  _ <- applyRecords env [acceptance "ACC-X3" "S-X" (D.addDays later 1)]
  x' <- stateOf env "S-X"
  (x'.quantity, x'.vesting) === (x.quantity, x.vesting)
