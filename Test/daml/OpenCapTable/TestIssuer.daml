-- The issuer record and its authorized-shares adjustments, ported from v34's TestIssuer and TestIssuerAuthorizedSharesAdjustment: the issuer written with the cap table and edited by restatement, every validator branch, and the adjustment's issuer reference.
module OpenCapTable.TestIssuer where

import DA.Assert ((===))
import qualified DA.Date as D
import DA.Action (foldlA)
import DA.List (head, tail)
import qualified DA.Map as Map
import Daml.Script

import Fairmint.OpenCapTable.IssuerAuthorization
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.OcpFactory
import Fairmint.OpenCapTable.Restate hiding (restate)
import Fairmint.OpenCapTable.Types.Contact
import Fairmint.OpenCapTable.Types.Stock (OcfAuthorizedShares(..), OcfInitialSharesAuthorized(..))
import Fairmint.OpenCapTable.OCF.Issuer
import Fairmint.OpenCapTable.OCF.IssuerAuthorizedSharesAdjustment
import OpenCapTable.DefinitionFixtures
import OpenCapTable.Harness

-- =============================================================================
-- FIXTURES
-- =============================================================================

-- | An issuer with every optional field and array populated (v34 testCreateIssuerWithOptionalsSome).
fullIssuer : IssuerOcfData
fullIssuer = issuerData with
  id = "ISSUER_OPT_SOME"
  legal_name = "Acme Incorporated"
  formation_date = D.date 2010 D.Jun 1
  dba = Some "Acme"
  country_subdivision_of_formation = Some "CA"
  country_subdivision_name_of_formation = None
  tax_ids = [OcfTaxID with tax_id = "12-3456789"; country = "US"]
  email = Some OcfEmail with email_type = OcfEmailTypeBusiness; email_address = "info@acme.example"
  phone = Some OcfPhone with phone_type = OcfPhoneTypeBusiness; phone_number = "+1 555 0100"
  address = Some OcfAddress with
    address_type = OcfAddressTypeLegal
    country = "US"
    city = Some "SF"
    country_subdivision = Some "CA"
    postal_code = Some "94105"
    street_suite = Some "1 Market St"
  initial_shares_authorized = Some (OcfInitialSharesNumeric 2000000.0)
  comments = ["Seed stage"]

-- | A TA-accepted authorization for another cap table with the same parties, ready for the issuer,
-- and the env with the factory's successor.
acceptedAuthorization : Env -> Script (Env, ContractId IssuerAuthorization)
acceptedAuthorization env = do
  auth <- submit env.system_operator do
    exerciseCmd env.factory OcpFactory_AuthorizeIssuer with issuer = env.issuer; transfer_agent = env.transfer_agent
  accepted <- submit env.transfer_agent do exerciseCmd auth.authorization IssuerAuthorization_TaAccept
  pure ((env with factory = auth.factory), accepted)

createWithIssuer : Env -> ContractId IssuerAuthorization -> IssuerOcfData -> Script IssuerAuthorization_CreateCapTableResult
createWithIssuer env auth d = submit env.issuer do
  exerciseCmd auth IssuerAuthorization_CreateCapTable with transfer_agent = env.transfer_agent; issuer_data = d

-- | Creating a cap table with this issuer data fails on the issuer's `ensure`, and the validator agrees.
refuseIssuer : Env -> ContractId IssuerAuthorization -> IssuerOcfData -> Script ()
refuseIssuer env auth d = do
  assertMsg ("the validator accepted " <> show d) (not (validateIssuerOcfData d))
  expectSubmitFailure "precondition" env.issuer
    (exerciseCmd auth IssuerAuthorization_CreateCapTable with transfer_agent = env.transfer_agent; issuer_data = d)

adjustment : Text -> Text -> Decimal -> IssuerAuthorizedSharesAdjustmentOcfData
adjustment id issuerId shares = IssuerAuthorizedSharesAdjustmentOcfData with
  id
  date = D.date 2024 D.Jan 1
  issuer_id = issuerId
  new_shares_authorized = shares
  comments = []
  board_approval_date = None
  stockholder_approval_date = None

-- =============================================================================
-- ISSUER
-- =============================================================================

-- v34 testCreateAndArchiveIssuer / testCreateAndArchiveIssuerBuiltIn: the factory flow writes the
-- issuer record with the cap table.
test_issuer_written_with_the_cap_table : Script ()
test_issuer_written_with_the_cap_table = do
  env <- setupEnv
  expectRecord env (OcfRecordDataIssuer issuerData)
  rcid <- recordCidOf env issuerId
  rcid === OcfRecordCidIssuer env.issuer_record
  Some i <- queryContractId env.transfer_agent env.issuer_record
  i.context === env.ctx

-- v34 testCreateIssuerWithOptionalsSome.
test_issuer_all_optional_fields : Script ()
test_issuer_all_optional_fields = do
  env0 <- setupEnv
  (env, auth) <- acceptedAuthorization env0
  assertMsg "the validator refused the full issuer" (validateIssuerOcfData fullIssuer)
  created <- createWithIssuer env auth fullIssuer
  Some i <- queryContractId env.transfer_agent created.issuer
  i.ocf_data === fullIssuer
  i.context.issuer === env.issuer
  i.context.transfer_agent === env.transfer_agent

test_issuer_validation : Script ()
test_issuer_validation = do
  env0 <- setupEnv
  (env, auth) <- acceptedAuthorization env0
  let no = refuseIssuer env auth
      base = fullIssuer
  no base with id = ""
  no base with legal_name = ""
  -- ISO 3166-1 alpha-2 countries
  no base with country_of_formation = "USA"
  no base with country_of_formation = "XX"
  no base with country_of_formation = ""
  -- A subdivision code of 1-3 characters, or a non-empty name, not both
  no base with country_subdivision_of_formation = Some ""
  no base with country_subdivision_of_formation = Some "ABCD"
  no base with country_subdivision_of_formation = Some "CA"; country_subdivision_name_of_formation = Some "California"
  no base with country_subdivision_of_formation = None; country_subdivision_name_of_formation = Some ""
  -- Optional text and contacts
  no base with dba = Some ""
  no base with email = Some (OcfEmail with email_type = OcfEmailTypeBusiness; email_address = "acme.example")
  no base with phone = Some (OcfPhone with phone_type = OcfPhoneTypeBusiness; phone_number = "")
  no base with address = Some (OcfAddress with address_type = OcfAddressTypeLegal; country = "ZZ"; city = None; country_subdivision = None; postal_code = None; street_suite = None)
  no base with comments = [""]
  no base with tax_ids = [OcfTaxID with tax_id = "12-3456789"; country = "U"]
  no base with initial_shares_authorized = Some (OcfInitialSharesNumeric (-1.0))
  -- The boundaries that pass, each a new cap table: a subdivision name alone, zero, enum and absent
  -- authorized shares, a three-letter code.
  let passing =
        [ base with country_subdivision_of_formation = None; country_subdivision_name_of_formation = Some "California"
        , base with initial_shares_authorized = Some (OcfInitialSharesNumeric 0.0)
        , base with initial_shares_authorized = Some (OcfInitialSharesEnum OcfAuthorizedSharesUnlimited)
        , base with initial_shares_authorized = Some (OcfInitialSharesEnum OcfAuthorizedSharesNotApplicable)
        , base with initial_shares_authorized = None; country_subdivision_of_formation = Some "NSW"
        ]
  -- The pending authorization takes the first; each other gets its own.
  assertMsg "the validator refused the first passing issuer" (validateIssuerOcfData (head passing))
  created <- createWithIssuer env auth (head passing)
  Some i <- queryContractId env.transfer_agent created.issuer
  i.ocf_data === head passing
  _ <- foldlA (\e d -> do
      assertMsg ("the validator refused " <> show d) (validateIssuerOcfData d)
      (e', a) <- acceptedAuthorization e
      c <- createWithIssuer e' a d
      Some i <- queryContractId e'.transfer_agent c.issuer
      i.ocf_data === d
      pure e')
    env (tail passing)
  pure ()

-- v34 testEditIssuerViaBatch.
test_issuer_edit : Script ()
test_issuer_edit = do
  env <- setupEnv
  let edited = issuerData with
        legal_name = "Test Corp Updated"
        dba = Some "Updated DBA"
        comments = ["Edited via CapTable_Restate"]
  r <- restateOps env [RestateEdit (OcfRecordDataIssuer edited)]
  Map.keys r.records === [issuerId]
  expectRecord env (OcfRecordDataIssuer edited)
  -- The edit replaced the record: the old contract is archived.
  queryContractId env.transfer_agent env.issuer_record >>= (=== None)
  -- An edit is validated like a create.
  restateOpsFails env "precondition" [RestateEdit (OcfRecordDataIssuer edited with country_of_formation = "XX")]
  restateOpsFails env "changes nothing" [RestateEdit (OcfRecordDataIssuer edited)]

-- v34 testMultipleIssuerEditsRejected.
test_issuer_edited_once_per_restatement : Script ()
test_issuer_edited_once_per_restatement = do
  env <- setupEnv
  restateOpsFails env "edited or deleted more than once"
    [ RestateEdit (OcfRecordDataIssuer issuerData with legal_name = "Test Corp First Edit")
    , RestateEdit (OcfRecordDataIssuer issuerData with legal_name = "Test Corp Second Edit")
    ]
  expectRecord env (OcfRecordDataIssuer issuerData)

-- v34 testIssuerIdMismatchRejected: an edit names its record by object ID, so another ID finds none.
test_issuer_id_cannot_change : Script ()
test_issuer_id_cannot_change = do
  env <- setupEnv
  restateOpsFails env "record DIFFERENT_ISSUER_ID is not in this write"
    [RestateEdit (OcfRecordDataIssuer issuerData with id = "DIFFERENT_ISSUER_ID")]
  expectRecord env (OcfRecordDataIssuer issuerData)

test_issuer_not_written_by_apply : Script ()
test_issuer_not_written_by_apply = do
  env <- setupEnv
  applyRecordsFails env "the issuer record is written when the cap table is created"
    [OcfRecordDataIssuer issuerData with id = "ISSUER-2"]
  expectNoRecord env "ISSUER-2"

-- =============================================================================
-- ISSUER AUTHORIZED SHARES ADJUSTMENT
-- =============================================================================

-- v34 testCreateAndArchiveIssuerAuthorizedSharesAdjustment(BuiltIn) and _OptionalsSome.
test_issuer_authorized_shares_adjustment : Script ()
test_issuer_authorized_shares_adjustment = do
  env <- setupEnv
  let ok = accept env validateIssuerAuthorizedSharesAdjustmentOcfData OcfRecordDataIssuerAuthorizedSharesAdjustment
      plain = adjustment "TX_ISSUER_AUTH_SHARES_ADJ_1" issuerId 2000.0
      full = (adjustment "TX_ISSUER_AUTH_SHARES_ADJ_2" issuerId 2500.0) with
        date = D.date 2024 D.Jan 2
        board_approval_date = Some (D.date 2024 D.Jan 3)
        stockholder_approval_date = Some (D.date 2024 D.Jan 4)
        comments = ["Increase"]
  ok plain
  ok full
  ok (adjustment "TX_ISSUER_AUTH_SHARES_ADJ_0" issuerId 0.0)
  -- Edit and delete.
  let edited = plain with new_shares_authorized = 3000.0
  _ <- restateOps env [RestateEdit (OcfRecordDataIssuerAuthorizedSharesAdjustment edited), RestateDelete "TX_ISSUER_AUTH_SHARES_ADJ_2"]
  expectRecord env (OcfRecordDataIssuerAuthorizedSharesAdjustment edited)
  expectNoRecord env "TX_ISSUER_AUTH_SHARES_ADJ_2"

test_issuer_authorized_shares_adjustment_validation : Script ()
test_issuer_authorized_shares_adjustment_validation = do
  env <- setupEnv
  let no = refuse env validateIssuerAuthorizedSharesAdjustmentOcfData OcfRecordDataIssuerAuthorizedSharesAdjustment
      base = adjustment "TX_BAD" issuerId 2000.0
  no base with new_shares_authorized = -1.0
  no base with issuer_id = ""
  no base with comments = [""]

-- v34 testIssuerAuthorizedSharesAdjustment_WrongIssuerId{Create,Edit}Fails.
test_issuer_authorized_shares_adjustment_issuer_reference : Script ()
test_issuer_authorized_shares_adjustment_issuer_reference = do
  env <- setupEnv
  _ <- applyRecords env [OcfRecordDataStakeholder (stakeholderData "SH-1")]
  applyRecordsFails env "Issuer authorized shares adjustment issuer not found: OTHER_ISSUER"
    [OcfRecordDataIssuerAuthorizedSharesAdjustment (adjustment "TX_BAD_ISSUER_ID" "OTHER_ISSUER" 2000.0)]
  applyRecordsFails env "Issuer authorized shares adjustment issuer SH-1 is a OcfObjectTypeStakeholder"
    [OcfRecordDataIssuerAuthorizedSharesAdjustment (adjustment "TX_BAD_ISSUER_ID" "SH-1" 2000.0)]
  let good = adjustment "TX_ISSUER_AUTH_SHARES_ADJ_1" issuerId 2000.0
  _ <- applyRecords env [OcfRecordDataIssuerAuthorizedSharesAdjustment good]
  restateOpsFails env "Issuer authorized shares adjustment issuer not found: OTHER_ISSUER"
    [RestateEdit (OcfRecordDataIssuerAuthorizedSharesAdjustment good with issuer_id = "OTHER_ISSUER")]
  expectRecord env (OcfRecordDataIssuerAuthorizedSharesAdjustment good)

