-- Equity compensation releases, ported from v34's TestEquityCompensationRelease: RSU releases into resulting stock issuances, the validator (Date settlement date, release price, at least one resulting security), and the security and resulting-security references.
module OpenCapTable.TestEquityCompensationRelease where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationRelease
import OpenCapTable.EquityFixtures
import OpenCapTable.Harness

valid : EquityCompensationReleaseOcfData -> Bool
valid = validateEquityCompensationReleaseOcfData

wrap : EquityCompensationReleaseOcfData -> OcfRecordData
wrap = OcfRecordDataEquityCompensationRelease

release : Text -> Text -> Decimal -> [Text] -> EquityCompensationReleaseOcfData
release id sec q resulting = EquityCompensationReleaseOcfData with
  id
  date = D.date 2024 D.Jul 1
  quantity = q
  release_price = usd 52.0
  security_id = sec
  settlement_date = D.date 2024 D.Jul 5
  comments = []
  resulting_security_ids = resulting
  consideration_text = None

released : Text -> Decimal -> Date -> OcfRecordData
released sec q d = OcfRecordDataStockIssuance (issuance sec "SH-A" "CLS-A" q d)

-- | A book with Alice's RSU grant `sec` over `q` units of class CLS-A.
grantBook : Text -> Decimal -> Script Env
grantBook sec q = ecBookWith [ecRecord ((rsu sec "SH-A" q) with stock_class_id = Some "CLS-A")]

test_ec_release_rsu_cliff : Script ()
test_ec_release_rsu_cliff = do
  env <- grantBook "SEC_RSU_001" 20000.0
  let r = EquityCompensationReleaseOcfData with
        id = "TX_EC_RELEASE_1"
        date = D.date 2024 D.Apr 1
        security_id = "SEC_RSU_001"
        settlement_date = D.date 2024 D.Apr 3
        release_price = OcfMonetary with amount = 45.5; currency = "USD"
        quantity = 5000.0
        resulting_security_ids = ["SEC_STOCK_101"]
        consideration_text = Some "RSU cliff vest - 25% of total grant"
        comments = ["First anniversary cliff vest for Employee A"]
  _ <- applyRecords env [released "SEC_STOCK_101" 5000.0 (D.date 2024 D.Apr 3), wrap r]
  expectRecord env (wrap r)
  (.quantity) <$> stateOf env "SEC_STOCK_101" >>= (=== 5000.0)

test_ec_release_quarterly_net_settlement : Script ()
test_ec_release_quarterly_net_settlement = do
  env <- grantBook "SEC_RSU_002" 5000.0
  let r = (release "TX_EC_RELEASE_2" "SEC_RSU_002" 1250.0 ["SEC_STOCK_102", "SEC_STOCK_103"]) with
        comments = ["Q3 2024 quarterly vest", "Net settlement after tax withholding"]
  _ <- applyRecords env
    [ wrap r
    , released "SEC_STOCK_102" 625.0 (D.date 2024 D.Jul 5)
    , released "SEC_STOCK_103" 625.0 (D.date 2024 D.Jul 5)
    ]
  expectRecord env (wrap r)

-- v36 settlement dates are Dates; the register does not order them against the release date.
test_ec_release_settlement_date_is_a_date : Script ()
test_ec_release_settlement_date_is_a_date = do
  env <- grantBook "RSU-1" 100.0
  _ <- applyRecords env [released "S-1" 10.0 d2024]
  accept env valid wrap ((release "REL-1" "RSU-1" 10.0 ["S-1"]) with settlement_date = D.date 2024 D.Jul 1)
  accept env valid wrap ((release "REL-2" "RSU-1" 10.0 ["S-1"]) with settlement_date = D.date 2024 D.Jun 28)

test_ec_release_security_reference : Script ()
test_ec_release_security_reference = do
  env <- grantBook "RSU-1" 100.0
  _ <- applyRecords env [released "S-1" 10.0 d2024]
  applyRecordsFails env "Equity compensation release security not found: RSU-MISSING" [wrap (release "REL-1" "RSU-MISSING" 1.0 ["S-1"])]
  applyRecordsFails env "Equity compensation release security S-1 is carried by a OcfObjectTypeTxStockIssuance" [wrap (release "REL-1" "S-1" 1.0 ["S-1"])]
  expectNoRecord env "REL-1"

test_ec_release_resulting_securities_are_stock : Script ()
test_ec_release_resulting_securities_are_stock = do
  env <- grantBook "RSU-1" 100.0
  _ <- applyRecords env [ecRecord (rsu "RSU-2" "SH-A" 10.0)]
  applyRecordsFails env "Equity compensation release resulting security security not found: S-X" [wrap (release "REL-1" "RSU-1" 10.0 ["S-X"])]
  applyRecordsFails env "Equity compensation release resulting security security RSU-2 is carried by a OcfObjectTypeTxEquityCompensationIssuance"
    [wrap (release "REL-1" "RSU-1" 10.0 ["RSU-2"])]
  expectNoRecord env "REL-1"

test_ec_release_validation : Script ()
test_ec_release_validation = do
  env <- grantBook "RSU-1" 100.0
  let r = release "REL-V" "RSU-1" 10.0 ["S-1"]
  refuseWith env "an empty ID cannot be claimed" valid wrap (r with id = "")
  refuse env valid wrap (r with security_id = "")
  refuse env valid wrap (r with quantity = 0.0)
  refuse env valid wrap (r with quantity = -10.0)
  refuse env valid wrap (r with release_price = usd (-1.0))
  refuse env valid wrap (r with release_price = OcfMonetary with amount = 52.0; currency = "us")
  -- A release results in at least one security, none of them empty.
  refuse env valid wrap (r with resulting_security_ids = [])
  refuse env valid wrap (r with resulting_security_ids = ["S-1", ""])
  refuse env valid wrap (r with comments = [""])
  refuse env valid wrap (r with consideration_text = Some "")

test_ec_release_restate : Script ()
test_ec_release_restate = do
  env <- grantBook "RSU-1" 100.0
  let r = release "REL-1" "RSU-1" 10.0 ["S-1"]
  _ <- applyRecords env [released "S-1" 10.0 d2024, wrap r]
  restateOpsFails env "changes nothing" [RestateEdit (wrap r)]
  let r' = r with release_price = usd 50.0
  _ <- restateOps env [RestateEdit (wrap r')]
  expectRecord env (wrap r')
  _ <- restateOps env [RestateDelete "REL-1"]
  expectNoRecord env "REL-1"
