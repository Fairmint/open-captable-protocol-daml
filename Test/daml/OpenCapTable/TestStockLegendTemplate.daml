-- Stock legend templates, ported from v34's TestStockLegendTemplate: writes, edits and deletes, and every validator branch.
module OpenCapTable.TestStockLegendTemplate where

import DA.Assert ((===))
import qualified DA.Map as Map
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.OCF.StockLegendTemplate
import OpenCapTable.DefinitionFixtures
import OpenCapTable.Harness

standardLegend : StockLegendTemplateOcfData
standardLegend = StockLegendTemplateOcfData with
  id = "LEG_STD"
  name = "Standard Legend"
  text = "THIS SECURITY HAS NOT BEEN REGISTERED..."
  comments = []

-- v34 testCreateStockLegendTemplate and testStockLegendTemplate_OptionalsSome.
test_stock_legend_template_create : Script ()
test_stock_legend_template_create = do
  env <- setupEnv
  r <- applyRecords env [OcfRecordDataStockLegendTemplate standardLegend]
  Map.keys r.records === ["LEG_STD"]
  expectRecord env (OcfRecordDataStockLegendTemplate standardLegend)
  accept env validateStockLegendTemplateOcfData OcfRecordDataStockLegendTemplate StockLegendTemplateOcfData with
    id = "LEG_EXT"
    name = "Extended Legend"
    text = "EXTENDED LEGEND TEXT"
    comments = ["Longer legend text"]

-- v34 testCreateAndDeleteStockLegendTemplate and testEditStockLegendTemplate.
test_stock_legend_template_edit_and_delete : Script ()
test_stock_legend_template_edit_and_delete = do
  env <- setupEnv
  let original = standardLegend with id = "LEG_EDIT"; name = "Original Legend"; text = "ORIGINAL TEXT"
      updated = original with name = "Updated Legend"; text = "UPDATED TEXT"; comments = ["Updated"]
  _ <- applyRecords env [OcfRecordDataStockLegendTemplate original, OcfRecordDataStockLegendTemplate standardLegend]
  _ <- restateOps env [RestateEdit (OcfRecordDataStockLegendTemplate updated)]
  expectRecord env (OcfRecordDataStockLegendTemplate updated)
  restateOpsFails env "changes nothing" [RestateEdit (OcfRecordDataStockLegendTemplate updated)]
  restateOpsFails env "precondition" [RestateEdit (OcfRecordDataStockLegendTemplate (updated with text = ""))]
  _ <- restateOps env [RestateDelete "LEG_STD"]
  expectNoRecord env "LEG_STD"
  expectRecord env (OcfRecordDataStockLegendTemplate updated)
  -- The ID is free again.
  _ <- applyRecords env [OcfRecordDataStockLegendTemplate standardLegend]
  expectRecord env (OcfRecordDataStockLegendTemplate standardLegend)

test_stock_legend_template_validation : Script ()
test_stock_legend_template_validation = do
  env <- setupEnv
  let no = refuse env validateStockLegendTemplateOcfData OcfRecordDataStockLegendTemplate
  no standardLegend with name = ""
  no standardLegend with text = ""
  no standardLegend with comments = ["a", ""]
  applyRecordsFails env "an empty ID cannot be claimed" [OcfRecordDataStockLegendTemplate (standardLegend with id = "")]
  applyRecordsFails env "ID already used: LEG_STD"
    [OcfRecordDataStockLegendTemplate standardLegend, OcfRecordDataStockLegendTemplate (standardLegend with name = "Twin")]
