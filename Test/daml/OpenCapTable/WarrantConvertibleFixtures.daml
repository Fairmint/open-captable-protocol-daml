-- Fixtures and ACS readers for the v36 warrant, convertible, conversion-mechanism and instrument-terms test modules: issuances with their triggers and rights, vesting terms, record payloads by object ID, and the edit and delete rules every record type shares.
module OpenCapTable.WarrantConvertibleFixtures where

import DA.Action (unless, when)
import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.Types.Conversion
import Fairmint.OpenCapTable.Types.Stock (OcfRatio(..))
import Fairmint.OpenCapTable.Types.Vesting (OcfCompensationType(..))
import Fairmint.OpenCapTable.OCF.ConvertibleIssuance (ConvertibleIssuanceOcfData(..), OcfConvertibleConversionTrigger(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationIssuance (EquityCompensationIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingTerms (OcfAllocationType(..), OcfVestingCondition(..), OcfVestingConditionPortion(..), OcfVestingTrigger(..), VestingTermsOcfData(..))
import Fairmint.OpenCapTable.OCF.WarrantIssuance (WarrantIssuanceOcfData(..))
import OpenCapTable.Harness

-- =============================================================================
-- BOOKS AND DATES
-- =============================================================================

-- | The standard book plus warrant W-1 (100 units, issuance WI-1) and convertible C-1 (100,000 USD,
-- issuance CI-1), both held by SH-A and issued on 2024-01-01.
instrumentBook : Script Env
instrumentBook = do
  env <- standardBook
  _ <- applyRecords env
    [ OcfRecordDataWarrantIssuance (warrantIssuance "WI-1" "W-1" "SH-A")
    , OcfRecordDataConvertibleIssuance (convertibleIssuance "CI-1" "C-1" "SH-A")
    ]
  pure env

-- | The date of the events the modules write on W-1 and C-1.
eventDate : Date
eventDate = D.date 2024 D.Mar 1

-- =============================================================================
-- CONVERSION RIGHTS AND TRIGGERS
-- =============================================================================

warrantTriggerId : Text
warrantTriggerId = "WR-AT-WILL"

convertibleTriggerId : Text
convertibleTriggerId = "CV-AT-WILL"

customMechanism : Text -> OcfCustomConversionMechanism
customMechanism description = OcfCustomConversionMechanism with custom_conversion_description = description

warrantRight : OcfWarrantConversionMechanism -> Optional Text -> OcfWarrantConversionRight
warrantRight mechanism target = OcfWarrantConversionRight with
  conversion_mechanism = mechanism
  converts_to_future_round = None
  converts_to_stock_class_id = target

convertibleRight : OcfConvertibleConversionMechanism -> Optional Text -> OcfConvertibleConversionRight
convertibleRight mechanism target = OcfConvertibleConversionRight with
  conversion_mechanism = mechanism
  converts_to_future_round = None
  converts_to_stock_class_id = target

-- | A one-for-one ratio right at 1.00 USD a share, the only mechanism a stock class right has.
ratioMechanism : OcfRatioConversionMechanism
ratioMechanism = OcfRatioConversionMechanism with
  conversion_price = usd 1.0
  ratio = OcfRatio with numerator = 1.0; denominator = 1.0
  rounding_type = OcfRoundingTypeNormal

stockClassRight : Optional Text -> OcfStockClassConversionRight
stockClassRight target = OcfStockClassConversionRight with
  conversion_mechanism = ratioMechanism
  converts_to_future_round = None
  converts_to_stock_class_id = target

-- | A warrant exercise trigger of the given type with no dates, condition, nickname or description.
warrantTrigger : Text -> OcfConversionTriggerType -> OcfAnyConversionRight -> OcfConversionTrigger
warrantTrigger triggerId triggerType right = OcfConversionTrigger with
  conversion_right = right
  trigger_id = triggerId
  type_ = triggerType
  end_date = None
  nickname = None
  start_date = None
  trigger_condition = None
  trigger_date = None
  trigger_description = None

-- | An elective-at-will warrant trigger with a custom warrant right and no conversion target.
atWillWarrantTrigger : Text -> OcfConversionTrigger
atWillWarrantTrigger triggerId =
  warrantTrigger triggerId OcfConversionTriggerTypeElectiveAtWill
    (OcfRightWarrant (warrantRight (OcfWarrantMechanismCustom (customMechanism "Custom")) None))

-- | A convertible conversion trigger of the given type with no dates, condition, nickname or description.
convertibleTrigger : Text -> OcfConversionTriggerType -> OcfConvertibleConversionRight -> OcfConvertibleConversionTrigger
convertibleTrigger triggerId triggerType right = OcfConvertibleConversionTrigger with
  conversion_right = right
  trigger_id = triggerId
  type_ = triggerType
  end_date = None
  nickname = None
  start_date = None
  trigger_condition = None
  trigger_date = None
  trigger_description = None

-- | An elective-at-will convertible trigger with a custom right and no conversion target.
atWillConvertibleTrigger : Text -> OcfConvertibleConversionTrigger
atWillConvertibleTrigger triggerId =
  convertibleTrigger triggerId OcfConversionTriggerTypeElectiveAtWill
    (convertibleRight (OcfConvMechCustom (customMechanism "Custom")) None)

-- | The automatic-on-date convertible trigger AUTO_DATE, firing on `d`, with a custom right and no
-- conversion target.
autoOnDateConvertibleTrigger : Date -> OcfConvertibleConversionTrigger
autoOnDateConvertibleTrigger d =
  (convertibleTrigger "AUTO_DATE" OcfConversionTriggerTypeAutomaticOnDate
    (convertibleRight (OcfConvMechCustom (customMechanism "Custom")) None)) with trigger_date = Some d

