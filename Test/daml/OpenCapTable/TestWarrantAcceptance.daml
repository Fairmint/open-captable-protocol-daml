-- Warrant acceptances through CapTable_Update: a record on the warrant's security, checked against a warrant issuance in the write's inputs, with the acceptance validator and the shared edit and delete rules.
module OpenCapTable.TestWarrantAcceptance where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.Apply hiding (applyOperation)
import Fairmint.OpenCapTable.CapTable
import Fairmint.OpenCapTable.Update (UpdateOperation(..))
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.OCF.WarrantAcceptance (WarrantAcceptanceOcfData(..), validateWarrantAcceptanceOcfData)
import OpenCapTable.Harness
import OpenCapTable.WarrantConvertibleFixtures

acceptance : Text -> Text -> Date -> WarrantAcceptanceOcfData
acceptance id sec d = WarrantAcceptanceOcfData with id; date = d; security_id = sec; comments = []

wa : WarrantAcceptanceOcfData -> OcfRecordData
wa = OcfRecordDataWarrantAcceptance

test_warrant_acceptance_create : Script ()
test_warrant_acceptance_create = do
  env <- instrumentBook
  let a = acceptance "TX_WARRANT_ACCEPT_1" "W-1" (D.date 2024 D.Jan 2)
  _ <- applyRecords env [wa a]
  expectRecord env (wa a)
  viewSecurityIds env "TX_WARRANT_ACCEPT_1" >>= (=== ["W-1"])
  -- The warrant keeps its issuance record and has no stock state.
  hasRecord env "WI-1" >>= (=== True)
  hasState env "W-1" >>= (=== False)
  applyRecordsFails env "ID already used: TX_WARRANT_ACCEPT_1" [OcfRecordDataStakeholder (stakeholderData "TX_WARRANT_ACCEPT_1")]

test_warrant_acceptance_with_comments : Script ()
test_warrant_acceptance_with_comments = do
  env <- instrumentBook
  let a = (acceptance "TX_WARRANT_ACCEPT_2" "W-1" (D.date 2024 D.Jan 3)) with
        comments = ["Warrant certificate delivered", "Holder acknowledged terms"]
  _ <- applyRecords env [wa a]
  expectRecord env (wa a)

test_warrant_acceptance_security_reference : Script ()
test_warrant_acceptance_security_reference = do
  env <- instrumentBook
  applyRecordsFails env "Warrant acceptance security not found: W-NONE" [wa (acceptance "WA-1" "W-NONE" eventDate)]
  -- The security must be a warrant's.
  applyRecordsFails env "Warrant acceptance security C-1 is carried by a OcfObjectTypeTxConvertibleIssuance" [wa (acceptance "WA-1" "C-1" eventDate)]
  applyRecordsFails env "Warrant acceptance security S-A1 is carried by a OcfObjectTypeTxStockIssuance" [wa (acceptance "WA-1" "S-A1" eventDate)]
  -- An object ID is not a security ID.
  applyRecordsFails env "Warrant acceptance security not found: WI-1" [wa (acceptance "WA-1" "WI-1" eventDate)]
  -- The warrant may be issued later in the same batch.
  let a = acceptance "WA-2" "W-2" eventDate
  _ <- applyRecords env [wa a, OcfRecordDataWarrantIssuance (warrantIssuance "WI-2" "W-2" "SH-B")]
  expectRecord env (wa a)

-- The referenced issuance must be among the write's inputs.
test_warrant_acceptance_needs_issuance_in_inputs : Script ()
test_warrant_acceptance_needs_issuance_in_inputs = do
  env <- instrumentBook
  inputs <- allInputs env
  wiCid <- recordCidOf env "WI-1"
  let a = acceptance "WA-1" "W-1" eventDate
  expectSubmitFailure "Warrant acceptance security not found: W-1" env.transfer_agent
    (exerciseCmd env.cap_table CapTable_Update with
      inputs = inputs with records = filter (/= wiCid) inputs.records
      operations = [UpdateCreate (ApplyRecord (wa a))])
  _ <- applyWith env (inputs with records = [wiCid]) [ApplyRecord (wa a)]
  expectRecord env (wa a)

test_warrant_acceptance_validator : Script ()
test_warrant_acceptance_validator = do
  env <- instrumentBook
  let base = acceptance "WA-V" "W-1" eventDate
  expectValid "base" (validateWarrantAcceptanceOcfData base)
  expectInvalid "empty id" (validateWarrantAcceptanceOcfData base with id = "")
  expectInvalid "empty security_id" (validateWarrantAcceptanceOcfData base with security_id = "")
  expectInvalid "empty comment" (validateWarrantAcceptanceOcfData base with comments = [""])
  applyRecordsFails env "an empty ID cannot be claimed" [wa base with id = ""]
  applyRecordsFails env "precondition" [wa base with security_id = ""]
  applyRecordsFails env "precondition" [wa base with comments = ["ok", ""]]

test_warrant_acceptance_edit_and_delete : Script ()
test_warrant_acceptance_edit_and_delete = do
  env <- instrumentBook
  let a = acceptance "WA-1" "W-1" eventDate
  _ <- applyRecords env [wa a]
  restateOpsFails env "precondition" [RestateEdit (wa a with comments = [""])]
  restateOpsFails env "Warrant acceptance security not found: W-NONE" [RestateEdit (wa a with security_id = "W-NONE")]
  checkEditAndDelete env (wa a) (wa a with date = D.date 2024 D.Mar 2; comments = ["Re-dated"])
