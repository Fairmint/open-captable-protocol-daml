-- Security IDs on events: a stock event needs the security's stock state; a warrant, convertible or equity-compensation event needs an issuance of its own instrument carrying the ID; and security IDs are unique across instruments.
module OpenCapTable.TestSecurityIdValidation where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.Apply hiding (apply)
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.OCF.StockIssuance (StockIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockTransfer (StockTransferOcfData(..))
import OpenCapTable.Harness
import OpenCapTable.StockHelpers

transferOn : Text -> Decimal -> [Text] -> StockTransferOcfData
transferOn sec q resulting = StockTransferOcfData with
  id = "TX_TRANSFER_1"; date = D.date 2024 D.Jan 1; security_id = sec; quantity = q; comments = []
  resulting_security_ids = resulting; balance_security_id = None; consideration_text = None

stockTransferOp : StockTransferOcfData -> [StockIssuanceOcfData] -> ApplyOperation
stockTransferOp t rs = ApplyStockTransfer with transfer = t; resulting = rs; balance = None

newSec : Text -> Decimal -> StockIssuanceOcfData
newSec sec q = (issuance sec "SH-B" "CLS-A" q (D.date 2024 D.Jan 1)) with id = "ISS-" <> sec

-- =============================================================================
-- NON-EXISTENT SECURITY IDS
-- =============================================================================

test_security_ids_stock_transfer_nonexistent_fails : Script ()
test_security_ids_stock_transfer_nonexistent_fails = do
  env <- standardBook
  applyOpsFails env "no active state for security NONEXISTENT-STOCK-SEC in this write"
    [stockTransferOp (transferOn "NONEXISTENT-STOCK-SEC" 50.0 ["NEW-SEC-1"]) [newSec "NEW-SEC-1" 50.0]]

test_security_ids_warrant_transfer_nonexistent_fails : Script ()
test_security_ids_warrant_transfer_nonexistent_fails = do
  env <- standardBook
  applyRecordsFails env "Warrant transfer security not found: NONEXISTENT-WARRANT-SEC"
    [ OcfRecordDataWarrantIssuance (warrantIssuance "NEW-WARRANT-1" "SH-B")
    , OcfRecordDataWarrantTransfer (warrantTransfer "TX_WARRANT_TRANSFER_1" "NONEXISTENT-WARRANT-SEC" ["NEW-WARRANT-1"] None)
    ]

test_security_ids_convertible_transfer_nonexistent_fails : Script ()
test_security_ids_convertible_transfer_nonexistent_fails = do
  env <- standardBook
  applyRecordsFails env "Convertible transfer security not found: NONEXISTENT-CONV-SEC"
    [ OcfRecordDataConvertibleIssuance (convertibleIssuance "NEW-CONV-1" "SH-B")
    , OcfRecordDataConvertibleTransfer (convertibleTransfer "TX_CONV_TRANSFER_1" "NONEXISTENT-CONV-SEC" ["NEW-CONV-1"] None)
    ]

test_security_ids_equity_compensation_transfer_nonexistent_fails : Script ()
test_security_ids_equity_compensation_transfer_nonexistent_fails = do
  env <- standardBook
  applyRecordsFails env "Equity compensation transfer security not found: NONEXISTENT-EC-SEC"
    [ OcfRecordDataEquityCompensationIssuance (equityCompensationIssuance "NEW-EC-1" "SH-B")
    , OcfRecordDataEquityCompensationTransfer (equityCompensationTransfer "TX_EC_TRANSFER_1" "NONEXISTENT-EC-SEC" ["NEW-EC-1"] None)
    ]

-- =============================================================================
-- WRONG INSTRUMENT
-- =============================================================================

test_security_ids_stock_transfer_of_warrant_fails : Script ()
test_security_ids_stock_transfer_of_warrant_fails = do
  env <- instrumentBook
  applyOpsFails env "no active state for security W-1 in this write"
    [stockTransferOp ((transferOn "W-1" 50.0 ["NEW-SEC-1"]) with id = "TX_TRANSFER_WRONG_TYPE") [newSec "NEW-SEC-1" 50.0]]

test_security_ids_warrant_transfer_of_stock_fails : Script ()
test_security_ids_warrant_transfer_of_stock_fails = do
  env <- instrumentBook
  applyRecordsFails env "Warrant transfer security S-A1 is carried by a OcfObjectTypeTxStockIssuance"
    [ OcfRecordDataWarrantIssuance (warrantIssuance "NEW-WARRANT-1" "SH-B")
    , OcfRecordDataWarrantTransfer (warrantTransfer "TX_WARRANT_TRANSFER_WRONG_TYPE" "S-A1" ["NEW-WARRANT-1"] None)
    ]

test_security_ids_convertible_transfer_of_equity_compensation_fails : Script ()
test_security_ids_convertible_transfer_of_equity_compensation_fails = do
  env <- instrumentBook
  applyRecordsFails env "Convertible transfer security EC-1 is carried by a OcfObjectTypeTxEquityCompensationIssuance"
    [ OcfRecordDataConvertibleIssuance (convertibleIssuance "NEW-CONV-1" "SH-B")
    , OcfRecordDataConvertibleTransfer (convertibleTransfer "TX_CONV_TRANSFER_WRONG_TYPE" "EC-1" ["NEW-CONV-1"] None)
    ]

test_security_ids_equity_compensation_transfer_of_convertible_fails : Script ()
test_security_ids_equity_compensation_transfer_of_convertible_fails = do
  env <- instrumentBook
  applyRecordsFails env "Equity compensation transfer security CV-1 is carried by a OcfObjectTypeTxConvertibleIssuance"
    [ OcfRecordDataEquityCompensationIssuance (equityCompensationIssuance "NEW-EC-1" "SH-B")
    , OcfRecordDataEquityCompensationTransfer (equityCompensationTransfer "TX_EC_TRANSFER_WRONG_TYPE" "CV-1" ["NEW-EC-1"] None)
    ]

-- =============================================================================
-- VALID SECURITY IDS
-- =============================================================================

test_security_ids_stock_transfer_correct_id_succeeds : Script ()
test_security_ids_stock_transfer_correct_id_succeeds = do
  env <- standardBook
  let t = (transferOn "S-A2" 400.0 ["NEW-SEC-1"]) with id = "TX_TRANSFER_VALID"
      r = (newSec "NEW-SEC-1" 400.0) with id = "TX_TRANSFER_VALID_RESULT"
  _ <- applyOps env [stockTransferOp t [r]]
  expectRecord env (OcfRecordDataStockTransfer t)
  expectRecord env (OcfRecordDataStockIssuance r)
  hasState env "S-A2" >>= (=== False)
  (.quantity) <$> stateOf env "NEW-SEC-1" >>= (=== 400.0)

test_security_ids_warrant_transfer_correct_id_succeeds : Script ()
test_security_ids_warrant_transfer_correct_id_succeeds = do
  env <- instrumentBook
  let t = warrantTransfer "TX_WARRANT_TRANSFER_VALID" "W-1" ["NEW-WARRANT-1"] None
      w = (warrantIssuance "NEW-WARRANT-1" "SH-B") with id = "TX_WARRANT_TRANSFER_VALID_RESULT"
  _ <- applyRecords env [OcfRecordDataWarrantTransfer t, OcfRecordDataWarrantIssuance w]
  expectRecord env (OcfRecordDataWarrantTransfer t)
  expectRecord env (OcfRecordDataWarrantIssuance w)

-- =============================================================================
-- UNIQUENESS ACROSS INSTRUMENTS
-- =============================================================================

test_security_ids_unique_across_instruments : Script ()
test_security_ids_unique_across_instruments = do
  env <- instrumentBook
  applyRecordsFails env "security ID already used: S-A1"
    [OcfRecordDataWarrantIssuance ((warrantIssuance "S-A1" "SH-B") with id = "ISS-W-DUP")]
  applyRecordsFails env "security ID already used: W-1"
    [OcfRecordDataStockIssuance ((newSec "W-1" 1.0) with id = "ISS-S-DUP")]
  applyRecordsFails env "security ID already used: CV-1"
    [OcfRecordDataEquityCompensationIssuance ((equityCompensationIssuance "CV-1" "SH-B") with id = "ISS-EC-DUP")]
  applyRecordsFails env "security ID already used: EC-1"
    [OcfRecordDataConvertibleIssuance ((convertibleIssuance "EC-1" "SH-B") with id = "ISS-CV-DUP")]
  -- Two instruments with one new security ID in the same batch.
  applyRecordsFails env "security ID already used: SEC-NEW"
    [ OcfRecordDataWarrantIssuance (warrantIssuance "SEC-NEW" "SH-B")
    , OcfRecordDataStockIssuance ((newSec "SEC-NEW" 1.0) with id = "ISS-SEC-NEW-2")
    ]

-- Security IDs and object IDs are claimed in separate namespaces.
test_security_ids_separate_from_object_ids : Script ()
test_security_ids_separate_from_object_ids = do
  env <- standardBook
  let iss = (newSec "SH-B" 5.0) with id = "ISS-NAMED-LIKE-A-STAKEHOLDER"
  _ <- applyRecords env [OcfRecordDataStockIssuance iss]
  expectRecord env (OcfRecordDataStockIssuance iss)
  (.quantity) <$> stateOf env "SH-B" >>= (=== 5.0)
  -- The issuance's object ID is claimed against every type.
  applyRecordsFails env "ID already used: ISS-NAMED-LIKE-A-STAKEHOLDER"
    [OcfRecordDataStakeholder (stakeholderData "ISS-NAMED-LIKE-A-STAKEHOLDER")]
