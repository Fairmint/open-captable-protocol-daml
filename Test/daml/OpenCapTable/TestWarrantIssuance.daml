test_warrant_issuance_stakeholder_reference : Script ()
test_warrant_issuance_stakeholder_reference = do
  env <- standardBook
  applyRecordsFails env "Warrant issuance stakeholder not found: SH-NONE" [wi (warrantIssuance "WI-1" "W-1" "SH-NONE")]
  applyRecordsFails env "Warrant issuance stakeholder ISS-S-A1 is a OcfObjectTypeTxStockIssuance, not one of [OcfObjectTypeStakeholder]"
    [wi (warrantIssuance "WI-1" "W-1" "ISS-S-A1")]
  -- A stakeholder written later in the same batch satisfies the reference.
  let w = warrantIssuance "WI-1" "W-1" "SH-NEW"
  _ <- applyRecords env [wi w, OcfRecordDataStakeholder (stakeholderData "SH-NEW")]
  expectRecord env (wi w)

test_warrant_issuance_vesting_terms_reference : Script ()
test_warrant_issuance_vesting_terms_reference = do
  env <- standardBook
  let w = (warrantIssuance "TX_WARRANT_REF" "WARRANT-REF" "SH-A") with vesting_terms_id = Some "VT_MISSING_WARRANT"
  applyRecordsFails env "Warrant vesting terms not found: VT_MISSING_WARRANT" [wi w]
  applyRecordsFails env "Warrant vesting terms SH-B is a OcfObjectTypeStakeholder, not one of [OcfObjectTypeVestingTerms]"
    [wi w with vesting_terms_id = Some "SH-B"]
  let w' = w with vesting_terms_id = Some "VT_WARRANT_REF"
  _ <- applyRecords env [OcfRecordDataVestingTerms (vestingTerms "VT_WARRANT_REF"), wi w']
  expectRecord env (wi w')

test_warrant_issuance_edit_references : Script ()
test_warrant_issuance_edit_references = do
  env <- standardBook
  let w = warrantIssuance "TX_WARRANT_EDIT" "WARRANT-EDIT" "SH-A"
  _ <- applyRecords env [wi w]
  -- The references an edit adds are checked against the book.
  restateOpsFails env "Warrant vesting terms not found: VT_MISSING_WARRANT_ON_EDIT"
    [RestateEdit (wi w with vesting_terms_id = Some "VT_MISSING_WARRANT_ON_EDIT")]
  restateOpsFails env "Warrant issuance stakeholder not found: SH-NONE" [RestateEdit (wi w with stakeholder_id = "SH-NONE")]
  -- Definitions written before the edit satisfy them.
  _ <- applyRecords env [OcfRecordDataVestingTerms (vestingTerms "VT_WARRANT_EDIT"), OcfRecordDataStakeholder (stakeholderData "SH_WARRANT_EDIT_NEW")]
  let edited = w with vesting_terms_id = Some "VT_WARRANT_EDIT"; stakeholder_id = "SH_WARRANT_EDIT_NEW"
  _ <- restateOps env [RestateEdit (wi edited)]
  expectRecord env (wi edited)

-- References are checked when the referring record is written. A later delete of the definition
-- is not re-checked on the ledger: refusing an edit or delete that orphans a live reference is
-- the SDK's job.
test_warrant_issuance_definition_deletes_not_rechecked : Script ()
test_warrant_issuance_definition_deletes_not_rechecked = do
  env <- standardBook
  let w = (warrantWithTriggers "WI-1" "W-1" [atWill "T-1" (fixedWarrantRight (Some "CLS-W"))]) with
        stakeholder_id = "SH-W"
        vesting_terms_id = Some "VT-W"
  _ <- applyRecords env
    [ OcfRecordDataStakeholder (stakeholderData "SH-W")
    , OcfRecordDataVestingTerms (vestingTerms "VT-W")
    , OcfRecordDataStockClass (stockClass "CLS-W")
    , wi w
    ]
  _ <- restateOps env [RestateDelete "SH-W", RestateDelete "VT-W", RestateDelete "CLS-W"]
  mapA (hasRecord env) ["SH-W", "VT-W", "CLS-W"] >>= (=== [False, False, False])
  expectRecord env (wi w)

test_warrant_issuance_ids : Script ()
test_warrant_issuance_ids = do
  env <- instrumentBook
  -- Security IDs are unique across stock, warrants and convertibles ...
  applyRecordsFails env "security ID already used: S-A1" [wi (warrantIssuance "WI-2" "S-A1" "SH-A")]
  applyRecordsFails env "security ID already used: C-1" [wi (warrantIssuance "WI-2" "C-1" "SH-A")]
  applyRecordsFails env "security ID already used: W-1" [wi (warrantIssuance "WI-2" "W-1" "SH-A")]
  -- ... and within one batch.
  applyRecordsFails env "security ID already used: W-2"
    [wi (warrantIssuance "WI-2" "W-2" "SH-A"), OcfRecordDataConvertibleIssuance (convertibleIssuance "CI-2" "W-2" "SH-A")]
  -- Object IDs are unique across types.
  applyRecordsFails env "ID already used: SH-B" [wi (warrantIssuance "SH-B" "W-2" "SH-A")]
  applyRecordsFails env "ID already used: CI-1" [wi (warrantIssuance "CI-1" "W-2" "SH-A")]
  -- Neither may have the book's derived form.
  applyRecordsFails env "derived form" [wi (warrantIssuance (env.ctx.cap_table_id <> ":WI-2") "W-2" "SH-A")]
  applyRecordsFails env "derived form" [wi (warrantIssuance "WI-2" (env.ctx.cap_table_id <> ":W-2") "SH-A")]
  -- Object and security IDs are separate namespaces: one text may be both.
  let w = warrantIssuance "W-2" "W-2" "SH-A"
  _ <- applyRecords env [wi w]
  expectRecord env (wi w)

test_warrant_issuance_edit_and_delete : Script ()
test_warrant_issuance_edit_and_delete = do
  env <- instrumentBook
  let w = warrantIssuance "WI-1" "W-1" "SH-A"
  restateOpsFails env "precondition" [RestateEdit (wi w with custom_id = "")]
  restateOpsFails env "keeps record WI-1's type" [RestateEdit (OcfRecordDataConvertibleIssuance (convertibleIssuance "WI-1" "W-1" "SH-A"))]
  checkEditAndDelete env (wi w) (wi w with quantity = Some 150.0; comments = ["Amended"])
  -- The delete released the security ID with the object ID.
  let w2 = warrantIssuance "WI-NEW" "W-1" "SH-A"
  _ <- applyRecords env [wi w2]
  expectRecord env (wi w2)

-- A warrant's security ID may change on an edit: the old one is released and the new one claimed.
test_warrant_issuance_edit_security_id : Script ()
test_warrant_issuance_edit_security_id = do
  env <- instrumentBook
  let w = warrantIssuance "WI-1" "W-1" "SH-A"
  restateOpsFails env "security ID already used: C-1" [RestateEdit (wi w with security_id = "C-1")]
  _ <- restateOps env [RestateEdit (wi w with security_id = "W-1B")]
  expectRecord env (wi w with security_id = "W-1B")
  viewSecurityIds env "WI-1" >>= (=== ["W-1B"])
  applyRecordsFails env "security ID already used: W-1B" [wi (warrantIssuance "WI-2" "W-1B" "SH-A")]
  let w2 = warrantIssuance "WI-2" "W-1" "SH-A"
  _ <- applyRecords env [wi w2]
  expectRecord env (wi w2)

test_warrant_issuance_tranche_cap : Script ()
test_warrant_issuance_tranche_cap = do
  env <- standardBook
  let w = warrantIssuance "WI-T" "W-T" "SH-A"
  applyRecordsFails env "OcfObjectTypeTxWarrantIssuance has 1501 vesting tranches; at most 1500" [wi w with vestings = tranches 1501]
  _ <- applyRecords env [wi w with vestings = tranches 1500]
  expectRecord env (wi w with vestings = tranches 1500)

test_warrant_issuance_conversion_targets : Script ()
test_warrant_issuance_conversion_targets = do
  env <- standardBook
  -- Each kind of right a warrant trigger may carry has its target stock class checked.
  forA_ [fixedWarrantRight, customConvertibleRight, ratioStockClassRight] \right ->
    applyRecordsFails env "Warrant exercise trigger conversion target not found: SC_MISSING_WARRANT_TARGET"
      [wi (warrantWithTriggers "WI-M" "W-M" [atWill "T-1" (right (Some "SC_MISSING_WARRANT_TARGET"))])]
  applyRecordsFails env "Warrant exercise trigger conversion target SH-B is a OcfObjectTypeStakeholder"
    [wi (warrantWithTriggers "WI-M" "W-M" [atWill "T-1" (fixedWarrantRight (Some "SH-B"))])]
  -- A target written later in the same batch satisfies all three.
  let w = warrantWithTriggers "WI-T" "W-T"
        [ atWill "T-W" (fixedWarrantRight (Some "SC_WARRANT_TARGET"))
        , atWill "T-C" (customConvertibleRight (Some "SC_WARRANT_TARGET"))
        , atWill "T-S" (ratioStockClassRight (Some "SC_WARRANT_TARGET"))
        ]
  _ <- applyRecords env [wi w, OcfRecordDataStockClass (stockClass "SC_WARRANT_TARGET")]
  expectRecord env (wi w)

test_warrant_issuance_edit_conversion_target : Script ()
test_warrant_issuance_edit_conversion_target = do
  env <- standardBook
  let w = warrantWithTriggers "WI-E" "W-E" [atWill "T-1" (fixedWarrantRight None)]
  _ <- applyRecords env [wi w]
  restateOpsFails env "Warrant exercise trigger conversion target not found: SC_MISSING_WARRANT_EDIT_TARGET"
    [RestateEdit (wi w with exercise_triggers = [atWill "T-1" (fixedWarrantRight (Some "SC_MISSING_WARRANT_EDIT_TARGET"))])]
  let edited = w with exercise_triggers = [atWill "T-1" (fixedWarrantRight (Some "CLS-A"))]
  _ <- restateOps env [RestateEdit (wi edited)]
  expectRecord env (wi edited)

test_warrant_issuance_duplicate_trigger_ids : Script ()
test_warrant_issuance_duplicate_trigger_ids = do
  env <- standardBook
  let t = atWill "TRIGGER-1" (fixedWarrantRight None)
      w = warrantWithTriggers "WI-D" "W-D" [t]
  applyRecordsFails env "precondition" [wi w with exercise_triggers = [t, t]]
  -- One ID on two different triggers is refused too.
  applyRecordsFails env "precondition" [wi w with exercise_triggers = [t, t with nickname = Some "Other"]]
  _ <- applyRecords env [wi w]
  restateOpsFails env "precondition" [RestateEdit (wi w with exercise_triggers = [t, t])]
  expectRecord env (wi w)
