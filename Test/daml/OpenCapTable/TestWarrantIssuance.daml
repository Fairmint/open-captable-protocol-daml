-- Warrant issuances through CapTable_Apply and CapTable_Restate: the issuance validator, its stakeholder, vesting-terms and conversion-target references, unique trigger IDs, claimed object and security IDs, the tranche cap, and edits and deletes.
module OpenCapTable.TestWarrantIssuance where

import DA.Assert ((===))
import qualified DA.Date as D
import DA.Foldable (forA_)
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate hiding (restate)
import Fairmint.OpenCapTable.Types.Conversion
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary(..))
import Fairmint.OpenCapTable.Types.Stock (OcfQuantitySourceType(..), OcfSecurityExemption(..))
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting(..))
import Fairmint.OpenCapTable.OCF.WarrantIssuance (WarrantIssuanceOcfData(..), validateWarrantIssuanceOcfData)
import OpenCapTable.Harness
import OpenCapTable.WarrantConvertibleFixtures

wi : WarrantIssuanceOcfData -> OcfRecordData
wi = OcfRecordDataWarrantIssuance

warrantWithTriggers : Text -> Text -> [OcfConversionTrigger] -> WarrantIssuanceOcfData
warrantWithTriggers id sec triggers = (warrantIssuance id sec "SH-A") with exercise_triggers = triggers

atWill : Text -> OcfAnyConversionRight -> OcfConversionTrigger
atWill id right = warrantTrigger id OcfConversionTriggerTypeElectiveAtWill right

-- The three kinds of conversion right a warrant's exercise trigger may carry, by target.
fixedWarrantRight : Optional Text -> OcfAnyConversionRight
fixedWarrantRight target =
  OcfRightWarrant (warrantRight (OcfWarrantMechanismFixedAmount (OcfFixedAmountConversionMechanism with converts_to_quantity = 100.0)) target)

customConvertibleRight : Optional Text -> OcfAnyConversionRight
customConvertibleRight target = OcfRightConvertible (convertibleRight (OcfConvMechCustom (customMechanism "Custom")) target)

ratioStockClassRight : Optional Text -> OcfAnyConversionRight
ratioStockClassRight target = OcfRightStockClass (stockClassRight target)

tranches : Int -> [OcfVesting]
tranches n = map (\i -> OcfVesting with amount = 1.0; date = D.addDays d2024 i) [1 .. n]

test_warrant_issuance_create : Script ()
test_warrant_issuance_create = do
  env <- standardBook
  let w = warrantIssuance "TX_WARRANT_ISSUANCE_1" "WSEC-1" "SH-A"
  _ <- applyRecords env [wi w]
  expectRecord env (wi w)
  viewSecurityIds env "TX_WARRANT_ISSUANCE_1" >>= (=== ["WSEC-1"])
  -- A warrant is a record, not a stock state.
  hasState env "WSEC-1" >>= (=== False)
  -- Its object ID and its security ID are claimed.
  applyRecordsFails env "ID already used: TX_WARRANT_ISSUANCE_1" [OcfRecordDataStakeholder (stakeholderData "TX_WARRANT_ISSUANCE_1")]
  applyRecordsFails env "security ID already used: WSEC-1" [OcfRecordDataStockIssuance (issuance "WSEC-1" "SH-A" "CLS-A" 10.0 d2024)]

test_warrant_issuance_optionals_and_arrays : Script ()
test_warrant_issuance_optionals_and_arrays = do
  env <- standardBook
  let w = (warrantIssuance "TX_WARRANT_SOME" "WSEC-3" "SH-A") with
        date = D.date 2024 D.Feb 1
        board_approval_date = Some (D.date 2024 D.Jan 15)
        stockholder_approval_date = Some (D.date 2024 D.Jan 20)
        consideration_text = Some "Cash"
        security_law_exemptions = [OcfSecurityExemption with description = "Reg D"; jurisdiction = "US-DE"]
        quantity_source = Some OcfQuantitySourceTypeInstrumentFixed
        exercise_price = Some (usd 1.5)
        purchase_price = usd 0.1
        warrant_expiration_date = Some (D.date 2025 D.Jan 1)
        vesting_terms_id = Some "VT_W"
        vestings = [OcfVesting with date = D.date 2024 D.Mar 1; amount = 10.0]
        comments = ["Issued"]
  -- The vesting terms come later in the batch: references are checked after its last operation.
  _ <- applyRecords env [wi w, OcfRecordDataVestingTerms (vestingTerms "VT_W")]
  expectRecord env (wi w)
  expectRecord env (OcfRecordDataVestingTerms (vestingTerms "VT_W"))

-- OCF requires exercise_triggers but sets no minItems, so a warrant may carry none.
test_warrant_issuance_without_triggers : Script ()
test_warrant_issuance_without_triggers = do
  env <- standardBook
  let w = (warrantIssuance "WI-NT" "W-NT" "SH-A") with exercise_triggers = []
  _ <- applyRecords env [wi w]
  expectRecord env (wi w)

test_warrant_issuance_validator : Script ()
test_warrant_issuance_validator = do
  env <- standardBook
  let base = warrantIssuance "WI-V" "W-V" "SH-A"
      trigger = atWillWarrantTrigger warrantTriggerId
      rejects : Text -> Text -> WarrantIssuanceOcfData -> Script ()
      rejects label expected w = do
        expectInvalid label (validateWarrantIssuanceOcfData w)
        applyRecordsFails env expected [wi w]
      accepts : Text -> Int -> WarrantIssuanceOcfData -> Script ()
      accepts label n w = do
        let w' = w with id = "WI-OK-" <> show n; security_id = "W-OK-" <> show n
        expectValid label (validateWarrantIssuanceOcfData w')
        _ <- applyRecords env [wi w']
        expectRecord env (wi w')
  expectValid "base" (validateWarrantIssuanceOcfData base)
  -- Empty IDs fail their claim before the record is created.
  rejects "empty id" "an empty ID cannot be claimed" base with id = ""
  rejects "empty security_id" "an empty ID cannot be claimed" base with security_id = ""
  rejects "empty custom_id" "precondition" base with custom_id = ""
  rejects "empty stakeholder_id" "precondition" base with stakeholder_id = ""
  rejects "exemption without description" "precondition"
    base with security_law_exemptions = [OcfSecurityExemption with description = ""; jurisdiction = "US"]
  rejects "exemption without jurisdiction" "precondition"
    base with security_law_exemptions = [OcfSecurityExemption with description = "Reg D"; jurisdiction = ""]
  rejects "empty comment" "precondition" base with comments = ["ok", ""]
  rejects "negative purchase price" "precondition" base with purchase_price = usd (-1.0)
  rejects "two-letter currency" "precondition" base with purchase_price = OcfMonetary with amount = 1.0; currency = "US"
  rejects "empty consideration" "precondition" base with consideration_text = Some ""
  rejects "duplicate trigger IDs" "precondition" base with exercise_triggers = [trigger, trigger]
  rejects "empty trigger ID" "precondition" base with exercise_triggers = [trigger with trigger_id = ""]
  rejects "empty trigger nickname" "precondition" base with exercise_triggers = [trigger with nickname = Some ""]
  rejects "empty trigger description" "precondition" base with exercise_triggers = [trigger with trigger_description = Some ""]
  rejects "at-will trigger with a date" "precondition" base with exercise_triggers = [trigger with trigger_date = Some d2024]
  rejects "invalid trigger right" "precondition"
    base with exercise_triggers = [atWill "T" (OcfRightWarrant (warrantRight (OcfWarrantMechanismCustom (customMechanism "")) None))]
  rejects "empty conversion target" "precondition" base with exercise_triggers = [atWill "T" (fixedWarrantRight (Some ""))]
  rejects "expiration before the issuance" "precondition" base with warrant_expiration_date = Some (D.date 2023 D.Dec 31)
  rejects "empty vesting terms ID" "precondition" base with vesting_terms_id = Some ""
  rejects "zero vesting" "precondition" base with vestings = [OcfVesting with amount = 0.0; date = d2024]
  rejects "negative vesting" "precondition" base with vestings = [OcfVesting with amount = -1.0; date = d2024]
  -- Vestings stay within the quantity when it is a fixed or maximum instrument quantity ...
  let over = base with vestings = [(OcfVesting with amount = 60.0; date = d2024), (OcfVesting with amount = 41.0; date = D.date 2025 D.Jan 1)]
  rejects "vestings over a fixed quantity" "precondition" over with quantity_source = Some OcfQuantitySourceTypeInstrumentFixed
  rejects "vestings over a maximum quantity" "precondition" over with quantity_source = Some OcfQuantitySourceTypeInstrumentMax
  -- ... and are not bounded by a minimum, estimated, unspecified or absent source, or no quantity.
  accepts "vestings over a minimum quantity" 1 over with quantity_source = Some OcfQuantitySourceTypeInstrumentMin
  accepts "vestings over a human estimate" 2 over with quantity_source = Some OcfQuantitySourceTypeHumanEstimated
  accepts "vestings over a machine estimate" 3 over with quantity_source = Some OcfQuantitySourceTypeMachineEstimated
  accepts "vestings over an unspecified quantity" 4 over with quantity_source = Some OcfQuantitySourceTypeUnspecified
  accepts "vestings with no quantity source" 5 over
  accepts "vestings with no quantity" 6 over with quantity = None; quantity_source = Some OcfQuantitySourceTypeInstrumentFixed
  accepts "vestings equal to a fixed quantity" 7
    base with quantity_source = Some OcfQuantitySourceTypeInstrumentFixed; vestings = [OcfVesting with amount = 100.0; date = d2024]
  -- The expiration may fall on the issuance date.
  accepts "expiration on the issuance date" 8 base with warrant_expiration_date = Some d2024

-- KNOWN BUG: validateWarrantIssuanceOcfData never validates exercise_price (v34 did not either),
-- so a present exercise price that is not a valid OCF Monetary is accepted; the equity
-- compensation issuance validates its exercise_price and base_price. Expected: both writes fail
-- with "precondition". Actual: both succeed.
