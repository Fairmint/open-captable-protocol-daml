-- Warrant retractions through CapTable_Update: a record on the warrant's security, its security reference, the retraction validator and the shared edit and delete rules.
module OpenCapTable.TestWarrantRetraction where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.OCF.WarrantRetraction (WarrantRetractionOcfData(..), validateWarrantRetractionOcfData)
import OpenCapTable.Harness
import OpenCapTable.WarrantConvertibleFixtures

retraction : Text -> Text -> WarrantRetractionOcfData
retraction id sec = WarrantRetractionOcfData with
  id
  date = D.date 2024 D.Jan 2
  reason_text = "Administrative error - incorrect warrant quantity"
  security_id = sec
  comments = []

wr : WarrantRetractionOcfData -> OcfRecordData
wr = OcfRecordDataWarrantRetraction

test_warrant_retraction_create : Script ()
test_warrant_retraction_create = do
  env <- instrumentBook
  let r = retraction "TX_WARRANT_RETRACT_1" "W-1"
  _ <- applyRecords env [wr r]
  expectRecord env (wr r)
  viewSecurityIds env "TX_WARRANT_RETRACT_1" >>= (=== ["W-1"])
  -- The retracted warrant's issuance record stays; correcting it is a restatement.
  hasRecord env "WI-1" >>= (=== True)
  applyRecordsFails env "ID already used: TX_WARRANT_RETRACT_1" [OcfRecordDataStakeholder (stakeholderData "TX_WARRANT_RETRACT_1")]

test_warrant_retraction_with_comments : Script ()
test_warrant_retraction_with_comments = do
  env <- instrumentBook
  let r = (retraction "TX_WARRANT_RETRACT_2" "W-1") with
        date = D.date 2024 D.Jan 3
        reason_text = "Warrant void ab initio - debt financing fell through"
        comments = ["Board resolution 2024-005", "Holder acknowledged"]
  _ <- applyRecords env [wr r]
  expectRecord env (wr r)

test_warrant_retraction_security_reference : Script ()
test_warrant_retraction_security_reference = do
  env <- instrumentBook
  applyRecordsFails env "Warrant retraction security not found: W-NONE" [wr (retraction "WR-1" "W-NONE")]
  applyRecordsFails env "Warrant retraction security C-1 is carried by a OcfObjectTypeTxConvertibleIssuance" [wr (retraction "WR-1" "C-1")]
  applyRecordsFails env "Warrant retraction security S-A2 is carried by a OcfObjectTypeTxStockIssuance" [wr (retraction "WR-1" "S-A2")]

test_warrant_retraction_validator : Script ()
test_warrant_retraction_validator = do
  env <- instrumentBook
  let base = retraction "WR-V" "W-1"
      rejects : Text -> Text -> WarrantRetractionOcfData -> Script ()
      rejects label expected r = do
        expectInvalid label (validateWarrantRetractionOcfData r)
        applyRecordsFails env expected [wr r]
  expectValid "base" (validateWarrantRetractionOcfData base)
  rejects "empty id" "an empty ID cannot be claimed" base with id = ""
  rejects "empty security_id" "precondition" base with security_id = ""
  rejects "empty reason" "precondition" base with reason_text = ""
  rejects "empty comment" "precondition" base with comments = [""]

test_warrant_retraction_edit_and_delete : Script ()
test_warrant_retraction_edit_and_delete = do
  env <- instrumentBook
  let r = retraction "WR-1" "W-1"
  _ <- applyRecords env [wr r]
  restateOpsFails env "precondition" [RestateEdit (wr r with reason_text = "")]
  restateOpsFails env "Warrant retraction security not found: W-NONE" [RestateEdit (wr r with security_id = "W-NONE")]
  checkEditAndDelete env (wr r) (wr r with reason_text = "Issued to the wrong holder")
