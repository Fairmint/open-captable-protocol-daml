-- A demo-style end-to-end book, ported from v34's Demo and Setup: Acme Inc. is authorized through the factory with its pinned TA, and the TA builds its cap table step by step the way it replays a real one (v34's definitions, founder stock, a SAFE, a Series A that converts it, an option grant under the plan, a secondary transfer, a valuation and corrections), reading the book back after each step and as a whole; the same export replayed in one batch yields the same book.
module OpenCapTable.TestDemo where

import DA.Assert ((===))
import qualified DA.Date as D
import DA.Foldable (forA_)
import DA.List (head, sort)
import qualified DA.Map as Map
import Daml.Script

import Fairmint.OpenCapTable.Types.ObjectType (OcfObjectType(..))
import Fairmint.OpenCapTable.Apply hiding (applyOperation)
import Fairmint.OpenCapTable.CapTable
import Fairmint.OpenCapTable.Update (UpdateOperation(..))
import Fairmint.OpenCapTable.Ids
import Fairmint.OpenCapTable.IssuerAuthorization
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.OcpFactory
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.State
import Fairmint.OpenCapTable.Types.Conversion (OcfRatioConversionMechanism(..), OcfRoundingType(..), OcfStockClassConversionRight(..))
import Fairmint.OpenCapTable.Types.Core (Context(..))
import Fairmint.OpenCapTable.Types.Stock (OcfInitialSharesAuthorized(..), OcfRatio(..), OcfStockClassType(..))
import Fairmint.OpenCapTable.Types.Vesting (OcfCompensationType(..))
import Fairmint.OpenCapTable.OCF.ConvertibleConversion (ConvertibleConversionOcfData(..))
import Fairmint.OpenCapTable.OCF.ConvertibleIssuance (ConvertibleIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.Document (DocumentOcfData(..), OcfObjectReference(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationIssuance (EquityCompensationIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.Financing (FinancingOcfData(..))
import Fairmint.OpenCapTable.OCF.Issuer (IssuerOcfData(..))
import Fairmint.OpenCapTable.OCF.IssuerAuthorizedSharesAdjustment (IssuerAuthorizedSharesAdjustmentOcfData(..))
import Fairmint.OpenCapTable.OCF.Stakeholder (OcfName(..), StakeholderOcfData(..))
import Fairmint.OpenCapTable.OCF.StockAcceptance (StockAcceptanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockClass (StockClassOcfData(..))
import Fairmint.OpenCapTable.OCF.StockIssuance (OcfStockIssuanceType(..), StockIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockLegendTemplate (StockLegendTemplateOcfData(..))
import Fairmint.OpenCapTable.OCF.StockPlan (StockPlanOcfData(..))
import Fairmint.OpenCapTable.OCF.StockPlanPoolAdjustment (StockPlanPoolAdjustmentOcfData(..))
