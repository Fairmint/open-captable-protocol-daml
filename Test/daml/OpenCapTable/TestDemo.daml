founderDate : Date
founderDate = D.date 2010 D.Jun 15

founderStock : Text -> Text -> Decimal -> StockIssuanceOcfData
founderStock sec holder qty = (issuance sec holder "SC_COMMON" qty founderDate) with
  share_price = usd 0.0001
  cost_basis = Some (usd (qty * 0.0001))
  stock_legend_ids = ["LEG_STD"]
  issuance_type = Some OcfStockIssuanceTypeRsa

aliceFounder : StockIssuanceOcfData
aliceFounder = founderStock "S_ALICE_1" "STKH_Alice" 4000000.0

bobFounder : StockIssuanceOcfData
bobFounder = (founderStock "S_BOB_1" "STKH_Bob" 3000000.0) with vesting_terms_id = Some "VT_4Y1C"

-- | Founder stock: Alice's 4M fully vested, Bob's 3M on the four-year terms.
founders : [OcfRecordData]
founders = [OcfRecordDataStockIssuance aliceFounder, OcfRecordDataStockIssuance bobFounder]

safeCarol : ConvertibleIssuanceOcfData
safeCarol = (convertibleIssuance "SAFE_CAROL" "SEC_SAFE_CAROL" "STKH_Carol") with
  custom_id = "SAFE-1"
  date = D.date 2023 D.Sep 1
  investment_amount = usd 500000.0

-- | A SAFE from Carol, who joins after it in the same batch.
safe : [OcfRecordData]
safe = [OcfRecordDataConvertibleIssuance safeCarol, OcfRecordDataStakeholder (person "STKH_Carol" "Carol")]

seriesADate : Date
seriesADate = D.date 2024 D.Jun 1

seriesAStock : Text -> Text -> Decimal -> StockIssuanceOcfData
seriesAStock sec holder qty = (issuance sec holder "SC_SERIES_A" qty seriesADate) with stock_legend_ids = ["LEG_STD"]

ref : OcfObjectType -> Text -> OcfObjectReference
ref t id = OcfObjectReference with object_type = t; object_id = id

spa : DocumentOcfData
spa = DocumentOcfData with
  id = "DOC_SPA"
  md5 = "0123456789abcdef0123456789abcdef"
  comments = []
  related_objects = [ref OcfObjectTypeFinancing "FIN_SERIES_A", ref OcfObjectTypeStockClass "SC_SERIES_A", ref OcfObjectTypeIssuer "ISSUER_DEMO"]
  path = Some "/docs/series-a-spa.pdf"
  uri = None

draftDocument : DocumentOcfData
draftDocument = spa with id = "DOC_DRAFT"; path = Some "/docs/draft.pdf"; related_objects = []

-- | The Series A: the purchase agreement and the financing ahead of what they name, Carol's SAFE
-- converted into Series A stock, a preferred class converting into common, Erin's purchase, Erin,
-- and the issuer's authorized shares raised to 17M.
seriesARound : [OcfRecordData]
seriesARound =
  [ OcfRecordDataDocument spa
  , OcfRecordDataFinancing FinancingOcfData with
      id = "FIN_SERIES_A"; date = seriesADate; name = "Series A"; comments = []
      issuance_ids = ["ISS-S_ERIN_A", "ISS-S_CAROL_A", "SAFE_CAROL"]
  , OcfRecordDataConvertibleConversion ConvertibleConversionOcfData with
      id = "CONV_SAFE_CAROL"
      date = seriesADate
      reason_text = "Series A qualified financing"
      security_id = "SEC_SAFE_CAROL"
      trigger_id = "T-SEC_SAFE_CAROL"
      comments = []
      resulting_security_ids = ["S_CAROL_A"]
      balance_security_id = None
      capitalization_definition = None
      quantity_converted = None
  , OcfRecordDataStockClass seriesA
  , OcfRecordDataStockIssuance (seriesAStock "S_ERIN_A" "STKH_Erin" 1000000.0)
  , OcfRecordDataStockIssuance (seriesAStock "S_CAROL_A" "STKH_Carol" 600000.0)
  , OcfRecordDataStakeholder (person "STKH_Erin" "Erin")
  , OcfRecordDataIssuerAuthorizedSharesAdjustment IssuerAuthorizedSharesAdjustmentOcfData with
      id = "ISSUER_ADJ_1"; date = seriesADate; issuer_id = "ISSUER_DEMO"; new_shares_authorized = 17000000.0
      comments = []; board_approval_date = Some seriesADate; stockholder_approval_date = None
  ]

daveOption : EquityCompensationIssuanceOcfData
daveOption = (equityCompensationIssuance "EC_DAVE_1" "SEC_EC_DAVE_1" "STKH_Dave") with
  compensation_type = OcfCompensationTypeOptionIso
  custom_id = "OPT-1"
  date = D.date 2025 D.Mar 1
  quantity = 100000.0
  exercise_price = Some (usd 0.10)
  expiration_date = Some (D.date 2035 D.Mar 1)
  stock_plan_id = Some "PLAN_2025"
  stock_class_id = Some "SC_COMMON"
  vesting_terms_id = Some "VT_4Y1C"

-- | Dave joins and is granted options under the plan on the four-year terms, with his vesting
-- start; the pool grows to 1.5M.
grant : [OcfRecordData]
grant =
  [ OcfRecordDataEquityCompensationIssuance daveOption
  , OcfRecordDataVestingStart VestingStartOcfData with
      id = "VS_DAVE_1"; date = D.date 2025 D.Mar 1; security_id = "SEC_EC_DAVE_1"; vesting_condition_id = "start"; comments = []
  , OcfRecordDataStockPlanPoolAdjustment StockPlanPoolAdjustmentOcfData with
      id = "POOL_ADJ_1"; date = D.date 2025 D.Feb 15; shares_reserved = 1500000.0; stock_plan_id = "PLAN_2025"
      comments = []; board_approval_date = Some (D.date 2025 D.Feb 15); stockholder_approval_date = None
  , OcfRecordDataStakeholder (person "STKH_Dave" "Dave")
  ]

saleDate : Date
saleDate = D.date 2025 D.Jun 2

-- | The secondary: Alice sells 500,000 common to Erin at 2.00 USD a share, under the IDs the
-- register derives in this book, and Erin accepts.
data Sale = Sale with
    transfer : StockTransferOcfData
    to_erin : StockIssuanceOcfData
    kept_by_alice : StockIssuanceOcfData
    acceptance : StockAcceptanceOcfData

saleIn : Env -> Sale
saleIn env =
  let resultingSec = derived env "S_ALICE_1" 0 DerivedRoleResultingSecurity 0
      balanceSec = derived env "S_ALICE_1" 0 DerivedRoleBalanceSecurity 0
  in Sale with
    transfer = StockTransferOcfData with
      id = derived env "S_ALICE_1" 0 DerivedRoleEvent 0
      date = saleDate
      quantity = 500000.0
      security_id = "S_ALICE_1"
      comments = []
      resulting_security_ids = [resultingSec]
      balance_security_id = Some balanceSec
      consideration_text = Some "Secondary sale at 2.00 USD a share"
    to_erin = (founderStock resultingSec "STKH_Erin" 500000.0) with
      id = derived env "S_ALICE_1" 0 DerivedRoleResultingIssuance 0; date = saleDate
      share_price = usd 2.0; cost_basis = Some (usd 1000000.0)
    kept_by_alice = (founderStock balanceSec "STKH_Alice" 3500000.0) with
      id = derived env "S_ALICE_1" 0 DerivedRoleBalanceIssuance 0; date = saleDate; cost_basis = Some (usd 350.0)
    acceptance = StockAcceptanceOcfData with
      id = derived env resultingSec 0 DerivedRoleEvent 0; date = saleDate; security_id = resultingSec; comments = []

saleOps : Sale -> [ApplyOperation]
saleOps s =
  [ ApplyStockTransfer with transfer = s.transfer; resulting = [s.to_erin]; balance = Some s.kept_by_alice
  , ApplyRecord (OcfRecordDataStockAcceptance s.acceptance)
  ]

fmv : ValuationOcfData
fmv = ValuationOcfData with
  id = "VAL_409A_2025"; effective_date = D.date 2025 D.Jun 30; price_per_share = usd 0.45; stock_class_id = "SC_COMMON"
  valuation_type = OcfValuationType409a; comments = []; board_approval_date = Some (D.date 2025 D.Jul 10)
  provider = Some "Valuer LLC"; stockholder_approval_date = None

bobFixed : StakeholderOcfData
bobFixed = person "STKH_Bob" "Robert Builder"

-- =============================================================================
-- READING THE BOOK
-- =============================================================================

-- | The quantities of the active stock states, by stakeholder and class, summed.
holdings : Env -> Script (Map.Map (Text, Text) Decimal)
holdings env = do
  states <- map snd <$> statesOf env
  pure (foldl (\m s -> Map.insertWith (+) (s.stakeholder_id, s.stock_class_id) s.quantity m) Map.empty states)

-- | The active records of the book, counted by type.
recordCounts : Env -> Script (Map.Map Text Int)
recordCounts env = do
  views <- map snd <$> recordsOf env
  pure (foldl (\m v -> Map.insertWith (+) v.object_type 1 m) Map.empty views)

expectedCounts : Map.Map Text Int
expectedCounts = Map.fromList
  [ ("DOCUMENT", 1)
  , ("FINANCING", 1)
  , ("ISSUER", 1)
  , ("STAKEHOLDER", 5)
  , ("STOCK_CLASS", 2)
  , ("STOCK_LEGEND_TEMPLATE", 1)
  , ("STOCK_PLAN", 1)
  , ("TX_CONVERTIBLE_CONVERSION", 1)
  , ("TX_CONVERTIBLE_ISSUANCE", 1)
  , ("TX_EQUITY_COMPENSATION_ISSUANCE", 1)
  , ("TX_ISSUER_AUTHORIZED_SHARES_ADJUSTMENT", 1)
  , ("TX_STOCK_ACCEPTANCE", 1)
  , ("TX_STOCK_ISSUANCE", 6)
  , ("TX_STOCK_PLAN_POOL_ADJUSTMENT", 1)
  , ("TX_STOCK_TRANSFER", 1)
  , ("TX_VESTING_START", 1)
  , ("VALUATION", 1)
  , ("VESTING_TERMS", 2)
  ]

expectedHoldings : Map.Map (Text, Text) Decimal
expectedHoldings = Map.fromList
  [ (("STKH_Alice", "SC_COMMON"), 3500000.0)
  , (("STKH_Bob", "SC_COMMON"), 3000000.0)
  , (("STKH_Carol", "SC_SERIES_A"), 600000.0)
  , (("STKH_Erin", "SC_COMMON"), 500000.0)
  , (("STKH_Erin", "SC_SERIES_A"), 1000000.0)
  ]

-- | The finished book: its records by type and payload, its holdings against what the classes and
-- the issuer authorize (the register does not enforce authorized shares; the book is consistent
-- with them), and its claimed IDs.
expectFinishedBook : Env -> Script ()
expectFinishedBook env = do
  recordCounts env >>= (=== expectedCounts)
  let sale = saleIn env
      corrected = map (\d -> if d == OcfRecordDataStakeholder (person "STKH_Bob" "Bob") then OcfRecordDataStakeholder bobFixed else d)
  expectRecords env (corrected definitions <> founders <> safe <> seriesARound <> grant)
  expectRecords env
    [ OcfRecordDataStockTransfer sale.transfer, OcfRecordDataStockIssuance sale.to_erin
    , OcfRecordDataStockIssuance sale.kept_by_alice, OcfRecordDataStockAcceptance sale.acceptance
    , OcfRecordDataValuation fmv
    ]
  recordDataOf env "ISSUER_DEMO" >>= (=== OcfRecordDataIssuer acmeIssuer)
  hs <- holdings env
  hs === expectedHoldings
  let outstanding klass = sum [q | ((_, k), q) <- Map.toList hs, k == klass]
  outstanding "SC_COMMON" === 7000000.0
  outstanding "SC_SERIES_A" === 1600000.0
  assertMsg "common within its 12M" (outstanding "SC_COMMON" <= 12000000.0)
  assertMsg "Series A within its 2M" (outstanding "SC_SERIES_A" <= 2000000.0)
  assertMsg "all stock within the issuer's 17M" (outstanding "SC_COMMON" + outstanding "SC_SERIES_A" <= 17000000.0)
  e <- stateOf env (head sale.transfer.resulting_security_ids)
  (e.stakeholder_id, e.quantity, e.seq, e.last_event_date) === ("STKH_Erin", 500000.0, 1, saleDate)
  b <- stateOf env "S_BOB_1"
  b.vesting === StockVestingOnTerms "VT_4Y1C"
  hasState env "S_ALICE_1" >>= (=== False)
  epochs <- map ((.stock_class_id) . snd) <$> epochsOf env
  sort epochs === ["SC_COMMON", "SC_SERIES_A"]
  -- IDs stay claimed by the records that hold them, across types and after the security is consumed.
  applyRecordsFails env "security ID already used: S_ALICE_1"
    [OcfRecordDataStockIssuance ((founderStock "S_ALICE_1" "STKH_Alice" 1.0) with id = "ISS_AGAIN")]
  applyRecordsFails env "ID already used: STKH_Erin" [OcfRecordDataStockLegendTemplate (legendStd with id = "STKH_Erin")]

-- =============================================================================
-- THE DEMO
-- =============================================================================

test_demo_acme_book : Script ()
test_demo_acme_book = do
  env <- acmeEnv
  env.ctx.cap_table_id === "demo-1"
  recordDataOf env "ISSUER_DEMO" >>= (=== OcfRecordDataIssuer acmeIssuer)

  r1 <- applyRecords env definitions
  sort (Map.keys r1.records) === sort ["PLAN_2025", "SC_COMMON", "STKH_Alice", "STKH_Bob", "LEG_STD", "VT_DEMO", "VT_4Y1C"]
  Map.keys r1.epochs === ["SC_COMMON"]
  expectRecords env definitions

  r2 <- applyRecords env founders
  sort (Map.keys r2.states) === ["S_ALICE_1", "S_BOB_1"]
  a <- stateOf env "S_ALICE_1"
  (a.quantity, a.vesting, a.issue_date) === (4000000.0, StockVestingNone, founderDate)
  b <- stateOf env "S_BOB_1"
  (b.quantity, b.vesting) === (3000000.0, StockVestingOnTerms "VT_4Y1C")

  _ <- applyRecords env safe
  expectRecords env safe

  -- The round, with a draft agreement that is withdrawn below.
  r3 <- applyRecords env (seriesARound <> [OcfRecordDataDocument draftDocument])
  Map.size r3.records === 9
  sort (Map.keys r3.states) === ["S_CAROL_A", "S_ERIN_A"]
  Map.keys r3.epochs === ["SC_SERIES_A"]
  expectRecords env (seriesARound <> [OcfRecordDataDocument draftDocument])

  r4 <- applyRecords env grant
  r4.states === Map.empty
  expectRecords env grant

  let sale = saleIn env
  r5 <- applyOps env (saleOps sale)
  sort (Map.keys r5.states) === sort (sale.transfer.resulting_security_ids <> [sale.kept_by_alice.security_id])
  hasState env "S_ALICE_1" >>= (=== False)

  _ <- applyRecords env [OcfRecordDataValuation fmv]

  -- Corrections: Bob's legal name, and the draft agreement withdrawn.
  _ <- restateOps env [RestateEdit (OcfRecordDataStakeholder bobFixed), RestateDelete "DOC_DRAFT"]
  expectNoRecord env "DOC_DRAFT"

  expectFinishedBook env
  -- Only the TA writes the book, and the anchor is still the one Acme created.
  inputs <- allInputs env
  let frank = [ApplyRecord (OcfRecordDataStakeholder (person "STKH_Frank" "Frank"))]
  submitMustFail env.issuer do exerciseCmd env.cap_table CapTable_Update with batch_id = None; inputs; operations = map UpdateCreate frank
  submitMustFail env.outsider do exerciseCmd env.cap_table CapTable_Update with batch_id = None; inputs; operations = map UpdateCreate frank
  Some anchor <- queryContractId env.transfer_agent env.cap_table
  anchor.status === CapTableStatusActive

-- A TA migrating Acme replays its corrected OCF export into a new book in one batch, in the
-- export's order (each stock issuance after its class, the sale after Alice's lot): the result is
-- the same book as the step-by-step one, under the new book's derived IDs.
test_demo_acme_book_in_one_batch : Script ()
test_demo_acme_book_in_one_batch = do
  first <- acmeEnv
  env <- acmeBook first.system_operator first.issuer first.transfer_agent first.outsider first.factory
  env.ctx.cap_table_id === "demo-2"
  let export =
        map (\d -> if d == OcfRecordDataStakeholder (person "STKH_Bob" "Bob") then OcfRecordDataStakeholder bobFixed else d) definitions
          <> founders <> safe <> seriesARound <> grant
      ops = map ApplyRecord export <> saleOps (saleIn env) <> [ApplyRecord (OcfRecordDataValuation fmv)]
  length ops === 26
  r <- applyOps env ops
  Map.size r.records === 28
  Map.size r.epochs === 2
  -- Alice's lot was issued and sold within the batch: it leaves no state.
  Map.size r.states === 5
  forA_ (Map.toList r.states) \(sec, cid) -> do
    cid' <- stateCidOf env sec
    cid' === cid
  expectFinishedBook env
  -- Derived IDs are per book: the first book's would differ.
  assertMsg "derived IDs are per book" ((saleIn env).transfer.id /= (saleIn first).transfer.id)
