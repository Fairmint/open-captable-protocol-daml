import OpenCapTable.DefinitionFixtures
import OpenCapTable.Harness

-- =============================================================================
-- THE ISSUER AND ITS CAP TABLE
-- =============================================================================

-- | v34's demo issuer: Acme Inc, formed 2010-06-01, 15M shares authorized.
acmeIssuer : IssuerOcfData
acmeIssuer = issuerData with
  id = "ISSUER_DEMO"
  legal_name = "Acme Inc"
  formation_date = D.date 2010 D.Jun 1
  initial_shares_authorized = Some (OcfInitialSharesNumeric 15000000.0)

-- | v34 Demo's step 1 (and Setup's setupTestOcp), the production way: the system operator's factory
-- authorizes Acme with its pinned TA, the TA accepts, and Acme creates its cap table.
acmeBook : Party -> Party -> Party -> Party -> ContractId OcpFactory -> Script Env
acmeBook sysOp acme ta outsider factory = do
  auth <- submit sysOp do
    exerciseCmd factory OcpFactory_AuthorizeIssuer with issuer = acme; transfer_agent = ta
  accepted <- submit ta do exerciseCmd auth.authorization IssuerAuthorization_TaAccept
  created <- submit acme do
    exerciseCmd accepted IssuerAuthorization_CreateCapTable with transfer_agent = ta; issuer_data = acmeIssuer
  Map.size created.shards === 256
  pure Env with
    system_operator = sysOp
    issuer = acme
    transfer_agent = ta
    outsider
    ctx = Context with cap_table_id = auth.cap_table_id; issuer = acme; system_operator = sysOp; transfer_agent = ta
    cap_table = created.cap_table
    issuer_record = created.issuer
    factory = auth.factory

acmeEnv : Script Env
acmeEnv = do
  sysOp <- allocateParty "SystemOperator"
  acme <- allocateParty "Acme"
  ta <- allocateParty "TransferAgent"
  outsider <- allocateParty "Rando"
  factory <- submit sysOp do
    createCmd OcpFactory with system_operator = sysOp; factory_id = "demo"; next_cap_table_number = 1
  acmeBook sysOp acme ta outsider factory

