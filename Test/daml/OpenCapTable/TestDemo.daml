seriesA = (stockClass "SC_SERIES_A") with
  name = "Series A Preferred"
  class_type = OcfStockClassTypePreferred
  default_id_prefix = "PA-"
  initial_shares_authorized = OcfInitialSharesNumeric 2000000.0
  seniority = 2.0
  price_per_share = Some (usd 1.0)
  liquidation_preference_multiple = Some 1.0
  conversion_rights =
    [ OcfStockClassConversionRight with
        conversion_mechanism = OcfRatioConversionMechanism with
          conversion_price = usd 1.0
          ratio = OcfRatio with numerator = 1.0; denominator = 1.0
          rounding_type = OcfRoundingTypeNormal
        converts_to_future_round = None
        converts_to_stock_class_id = Some "SC_COMMON"
    ]

