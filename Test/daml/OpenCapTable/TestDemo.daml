-- | v34's 2025 Equity Incentive Plan over the common class.
plan2025 : StockPlanOcfData
plan2025 = (stockPlan "PLAN_2025" ["SC_COMMON"]) with
  plan_name = "2025 Equity Incentive Plan"
  initial_shares_reserved = 1000000.0

-- | v34 Demo's steps 2 to 5 (the common class, Alice and Bob, the legend, vesting terms and the
-- plan), the plan ahead of its class.
definitions : [OcfRecordData]
definitions =
  [ OcfRecordDataStockPlan plan2025
  , OcfRecordDataStockClass common
  , OcfRecordDataStakeholder (person "STKH_Alice" "Alice")
  , OcfRecordDataStakeholder (person "STKH_Bob" "Bob")
  , OcfRecordDataStockLegendTemplate legendStd
  , OcfRecordDataVestingTerms vtDemo
  , OcfRecordDataVestingTerms vt4y1c
