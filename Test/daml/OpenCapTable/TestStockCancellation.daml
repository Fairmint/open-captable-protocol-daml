-- Stock cancellations through ApplyStockCancellation: a terminal event with an optional balance issuance, its balance rules, one event per state per batch, date order, the units rule for splits on and around the event's date, and the cancellation validator.
module OpenCapTable.TestStockCancellation where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.Apply hiding (applyOperation)
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.Types.Stock (OcfHoldType(..))
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting(..))
import Fairmint.OpenCapTable.OCF.StockCancellation (StockCancellationOcfData(..), validateStockCancellationOcfData)
import Fairmint.OpenCapTable.OCF.StockIssuance (StockIssuanceOcfData(..))
import OpenCapTable.Harness
import OpenCapTable.StockHelpers

jan : Int -> Date
jan = D.date 2024 D.Jan

-- SEC-1: 100 shares of CLS-A held by SH-A, issued 2024-01-01.
sec1 : StockIssuanceOcfData
sec1 = issuance "SEC-1" "SH-A" "CLS-A" 100.0 (jan 1)

cancellationBook : Script Env
cancellationBook = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockIssuance sec1]
  pure env

mkCancellation : Text -> Date -> Decimal -> Optional Text -> StockCancellationOcfData
mkCancellation id d q balance = StockCancellationOcfData with
  id; date = d; quantity = q; reason_text = "Forfeit"; security_id = "SEC-1"; comments = []
  balance_security_id = balance

-- A balance issuance of SEC-1, dated on the event.
balanceOf : Text -> Date -> Decimal -> StockIssuanceOcfData
balanceOf sec d q = issuance sec "SH-A" "CLS-A" q d

cancel : StockCancellationOcfData -> Optional StockIssuanceOcfData -> ApplyOperation
cancel c balance = ApplyStockCancellation with cancellation = c; balance

-- =============================================================================
-- WHOLE AND PARTIAL
-- =============================================================================

test_stock_cancellation_whole : Script ()
test_stock_cancellation_whole = do
  env <- cancellationBook
  let c = mkCancellation "TX_STOCK_CANCEL_1" (jan 2) 100.0 None
  _ <- applyOps env [cancel c None]
  expectRecord env (OcfRecordDataStockCancellation c)
  hasState env "SEC-1" >>= (=== False)
  -- The source issuance stays; only its state ends.
  expectRecord env (OcfRecordDataStockIssuance sec1)

-- Optionals Some and arrays non-empty: a partial cancellation names and writes its balance.
test_stock_cancellation_partial_with_balance : Script ()
test_stock_cancellation_partial_with_balance = do
  env <- cancellationBook
  let c = (mkCancellation "TX_STOCK_CANCEL_2" (jan 3) 25.0 (Some "SEC-1-BAL2")) with
        reason_text = "Return to pool"
        comments = ["Admin correction"]
      bal = (balanceOf "SEC-1-BAL2" (jan 3) 75.0) with id = "TX_STOCK_ISS_1_BALANCE"
  _ <- applyOps env [cancel c (Some bal)]
  expectRecord env (OcfRecordDataStockCancellation c)
  expectRecord env (OcfRecordDataStockIssuance bal)
  hasState env "SEC-1" >>= (=== False)
  b <- stateOf env "SEC-1-BAL2"
  b.quantity === 75.0
  b.stakeholder_id === "SH-A"
  b.origin_transaction_id === "TX_STOCK_ISS_1_BALANCE"
  b.last_event_date === jan 3
  b.seq === 0

test_stock_cancellation_balance_rules : Script ()
test_stock_cancellation_balance_rules = do
  env <- cancellationBook
  let partial = mkCancellation "CXL-1" (jan 2) 40.0 (Some "SEC-1-R")
  applyOpsFails env "event quantity 101.0 exceeds the 100.0 of security SEC-1" [cancel (mkCancellation "CXL-1" (jan 2) 101.0 None) None]
  applyOpsFails env "needs a balance issuance" [cancel partial None]
  applyOpsFails env "an event on the whole of security SEC-1 has no balance"
    [cancel (mkCancellation "CXL-1" (jan 2) 100.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 0.0))]
  applyOpsFails env "the event must name its balance security SEC-1-R"
    [cancel (partial with balance_security_id = Some "SEC-1-OTHER") (Some (balanceOf "SEC-1-R" (jan 2) 60.0))]
  applyOpsFails env "the event must name its balance security SEC-1-R"
    [cancel (partial with balance_security_id = None) (Some (balanceOf "SEC-1-R" (jan 2) 60.0))]
  applyOpsFails env "balance SEC-1-R must hold the remaining 60.0"
    [cancel partial (Some (balanceOf "SEC-1-R" (jan 2) 59.0))]
  applyOpsFails env "must stay with the source's stakeholder and class"
    [cancel partial (Some ((balanceOf "SEC-1-R" (jan 2) 60.0) with stakeholder_id = "SH-B"))]
  applyOpsFails env "names a balance security but writes none"
    [cancel (mkCancellation "CXL-1" (jan 2) 100.0 (Some "SEC-1-R")) None]
  -- A fully vested source leaves a fully vested balance.
  applyOpsFails env "the balance of fully vested security SEC-1 must carry no vesting"
    [cancel partial (Some ((balanceOf "SEC-1-R" (jan 2) 60.0) with vestings = [OcfVesting with date = jan 2; amount = 60.0]))]
  hasState env "SEC-1" >>= (=== True)

-- v34 summed the batch's reductions of one source. In v36 the first event consumes the state, so a
-- second event on the same security in the batch finds no state.
test_stock_cancellation_second_event_in_batch_refused : Script ()
test_stock_cancellation_second_event_in_batch_refused = do
  env <- cancellationBook
  applyOpsFails env "no active state for security SEC-1 in this write"
    [ cancel (mkCancellation "TX_STOCK_CANCEL_OVERDRAW_1" (jan 2) 60.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 40.0))
    , cancel (mkCancellation "TX_STOCK_CANCEL_OVERDRAW_2" (jan 2) 50.0 None) None
    ]
  (.quantity) <$> stateOf env "SEC-1" >>= (=== 100.0)

test_stock_cancellation_before_issuance_refused : Script ()
test_stock_cancellation_before_issuance_refused = do
  env <- cancellationBook
  applyOpsFails env "event dated 2023-12-31 precedes the last event on security SEC-1"
    [cancel (mkCancellation "TX_STOCK_CANCEL_BEFORE_ISSUANCE" (D.date 2023 D.Dec 31) 10.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (D.date 2023 D.Dec 31) 90.0))]

test_stock_cancellation_refused_while_on_hold : Script ()
test_stock_cancellation_refused_while_on_hold = do
  env <- cancellationBook
  let d = D.date 2025 D.Jun 2
  onDate d
  _ <- placeHolds env OcfHoldTypeStopTransfer "CASE-1" d [stopLot "SEC-1"]
  applyOpsFails env "security SEC-1 carries an open hold" [cancel (mkCancellation "CXL-1" d 100.0 None) None]

-- v34 refused an issuance edit that renamed the security and orphaned its cancellation; v36 refuses
-- any edit of a stock issuance's security ID.
test_stock_cancellation_source_security_id_edit_refused : Script ()
test_stock_cancellation_source_security_id_edit_refused = do
  env <- cancellationBook
  _ <- applyOps env [cancel (mkCancellation "TX_STOCK_CANCEL_1" (jan 2) 50.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 50.0))]
  restateOpsFails env "cannot change stock issuance ISS-SEC-1's security ID"
    [RestateEdit (OcfRecordDataStockIssuance (sec1 with security_id = "SEC-RENAMED"; quantity = 25.0))]

-- =============================================================================
-- SPLITS AND THE UNITS RULE
-- =============================================================================

-- A split dated after the issuance scales the source at the event.
test_stock_cancellation_later_split_scales_source : Script ()
test_stock_cancellation_later_split_scales_source = do
  env <- cancellationBook
  recordSplit env "TX_STOCK_SPLIT_LATER" "CLS-A" 2.0 1.0 (jan 2)
  applyOpsFails env "exceeds the 200.0 of security SEC-1" [cancel (mkCancellation "CXL-1" (jan 3) 201.0 None) None]
  let c = mkCancellation "TX_STOCK_CANCEL_AFTER_LATER_SPLIT" (jan 3) 150.0 (Some "SEC-1-R")
  _ <- applyOps env [cancel c (Some (balanceOf "SEC-1-R" (jan 3) 50.0))]
  expectRecord env (OcfRecordDataStockCancellation c)
  b <- stateOf env "SEC-1-R"
  b.quantity === 50.0
  b.split_epoch === 1

test_stock_cancellation_later_reverse_split_scales_source : Script ()
test_stock_cancellation_later_reverse_split_scales_source = do
  env <- cancellationBook
  recordSplit env "TX_STOCK_REVERSE_SPLIT_LATER" "CLS-A" 1.0 2.0 (jan 2)
  applyOpsFails env "event quantity 60.0 exceeds the 50.0 of security SEC-1"
    [cancel (mkCancellation "TX_STOCK_CANCEL_AFTER_REVERSE_SPLIT" (jan 3) 60.0 None) None]
  _ <- applyOps env [cancel (mkCancellation "CXL-OK" (jan 3) 50.0 None) None]
  hasState env "SEC-1" >>= (=== False)

-- An issuance dated after a split is already in post-split units: the split does not scale it.
test_stock_cancellation_earlier_split_does_not_scale_source : Script ()
test_stock_cancellation_earlier_split_does_not_scale_source = do
  env <- setupEnv
  _ <- applyRecords env [OcfRecordDataStakeholder (stakeholderData "SH-A"), OcfRecordDataStockClass (stockClass "CLS-A")]
  recordSplit env "TX_STOCK_SPLIT_EARLIER" "CLS-A" 2.0 1.0 (D.date 2023 D.Dec 31)
  _ <- applyRecords env [OcfRecordDataStockIssuance sec1]
  (.split_epoch) <$> stateOf env "SEC-1" >>= (=== 1)
  applyOpsFails env "event quantity 150.0 exceeds the 100.0 of security SEC-1"
    [cancel (mkCancellation "TX_STOCK_CANCEL_AFTER_EARLIER_SPLIT" (jan 2) 150.0 None) None]
  _ <- applyOps env [cancel (mkCancellation "CXL-OK" (jan 2) 100.0 None) None]
  pure ()

-- v34 refused a reduction on a split's day that fit only if it came after the split. v36's units
-- rule settles the order: a record dated on the split's day is post-split.
test_stock_cancellation_on_split_day_is_post_split : Script ()
test_stock_cancellation_on_split_day_is_post_split = do
  env <- cancellationBook
  recordSplit env "TX_STOCK_SPLIT_WITH_SAME_DAY_REDUCTION" "CLS-A" 2.0 1.0 (jan 2)
  applyOpsFails env "event quantity 201.0 exceeds the 200.0" [cancel (mkCancellation "CXL-1" (jan 2) 201.0 None) None]
  -- A balance in pre-split units is refused.
  applyOpsFails env "balance SEC-1-R must hold the remaining 50.0"
    [cancel (mkCancellation "TX_STOCK_CANCEL_SAME_DAY_AS_SPLIT" (jan 2) 150.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 25.0))]
  let c = mkCancellation "TX_STOCK_CANCEL_SAME_DAY_AS_SPLIT" (jan 2) 150.0 (Some "SEC-1-R")
  _ <- applyOps env [cancel c (Some (balanceOf "SEC-1-R" (jan 2) 50.0))]
  expectRecord env (OcfRecordDataStockCancellation c)
  b <- stateOf env "SEC-1-R"
  b.quantity === 50.0
  b.split_epoch === 1

test_stock_cancellation_on_reverse_split_day_is_post_split : Script ()
test_stock_cancellation_on_reverse_split_day_is_post_split = do
  env <- cancellationBook
  recordSplit env "TX_STOCK_REVERSE_SPLIT_WITH_SAME_DAY_REDUCTION" "CLS-A" 1.0 2.0 (jan 2)
  applyOpsFails env "event quantity 60.0 exceeds the 50.0 of security SEC-1"
    [cancel (mkCancellation "TX_STOCK_CANCEL_SAME_DAY_AS_REVERSE_SPLIT" (jan 2) 60.0 None) None]
  let c = mkCancellation "TX_STOCK_SAFE_REVERSE_SPLIT_CANCEL" (jan 2) 40.0 (Some "SEC-1-R")
  _ <- applyOps env [cancel c (Some (balanceOf "SEC-1-R" (jan 2) 10.0))]
  (.quantity) <$> stateOf env "SEC-1-R" >>= (=== 10.0)

-- A split dated on the issuance's own day but recorded after it cannot say whether the issuance's
-- quantity is pre- or post-split. v34 assumed the lower balance; v36 fails closed: the state's
-- split epoch is stale, and its next event is refused until a restatement fixes it.
test_stock_cancellation_split_on_issuance_day_fails_closed : Script ()
test_stock_cancellation_split_on_issuance_day_fails_closed = do
  env <- cancellationBook
  recordSplit env "TX_STOCK_SPLIT_SAME_DAY" "CLS-A" 2.0 1.0 (jan 1)
  applyOpsFails env "stale split epoch on security SEC-1"
    [cancel (mkCancellation "TX_STOCK_CANCEL_AFTER_SAME_DAY_SPLIT" (jan 2) 150.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 50.0))]
  applyOpsFails env "stale split epoch on security SEC-1" [cancel (mkCancellation "CXL-SMALL" (jan 2) 10.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 90.0))]

test_stock_cancellation_reverse_split_on_issuance_day_fails_closed : Script ()
test_stock_cancellation_reverse_split_on_issuance_day_fails_closed = do
  env <- cancellationBook
  recordSplit env "TX_STOCK_REVERSE_SPLIT_ON_ISSUANCE_DATE" "CLS-A" 1.0 2.0 (jan 1)
  applyOpsFails env "stale split epoch on security SEC-1"
    [cancel (mkCancellation "TX_STOCK_CANCEL_AFTER_SAME_DAY_REVERSE_SPLIT" (jan 2) 75.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 25.0))]

-- =============================================================================
-- VALIDATOR
-- =============================================================================

test_stock_cancellation_ensure_refuses_invalid_data : Script ()
test_stock_cancellation_ensure_refuses_invalid_data = do
  env <- cancellationBook
  let whole = mkCancellation "CXL-1" (jan 2) 100.0 None
  applyOpsFails env "precondition" [cancel (whole with reason_text = "") None]
  applyOpsFails env "precondition" [cancel (whole with comments = [""]) None]
  -- A zero quantity leaves the whole security as the balance, which the record's ensure refuses.
  applyOpsFails env "precondition" [cancel (mkCancellation "CXL-1" (jan 2) 0.0 (Some "SEC-1-R")) (Some (balanceOf "SEC-1-R" (jan 2) 100.0))]
  applyOpsFails env "precondition" [cancel (mkCancellation "CXL-1" (jan 2) 10.0 (Some "")) (Some (balanceOf "" (jan 2) 90.0))]
  applyOpsFails env "an empty ID cannot be claimed" [cancel (whole with id = "") None]
  applyOpsFails env "no active state for security  in this write" [cancel (whole with security_id = "") None]
  hasState env "SEC-1" >>= (=== True)

test_stock_cancellation_validator_branches : Script ()
test_stock_cancellation_validator_branches = do
  let c = mkCancellation "CXL-1" (jan 2) 10.0 (Some "SEC-1-R")
      ok = validateStockCancellationOcfData
  expectTrue "the fixture" (ok c)
  expectTrue "no balance" (ok c with balance_security_id = None)
  expectFalse "empty id" (ok c with id = "")
  expectFalse "empty security_id" (ok c with security_id = "")
  expectFalse "zero quantity" (ok c with quantity = 0.0)
  expectFalse "negative quantity" (ok c with quantity = -1.0)
  expectFalse "empty reason_text" (ok c with reason_text = "")
  expectFalse "an empty comment" (ok c with comments = [""])
  expectFalse "an empty balance_security_id" (ok c with balance_security_id = Some "")
