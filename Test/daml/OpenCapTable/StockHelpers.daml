import OpenCapTable.Harness

-- =============================================================================
-- RECORD PAYLOADS
-- =============================================================================

-- | The data of the active record with this object ID, read from the ACS.
recordDataOf : Env -> Text -> Script OcfRecordData
recordDataOf env objectId = do
  rcid <- recordCidOf env objectId
  case rcid of
    OcfRecordCidConvertibleAcceptance cid -> load OcfRecordDataConvertibleAcceptance cid
    OcfRecordCidConvertibleCancellation cid -> load OcfRecordDataConvertibleCancellation cid
    OcfRecordCidConvertibleConversion cid -> load OcfRecordDataConvertibleConversion cid
    OcfRecordCidConvertibleIssuance cid -> load OcfRecordDataConvertibleIssuance cid
    OcfRecordCidConvertibleRetraction cid -> load OcfRecordDataConvertibleRetraction cid
    OcfRecordCidConvertibleTransfer cid -> load OcfRecordDataConvertibleTransfer cid
    OcfRecordCidDocument cid -> load OcfRecordDataDocument cid
    OcfRecordCidEquityCompensationAcceptance cid -> load OcfRecordDataEquityCompensationAcceptance cid
    OcfRecordCidEquityCompensationCancellation cid -> load OcfRecordDataEquityCompensationCancellation cid
    OcfRecordCidEquityCompensationExercise cid -> load OcfRecordDataEquityCompensationExercise cid
    OcfRecordCidEquityCompensationIssuance cid -> load OcfRecordDataEquityCompensationIssuance cid
    OcfRecordCidEquityCompensationRelease cid -> load OcfRecordDataEquityCompensationRelease cid
    OcfRecordCidEquityCompensationRepricing cid -> load OcfRecordDataEquityCompensationRepricing cid
    OcfRecordCidEquityCompensationRetraction cid -> load OcfRecordDataEquityCompensationRetraction cid
    OcfRecordCidEquityCompensationTransfer cid -> load OcfRecordDataEquityCompensationTransfer cid
    OcfRecordCidFinancing cid -> load OcfRecordDataFinancing cid
    OcfRecordCidIssuer cid -> load OcfRecordDataIssuer cid
    OcfRecordCidIssuerAuthorizedSharesAdjustment cid -> load OcfRecordDataIssuerAuthorizedSharesAdjustment cid
    OcfRecordCidStakeholder cid -> load OcfRecordDataStakeholder cid
    OcfRecordCidStakeholderRelationshipChangeEvent cid -> load OcfRecordDataStakeholderRelationshipChangeEvent cid
    OcfRecordCidStakeholderStatusChangeEvent cid -> load OcfRecordDataStakeholderStatusChangeEvent cid
    OcfRecordCidStockAcceptance cid -> load OcfRecordDataStockAcceptance cid
    OcfRecordCidStockCancellation cid -> load OcfRecordDataStockCancellation cid
    OcfRecordCidStockClass cid -> load OcfRecordDataStockClass cid
    OcfRecordCidStockClassAuthorizedSharesAdjustment cid -> load OcfRecordDataStockClassAuthorizedSharesAdjustment cid
    OcfRecordCidStockClassConversionRatioAdjustment cid -> load OcfRecordDataStockClassConversionRatioAdjustment cid
    OcfRecordCidStockClassSplit cid -> load OcfRecordDataStockClassSplit cid
    OcfRecordCidStockConsolidation cid -> load OcfRecordDataStockConsolidation cid
    OcfRecordCidStockConversion cid -> load OcfRecordDataStockConversion cid
    OcfRecordCidStockHold cid -> load OcfRecordDataStockHold cid
    OcfRecordCidStockHoldCancellation cid -> load OcfRecordDataStockHoldCancellation cid
    OcfRecordCidStockIssuance cid -> load OcfRecordDataStockIssuance cid
    OcfRecordCidStockLegendTemplate cid -> load OcfRecordDataStockLegendTemplate cid
    OcfRecordCidStockPlan cid -> load OcfRecordDataStockPlan cid
    OcfRecordCidStockPlanPoolAdjustment cid -> load OcfRecordDataStockPlanPoolAdjustment cid
    OcfRecordCidStockPlanReturnToPool cid -> load OcfRecordDataStockPlanReturnToPool cid
    OcfRecordCidStockReissuance cid -> load OcfRecordDataStockReissuance cid
    OcfRecordCidStockRepurchase cid -> load OcfRecordDataStockRepurchase cid
    OcfRecordCidStockRetraction cid -> load OcfRecordDataStockRetraction cid
    OcfRecordCidStockTransfer cid -> load OcfRecordDataStockTransfer cid
    OcfRecordCidValuation cid -> load OcfRecordDataValuation cid
    OcfRecordCidVestingAcceleration cid -> load OcfRecordDataVestingAcceleration cid
    OcfRecordCidVestingEvent cid -> load OcfRecordDataVestingEvent cid
    OcfRecordCidVestingStart cid -> load OcfRecordDataVestingStart cid
    OcfRecordCidVestingTerms cid -> load OcfRecordDataVestingTerms cid
    OcfRecordCidWarrantAcceptance cid -> load OcfRecordDataWarrantAcceptance cid
    OcfRecordCidWarrantCancellation cid -> load OcfRecordDataWarrantCancellation cid
    OcfRecordCidWarrantExercise cid -> load OcfRecordDataWarrantExercise cid
    OcfRecordCidWarrantIssuance cid -> load OcfRecordDataWarrantIssuance cid
    OcfRecordCidWarrantRetraction cid -> load OcfRecordDataWarrantRetraction cid
    OcfRecordCidWarrantTransfer cid -> load OcfRecordDataWarrantTransfer cid
  where
    load : (Template t, HasEnsure t, HasField "ocf_data" t d) => (d -> OcfRecordData) -> ContractId t -> Script OcfRecordData
    load wrap cid = do
      r <- queryContractId env.transfer_agent cid
      case r of
        Some c -> pure (wrap c.ocf_data)
        None -> fail ("record " <> objectId <> " is not visible to the TA")

-- | Requires the active record with this object ID to hold exactly this data.
expectRecord : Env -> OcfRecordData -> Script ()
expectRecord env d = do
  let objectId = (recordView env.ctx d).object_id
  actual <- recordDataOf env objectId
  unless (actual == d) (fail ("record " <> objectId <> " holds " <> show actual <> ", expected " <> show d))

-- | Requires a pure check to hold, naming the case that failed.
expectTrue : Text -> Bool -> Script ()
expectTrue label ok = unless ok (fail ("expected: " <> label))

expectFalse : Text -> Bool -> Script ()
expectFalse label ok = when ok (fail ("expected to fail: " <> label))

-- =============================================================================
-- SPLITS
-- =============================================================================

freezeClass : Env -> Text -> Script ()
freezeClass env cls = do
  _ <- updateOps env [UpdateFreezeClass cls]
  pure ()

unfreezeClass : Env -> Text -> Script ()
unfreezeClass env cls = do
  _ <- updateOps env [UpdateUnfreezeClass cls]
  pure ()

-- | Records a split in one update: freeze the class, record the split, unfreeze.
recordSplit : Env -> Text -> Text -> Decimal -> Decimal -> Date -> Script ()
recordSplit env id cls n d dt = do
  _ <- updateOps env
    [ UpdateFreezeClass cls
    , UpdateCreate (ApplyRecord (OcfRecordDataStockClassSplit (split id cls n d dt)))
    , UpdateUnfreezeClass cls
    ]
  pure ()

-- =============================================================================
-- DEFINITIONS
-- =============================================================================

-- | Vesting terms with one start condition that vests everything.
vestingTerms : Text -> VestingTermsOcfData
vestingTerms id = VestingTermsOcfData with
  id
  allocation_type = OcfAllocationTypeCumulativeRounding
  description = "All at once"
  name = "Terms " <> id
  comments = []
  vesting_conditions =
    [ OcfVestingCondition with
        id = "VC-START"
        trigger = OcfVestingStartTrigger
        next_condition_ids = []
        description = None
        portion = Some OcfVestingConditionPortion with numerator = 1.0; denominator = 1.0; remainder = None
        quantity = None
    ]

-- =============================================================================
-- WARRANTS, CONVERTIBLES AND EQUITY COMPENSATION
-- =============================================================================

warrantTriggerId : Text
warrantTriggerId = "WR-TRIGGER"

convertibleTriggerId : Text
convertibleTriggerId = "CV-TRIGGER"

-- | A warrant for 100 shares of CLS-A, exercisable at will.
warrantIssuance : Text -> Text -> WarrantIssuanceOcfData
warrantIssuance sec sh = WarrantIssuanceOcfData with
  id = "ISS-" <> sec
  custom_id = "W-" <> sec
  date = d2024
  purchase_price = usd 1.0
  security_id = sec
  stakeholder_id = sh
  comments = []
  exercise_triggers =
    [ OcfConversionTrigger with
        conversion_right = OcfRightWarrant OcfWarrantConversionRight with
          conversion_mechanism = OcfWarrantMechanismFixedAmount OcfFixedAmountConversionMechanism with converts_to_quantity = 100.0
          converts_to_future_round = None
          converts_to_stock_class_id = Some "CLS-A"
        trigger_id = warrantTriggerId
        type_ = OcfConversionTriggerTypeElectiveAtWill
        end_date = None
        nickname = None
        start_date = None
        trigger_condition = None
        trigger_date = None
        trigger_description = None
    ]
  security_law_exemptions = []
  vestings = []
  board_approval_date = None
  consideration_text = None
  exercise_price = Some (usd 1.0)
  quantity = Some 100.0
  quantity_source = None
  stockholder_approval_date = None
  vesting_terms_id = None
  warrant_expiration_date = None

-- | A 10,000 USD SAFE with one at-will conversion trigger.
convertibleIssuance : Text -> Text -> ConvertibleIssuanceOcfData
convertibleIssuance sec sh = ConvertibleIssuanceOcfData with
  id = "ISS-" <> sec
  convertible_type = OcfConvertibleTypeSafe
  custom_id = "SAFE-" <> sec
  date = d2024
  investment_amount = usd 10000.0
  security_id = sec
  seniority = 1
  stakeholder_id = sh
  comments = []
  conversion_triggers =
    [ OcfConvertibleConversionTrigger with
        conversion_right = OcfConvertibleConversionRight with
          conversion_mechanism = OcfConvMechCustom OcfCustomConversionMechanism with custom_conversion_description = "Converts at the next round"
          converts_to_future_round = None
          converts_to_stock_class_id = None
        trigger_id = convertibleTriggerId
        type_ = OcfConversionTriggerTypeElectiveAtWill
        end_date = None
        nickname = None
        start_date = None
        trigger_condition = None
        trigger_date = None
        trigger_description = None
    ]
  security_law_exemptions = []
  board_approval_date = None
  consideration_text = None
  pro_rata = None
  stockholder_approval_date = None

-- | 100 RSUs, fully vested.
equityCompensationIssuance : Text -> Text -> EquityCompensationIssuanceOcfData
equityCompensationIssuance sec sh = EquityCompensationIssuanceOcfData with
  id = "ISS-" <> sec
  compensation_type = OcfCompensationTypeRsu
  custom_id = "RSU-" <> sec
  date = d2024
  quantity = 100.0
  security_id = sec
  stakeholder_id = sh
  comments = []
  security_law_exemptions = []
  termination_exercise_windows = []
  vestings = []
  base_price = None
  board_approval_date = None
  consideration_text = None
  early_exercisable = None
  exercise_price = None
  expiration_date = None
  stock_class_id = None
  stock_plan_id = None
  stockholder_approval_date = None
  vesting_terms_id = None

eventDate : Date
eventDate = D.date 2024 D.Mar 1

warrantTransfer : Text -> Text -> [Text] -> Optional Text -> WarrantTransferOcfData
warrantTransfer id sec resulting balance = WarrantTransferOcfData with
  id; date = eventDate; quantity = 100.0; security_id = sec; comments = []
  resulting_security_ids = resulting; balance_security_id = balance; consideration_text = None

warrantCancellation : Text -> Text -> Optional Text -> WarrantCancellationOcfData
warrantCancellation id sec balance = WarrantCancellationOcfData with
  id; date = eventDate; quantity = 10.0; reason_text = "Partial cancellation"; security_id = sec
  comments = []; balance_security_id = balance

warrantExercise : Text -> Text -> [Text] -> WarrantExerciseOcfData
warrantExercise id sec resulting = WarrantExerciseOcfData with
  id; date = eventDate; security_id = sec; trigger_id = warrantTriggerId; comments = []
  resulting_security_ids = resulting; consideration_text = None

convertibleTransfer : Text -> Text -> [Text] -> Optional Text -> ConvertibleTransferOcfData
convertibleTransfer id sec resulting balance = ConvertibleTransferOcfData with
  id; date = eventDate; amount = usd 10000.0; security_id = sec; comments = []
  resulting_security_ids = resulting; balance_security_id = balance; consideration_text = None

convertibleCancellation : Text -> Text -> Optional Text -> ConvertibleCancellationOcfData
convertibleCancellation id sec balance = ConvertibleCancellationOcfData with
  id; date = eventDate; amount = usd 10.0; reason_text = "Partial cancellation"; security_id = sec
  comments = []; balance_security_id = balance

convertibleConversion : Text -> Text -> [Text] -> ConvertibleConversionOcfData
convertibleConversion id sec resulting = ConvertibleConversionOcfData with
  id; date = eventDate; reason_text = "Qualified financing"; security_id = sec; trigger_id = convertibleTriggerId
  comments = []; resulting_security_ids = resulting; balance_security_id = None
  capitalization_definition = None; quantity_converted = Some 100.0

equityCompensationTransfer : Text -> Text -> [Text] -> Optional Text -> EquityCompensationTransferOcfData
equityCompensationTransfer id sec resulting balance = EquityCompensationTransferOcfData with
  id; date = eventDate; quantity = 100.0; security_id = sec; comments = []
  resulting_security_ids = resulting; balance_security_id = balance; consideration_text = None

equityCompensationCancellation : Text -> Text -> Optional Text -> EquityCompensationCancellationOcfData
equityCompensationCancellation id sec balance = EquityCompensationCancellationOcfData with
  id; date = eventDate; quantity = 10.0; reason_text = "Partial cancellation"; security_id = sec
  comments = []; balance_security_id = balance

equityCompensationExercise : Text -> Text -> [Text] -> EquityCompensationExerciseOcfData
equityCompensationExercise id sec resulting = EquityCompensationExerciseOcfData with
  id; date = eventDate; quantity = 100.0; security_id = sec; comments = []
  resulting_security_ids = resulting; consideration_text = None

equityCompensationRelease : Text -> Text -> [Text] -> EquityCompensationReleaseOcfData
equityCompensationRelease id sec resulting = EquityCompensationReleaseOcfData with
  id; date = eventDate; quantity = 100.0; release_price = usd 1.0; security_id = sec
  settlement_date = eventDate; comments = []; resulting_security_ids = resulting; consideration_text = None

-- | The standard book plus a warrant W-1, a convertible CV-1 and RSUs EC-1, all held by SH-A.
instrumentBook : Script Env
instrumentBook = do
  env <- standardBook
  _ <- applyRecords env
    [ OcfRecordDataWarrantIssuance (warrantIssuance "W-1" "SH-A")
    , OcfRecordDataConvertibleIssuance (convertibleIssuance "CV-1" "SH-A")
    , OcfRecordDataEquityCompensationIssuance (equityCompensationIssuance "EC-1" "SH-A")
    ]
  pure env
