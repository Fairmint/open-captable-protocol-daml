-- Convertible cancellations through CapTable_Update: whole and partial cancellations with a balance convertible, their security references, the cancellation validator and the shared edit and delete rules.
module OpenCapTable.TestConvertibleCancellation where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary(..))
import Fairmint.OpenCapTable.OCF.ConvertibleCancellation (ConvertibleCancellationOcfData(..), validateConvertibleCancellationOcfData)
import OpenCapTable.Harness
import OpenCapTable.WarrantConvertibleFixtures

cancellation : Text -> Text -> Decimal -> ConvertibleCancellationOcfData
cancellation id sec amount = ConvertibleCancellationOcfData with
  id
  amount = usd amount
  date = D.date 2024 D.Nov 3
  reason_text = "Full cancellation"
  security_id = sec
  comments = []
  balance_security_id = None

cc : ConvertibleCancellationOcfData -> OcfRecordData
cc = OcfRecordDataConvertibleCancellation

test_convertible_cancellation_create : Script ()
test_convertible_cancellation_create = do
  env <- instrumentBook
  let c = cancellation "TX_CONV_CANCEL_1" "C-1" 100000.0
  _ <- applyRecords env [cc c]
  expectRecord env (cc c)
  viewSecurityIds env "TX_CONV_CANCEL_1" >>= (=== ["C-1"])
  -- The cancelled convertible's issuance record stays, and a convertible has no stock state.
  expectRecord env (OcfRecordDataConvertibleIssuance (convertibleIssuance "CI-1" "C-1" "SH-A"))
  hasState env "C-1" >>= (=== False)
  applyRecordsFails env "ID already used: TX_CONV_CANCEL_1" [OcfRecordDataStakeholder (stakeholderData "TX_CONV_CANCEL_1")]

test_convertible_cancellation_partial_with_balance : Script ()
test_convertible_cancellation_partial_with_balance = do
  env <- instrumentBook
  let d = D.date 2024 D.Jun 15
      balance = (convertibleIssuance "CI-PARTIAL-BAL" "SEC-CONV-PARTIAL-BAL" "SH-A") with date = d; investment_amount = usd 75000.0
      c = (cancellation "TX_CONV_CANCEL_PARTIAL" "C-1" 25000.0) with
        date = d
        reason_text = "Partial cancellation - investor early exit"
        balance_security_id = Some "SEC-CONV-PARTIAL-BAL"
        comments = ["Partial cancellation approved by board", "Remaining balance: $75,000"]
  -- The balance convertible is issued in the same batch, after the cancellation that names it.
  _ <- applyRecords env [cc c, OcfRecordDataConvertibleIssuance balance]
  expectRecord env (cc c)
  expectRecord env (OcfRecordDataConvertibleIssuance balance)
  viewSecurityIds env "TX_CONV_CANCEL_PARTIAL" >>= (=== ["C-1", "SEC-CONV-PARTIAL-BAL"])

test_convertible_cancellation_security_references : Script ()
test_convertible_cancellation_security_references = do
  env <- instrumentBook
  let c = cancellation "CC-1" "C-1" 1000.0
  applyRecordsFails env "Convertible cancellation security not found: C-NONE" [cc c with security_id = "C-NONE"]
  applyRecordsFails env "Convertible cancellation security W-1 is carried by a OcfObjectTypeTxWarrantIssuance" [cc c with security_id = "W-1"]
  applyRecordsFails env "Convertible cancellation security S-A1 is carried by a OcfObjectTypeTxStockIssuance" [cc c with security_id = "S-A1"]
  -- An object ID is not a security ID.
  applyRecordsFails env "Convertible cancellation security not found: CI-1" [cc c with security_id = "CI-1"]
  applyRecordsFails env "Convertible cancellation balance security not found: C-BAL-NONE" [cc c with balance_security_id = Some "C-BAL-NONE"]
  applyRecordsFails env "Convertible cancellation balance security W-1 is carried by a OcfObjectTypeTxWarrantIssuance"
    [cc c with balance_security_id = Some "W-1"]

test_convertible_cancellation_validator : Script ()
test_convertible_cancellation_validator = do
  env <- instrumentBook
  let base = cancellation "CC-V" "C-1" 1000.0
      rejects : Text -> Text -> ConvertibleCancellationOcfData -> Script ()
      rejects label expected c = do
        expectInvalid label (validateConvertibleCancellationOcfData c)
        applyRecordsFails env expected [cc c]
  expectValid "base" (validateConvertibleCancellationOcfData base)
  rejects "empty id" "an empty ID cannot be claimed" base with id = ""
  rejects "empty security_id" "precondition" base with security_id = ""
  rejects "zero amount" "precondition" base with amount = usd 0.0
  rejects "negative amount" "precondition" base with amount = usd (-1.0)
  rejects "empty currency" "precondition" base with amount = OcfMonetary with amount = 1.0; currency = ""
  rejects "two-letter currency" "precondition" base with amount = OcfMonetary with amount = 1.0; currency = "US"
  rejects "empty reason" "precondition" base with reason_text = ""
  rejects "empty comment" "precondition" base with comments = ["ok", ""]
  rejects "empty balance security" "precondition" base with balance_security_id = Some ""

test_convertible_cancellation_edit_and_delete : Script ()
test_convertible_cancellation_edit_and_delete = do
  env <- instrumentBook
  let c = cancellation "CC-1" "C-1" 1000.0
  _ <- applyRecords env [cc c]
  restateOpsFails env "precondition" [RestateEdit (cc c with amount = usd 0.0)]
  restateOpsFails env "Convertible cancellation balance security not found: C-BAL" [RestateEdit (cc c with balance_security_id = Some "C-BAL")]
  checkEditAndDelete env (cc c) (cc c with amount = usd 2000.0; reason_text = "Corrected amount")
