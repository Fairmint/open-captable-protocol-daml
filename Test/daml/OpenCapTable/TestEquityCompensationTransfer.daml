-- Equity compensation transfers, ported from v34's TestEquityCompensationTransfer: partial and whole transfers into resulting and balance grants written in the same batch, the validator, and the security, resulting and balance references (all grants).
module OpenCapTable.TestEquityCompensationTransfer where

import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate hiding (restate)
import Fairmint.OpenCapTable.OCF.EquityCompensationIssuance (EquityCompensationIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationTransfer
import OpenCapTable.EquityFixtures
import OpenCapTable.Harness

valid : EquityCompensationTransferOcfData -> Bool
valid = validateEquityCompensationTransferOcfData

wrap : EquityCompensationTransferOcfData -> OcfRecordData
wrap = OcfRecordDataEquityCompensationTransfer

transfer : Text -> Text -> Decimal -> [Text] -> Optional Text -> EquityCompensationTransferOcfData
transfer id sec q resulting balance = EquityCompensationTransferOcfData with
  id
  date = D.date 2025 D.Jun 1
  quantity = q
  security_id = sec
  comments = []
  resulting_security_ids = resulting
  balance_security_id = balance
  consideration_text = None

-- | An NSO grant expiring on 2032-01-15.
nso : Text -> Text -> Decimal -> Date -> EquityCompensationIssuanceOcfData
nso sec sh q d = (option sec sh q) with date = d; exercise_price = Some (usd 0.5); expiration_date = Some (D.date 2032 D.Jan 15)

-- | A book with Alice's NSO `sec` over `q` shares, granted on 2022-01-15.
grantBook : Text -> Decimal -> Script Env
grantBook sec q = ecBookWith [ecRecord (nso sec "SH-A" q (D.date 2022 D.Jan 15))]

-- An NSO transferred in part to a family trust, with the remainder in a balance grant.
test_ec_transfer_partial_to_family_trust : Script ()
test_ec_transfer_partial_to_family_trust = do
  env <- grantBook "ESEC-NSO-001" 10000.0
  let d = D.date 2025 D.Jun 1
      t = (transfer "TX_EQUITY_COMP_TRANSFER_1" "ESEC-NSO-001" 5000.0 ["ESEC-NSO-TRANSFERRED-001"] (Some "ESEC-NSO-REMAIN")) with
        comments = ["NSO transfer to family trust per company approval"]
        consideration_text = Some "Transfer of 5,000 NSOs to family trust for estate planning."
      resulting = nso "ESEC-NSO-TRANSFERRED-001" "SH-B" 5000.0 d
      balance = nso "ESEC-NSO-REMAIN" "SH-A" 5000.0 d
  _ <- applyRecords env [wrap t, ecRecord resulting, ecRecord balance]
  expectRecord env (wrap t)
  expectRecord env (ecRecord resulting)
  expectRecord env (ecRecord balance)

test_ec_transfer_whole_grant : Script ()
test_ec_transfer_whole_grant = do
  env <- grantBook "ESEC-NSO-FULL" 2500.0
  let d = D.date 2025 D.Sep 15
      t = (transfer "TX_EQUITY_COMP_TRANSFER_FULL" "ESEC-NSO-FULL" 2500.0 ["ESEC-NSO-NEWHOLDER"] None) with
        date = d
        comments = ["Full NSO grant transferred to irrevocable trust"]
        consideration_text = Some "Transfer of entire NSO grant to irrevocable trust per estate planning documents."
  _ <- applyRecords env [ecRecord (nso "ESEC-NSO-NEWHOLDER" "SH-B" 2500.0 d), wrap t]
  expectRecord env (wrap t)

test_ec_transfer_with_approval_comments : Script ()
test_ec_transfer_with_approval_comments = do
  env <- grantBook "ESEC-NSO-APPROVAL" 15000.0
  let d = D.date 2025 D.Nov 1
      t = (transfer "TX_EQUITY_COMP_TRANSFER_APPROVED" "ESEC-NSO-APPROVAL" 8000.0 ["ESEC-NSO-TRUST"] (Some "ESEC-NSO-REMAINING")) with
        date = d
        comments =
          [ "Transfer approved by Board on 2025-10-15"
          , "Transfer approved by Compensation Committee on 2025-10-20"
          , "Transferee: Smith Family Irrevocable Trust dated 2020-03-01"
          ]
  _ <- applyRecords env
    [ ecRecord (nso "ESEC-NSO-REMAINING" "SH-A" 7000.0 d)
    , ecRecord (nso "ESEC-NSO-TRUST" "SH-B" 8000.0 d)
    , wrap t
    ]
  expectRecord env (wrap t)

test_ec_transfer_security_reference : Script ()
test_ec_transfer_security_reference = do
  env <- standardBook
  _ <- applyRecords env [ecRecord (option "EC-R" "SH-B" 10.0)]
  applyRecordsFails env "Equity compensation transfer security not found: EC-MISSING" [wrap (transfer "TR-1" "EC-MISSING" 10.0 ["EC-R"] None)]
  -- A stock transfer is ApplyStockTransfer; this record moves a grant.
  applyRecordsFails env "Equity compensation transfer security S-A1 is carried by a OcfObjectTypeTxStockIssuance" [wrap (transfer "TR-1" "S-A1" 10.0 ["EC-R"] None)]
  expectNoRecord env "TR-1"

test_ec_transfer_resulting_and_balance_are_grants : Script ()
test_ec_transfer_resulting_and_balance_are_grants = do
  env <- standardBook
  _ <- applyRecords env [ecRecord (option "EC-1" "SH-A" 100.0), ecRecord (option "EC-R" "SH-B" 60.0)]
  applyRecordsFails env "Equity compensation transfer resulting security security not found: EC-X" [wrap (transfer "TR-1" "EC-1" 60.0 ["EC-X"] None)]
  applyRecordsFails env "Equity compensation transfer resulting security security S-A1 is carried by a OcfObjectTypeTxStockIssuance"
    [wrap (transfer "TR-1" "EC-1" 60.0 ["S-A1"] None)]
  applyRecordsFails env "Equity compensation transfer balance security not found: EC-BAL" [wrap (transfer "TR-1" "EC-1" 60.0 ["EC-R"] (Some "EC-BAL"))]
  applyRecordsFails env "Equity compensation transfer balance security S-A2 is carried by a OcfObjectTypeTxStockIssuance"
    [wrap (transfer "TR-1" "EC-1" 60.0 ["EC-R"] (Some "S-A2"))]
  expectNoRecord env "TR-1"

test_ec_transfer_validation : Script ()
test_ec_transfer_validation = do
  env <- grantBook "EC-1" 100.0
  let t = transfer "TR-V" "EC-1" 10.0 ["EC-R"] None
  refuseWith env "an empty ID cannot be claimed" valid wrap (t with id = "")
  refuse env valid wrap (t with security_id = "")
  refuse env valid wrap (t with quantity = 0.0)
  refuse env valid wrap (t with quantity = -10.0)
  -- A transfer results in at least one security, none of them empty.
  refuse env valid wrap (t with resulting_security_ids = [])
  refuse env valid wrap (t with resulting_security_ids = ["EC-R", ""])
  refuse env valid wrap (t with comments = [""])
  refuse env valid wrap (t with balance_security_id = Some "")
  refuse env valid wrap (t with consideration_text = Some "")

test_ec_transfer_restate : Script ()
test_ec_transfer_restate = do
  env <- grantBook "EC-1" 100.0
  let t = transfer "TR-1" "EC-1" 100.0 ["EC-R"] None
  _ <- applyRecords env [ecRecord (option "EC-R" "SH-B" 100.0), wrap t]
  restateOpsFails env "changes nothing" [RestateEdit (wrap t)]
  -- An edit that adds a balance checks it.
  restateOpsFails env "Equity compensation transfer balance security not found: EC-BAL" [RestateEdit (wrap (t with quantity = 60.0; balance_security_id = Some "EC-BAL"))]
  let t' = t with consideration_text = Some "Gift"
  _ <- restateOps env [RestateEdit (wrap t')]
  expectRecord env (wrap t')
  _ <- restateOps env [RestateDelete "TR-1"]
  expectNoRecord env "TR-1"
