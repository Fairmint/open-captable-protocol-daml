-- Shared fixtures for the equity compensation and vesting record tests: a book with stakeholders and a class, minimal valid grants and instrument issuances, vesting terms and vesting records, typed reads of records from the ACS, and helpers that pair a validator with the ledger.
module OpenCapTable.EquityFixtures where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Types.Conversion
import Fairmint.OpenCapTable.Types.Core (Context)
import Fairmint.OpenCapTable.Types.Vesting (OcfCompensationType(..))
import Fairmint.OpenCapTable.OCF.ConvertibleIssuance (ConvertibleIssuanceOcfData(..), OcfConvertibleConversionTrigger(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationIssuance (EquityCompensationIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockIssuance (StockIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingAcceleration (VestingAccelerationOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingEvent (VestingEventOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingStart (VestingStartOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingTerms
import Fairmint.OpenCapTable.OCF.WarrantIssuance (WarrantIssuanceOcfData(..))
import OpenCapTable.Harness

-- =============================================================================
-- BOOKS
-- =============================================================================

-- | Stakeholders SH-A and SH-B and stock class CLS-A; no securities.
ecBook : Script Env
ecBook = do
  env <- setupEnv
  _ <- applyRecords env
    [ OcfRecordDataStakeholder (stakeholderData "SH-A")
    , OcfRecordDataStakeholder (stakeholderData "SH-B")
    , OcfRecordDataStockClass (stockClass "CLS-A")
    ]
  pure env

-- | `ecBook` plus these records, written in one batch.
ecBookWith : [OcfRecordData] -> Script Env
ecBookWith ds = do
  env <- ecBook
  _ <- applyRecords env ds
  pure env

-- =============================================================================
-- GRANTS AND OTHER ISSUANCES
-- =============================================================================

-- | An NSO over `qty` shares at 1.00 USD for stakeholder `sh`, granted on 2024-01-01, under no
-- plan, class or vesting. Its object ID is "ECI-" <> security ID.
option : Text -> Text -> Decimal -> EquityCompensationIssuanceOcfData
option sec sh qty = EquityCompensationIssuanceOcfData with
  id = "ECI-" <> sec
  compensation_type = OcfCompensationTypeOptionNso
  custom_id = "OPT-" <> sec
  date = d2024
  quantity = qty
  security_id = sec
  stakeholder_id = sh
  comments = []
  security_law_exemptions = []
  termination_exercise_windows = []
  vestings = []
  base_price = None
  board_approval_date = None
  consideration_text = None
  early_exercisable = Some False
  exercise_price = Some (usd 1.0)
  expiration_date = None
  stock_class_id = None
  stock_plan_id = None
  stockholder_approval_date = None
  vesting_terms_id = None

-- | An RSU over `qty` units: no exercise or base price.
rsu : Text -> Text -> Decimal -> EquityCompensationIssuanceOcfData
rsu sec sh qty = (option sec sh qty) with
  compensation_type = OcfCompensationTypeRsu
  custom_id = "RSU-" <> sec
  early_exercisable = None
  exercise_price = None

ecRecord : EquityCompensationIssuanceOcfData -> OcfRecordData
ecRecord = OcfRecordDataEquityCompensationIssuance

-- | A warrant over 100 shares with no exercise triggers. Its object ID is "WI-" <> security ID.
warrant : Text -> Text -> WarrantIssuanceOcfData
warrant sec sh = WarrantIssuanceOcfData with
  id = "WI-" <> sec
  custom_id = "W-" <> sec
  date = d2024
  purchase_price = usd 100.0
  security_id = sec
  stakeholder_id = sh
  comments = []
  exercise_triggers = []
  security_law_exemptions = []
  vestings = []
  board_approval_date = None
  consideration_text = None
  exercise_price = Some (usd 1.0)
  quantity = Some 100.0
  quantity_source = None
  stockholder_approval_date = None
  vesting_terms_id = None
  warrant_expiration_date = None

-- | A SAFE with one elective trigger. Its object ID is "CI-" <> security ID.
convertible : Text -> Text -> ConvertibleIssuanceOcfData
convertible sec sh = ConvertibleIssuanceOcfData with
  id = "CI-" <> sec
  convertible_type = OcfConvertibleTypeSafe
  custom_id = "SAFE-" <> sec
  date = d2024
  investment_amount = usd 50000.0
  security_id = sec
  seniority = 1
  stakeholder_id = sh
  comments = []
  conversion_triggers =
    [ OcfConvertibleConversionTrigger with
        conversion_right = OcfConvertibleConversionRight with
          conversion_mechanism = OcfConvMechSAFE OcfSAFEConversionMechanism with
            conversion_mfn = False
            capitalization_definition = None
            capitalization_definition_rules = None
            conversion_discount = None
            conversion_timing = None
            conversion_valuation_cap = None
            exit_multiple = None
          converts_to_future_round = Some True
          converts_to_stock_class_id = None
        trigger_id = "T-" <> sec
        type_ = OcfConversionTriggerTypeElectiveAtWill
        end_date = None
        nickname = None
        start_date = None
        trigger_condition = None
        trigger_date = None
        trigger_description = None
    ]
  security_law_exemptions = []
  board_approval_date = None
  consideration_text = None
  pro_rata = None
  stockholder_approval_date = None

-- =============================================================================
-- VESTING TERMS
-- =============================================================================

condition : Text -> OcfVestingTrigger -> [Text] -> OcfVestingCondition
condition id trigger next = OcfVestingCondition with
  id
  trigger
  next_condition_ids = next
  description = Some ("Condition " <> id)
  portion = None
  quantity = Some 100.0

startCondition : Text -> OcfVestingCondition
startCondition id = condition id OcfVestingStartTrigger []

eventCondition : Text -> OcfVestingCondition
eventCondition id = condition id OcfVestingEventTrigger []

terms : Text -> [OcfVestingCondition] -> VestingTermsOcfData
terms id conditions = VestingTermsOcfData with
  id
  allocation_type = OcfAllocationTypeCumulativeRounding
  description = "Vesting terms " <> id
  name = "Terms " <> id
  comments = []
  vesting_conditions = conditions

-- | Terms with one condition of the given trigger.
termsWith : Text -> Text -> OcfVestingTrigger -> VestingTermsOcfData
termsWith id conditionId trigger = terms id [condition conditionId trigger []]

termsRecord : VestingTermsOcfData -> OcfRecordData
termsRecord = OcfRecordDataVestingTerms

-- | A grant `sec` for SH-A over 100 shares on vesting terms "VT-" <> `sec`, which have one condition
-- `cond` with this trigger: the terms, then the grant.
grantOnTerms : Text -> Text -> OcfVestingTrigger -> [OcfRecordData]
grantOnTerms sec cond trigger =
  [ termsRecord (termsWith ("VT-" <> sec) cond trigger)
  , ecRecord ((option sec "SH-A" 100.0) with vesting_terms_id = Some ("VT-" <> sec))
  ]

-- | Alice's 100 shares of CLS-A issued on 2024-01-01, on these vesting terms.
stockOnTerms : Text -> Text -> StockIssuanceOcfData
stockOnTerms sec vt = (issuance sec "SH-A" "CLS-A" 100.0 d2024) with vesting_terms_id = Some vt

