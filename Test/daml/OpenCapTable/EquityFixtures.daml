vestingStart : Text -> Text -> Text -> VestingStartOcfData
vestingStart id sec cond = VestingStartOcfData with
  id
  date = d2024
  security_id = sec
  vesting_condition_id = cond
  comments = []

vestingEvent : Text -> Text -> Text -> VestingEventOcfData
vestingEvent id sec cond = VestingEventOcfData with
  id
  date = d2024
  security_id = sec
  vesting_condition_id = cond
  comments = []

acceleration : Text -> Text -> Decimal -> VestingAccelerationOcfData
acceleration id sec q = VestingAccelerationOcfData with
  id
  date = D.date 2025 D.Jan 1
  quantity = q
  reason_text = "Accelerated by board resolution"
  security_id = sec
  comments = []

startRecord : VestingStartOcfData -> OcfRecordData
startRecord = OcfRecordDataVestingStart

eventRecord : VestingEventOcfData -> OcfRecordData
eventRecord = OcfRecordDataVestingEvent

accelerationRecord : VestingAccelerationOcfData -> OcfRecordData
accelerationRecord = OcfRecordDataVestingAcceleration

-- =============================================================================
-- READING RECORDS
-- =============================================================================

-- | The context and payload of the active record with this object ID, read from the ACS by its
-- template-typed contract ID (the record types these tests write).
recordOf : Env -> Text -> Script (Context, OcfRecordData)
recordOf env objectId = do
  rcid <- recordCidOf env objectId
  let p = env.transfer_agent
  found <- case rcid of
    OcfRecordCidEquityCompensationAcceptance c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationAcceptance r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationCancellation c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationCancellation r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationExercise c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationExercise r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationIssuance c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationIssuance r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationRelease c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationRelease r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationRepricing c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationRepricing r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationRetraction c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationRetraction r.ocf_data)) <$> queryContractId p c
    OcfRecordCidEquityCompensationTransfer c -> fmap (\r -> (r.context, OcfRecordDataEquityCompensationTransfer r.ocf_data)) <$> queryContractId p c
    OcfRecordCidStockIssuance c -> fmap (\r -> (r.context, OcfRecordDataStockIssuance r.ocf_data)) <$> queryContractId p c
    OcfRecordCidVestingAcceleration c -> fmap (\r -> (r.context, OcfRecordDataVestingAcceleration r.ocf_data)) <$> queryContractId p c
    OcfRecordCidVestingEvent c -> fmap (\r -> (r.context, OcfRecordDataVestingEvent r.ocf_data)) <$> queryContractId p c
    OcfRecordCidVestingStart c -> fmap (\r -> (r.context, OcfRecordDataVestingStart r.ocf_data)) <$> queryContractId p c
    OcfRecordCidVestingTerms c -> fmap (\r -> (r.context, OcfRecordDataVestingTerms r.ocf_data)) <$> queryContractId p c
    OcfRecordCidWarrantIssuance c -> fmap (\r -> (r.context, OcfRecordDataWarrantIssuance r.ocf_data)) <$> queryContractId p c
    _ -> fail ("recordOf does not read the type of record " <> objectId)
  case found of
    Some r -> pure r
    None -> fail ("record " <> objectId <> " is not visible to the transfer agent")

objectIdOf : Env -> OcfRecordData -> Text
objectIdOf env d = (recordView env.ctx d).object_id

-- | The book holds exactly one active record under the data's object ID, with exactly this payload,
-- in this cap table's context.
expectRecord : Env -> OcfRecordData -> Script ()
expectRecord env expected = do
  (ctx, d) <- recordOf env (objectIdOf env expected)
  ctx === env.ctx
  d === expected

expectNoRecord : Env -> Text -> Script ()
expectNoRecord env objectId = hasRecord env objectId >>= (=== False)

-- =============================================================================
-- VALIDATORS AND THE LEDGER
-- =============================================================================

-- | The record's validator accepts it, the ledger writes it, and the book then holds it unchanged.
accept : Show a => Env -> (a -> Bool) -> (a -> OcfRecordData) -> a -> Script ()
accept env validate wrap d = do
  assertMsg ("the validator refused " <> show d) (validate d)
  _ <- applyRecords env [wrap d]
  expectRecord env (wrap d)

-- | The record's validator refuses it, and so does the ledger, by the template's `ensure`.
refuse : Show a => Env -> (a -> Bool) -> (a -> OcfRecordData) -> a -> Script ()
refuse env validate wrap d = do
  assertMsg ("the validator accepted " <> show d) (not (validate d))
  applyRecordsFails env "precondition" [wrap d]

-- | The validator refuses it; the ledger refuses it earlier, with this message (an empty ID is
-- stopped by its claim before the record's `ensure` runs).
refuseWith : Show a => Env -> Text -> (a -> Bool) -> (a -> OcfRecordData) -> a -> Script ()
refuseWith env expected validate wrap d = do
  assertMsg ("the validator accepted " <> show d) (not (validate d))
  applyRecordsFails env expected [wrap d]
