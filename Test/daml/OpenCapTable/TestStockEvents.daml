-- Stock security events written through CapTable_Apply: one state per lot, conservation, balances, date order, derived or claimed IDs, and vesting on outputs.
module OpenCapTable.TestStockEvents where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.Apply hiding (apply)
import Fairmint.OpenCapTable.CapTable
import Fairmint.OpenCapTable.Ids
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.State
import Fairmint.OpenCapTable.Types.Vesting (OcfVesting(..))
import Fairmint.OpenCapTable.OCF.StockAcceptance (StockAcceptanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockCancellation (StockCancellationOcfData(..))
import Fairmint.OpenCapTable.OCF.StockConsolidation (StockConsolidationOcfData(..))
import Fairmint.OpenCapTable.OCF.StockConversion (StockConversionOcfData(..))
import Fairmint.OpenCapTable.OCF.StockIssuance (StockIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockReissuance (StockReissuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockRepurchase (StockRepurchaseOcfData(..))
import Fairmint.OpenCapTable.OCF.StockRetraction (StockRetractionOcfData(..))
import Fairmint.OpenCapTable.OCF.StockTransfer (StockTransferOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingAcceleration (VestingAccelerationOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingStart (VestingStartOcfData(..))
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import OpenCapTable.DefinitionFixtures (equityCompensationIssuance, warrantIssuance)
import Fairmint.OpenCapTable.References (recordTranches)
import OpenCapTable.Harness
import OpenCapTable.TestSettlement (vestingTerms4y)

eventDay : Date
eventDay = D.date 2024 D.Mar 1

mkTransfer : Text -> Text -> Decimal -> [Text] -> Optional Text -> StockTransferOcfData
mkTransfer id sec q resulting balance = StockTransferOcfData with
  id; date = eventDay; quantity = q; security_id = sec; comments = []
  resulting_security_ids = resulting; balance_security_id = balance; consideration_text = None

out : Text -> Text -> Decimal -> StockIssuanceOcfData
out sec sh q = issuance sec sh "CLS-A" q eventDay

test_events_transfer_with_claimed_ids : Script ()
test_events_transfer_with_claimed_ids = do
  env <- standardBook
  _ <- applyOps env
    [ApplyStockTransfer with
        transfer = mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] (Some "S-A1-R")
        resulting = [out "S-B1" "SH-B" 100.0]
        balance = Some (out "S-A1-R" "SH-A" 500.0)]
  hasState env "S-A1" >>= (=== False)
  b <- stateOf env "S-B1"
  b.quantity === 100.0
  b.last_event_date === eventDay
  r <- stateOf env "S-A1-R"
  r.quantity === 500.0
  -- The writer-chosen IDs were claimed.
  applyRecordsFails env "ID already used: TR-1" [OcfRecordDataStakeholder (stakeholderData "TR-1")]

test_events_transfer_conservation : Script ()
test_events_transfer_conservation = do
  env <- standardBook
  let go t rs bal = ApplyStockTransfer with transfer = t; resulting = rs; balance = bal
  applyOpsFails env "must hold exactly its quantity"
    [go (mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] (Some "S-A1-R")) [out "S-B1" "SH-B" 90.0] (Some (out "S-A1-R" "SH-A" 500.0))]
  applyOpsFails env "must hold the remaining"
    [go (mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] (Some "S-A1-R")) [out "S-B1" "SH-B" 100.0] (Some (out "S-A1-R" "SH-A" 499.0))]
  applyOpsFails env "needs a balance issuance"
    [go (mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] None) [out "S-B1" "SH-B" 100.0] None]
  applyOpsFails env "has no balance"
    [go (mkTransfer "TR-1" "S-A1" 600.0 ["S-B1"] (Some "S-A1-R")) [out "S-B1" "SH-B" 600.0] (Some (out "S-A1-R" "SH-A" 0.0))]
  applyOpsFails env "must name its balance security"
    [go (mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] (Some "S-X")) [out "S-B1" "SH-B" 100.0] (Some (out "S-A1-R" "SH-A" 500.0))]
  applyOpsFails env "in order"
    [go (mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] (Some "S-A1-R")) [out "S-B2" "SH-B" 100.0] (Some (out "S-A1-R" "SH-A" 500.0))]
  applyOpsFails env "stay with the source's stakeholder"
    [go (mkTransfer "TR-1" "S-A1" 100.0 ["S-B1"] (Some "S-A1-R")) [out "S-B1" "SH-B" 100.0] (Some (out "S-A1-R" "SH-B" 500.0))]
  applyOpsFails env "exceeds"
    [go (mkTransfer "TR-1" "S-A1" 700.0 ["S-B1"] None) [out "S-B1" "SH-B" 700.0] None]

test_events_transfer_needs_resulting_class : Script ()
test_events_transfer_needs_resulting_class = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockClass (stockClass "CLS-B")]
  applyOpsFails env "stay in the source's class"
    [ApplyStockTransfer with
        transfer = mkTransfer "TR-1" "S-A1" 600.0 ["S-B1"] None
        resulting = [(out "S-B1" "SH-B" 600.0) with stock_class_id = "CLS-B"]
        balance = None]

test_events_double_spend_refused : Script ()
test_events_double_spend_refused = do
  env <- standardBook
  inputs <- allInputs env
  let t1 = ApplyStockTransfer with transfer = mkTransfer "TR-1" "S-A2" 400.0 ["S-B1"] None; resulting = [out "S-B1" "SH-B" 400.0]; balance = None
      t2 = ApplyStockTransfer with transfer = mkTransfer "TR-2" "S-A2" 400.0 ["S-B2"] None; resulting = [out "S-B2" "SH-B" 400.0]; balance = None
  _ <- submit env.transfer_agent do exerciseCmd env.cap_table CapTable_Apply with inputs; operations = [t1]
  -- The second write was prepared against the same state, which the first consumed.
  submitMustFail env.transfer_agent do exerciseCmd env.cap_table CapTable_Apply with inputs; operations = [t2]
  -- Against the current book, the security is gone.
  applyOpsFails env "no active state for security S-A2" [t2]

test_events_derived_ids : Script ()
test_events_derived_ids = do
  env <- standardBook
  let tid = derived env "S-A2" 0 DerivedRoleEvent 0
      rsec = derived env "S-A2" 0 DerivedRoleResultingSecurity 0
      riss = derived env "S-A2" 0 DerivedRoleResultingIssuance 0
  _ <- applyOps env
    [ApplyStockTransfer with
        transfer = mkTransfer tid "S-A2" 400.0 [rsec] None
        resulting = [(out rsec "SH-B" 400.0) with id = riss]
        balance = None]
  hasState env rsec >>= (=== True)
  -- A derived-form ID other than the ledger's own is refused.
  let wrong = derived env "S-A1" 7 DerivedRoleEvent 0
  applyOpsFails env "derived form"
    [ApplyStockTransfer with
        transfer = mkTransfer wrong "S-A1" 600.0 ["S-B9"] None
        resulting = [out "S-B9" "SH-B" 600.0]
        balance = None]

test_events_date_order : Script ()
test_events_date_order = do
  env <- standardBook
  let acc d = OcfRecordDataStockAcceptance StockAcceptanceOcfData with id = "ACC-" <> show d; date = d; security_id = "S-A1"; comments = []
  _ <- applyRecords env [acc (D.date 2024 D.Jun 1)]
  applyRecordsFails env "precedes the last event" [acc (D.date 2024 D.May 1)]
  s <- stateOf env "S-A1"
  s.seq === 1
  s.last_event_date === D.date 2024 D.Jun 1

test_events_cancellation_and_repurchase : Script ()
test_events_cancellation_and_repurchase = do
  env <- standardBook
  let c = StockCancellationOcfData with
        id = "CXL-1"; date = eventDay; quantity = 100.0; reason_text = "forfeit"; security_id = "S-A1"
        comments = []; balance_security_id = Some "S-A1-R"
  _ <- applyOps env [ApplyStockCancellation with cancellation = c; balance = Some (out "S-A1-R" "SH-A" 500.0)]
  (.quantity) <$> stateOf env "S-A1-R" >>= (=== 500.0)
  let r = StockRepurchaseOcfData with
        id = "REP-1"; date = eventDay; price = usd 1.0; quantity = 400.0; security_id = "S-A2"
        comments = []; balance_security_id = None; consideration_text = None
  _ <- applyOps env [ApplyStockRepurchase with repurchase = r; balance = None]
  hasState env "S-A2" >>= (=== False)

test_events_retraction_and_events_after_it : Script ()
test_events_retraction_and_events_after_it = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockRetraction StockRetractionOcfData with id = "RET-1"; date = eventDay; reason_text = "x"; security_id = "S-A2"; comments = []]
  -- An event on a retired security fails: its state is gone.
  applyRecordsFails env "no active state for security S-A2"
    [OcfRecordDataStockAcceptance StockAcceptanceOcfData with id = "ACC-1"; date = eventDay; security_id = "S-A2"; comments = []]

test_events_conversion_to_other_class : Script ()
test_events_conversion_to_other_class = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockClass (stockClass "CLS-B")]
  let c = StockConversionOcfData with
        id = "CONV-1"; date = eventDay; quantity_converted = 400.0; security_id = "S-A2"
        comments = []; resulting_security_ids = ["S-A2-C"]; balance_security_id = None
  -- Conversion arithmetic is the writer's: 400 preferred into 800 common.
  _ <- applyOps env [ApplyStockConversion with conversion = c; resulting = [(out "S-A2-C" "SH-A" 800.0) with stock_class_id = "CLS-B"]; balance = None]
  s <- stateOf env "S-A2-C"
  s.stock_class_id === "CLS-B"
  s.quantity === 800.0

test_events_reissuance_same_class_conserves : Script ()
test_events_reissuance_same_class_conserves = do
  env <- standardBook
  let r = StockReissuanceOcfData with
        id = "REISS-1"; date = eventDay; security_id = "S-A2"; comments = []
        resulting_security_ids = ["S-A2-X", "S-A2-Y"]; reason_text = None; split_transaction_id = None
  applyOpsFails env "must conserve the quantity" [ApplyStockReissuance with reissuance = r; resulting = [out "S-A2-X" "SH-A" 100.0, out "S-A2-Y" "SH-A" 100.0]]
  _ <- applyOps env [ApplyStockReissuance with reissuance = r; resulting = [out "S-A2-X" "SH-A" 100.0, out "S-A2-Y" "SH-A" 300.0]]
  (.quantity) <$> stateOf env "S-A2-Y" >>= (=== 300.0)

test_events_consolidation : Script ()
test_events_consolidation = do
  env <- standardBook
  let c = StockConsolidationOcfData with
        id = "CONS-1"; date = eventDay; resulting_security_id = "S-A-ALL"; comments = []
        security_ids = ["S-A1", "S-A2"]; reason_text = None
  applyOpsFails env "must yield the sum" [ApplyStockConsolidation with consolidation = c; resulting_issuance = out "S-A-ALL" "SH-A" 999.0]
  applyOpsFails env "names each security once" [ApplyStockConsolidation with consolidation = (c with security_ids = ["S-A1", "S-A1"]); resulting_issuance = out "S-A-ALL" "SH-A" 1200.0]
  _ <- applyOps env [ApplyStockConsolidation with consolidation = c; resulting_issuance = out "S-A-ALL" "SH-A" 1000.0]
  hasState env "S-A1" >>= (=== False)
  hasState env "S-A2" >>= (=== False)
  (.quantity) <$> stateOf env "S-A-ALL" >>= (=== 1000.0)

test_events_consolidation_one_class : Script ()
test_events_consolidation_one_class = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockClass (stockClass "CLS-B"), OcfRecordDataStockIssuance (issuance "S-B1" "SH-A" "CLS-B" 5.0 d2024)]
  let c = StockConsolidationOcfData with
        id = "CONS-1"; date = eventDay; resulting_security_id = "S-ALL"; comments = []
        security_ids = ["S-A1", "S-B1"]; reason_text = None
  applyOpsFails env "share one class" [ApplyStockConsolidation with consolidation = c; resulting_issuance = out "S-ALL" "SH-A" 605.0]

-- Outputs never vest ahead of their source: unvested shares move with their tranches.
test_events_transfer_conserves_vesting : Script ()
test_events_transfer_conserves_vesting = do
  env <- standardBook
  let t1 = D.date 2024 D.Feb 1
      t2 = D.date 2025 D.Feb 1
      tranches = [(OcfVesting with amount = 50.0; date = t1), (OcfVesting with amount = 50.0; date = t2)]
  _ <- applyRecords env [OcfRecordDataStockIssuance ((issuance "S-V" "SH-A" "CLS-A" 100.0 d2024) with vestings = tranches)]
  let t = mkTransfer "TR-V" "S-V" 60.0 ["S-V-B"] (Some "S-V-R")
      buyer vs = (out "S-V-B" "SH-B" 60.0) with vestings = vs
      balance vs = (out "S-V-R" "SH-A" 40.0) with vestings = vs
  -- A fully vested buyer lot would vest 60 + 20 = 80 by the event, but only 50 has.
  applyOpsFails env "more than the 50.0"
    [ApplyStockTransfer with transfer = t; resulting = [buyer []]; balance = Some (balance [(OcfVesting with amount = 20.0; date = t1), (OcfVesting with amount = 20.0; date = t2)])]
  -- A balance of a tranche lot must carry explicit vestings summing to its quantity.
  applyOpsFails env "explicit vestings that sum"
    [ApplyStockTransfer with transfer = t; resulting = [buyer [(OcfVesting with amount = 30.0; date = t1), (OcfVesting with amount = 30.0; date = t2)]]; balance = Some (balance [])]
  _ <- applyOps env
    [ApplyStockTransfer with
        transfer = t
        resulting = [buyer [(OcfVesting with amount = 30.0; date = t1), (OcfVesting with amount = 30.0; date = t2)]]
        balance = Some (balance [(OcfVesting with amount = 20.0; date = t1), (OcfVesting with amount = 20.0; date = t2)])]
  pure ()

-- A free transfer conserves each date's vested amount: it splits tranches, never moves vested
-- shares to later dates, and never replaces tranches with vesting terms.
test_events_transfer_keeps_each_dates_vesting : Script ()
test_events_transfer_keeps_each_dates_vesting = do
  env <- standardBook
  let t1 = D.date 2024 D.Feb 1
      t2 = D.date 2025 D.Feb 1
      tranches = [(OcfVesting with amount = 50.0; date = t1), (OcfVesting with amount = 50.0; date = t2)]
  _ <- applyRecords env [OcfRecordDataStockIssuance ((issuance "S-V" "SH-A" "CLS-A" 100.0 d2024) with vestings = tranches)]
  let t = mkTransfer "TR-V" "S-V" 60.0 ["S-V-B"] (Some "S-V-R")
      buyer vs = (out "S-V-B" "SH-B" 60.0) with vestings = vs
      balance vs = (out "S-V-R" "SH-A" 40.0) with vestings = vs
  applyOpsFails env "but security S-V has vested 50.0"
    [ApplyStockTransfer with
        transfer = t
        resulting = [buyer [(OcfVesting with amount = 30.0; date = t1), (OcfVesting with amount = 30.0; date = t2)]]
        balance = Some (balance [(OcfVesting with amount = 40.0; date = t2)])]
  applyOpsFails env "replaces them with vesting terms"
    [ApplyStockTransfer with
        transfer = t
        resulting = [(buyer []) with vesting_terms_id = Some "VT-1"]
        balance = Some (balance [(OcfVesting with amount = 20.0; date = t1), (OcfVesting with amount = 20.0; date = t2)])]
  -- A fully vested lot stays fully vested.
  applyOpsFails env "but security S-A2 has vested 400.0"
    [ApplyStockTransfer with
        transfer = mkTransfer "TR-F" "S-A2" 400.0 ["S-A2-B"] None
        resulting = [(out "S-A2-B" "SH-B" 400.0) with vestings = [OcfVesting with amount = 400.0; date = D.date 2030 D.Jan 1]]
        balance = None]

-- From a lot on vesting terms, the balance's tranches dated on or before the transfer equal the
-- vested shares it keeps: the snapshot's 40 less the 30 the resulting issuance takes vested.
test_events_transfer_from_terms_lot_keeps_vested : Script ()
test_events_transfer_from_terms_lot_keeps_vested = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataVestingTerms vestingTerms4y]
  _ <- applyRecords env [OcfRecordDataStockIssuance ((issuance "S-V1" "SH-A" "CLS-A" 100.0 d2024) with vesting_terms_id = Some "VT-4Y")]
  _ <- applyOps env [ApplyVestingSnapshot with security_id = "S-V1"; as_of = D.date 2025 D.Mar 1; vested = 40.0]
  let day = D.date 2025 D.Mar 3
      t = (mkTransfer "TR-T" "S-V1" 30.0 ["S-V1-B"] (Some "S-V1-R")) with date = day
      resulting = issuance "S-V1-B" "SH-B" "CLS-A" 30.0 day
      balance vs = (issuance "S-V1-R" "SH-A" "CLS-A" 70.0 day) with vestings = vs
  applyOpsFails env "but keeps 10.0 vested shares"
    [ApplyStockTransfer with transfer = t; resulting = [resulting]; balance = Some (balance [OcfVesting with amount = 70.0; date = D.date 2027 D.Jan 1])]
  _ <- applyOps env
    [ApplyStockTransfer with
        transfer = t
        resulting = [resulting]
        balance = Some (balance [(OcfVesting with amount = 10.0; date = D.date 2025 D.Mar 1), (OcfVesting with amount = 60.0; date = D.date 2027 D.Jan 1)])]
  rest <- stateOf env "S-V1-R"
  rest.quantity === 70.0

-- An output may take a claimed object ID and a derived security ID; deleting it releases only
-- what was claimed.
test_events_output_with_claimed_object_and_derived_security : Script ()
test_events_output_with_claimed_object_and_derived_security = do
  env <- standardBook
  let rsec = derived env "S-A2" 0 DerivedRoleResultingSecurity 0
      t = mkTransfer "TR-M" "S-A2" 400.0 [rsec] None
  _ <- applyOps env [ApplyStockTransfer with transfer = t; resulting = [(out rsec "SH-B" 400.0) with id = "ISS-R1"]; balance = None]
  hasState env rsec >>= (=== True)
  _ <- restateOps env [RestateDelete "ISS-R1", RestateEndState rsec]
  hasState env rsec >>= (=== False)
  hasRecord env "ISS-R1" >>= (=== False)

-- Every issuance's tranches count toward the 20,000 a transaction reads or writes, warrants' and
-- equity compensation's as well as stock's. (A transaction at the cap is too large for the script
-- service, so this checks the count each record contributes.)
test_events_every_issuance_counts_its_tranches : Script ()
test_events_every_issuance_counts_its_tranches = do
  let tranches = map (\i -> OcfVesting with amount = 1.0; date = D.addDays d2024 i) [1 .. 1500]
  recordTranches (OcfRecordDataStockIssuance ((issuance "S-T" "SH-A" "CLS-A" 1500.0 d2024) with vestings = tranches)) === 1500
  recordTranches (OcfRecordDataEquityCompensationIssuance ((equityCompensationIssuance "EC-1" "SEC-EC-1" "SH-A") with quantity = 1500.0; vestings = tranches)) === 1500
  recordTranches (OcfRecordDataWarrantIssuance ((warrantIssuance "W-1" "SEC-W-1" "SH-A") with vestings = tranches)) === 1500
  recordTranches (OcfRecordDataStakeholder (stakeholderData "SH-A")) === 0

test_events_partial_cover_takes_no_partial_event : Script ()
test_events_partial_cover_takes_no_partial_event = do
  env <- standardBook
  _ <- applyRecords env [OcfRecordDataStockIssuance ((issuance "S-P" "SH-A" "CLS-A" 100.0 d2024) with vestings = [(OcfVesting with amount = 50.0; date = d2024)])]
  applyOpsFails env "covering less than its quantity"
    [ApplyStockTransfer with
        transfer = mkTransfer "TR-P" "S-P" 10.0 ["S-P-B"] (Some "S-P-R")
        resulting = [(out "S-P-B" "SH-B" 10.0) with vestings = [(OcfVesting with amount = 10.0; date = d2024)]]
        balance = Some ((out "S-P-R" "SH-A" 90.0) with vestings = [(OcfVesting with amount = 40.0; date = d2024), (OcfVesting with amount = 50.0; date = D.date 2030 D.Jan 1)])]

test_events_vesting_records_on_stock : Script ()
test_events_vesting_records_on_stock = do
  env <- standardBook
  let later = D.date 2025 D.Jan 1
      tranches = [(OcfVesting with amount = 50.0; date = d2024), (OcfVesting with amount = 50.0; date = D.date 2026 D.Jan 1)]
  _ <- applyRecords env [OcfRecordDataStockIssuance ((issuance "S-T" "SH-A" "CLS-A" 100.0 d2024) with vestings = tranches)]
  -- An acceleration pulls the earliest unvested tranche forward.
  _ <- applyRecords env [OcfRecordDataVestingAcceleration VestingAccelerationOcfData with
    id = "ACC-1"; date = later; quantity = 20.0; reason_text = "x"; security_id = "S-T"; comments = []]
  s <- stateOf env "S-T"
  s.vesting === StockVestingTranches
    [ OcfVesting with amount = 50.0; date = d2024
    , OcfVesting with amount = 20.0; date = later
    , OcfVesting with amount = 30.0; date = D.date 2026 D.Jan 1
    ]
  applyRecordsFails env "unvested quantity" [OcfRecordDataVestingAcceleration VestingAccelerationOcfData with
    id = "ACC-2"; date = later; quantity = 31.0; reason_text = "x"; security_id = "S-T"; comments = []]
  -- A fully vested security cannot be accelerated.
  applyRecordsFails env "fully vested" [OcfRecordDataVestingAcceleration VestingAccelerationOcfData with
    id = "ACC-3"; date = later; quantity = 1.0; reason_text = "x"; security_id = "S-A1"; comments = []]
  -- A vesting start on a security without vesting terms is refused (it names no condition).
  applyRecordsFails env "has no vesting terms" [OcfRecordDataVestingStart VestingStartOcfData with
    id = "VS-1"; date = d2024; security_id = "S-T"; vesting_condition_id = "VC-1"; comments = []]

test_events_snapshots : Script ()
test_events_snapshots = do
  env <- standardBook
  applyOpsFails env "not on vesting terms" [ApplyVestingSnapshot with security_id = "S-A1"; as_of = eventDay; vested = 1.0]
  pure ()
