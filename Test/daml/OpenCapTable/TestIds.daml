-- Claimed and derived IDs: uniqueness across types and instruments, the derived-form rule, shard selection, splitting and release.
module OpenCapTable.TestIds where

import DA.Assert ((===))
import DA.List (head, sort)
import qualified DA.Map as Map
import qualified DA.Set as Set
import qualified DA.Text as T
import Daml.Script

import Fairmint.OpenCapTable.Apply hiding (applyOperation)
import Fairmint.OpenCapTable.CapTable
import Fairmint.OpenCapTable.Update (UpdateOperation(..))
import Fairmint.OpenCapTable.Ids
import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate (RestateOperation(..))
import Fairmint.OpenCapTable.State (OcfIdShard(..), validateOcfIdShard)
import OpenCapTable.Harness

