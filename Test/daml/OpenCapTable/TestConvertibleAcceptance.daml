-- Convertible acceptances through CapTable_Apply and CapTable_Restate: a record on the convertible's security, its security reference, the acceptance validator and the shared edit and delete rules.
module OpenCapTable.TestConvertibleAcceptance where

import DA.Assert ((===))
import qualified DA.Date as D
import Daml.Script

import Fairmint.OpenCapTable.OcfRecords
import Fairmint.OpenCapTable.Restate hiding (restate)
import Fairmint.OpenCapTable.OCF.ConvertibleAcceptance (ConvertibleAcceptanceOcfData(..), validateConvertibleAcceptanceOcfData)
import OpenCapTable.Harness
import OpenCapTable.WarrantConvertibleFixtures

acceptance : Text -> Text -> Date -> ConvertibleAcceptanceOcfData
acceptance id sec d = ConvertibleAcceptanceOcfData with id; date = d; security_id = sec; comments = []

ca : ConvertibleAcceptanceOcfData -> OcfRecordData
ca = OcfRecordDataConvertibleAcceptance

test_convertible_acceptance_create : Script ()
test_convertible_acceptance_create = do
  env <- instrumentBook
  let a = acceptance "TX_CONV_ACCEPT_1" "C-1" (D.date 2024 D.Jan 2)
  _ <- applyRecords env [ca a]
  expectRecord env (ca a)
  viewSecurityIds env "TX_CONV_ACCEPT_1" >>= (=== ["C-1"])
  hasRecord env "CI-1" >>= (=== True)
  applyRecordsFails env "ID already used: TX_CONV_ACCEPT_1" [OcfRecordDataStakeholder (stakeholderData "TX_CONV_ACCEPT_1")]

test_convertible_acceptance_with_comments : Script ()
test_convertible_acceptance_with_comments = do
  env <- instrumentBook
  let a = (acceptance "TX_CONV_ACCEPT_2" "C-1" (D.date 2024 D.Jan 3)) with
        comments = ["SAFE agreement countersigned", "Wire transfer confirmed"]
  _ <- applyRecords env [ca a]
  expectRecord env (ca a)

test_convertible_acceptance_security_reference : Script ()
test_convertible_acceptance_security_reference = do
  env <- instrumentBook
  applyRecordsFails env "Convertible acceptance security not found: C-NONE" [ca (acceptance "CA-1" "C-NONE" eventDate)]
  applyRecordsFails env "Convertible acceptance security W-1 is carried by a OcfObjectTypeTxWarrantIssuance" [ca (acceptance "CA-1" "W-1" eventDate)]
  applyRecordsFails env "Convertible acceptance security S-A1 is carried by a OcfObjectTypeTxStockIssuance" [ca (acceptance "CA-1" "S-A1" eventDate)]
  -- The convertible may be issued later in the same batch.
  let a = acceptance "CA-2" "C-2" eventDate
  _ <- applyRecords env [ca a, OcfRecordDataConvertibleIssuance (convertibleIssuance "CI-2" "C-2" "SH-B")]
  expectRecord env (ca a)

test_convertible_acceptance_validator : Script ()
test_convertible_acceptance_validator = do
  env <- instrumentBook
  let base = acceptance "CA-V" "C-1" eventDate
  expectValid "base" (validateConvertibleAcceptanceOcfData base)
  expectInvalid "empty id" (validateConvertibleAcceptanceOcfData base with id = "")
  expectInvalid "empty security_id" (validateConvertibleAcceptanceOcfData base with security_id = "")
  expectInvalid "empty comment" (validateConvertibleAcceptanceOcfData base with comments = [""])
  applyRecordsFails env "an empty ID cannot be claimed" [ca base with id = ""]
  applyRecordsFails env "precondition" [ca base with security_id = ""]
  applyRecordsFails env "precondition" [ca base with comments = [""]]

test_convertible_acceptance_edit_and_delete : Script ()
test_convertible_acceptance_edit_and_delete = do
  env <- instrumentBook
  let a = acceptance "CA-1" "C-1" eventDate
  _ <- applyRecords env [ca a]
  restateOpsFails env "precondition" [RestateEdit (ca a with comments = [""])]
  restateOpsFails env "Convertible acceptance security not found: C-NONE" [RestateEdit (ca a with security_id = "C-NONE")]
  checkEditAndDelete env (ca a) (ca a with comments = ["Countersigned"])
