module OpenCapTable.Positions.Common where

import DA.Date (Month(..))
import qualified DA.Date as D
import DA.Text qualified as T
import DA.Time (time)
import Daml.Script

import Fairmint.OpenCapTable.Types.Core (Context(..))
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary(..))
import Fairmint.OpenCapTable.Types.Stock (OcfStockClassType(..), OcfInitialSharesAuthorized(..))
import Fairmint.OpenCapTable.OCF.Issuer (IssuerOcfData(..))
import Fairmint.OpenCapTable.OCF.Stakeholder (StakeholderOcfData(..), OcfName(..), OcfStakeholderType(..))
import Fairmint.OpenCapTable.OCF.StockClass (StockClassOcfData(..))
import Fairmint.OpenCapTable.OCF.StockIssuance (StockIssuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockTransfer (StockTransferOcfData(..))
import Fairmint.OpenCapTable.IssuerAuthorization (IssuerAuthorization(..), CreateCapTable(..))
import qualified Fairmint.OpenCapTable.CapTable as CT

expectFail : Text -> Text -> SubmitOptions -> Commands a -> Script ()
expectFail label reason opts cmds = do
  r <- trySubmit opts cmds
  case r of
    Right _ -> fail ("UNEXPECTED SUCCESS [" <> label <> "]")
    Left e -> do
      let msg = show e
      debugRaw ("EXPECTED-FAILURE [" <> label <> "]: " <> T.take 400 msg)
      if reason `T.isInfixOf` msg
        then pure ()
        else fail ("FAILED FOR THE WRONG REASON [" <> label <> "], expected '" <> reason <> "', got: " <> msg)

d0 : Time
d0 = time (D.date 2024 Jan 01) 0 0 0

dTransfer : Time
dTransfer = time (D.date 2025 Jun 01) 0 0 0

usd : Decimal -> OcfMonetary
usd a = OcfMonetary with amount = a; currency = "USD"

mkStockClass : Text -> StockClassOcfData
mkStockClass cid = StockClassOcfData with
  id = cid; name = "Common " <> cid; class_type = OcfStockClassTypeCommon; default_id_prefix = "CS-"
  initial_shares_authorized = OcfInitialSharesNumeric 100000000000.0
  votes_per_share = 1.0; seniority = 1.0; board_approval_date = None; stockholder_approval_date = None
  par_value = None; price_per_share = None; liquidation_preference_multiple = None
  participation_cap_multiple = None; conversion_rights = []; comments = []

mkStakeholder : Text -> StakeholderOcfData
mkStakeholder sid = StakeholderOcfData with
  id = sid
  name = OcfName with legal_name = "Holder " <> sid; first_name = None; last_name = None
  stakeholder_type = OcfStakeholderTypeIndividual
  issuer_assigned_id = None; current_relationships = []; current_status = None
  primary_contact = None; contact_info = None; addresses = []; tax_ids = []; comments = []

mkIssuance : Text -> Text -> Text -> Decimal -> StockIssuanceOcfData
mkIssuance cls sec sh qty = StockIssuanceOcfData with
  id = "ISS-" <> sec; custom_id = "CS-" <> sec; date = d0; quantity = qty; security_id = sec
  share_price = usd 1.0; stakeholder_id = sh; stock_class_id = cls
  comments = []; security_law_exemptions = []; share_numbers_issued = []; stock_legend_ids = []
  vestings = []; board_approval_date = None; consideration_text = None; cost_basis = None
  issuance_type = None; stock_plan_id = None; stockholder_approval_date = None; vesting_terms_id = None

mkTransfer : Text -> Text -> Decimal -> [Text] -> Optional Text -> StockTransferOcfData
mkTransfer tid sec qty resulting balance = StockTransferOcfData with
  id = tid; date = dTransfer; quantity = qty; security_id = sec; comments = []
  resulting_security_ids = resulting; balance_security_id = balance; consideration_text = None

data Book = Book with
    sysop : Party
    issuer : Party
    ctx : Context
    root : ContractId CT.CapTable

newBook : Script Book
newBook = do
  sysop <- allocateParty "sysop"
  issuer <- allocateParty "issuer"
  let ctx = Context with issuer; system_operator = sysop
  auth <- submit sysop $ createCmd IssuerAuthorization with context = ctx
  root <- submit issuer $ exerciseCmd auth CreateCapTable with
    issuer_data = IssuerOcfData with
      id = "ISSUER_1"; legal_name = "Proto Issuer Inc."; formation_date = time (D.date 2020 Jan 15) 12 0 0
      country_of_formation = "US"; country_subdivision_of_formation = None
      country_subdivision_name_of_formation = None; dba = None; email = None
      initial_shares_authorized = Some (OcfInitialSharesNumeric 100000000000.0)
      phone = None; address = None; tax_ids = []; comments = []
  pure Book with ..

update : Book -> [CT.OcfCreateData] -> [CT.OcfEditData] -> [CT.OcfDeleteData] -> Script Book
update b creates edits deletes = do
  r <- submit b.issuer $ exerciseCmd b.root CT.UpdateCapTable with creates; edits; deletes
  pure b with root = r.updatedCapTableCid
