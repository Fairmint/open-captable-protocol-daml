-- | The root guard on books with a position-managed class: no root write may name a stock security
-- of a managed class, migrated or not, and a managed class cannot be deleted. Writes that name only
-- securities of unmanaged classes still pass, and migration batches still work after enabling.
module OpenCapTable.Positions.TestRootGuard where

import DA.Assert
import DA.Date (Month(..))
import qualified DA.Date as D
import qualified DA.Map as Map
import DA.Optional (fromOptional)
import DA.Time (time)
import Daml.Script

import Fairmint.OpenCapTable.OCF.EquityCompensationExercise (EquityCompensationExerciseOcfData(..))
import Fairmint.OpenCapTable.OCF.VestingStart (VestingStartOcfData(..))
import qualified Fairmint.OpenCapTable.CapTable as CT
import Fairmint.OpenCapTable.Positions

import OpenCapTable.Positions.Common
import OpenCapTable.Positions.TestMigration

-- | A date before every other record of the guard book.
dOld : Time
dOld = time (D.date 2015 Jan 01) 0 0 0

-- | Classes SC (position-managed) and PREF, stakeholders SH-A to SH-D, and:
--
-- * S-A -> TR-AB -> S-B: a transfer inside SC.
-- * S-D1 and S-D2: plain SC issuances.
-- * S-E1 and S-Y: plain PREF issuances.
--
-- Positions are enabled for SC; nothing is migrated yet.
guardBook : Script Book
guardBook = migrationBook
  [ CT.OcfCreateStakeholder (mkStakeholder "SH-D")
  , stock "SC" "S-A" "SH-A" dA 100.0
  , transferOf "TR-AB" dB "S-A" 100.0 ["S-B"] None
  , stock "SC" "S-B" "SH-B" dB 100.0
  , stock "SC" "S-D1" "SH-D" dA 30.0
  , stock "SC" "S-D2" "SH-D" dA 20.0
  , stock "PREF" "S-E1" "SH-B" dA 50.0
  , stock "PREF" "S-Y" "SH-A" dA 5.0
  ]

-- | TR-AB with its comments changed (an edit must change something).
editedTransferAB : CT.OcfEditData
editedTransferAB = CT.OcfEditStockTransfer ((mkTransfer "TR-AB" "S-A" 100.0 ["S-B"] None) with
  date = dB; comments = ["corrected"])

-- G1: an edit cannot move an unmigrated root issuance into a position-managed class: the guard
-- checks the proposed version, not only the stored one.
test_G1_editIntoManagedClass : Script ()
test_G1_editIntoManagedClass = do
  b <- guardBook
  expectRootWriteFails "G1 edit moves a root issuance into the managed class"
    "stock issuance ISS-S-E1 (proposed) is in position-managed class SC"
    b [] [CT.OcfEditStockIssuance ((mkIssuance "SC" "S-E1" "SH-B" 50.0) with date = dA)] []
  -- an edit that keeps the issuance in its root-managed class still works
  _ <- update b [] [CT.OcfEditStockIssuance ((mkIssuance "PREF" "S-E1" "SH-B" 60.0) with date = dA)] []
  pure ()

-- G2: an edit or delete of a stored root issuance in a position-managed class is rejected, even
-- when the issuance was not migrated and the edit would move it out of the class.
test_G2_editStoredManagedIssuance : Script ()
test_G2_editStoredManagedIssuance = do
  b <- guardBook
  expectRootWriteFails "G2a edit moves an unmigrated issuance out of the managed class"
    "stock issuance ISS-S-D1 (stored) is in position-managed class SC"
    b [] [CT.OcfEditStockIssuance ((mkIssuance "PREF" "S-D1" "SH-D" 30.0) with date = dA)] []
  expectRootWriteFails "G2b delete of an unmigrated issuance in the managed class"
    "stock issuance ISS-S-D1 (stored) is in position-managed class SC"
    b [] [] [CT.OcfDeleteStockIssuance "ISS-S-D1"]

-- G3: every security a proposed record names is checked: a balance or resulting security, and the
-- stock securities named by equity compensation, warrant, convertible and vesting records. A
-- migrated security's root issuance stays in the managed class, so the class rule covers it.
test_G3_proposedSecurityReferences : Script ()
test_G3_proposedSecurityReferences = do
  bob <- allocateParty "bob"
  b0 <- guardBook
  (b, _) <- migrate b0 [migration "SH-B" bob ["S-B"]]
  expectRootWriteFails "G3a root transfer whose balance security is migrated"
    "stock transfer TR-G3 (proposed) references security S-B of position-managed class SC"
    b [CT.OcfCreateStockTransfer (mkTransfer "TR-G3" "S-E1" 1.0 [] (Some "S-B"))] [] []
  expectRootWriteFails "G3b equity compensation exercise resulting in a migrated security"
    "equity compensation exercise EX-G3 (proposed) references security S-B of position-managed class SC"
    b [CT.OcfCreateEquityCompensationExercise EquityCompensationExerciseOcfData with
      id = "EX-G3"; date = dTransfer; quantity = 1.0; security_id = "EC-1"; comments = []
      resulting_security_ids = ["S-B"]; consideration_text = None] [] []
  expectRootWriteFails "G3c vesting start on a migrated security"
    "vesting start VS-G3 (proposed) references security S-B of position-managed class SC"
    b [CT.OcfCreateVestingStart VestingStartOcfData with
      id = "VS-G3"; date = dTransfer; security_id = "S-B"; vesting_condition_id = "start"; comments = []] [] []

-- G4: before any migration, a root write that names an unmigrated security of the managed class is
-- rejected, whichever record it is and whether the security is its source or its result. Writes
-- that name only PREF securities pass, and migration batches still work after enabling.
test_G4_unmigratedSecuritiesOfManagedClass : Script ()
test_G4_unmigratedSecuritiesOfManagedClass = do
  bob <- allocateParty "bob"
  dave <- allocateParty "dave"
  b <- guardBook
  -- the A -> B transfer, as a delete and as an edit
  expectRootWriteFails "G4a delete a transfer inside the managed class"
    "stock transfer TR-AB (stored) references security S-A of position-managed class SC"
    b [] [] [CT.OcfDeleteStockTransfer "TR-AB"]
  expectRootWriteFails "G4b edit a transfer inside the managed class"
    "stock transfer TR-AB (proposed) references security S-A of position-managed class SC"
    b [] [editedTransferAB] []
  -- new records on unmigrated securities of the class: a cancellation, a transfer into one that
  -- would backdate its holding, a transfer out of the class
  expectRootWriteFails "G4c new cancellation of an unmigrated security"
    "stock cancellation CN-D2 (proposed) references security S-D2 of position-managed class SC"
    b [cancellationOf "CN-D2" dB "S-D2" 20.0 None] [] []
  expectRootWriteFails "G4d new transfer that results in an existing unmigrated security"
    "stock transfer TR-OLD (proposed) references security S-D1 of position-managed class SC"
    b [stock "PREF" "S-OLD" "SH-A" dOld 30.0, transferOf "TR-OLD" dB "S-OLD" 30.0 ["S-D1"] None] [] []
  expectRootWriteFails "G4e new transfer of an unmigrated security out of the class"
    "stock transfer TR-OUT (proposed) references security S-D1 of position-managed class SC"
    b [stock "PREF" "S-E9" "SH-B" dC 30.0, transferOf "TR-OUT" dC "S-D1" 30.0 ["S-E9"] None] [] []
  -- writes that name only securities of an unmanaged class still pass, as creates and as edits
  b1 <- update b
    [ stock "PREF" "S-E2" "SH-C" dC 20.0
    , stock "PREF" "S-E3" "SH-B" dC 30.0
    , transferOf "TR-E" dC "S-E1" 20.0 ["S-E2"] (Some "S-E3") ] [] []
  b2 <- update b1 []
    [ CT.OcfEditStockTransfer ((mkTransfer "TR-E" "S-E1" 20.0 ["S-E2"] (Some "S-E3")) with
        date = dC; comments = ["corrected"])
    , CT.OcfEditStockIssuance ((mkIssuance "PREF" "S-Y" "SH-A" 6.0) with date = dA) ] []
  -- migration batches still work after enabling and after the rejected writes
  (b3, [posB]) <- migrate b2 [migration "SH-B" bob ["S-B"]]
  (b4, [posD]) <- migrate b3 [migration "SH-D" dave ["S-D1", "S-D2"]]
  lotQuantities b4 posB >>= (=== [("S-B", 100.0, 1.0)])
  lotQuantities b4 posD >>= (=== [("S-D1", 30.0, 1.0), ("S-D2", 20.0, 1.0)])
  -- migrated securities stay guarded by their class
  expectRootWriteFails "G4f new cancellation of a migrated security"
    "stock cancellation CN-D1 (proposed) references security S-D1 of position-managed class SC"
    b4 [cancellationOf "CN-D1" dB "S-D1" 30.0 None] [] []

-- G5: a position-managed stock class cannot be deleted from the root, even when no root record
-- references it (its holdings were issued through the registry), and a root with position
-- registries cannot be archived.
test_G5_managedClassCannotBeDeleted : Script ()
test_G5_managedClassCannotBeDeleted = do
  alice <- allocateParty "alice"
  b0 <- newBook
  b1 <- update b0
    [ CT.OcfCreateStockClass (mkStockClass "SC")
    , CT.OcfCreateStockClass (mkStockClass "SC2")
    , CT.OcfCreateStakeholder (mkStakeholder "SH-A") ] [] []
  (root, registry) <- submit b1.issuer $ exerciseCmd b1.root CT.EnablePositions with stock_class_id = "SC"
  let b = b1 with root
  _ <- submit b.issuer $ exerciseCmd registry Registry_Issue with
    holder = alice; position = None; issuances = [mkIssuance "SC" "S-N1" "SH-A" 10.0]
  expectRootWriteFails "G5a delete the managed class"
    "stock class SC is position-managed"
    b [] [] [CT.OcfDeleteStockClass "SC"]
  -- an unmanaged class can still be deleted
  b2 <- update b [] [] [CT.OcfDeleteStockClass "SC2"]
  Some r <- queryContractId b2.issuer b2.root
  (Map.keys r.stock_classes, Map.keys (fromOptional Map.empty r.position_registries)) === (["SC"], ["SC"])
  -- so the root cannot be emptied for ArchiveCapTable, and a root whose entity maps are empty but
  -- that still has a registry (created directly, like a corrupt legacy root) is not archived
  emptied <- submit (actAs [b2.issuer, b2.sysop]) $ createCmd r with
    stock_classes = Map.empty; stakeholders = Map.empty
  expectFail "G5b archive a root with a position registry" "Cannot archive: position_registries is not empty"
    (actAs b2.sysop) $ exerciseCmd emptied CT.ArchiveCapTable
