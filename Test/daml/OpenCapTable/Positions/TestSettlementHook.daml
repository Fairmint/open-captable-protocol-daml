-- | The OCP-pinned settlement hook with TestTokenV2 (Splice 398919a5, published DAR built with
-- SDK 3.5.2): V2 allocations with executors = [TA, buyer], a buyer-signed acceptance, a pinned
-- factory and authenticated allocations, run from inside Registry_Trade.
module OpenCapTable.Positions.TestSettlementHook where

import DA.Assert
import DA.Optional (isNone, isSome)
import qualified DA.Map as Map
import qualified DA.TextMap as TextMap
import DA.Time
import Daml.Script

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.HoldingV2 as H2
import qualified Splice.Api.Token.AllocationV2 as V2
import qualified Splice.Api.Token.AllocationInstructionV2 as V2
import qualified Splice.Testing.Tokens.TestTokenV2 as TT
import qualified Splice.Testing.Tokens.TestTokenV2.Util as TTU

import qualified Fairmint.OpenCapTable.CapTable as CT
import Fairmint.OpenCapTable.Positions
import Fairmint.OpenCapTable.Settlement.BuyerAcceptance

import OpenCapTable.Positions.Common

data HEnv = HEnv with
    book : Book
    ta : Party
    admin : Party
    alice : Party
    bob : Party
    registry : ContractId PositionRegistry
    posA : ContractId StockPosition
    rules : ContractId TT.TokenRules
    ctxArgs : ExtraArgs
    now : Time

hsetup : Script HEnv
hsetup = do
  b0 <- newBook
  ta <- allocateParty "ta"
  admin <- allocateParty "cashAdmin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  b1 <- update b0
    [ CT.OcfCreateStockClass (mkStockClass "SC")
    , CT.OcfCreateStakeholder (mkStakeholder "SH-A")
    , CT.OcfCreateStakeholder (mkStakeholder "SH-B")
    , CT.OcfCreateStockIssuance (mkIssuance "SC" "S-A1" "SH-A" 100.0)
    ] [] []
  (root2, registry) <- submit b1.issuer $ exerciseCmd b1.root CT.EnablePositions with
    stock_class_id = "SC"; cash_settlement_required = True
  (root3, [posA]) <- submit b1.issuer $ exerciseCmd root2 CT.MigrateToPositions with
    stock_class_id = "SC"
    migrations = [CT.PositionMigration with stakeholder_id = "SH-A"; holder = alice; security_ids = ["S-A1"]]
  now <- getTime
  passTime (seconds 1)
  rules <- submit admin $ createCmd TT.TokenRules with admin
  let ctxArgs = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList [(TTU.tokenRulesContextKey, AV_ContractId (coerceContractId rules))]
        meta = emptyMetadata
  let book = b1 with root = root3
  pure HEnv with book; ta; admin; alice; bob; registry; posA; rules; ctxArgs; now

pinnedFactory : HEnv -> ContractId V2.SettlementFactory
pinnedFactory env = toInterfaceContractId env.rules

mint : HEnv -> Party -> Decimal -> Script (ContractId TT.Token)
mint env p amt = submit (actAs [env.admin, p]) $ createCmd TT.Token with
  holding = H2.HoldingView with
    account = basicAccount p
    instrumentId = H2.InstrumentId with admin = env.admin; id = "USD"
    amount = amt; lock = None; meta = emptyMetadata

allocate : HEnv -> Party -> V2.SettlementInfo -> V2.AllocationSpecification -> [ContractId H2.Holding] -> Script (ContractId V2.Allocation)
allocate env p settlement allocation inputs = do
  r <- submit (actAs p <> readAs env.admin) $
    exerciseCmd (toInterfaceContractId @V2.AllocationFactory env.rules) V2.AllocationFactory_Allocate with
      settlement; allocation; requestedAt = env.now; inputHoldingCids = inputs; extraArgs = env.ctxArgs; actors = [p]
  case r.output of
    V2.AllocationInstructionResult_Completed cid -> pure cid
    o -> fail ("unexpected allocation result " <> show o)

unlocked : HEnv -> Party -> Script Decimal
unlocked env p = do
  toks <- query @TT.Token p
  pure $ sum [ x.holding.amount | (_, x) <- toks, x.holding.account == basicAccount p, isNone x.holding.lock ]

locked : HEnv -> Party -> Script Decimal
locked env p = do
  toks <- query @TT.Token p
  pure $ sum [ x.holding.amount | (_, x) <- toks, x.holding.account == basicAccount p, isSome x.holding.lock ]

data Deal = Deal with
    terms : TradeShareTerms
    cash : CashLegTerms
    buyerAlloc : ContractId V2.Allocation
    sellerAlloc : ContractId V2.Allocation
    acceptance : ContractId BuyerAcceptance

-- | Buyer funds 100, commits qty*price with executors = [TA, buyer]; seller's receipt allocation;
-- issuer + TA propose the exact terms; the buyer accepts.
mkDeal : HEnv -> Text -> Decimal -> Decimal -> Script Deal
mkDeal env tid qty price = do
  tok <- mint env env.bob 100.0
  let settlement = V2.SettlementInfo with executors = [env.ta, env.bob]; id = tid; cid = None; meta = emptyMetadata
      leg = V2.TransferLeg with
        transferLegId = "cash"; sender = basicAccount env.bob; receiver = basicAccount env.alice
        amount = qty * price; instrumentId = "USD"; meta = emptyMetadata
      deadline = env.now `addRelTime` days 1
      side s o = V2.TransferLegSide with
        transferLegId = "cash"; side = s; otherside = o; amount = qty * price; instrumentId = "USD"; meta = emptyMetadata
  buyerAlloc <- allocate env env.bob settlement V2.AllocationSpecification with
      admin = env.admin; authorizer = basicAccount env.bob
      transferLegSides = [side V2.SenderSide (basicAccount env.alice)]
      settlementDeadline = Some deadline; nextIterationFunding = None; committed = True; meta = emptyMetadata
    [toInterfaceContractId tok]
  sellerAlloc <- allocate env env.alice settlement V2.AllocationSpecification with
      admin = env.admin; authorizer = basicAccount env.alice
      transferLegSides = [side V2.ReceiverSide (basicAccount env.bob)]
      settlementDeadline = Some deadline; nextIterationFunding = None; committed = False; meta = emptyMetadata
    []
  let terms = TradeShareTerms with
        trade_id = tid; stock_class_id = "SC"; seller_stakeholder_id = "SH-A"; buyer_stakeholder_id = "SH-B"
        buyer = env.bob; quantity = qty; share_price = usd price
      cash = CashLegTerms with cash_admin = env.admin; factory = pinnedFactory env; settlement; cash_leg = leg
  prop <- submit (actAs [env.book.issuer, env.ta]) $ createCmd BuyerAcceptanceProposal with
    context = env.book.ctx; ta = env.ta; buyer = env.bob; seller = env.alice; terms; cash
  acceptance <- submit env.bob $ exerciseCmd prop Proposal_Accept
  pure Deal with ..

tradeCmd : HEnv -> Deal -> Decimal -> Optional SettlementHookCall -> Registry_Trade
tradeCmd env d qty hook = Registry_Trade with
  trade_id = d.terms.trade_id; date = dTrade; seller_position = env.posA
  buyer = TradeBuyer with stakeholder_id = "SH-B"; party = env.bob; position = None
  quantity = qty; share_price = d.terms.share_price
  draws = [LotDraw with security_id = "S-A1"; quantity = qty]
  bucket_legend_ids = None; settlement = hook

hookCall : HEnv -> Deal -> SettlementHookCall
hookCall env d = SettlementHookCall with
  acceptance = d.acceptance; buyer_allocation = d.buyerAlloc; seller_allocation = d.sellerAlloc
  extra_args = env.ctxArgs

-- H1: shares and cash move in one transaction, run by the issuer (TA desk) alone.
test_H1_tradeWithHook : Script ()
test_H1_tradeWithHook = do
  env <- hsetup
  d <- mkDeal env "TR-1" 10.0 4.0
  r <- submit (actAs env.book.issuer <> readAs env.admin) $ exerciseCmd env.registry (tradeCmd env d 10.0 (Some (hookCall env d)))
  s <- unlocked env env.alice
  s === 40.0
  l <- locked env env.bob
  l === 0.0
  Some b <- queryContractId env.bob r.buyer_position
  Map.keys b.lots === ["TR-1-B-0"]
  None <- queryContractId env.bob d.acceptance
  pure ()

-- H2: delivered terms differ from the acceptance -> nothing moves (shares or cash).
test_H2_mismatchRollsBack : Script ()
test_H2_mismatchRollsBack = do
  env <- hsetup
  d <- mkDeal env "TR-2" 10.0 4.0
  expectFail "H2 trade 9 shares against a 10-share acceptance" "delivered terms differ from the accepted terms"
    (actAs env.book.issuer <> readAs env.admin) $ exerciseCmd env.registry (tradeCmd env d 9.0 (Some (hookCall env d)))
  Some _ <- queryContractId env.alice env.posA
  l <- locked env env.bob
  l === 40.0

-- H3: the hook cannot be run outside the registry: issuer alone, TA alone, issuer + TA, buyer.
test_H3_hookNotCallableDirectly : Script ()
test_H3_hookNotCallableDirectly = do
  env <- hsetup
  d <- mkDeal env "TR-3" 10.0 4.0
  let arg = Acceptance_SettleOnDelivery with
        delivered = d.terms; buyer_allocation = d.buyerAlloc; seller_allocation = d.sellerAlloc; extra_args = env.ctxArgs
      others = readAs [env.admin, env.bob, env.alice, env.book.sysop]
  expectFail "H3a issuer alone" "requires authorizers" (actAs env.book.issuer <> others) $ exerciseCmd d.acceptance arg
  expectFail "H3b TA alone" "requires authorizers" (actAs env.ta <> others) $ exerciseCmd d.acceptance arg
  expectFail "H3c issuer + TA" "requires authorizers" (actAs [env.book.issuer, env.ta] <> others) $ exerciseCmd d.acceptance arg
  expectFail "H3d issuer + TA + buyer" "requires authorizers" (actAs [env.book.issuer, env.ta, env.bob] <> others) $ exerciseCmd d.acceptance arg
  l <- locked env env.bob
  l === 40.0

-- H4: a cash-required registry rejects a share-only trade.
test_H4_cashRequired : Script ()
test_H4_cashRequired = do
  env <- hsetup
  d <- mkDeal env "TR-4" 10.0 4.0
  expectFail "H4 share-only trade on a cash-required registry" "requires the cash settlement hook"
    (actAs env.book.issuer) $ exerciseCmd env.registry (tradeCmd env d 10.0 None)

-- H5: TA cleanup without holder action returns the buyer's cash.
test_H5_taCancel : Script ()
test_H5_taCancel = do
  env <- hsetup
  d <- mkDeal env "TR-5" 10.0 4.0
  _ <- submit (actAs env.ta <> readAs env.admin) $ exerciseCmd d.acceptance Acceptance_Cancel with
    allocations = [d.buyerAlloc, d.sellerAlloc]; extra_args = env.ctxArgs
  b <- unlocked env env.bob
  b === 100.0

-- H6: an allocation of another trade is rejected before the buyer's authority reaches it.
test_H6_allocationAuthenticated : Script ()
test_H6_allocationAuthenticated = do
  env <- hsetup
  d <- mkDeal env "TR-6" 10.0 4.0
  other <- mkDeal env "TR-6b" 10.0 4.0
  expectFail "H6 buyer allocation of another settlement" "allocation settlement mismatch"
    (actAs env.book.issuer <> readAs env.admin) $ exerciseCmd env.registry
      (tradeCmd env d 10.0 (Some ((hookCall env d) with buyer_allocation = other.buyerAlloc)))

-- H7: the acceptance is single use; a second trade with the same acceptance fails.
test_H7_singleUse : Script ()
test_H7_singleUse = do
  env <- hsetup
  d <- mkDeal env "TR-7" 10.0 4.0
  r <- submit (actAs env.book.issuer <> readAs env.admin) $ exerciseCmd env.registry (tradeCmd env d 10.0 (Some (hookCall env d)))
  Some sp <- pure r.seller_position
  expectFail "H7 reuse of a consumed acceptance" "contract"
    (actAs env.book.issuer <> readAs env.admin) $ exerciseCmd env.registry
      ((tradeCmd env d 90.0 (Some (hookCall env d))) with seller_position = sp; draws = [LotDraw with security_id = "TR-7-R-0"; quantity = 90.0])

-- H8: the buyer revokes her acceptance before settlement. The trade then fails. FINDING: the
-- revoke also removes the TA's cleanup path (Acceptance_Cancel), and a committed allocation with
-- executors = [TA, buyer] cannot be cancelled by the TA alone, so the buyer's cash stays locked
-- until the settlement deadline. The revoke should cancel the allocations itself.
test_H8_buyerRevoke : Script ()
test_H8_buyerRevoke = do
  env <- hsetup
  d <- mkDeal env "TR-8" 10.0 4.0
  submit env.bob $ exerciseCmd d.acceptance Acceptance_BuyerRevoke
  expectFail "H8a trade after the buyer revoked" "contract"
    (actAs env.book.issuer <> readAs env.admin) $ exerciseCmd env.registry (tradeCmd env d 10.0 (Some (hookCall env d)))
  expectFail "H8b TA cleanup after the revoke" "contract"
    (actAs env.ta <> readAs env.admin) $ exerciseCmd d.acceptance Acceptance_Cancel with
      allocations = [d.buyerAlloc, d.sellerAlloc]; extra_args = env.ctxArgs
  expectFail "H8c TA alone cancels the committed allocation at the root" "requires authorizers"
    (actAs env.ta <> readAs [env.admin, env.bob]) $ exerciseCmd d.buyerAlloc V2.Allocation_Cancel with
      actors = [env.ta, env.bob]; extraArgs = env.ctxArgs
  Some _ <- queryContractId env.alice env.posA
  l <- locked env env.bob
  l === 40.0
  note "H8: after a buyer revoke the buyer's 40.0 stays locked until the settlement deadline"
