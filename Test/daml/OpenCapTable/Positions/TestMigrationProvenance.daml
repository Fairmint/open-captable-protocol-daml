-- | Migration provenance: `MigrateToPositions` gives each lot the origin security, origin date and
-- ancestry of its root stock history, and rejects history it cannot attribute to one parent. A
-- migrated lot starts without holds or a vesting snapshot and obeys every hold and vesting rule.
module OpenCapTable.Positions.TestMigrationProvenance where

import DA.Assert
import DA.Date (Month(..))
import qualified DA.Date as D
import qualified DA.Map as Map
import DA.Optional (fromOptional)
import DA.Time (time)
import Daml.Script

import Fairmint.OpenCapTable.Types.Vesting (OcfCompensationType(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationExercise (EquityCompensationExerciseOcfData(..))
import Fairmint.OpenCapTable.OCF.EquityCompensationIssuance (EquityCompensationIssuanceOcfData(..))
import Fairmint.OpenCapTable.Types.Stock (OcfRatio(..))
import Fairmint.OpenCapTable.OCF.StockCancellation (StockCancellationOcfData(..))
import Fairmint.OpenCapTable.OCF.StockClassSplit (StockClassSplitOcfData(..))
import Fairmint.OpenCapTable.OCF.StockConsolidation (StockConsolidationOcfData(..))
import Fairmint.OpenCapTable.OCF.StockConversion (StockConversionOcfData(..))
import Fairmint.OpenCapTable.OCF.StockReissuance (StockReissuanceOcfData(..))
import Fairmint.OpenCapTable.OCF.StockRepurchase (StockRepurchaseOcfData(..))
import qualified Fairmint.OpenCapTable.CapTable as CT
import Fairmint.OpenCapTable.Positions

import OpenCapTable.Positions.Common
import OpenCapTable.TestHelpers (defaultVestingTerms)

-- Dates of the provenance books: issuances at dA, later records at dB, dC and dD.
dA : Time
dA = time (D.date 2024 Jan 01) 0 0 0

dB : Time
dB = time (D.date 2024 Jun 01) 0 0 0

dC : Time
dC = time (D.date 2025 Jan 01) 0 0 0

dD : Time
dD = time (D.date 2025 Jun 01) 0 0 0

-- Root records with an explicit date.

stock : Text -> Text -> Text -> Time -> Decimal -> CT.OcfCreateData
stock cls sec sh date qty = CT.OcfCreateStockIssuance ((mkIssuance cls sec sh qty) with date = date)

transferOf : Text -> Time -> Text -> Decimal -> [Text] -> Optional Text -> CT.OcfCreateData
transferOf tid date sec qty resulting balance =
  CT.OcfCreateStockTransfer ((mkTransfer tid sec qty resulting balance) with date = date)

cancellationOf : Text -> Time -> Text -> Decimal -> Optional Text -> CT.OcfCreateData
cancellationOf cid date sec qty balance = CT.OcfCreateStockCancellation StockCancellationOcfData with
  id = cid; date = date; quantity = qty; reason_text = "Cancelled"; security_id = sec; comments = []
  balance_security_id = balance

repurchaseOf : Text -> Time -> Text -> Decimal -> Optional Text -> CT.OcfCreateData
repurchaseOf rid date sec qty balance = CT.OcfCreateStockRepurchase StockRepurchaseOcfData with
  id = rid; date = date; price = usd 1.0; quantity = qty; security_id = sec; comments = []
  balance_security_id = balance; consideration_text = None

conversionOf : Text -> Time -> Text -> Decimal -> [Text] -> Optional Text -> CT.OcfCreateData
conversionOf cid date sec qty resulting balance = CT.OcfCreateStockConversion StockConversionOcfData with
  id = cid; date = date; quantity_converted = qty; security_id = sec; comments = []
  resulting_security_ids = resulting; balance_security_id = balance

reissuanceOf : Text -> Time -> Text -> [Text] -> CT.OcfCreateData
reissuanceOf rid date sec resulting = CT.OcfCreateStockReissuance StockReissuanceOcfData with
  id = rid; date = date; security_id = sec; comments = []; resulting_security_ids = resulting
  reason_text = None; split_transaction_id = None

consolidationOf : Text -> Time -> [Text] -> Text -> CT.OcfCreateData
consolidationOf cid date secs resulting = CT.OcfCreateStockConsolidation StockConsolidationOcfData with
  id = cid; date = date; security_ids = secs; resulting_security_id = resulting; comments = []
  reason_text = None

optionGrant : Text -> Text -> Decimal -> CT.OcfCreateData
optionGrant sec sh qty = CT.OcfCreateEquityCompensationIssuance EquityCompensationIssuanceOcfData with
  id = "ISS-" <> sec; custom_id = "EC-" <> sec; date = dA; compensation_type = OcfCompensationTypeOptionNSO
  quantity = qty; security_id = sec; stakeholder_id = sh; comments = []; security_law_exemptions = []
  vestings = []; termination_exercise_windows = []; base_price = None; board_approval_date = None
  consideration_text = None; early_exercisable = None; exercise_price = Some (usd 1.0)
  expiration_date = None; stock_class_id = None; stock_plan_id = None; stockholder_approval_date = None
  vesting_terms_id = None

classSplit : Text -> Time -> Decimal -> Decimal -> CT.OcfCreateData
classSplit sid date numerator denominator = CT.OcfCreateStockClassSplit StockClassSplitOcfData with
  id = sid; date = date; stock_class_id = "SC"; comments = []
  split_ratio = OcfRatio with numerator; denominator

exerciseOf : Text -> Time -> Text -> Decimal -> [Text] -> CT.OcfCreateData
exerciseOf eid date sec qty resulting = CT.OcfCreateEquityCompensationExercise EquityCompensationExerciseOcfData with
  id = eid; date = date; quantity = qty; security_id = sec; comments = []
  resulting_security_ids = resulting; consideration_text = None

-- | A book with classes SC (position-managed) and PREF, stakeholders SH-A, SH-B and SH-C, and the
-- given records; positions are enabled for SC.
provenanceBook : [CT.OcfCreateData] -> Script Book
provenanceBook records = do
  b0 <- newBook
  b1 <- update b0
    ([ CT.OcfCreateStockClass (mkStockClass "SC")
     , CT.OcfCreateStockClass (mkStockClass "PREF")
     , CT.OcfCreateStakeholder (mkStakeholder "SH-A")
     , CT.OcfCreateStakeholder (mkStakeholder "SH-B")
     , CT.OcfCreateStakeholder (mkStakeholder "SH-C")
     ] ++ records) [] []
  (root, _) <- submit b1.issuer $ exerciseCmd b1.root CT.EnablePositions with stock_class_id = "SC"
  pure b1 with root = root

-- | A lot's provenance and quantity: (origin security, origin date, ancestry, quantity).
provenanceOf : Book -> ContractId StockPosition -> Text -> Script (Text, Time, [Text], Decimal)
provenanceOf b position sid = do
  Some p <- queryContractId b.issuer position
  case Map.lookup sid p.lots of
    Some l -> pure (l.origin_security_id, l.origin_date, l.ancestry, l.issuance.quantity)
    None -> fail ("lot missing: " <> sid)

data Chains = Chains with
    book : Book
    posA : ContractId StockPosition
    posB : ContractId StockPosition
    posC : ContractId StockPosition

-- | Every chain the migration reconstructs, migrated in two batches (SH-A, then SH-B and SH-C):
--
-- * S-1: a plain issuance.
-- * S-2 -> S-3: a full transfer. S-4 -> S-5 + balance S-6: a partial transfer.
-- * S-10 -> S-11 (transfer) -> S-12 (balance of a partial cancellation) -> S-13 + balance S-14
--   (partial transfer) -> S-15 (balance of a partial repurchase).
-- * S-20 (PREF) -> S-21 (SC): a conversion into the class. S-22 -> S-23 (PREF) + balance S-24: a
--   partial conversion out of it.
-- * S-30 -> S-31 + S-32: a reissuance into two certificates.
-- * EC-40 -> S-40 and EC-41 -> S-41 -> S-42: option exercises start a new holding.
migratedChains : Script Chains
migratedChains = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  carol <- allocateParty "carol"
  b0 <- provenanceBook
    [ stock "SC" "S-1" "SH-A" dA 100.0
    , stock "SC" "S-2" "SH-A" dA 100.0
    , transferOf "TR-2" dB "S-2" 100.0 ["S-3"] None
    , stock "SC" "S-3" "SH-B" dB 100.0
    , stock "SC" "S-4" "SH-A" dA 100.0
    , transferOf "TR-4" dB "S-4" 30.0 ["S-5"] (Some "S-6")
    , stock "SC" "S-5" "SH-C" dB 30.0
    , stock "SC" "S-6" "SH-A" dB 70.0
    , stock "SC" "S-10" "SH-A" dA 100.0
    , transferOf "TR-10" dB "S-10" 100.0 ["S-11"] None
    , stock "SC" "S-11" "SH-B" dB 100.0
    , cancellationOf "CN-11" dC "S-11" 40.0 (Some "S-12")
    , stock "SC" "S-12" "SH-B" dC 60.0
    , transferOf "TR-12" dD "S-12" 50.0 ["S-13"] (Some "S-14")
    , stock "SC" "S-13" "SH-C" dD 50.0
    , stock "SC" "S-14" "SH-B" dD 10.0
    , repurchaseOf "RP-14" dD "S-14" 4.0 (Some "S-15")
    , stock "SC" "S-15" "SH-B" dD 6.0
    , stock "PREF" "S-20" "SH-A" dA 100.0
    , conversionOf "CV-20" dB "S-20" 100.0 ["S-21"] None
    , stock "SC" "S-21" "SH-A" dB 100.0
    , stock "SC" "S-22" "SH-B" dA 50.0
    , conversionOf "CV-22" dB "S-22" 20.0 ["S-23"] (Some "S-24")
    , stock "PREF" "S-23" "SH-B" dB 20.0
    , stock "SC" "S-24" "SH-B" dB 30.0
    , stock "SC" "S-30" "SH-C" dA 100.0
    , reissuanceOf "RI-30" dB "S-30" ["S-31", "S-32"]
    , stock "SC" "S-31" "SH-C" dB 60.0
    , stock "SC" "S-32" "SH-C" dB 40.0
    , optionGrant "EC-40" "SH-A" 100.0
    , exerciseOf "EX-40" dB "EC-40" 10.0 ["S-40"]
    , stock "SC" "S-40" "SH-A" dB 10.0
    , optionGrant "EC-41" "SH-A" 100.0
    , exerciseOf "EX-41" dB "EC-41" 20.0 ["S-41"]
    , stock "SC" "S-41" "SH-A" dB 20.0
    , transferOf "TR-41" dC "S-41" 20.0 ["S-42"] None
    , stock "SC" "S-42" "SH-B" dC 20.0
    ]
  (b1, [posA]) <- migrate b0 [migration "SH-A" alice ["S-1", "S-6", "S-21", "S-40"]]
  (book, [posB, posC]) <- migrate b1
    [ migration "SH-B" bob ["S-3", "S-15", "S-24", "S-42"]
    , migration "SH-C" carol ["S-5", "S-13", "S-31", "S-32"] ]
  pure Chains with ..

-- P1: a plain issuance is its own origin; a transfer's resulting security and a partial transfer's
-- resulting and balance securities tack to the transferred security.
test_P1_plainIssuanceAndTransfers : Script ()
test_P1_plainIssuanceAndTransfers = do
  c <- migratedChains
  let b = c.book
  provenanceOf b c.posA "S-1" >>= (=== ("S-1", dA, [], 100.0))
  provenanceOf b c.posB "S-3" >>= (=== ("S-2", dA, ["S-2"], 100.0))
  provenanceOf b c.posC "S-5" >>= (=== ("S-4", dA, ["S-4"], 30.0))
  provenanceOf b c.posA "S-6" >>= (=== ("S-4", dA, ["S-4"], 70.0))

-- P2: a chain of a transfer, a partial cancellation, a partial transfer and a partial repurchase
-- keeps the first issuance's origin and date, with every intermediate security in order.
test_P2_multiLevelChain : Script ()
test_P2_multiLevelChain = do
  c <- migratedChains
  let b = c.book
  provenanceOf b c.posC "S-13" >>= (=== ("S-10", dA, ["S-10", "S-11", "S-12"], 50.0))
  provenanceOf b c.posB "S-15" >>= (=== ("S-10", dA, ["S-10", "S-11", "S-12", "S-14"], 6.0))

-- P3: conversions (resulting and balance securities, across classes) and reissuances tack.
test_P3_conversionAndReissuance : Script ()
test_P3_conversionAndReissuance = do
  c <- migratedChains
  let b = c.book
  provenanceOf b c.posA "S-21" >>= (=== ("S-20", dA, ["S-20"], 100.0))
  provenanceOf b c.posB "S-24" >>= (=== ("S-22", dA, ["S-22"], 30.0))
  provenanceOf b c.posC "S-31" >>= (=== ("S-30", dA, ["S-30"], 60.0))
  provenanceOf b c.posC "S-32" >>= (=== ("S-30", dA, ["S-30"], 40.0))

-- P4: stock from an option exercise starts a new holding: its own origin and issuance date, and
-- the origin of anything transferred from it.
test_P4_exerciseStartsNewOrigin : Script ()
test_P4_exerciseStartsNewOrigin = do
  c <- migratedChains
  let b = c.book
  provenanceOf b c.posA "S-40" >>= (=== ("S-40", dB, [], 10.0))
  provenanceOf b c.posB "S-42" >>= (=== ("S-41", dB, ["S-41"], 20.0))
  -- only the migrated securities are recorded as migrated, not their ancestors
  Some root <- queryContractId b.issuer b.root
  Map.keys (fromOptional Map.empty root.position_migrated_security_ids) ===
    ["S-1", "S-13", "S-15", "S-21", "S-24", "S-3", "S-31", "S-32", "S-40", "S-42", "S-5", "S-6"]

-- P5: history the migration cannot attribute to a single parent is rejected, wherever it sits in
-- the ancestry: a consolidation, a security that is the result of two records (of the same or
-- different kinds), or a cycle.
test_P5_ambiguousHistory : Script ()
test_P5_ambiguousHistory = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  carol <- allocateParty "carol"
  b <- provenanceBook
    [ stock "SC" "S-50" "SH-A" dA 50.0
    , stock "SC" "S-51" "SH-A" dA 50.0
    , consolidationOf "CO-50" dB ["S-50", "S-51"] "S-52"
    , stock "SC" "S-52" "SH-A" dB 100.0
    , transferOf "TR-52" dC "S-52" 100.0 ["S-53"] None
    , stock "SC" "S-53" "SH-B" dC 100.0
    , stock "SC" "S-54" "SH-A" dA 50.0
    , stock "SC" "S-55" "SH-A" dA 50.0
    , consolidationOf "CO-54" dB ["S-54", "S-55"] "S-56"
    , stock "SC" "S-56" "SH-A" dB 100.0
    , stock "SC" "S-57" "SH-A" dA 10.0
    , stock "SC" "S-60" "SH-A" dA 100.0
    , stock "SC" "S-61" "SH-C" dA 100.0
    , transferOf "TR-60" dB "S-60" 100.0 ["S-62"] None
    , transferOf "TR-61" dB "S-61" 100.0 ["S-62"] None
    , stock "SC" "S-62" "SH-B" dB 100.0
    , optionGrant "EC-7" "SH-A" 100.0
    , exerciseOf "EX-7" dB "EC-7" 10.0 ["S-70"]
    , stock "SC" "S-71" "SH-C" dA 10.0
    , transferOf "TR-71" dB "S-71" 10.0 ["S-70"] None
    , stock "SC" "S-70" "SH-B" dB 10.0
    , transferOf "TR-70" dC "S-70" 10.0 ["S-72"] None
    , stock "SC" "S-72" "SH-C" dC 10.0
    , stock "SC" "S-80" "SH-A" dA 100.0
    , transferOf "TR-80" dB "S-80" 100.0 ["S-81"] None
    , stock "SC" "S-81" "SH-B" dB 100.0
    , transferOf "TR-81" dC "S-81" 50.0 ["S-80"] (Some "S-82")
    , stock "SC" "S-82" "SH-B" dC 50.0
    ]
  expectMigrationFails "P5a consolidation in the ancestry"
    "Ambiguous provenance for S-53: S-52 results from stock consolidation CO-50, which has several parents"
    b [migration "SH-B" bob ["S-53"]]
  expectMigrationFails "P5b consolidation result migrated directly"
    "Ambiguous provenance for S-56: S-56 results from stock consolidation CO-54, which has several parents"
    b [migration "SH-A" alice ["S-56"]]
  expectMigrationFails "P5c result of two transfers"
    "Ambiguous provenance for S-62: S-62 is the result of more than one record: stock transfer TR-60, stock transfer TR-61"
    b [migration "SH-B" bob ["S-62"]]
  expectMigrationFails "P5d ancestor that is the result of an exercise and a transfer"
    "Ambiguous provenance for S-72: S-70 is the result of more than one record: equity compensation exercise EX-7, stock transfer TR-71"
    b [migration "SH-C" carol ["S-72"]]
  expectMigrationFails "P5e cycle in the ancestry"
    "Cyclic provenance for S-82 at S-81"
    b [migration "SH-B" bob ["S-82"]]
  -- one ambiguous security fails the whole batch, including the holders before it
  expectMigrationFails "P5f ambiguous security in a later migration of the batch"
    "Ambiguous provenance for S-62"
    b [migration "SH-A" alice ["S-57"], migration "SH-B" bob ["S-62"]]
  -- the existing checks still come first
  expectMigrationFails "P5g consolidated security that was then transferred" "was transferred"
    b [migration "SH-A" alice ["S-52"]]
  -- nothing was migrated
  Some root <- queryContractId b.issuer b.root
  root.position_migrated_security_ids === None

-- P6: an ancestor without a stock issuance in the root is rejected. A book written through
-- UpdateCapTable always has the source issuance of each stock record, so this simulates a legacy
-- root by creating it directly (issuer and system operator) without the ancestor's issuance.
test_P6_ancestorWithoutStockIssuance : Script ()
test_P6_ancestorWithoutStockIssuance = do
  bob <- allocateParty "bob"
  b <- provenanceBook
    [ stock "SC" "S-90" "SH-A" dA 100.0
    , transferOf "TR-90" dB "S-90" 100.0 ["S-91"] None
    , stock "SC" "S-91" "SH-A" dB 100.0
    , transferOf "TR-91" dC "S-91" 100.0 ["S-92"] None
    , stock "SC" "S-92" "SH-B" dC 100.0
    ]
  Some root <- queryContractId b.issuer b.root
  legacyRoot <- submit (actAs [b.issuer, b.sysop]) $ createCmd root with
    stock_issuances = Map.delete "ISS-S-90" root.stock_issuances
    stock_issuances_by_security_id = Map.delete "S-90" root.stock_issuances_by_security_id
  expectMigrationFails "P6 ancestor without a stock issuance" "Ancestor S-90 of S-92 has no stock issuance"
    (b with root = legacyRoot) [migration "SH-B" bob ["S-92"]]
  -- the same history with the issuance in place migrates
  (b', [position]) <- migrate b [migration "SH-B" bob ["S-92"]]
  provenanceOf b' position "S-92" >>= (=== ("S-90", dA, ["S-90", "S-91"], 100.0))

-- | The position registry of class SC.
registryOf : Book -> Script (ContractId PositionRegistry)
registryOf b = do
  Some root <- queryContractId b.issuer b.root
  case Map.lookup "SC" (fromOptional Map.empty root.position_registries) of
    Some registry -> pure registry
    None -> fail "positions are not enabled for SC"

-- P7: provenance, holds and vesting compose. Migrated chain-derived lots keep their vesting terms
-- and start without holds or a vesting snapshot, and every hold and vesting rule applies to them:
-- a lot on vesting terms can be neither held nor drawn until a snapshot is recorded, and then only
-- its vested part; a stop locks a lot until it is lifted, and held quantity is not drawable. A
-- transfer under a reference then draws exactly the migrated lots' holds, the lots it writes keep
-- the reconstructed origin, origin date and ancestry, and the remainder keeps the unvested shares.
test_P7_migratedChainHeldAndTransferred : Script ()
test_P7_migratedChainHeldAndTransferred = do
  bob <- allocateParty "bob"
  carol <- allocateParty "carol"
  b0 <- provenanceBook
    [ CT.OcfCreateVestingTerms (defaultVestingTerms "VT-1")
    , stock "SC" "S-100" "SH-A" dA 100.0
    , transferOf "TR-100" dB "S-100" 100.0 ["S-101"] None
    , stock "SC" "S-101" "SH-B" dB 100.0
    , cancellationOf "CN-101" dC "S-101" 40.0 (Some "S-102")
    , CT.OcfCreateStockIssuance ((mkIssuance "SC" "S-102" "SH-B" 60.0) with
        date = dC; vesting_terms_id = Some "VT-1")
    , stock "SC" "S-110" "SH-A" dA 50.0
    , transferOf "TR-110" dB "S-110" 30.0 ["S-111"] (Some "S-112")
    , stock "SC" "S-111" "SH-B" dB 30.0
    , stock "SC" "S-112" "SH-A" dB 20.0
    ]
  (b, [pos0]) <- migrate b0 [migration "SH-B" bob ["S-102", "S-111"]]
  registry <- registryOf b
  let i = actAs b.issuer
      holdOn pos purpose ref lots = exerciseCmd registry Registry_Hold with
        position = pos; purpose; reference = ref; date = dD
        lots = map (\(s, q) -> HoldLot with security_id = s; quantity = q) lots
      settlementHoldOn pos lots = holdOn pos HoldPurposeRegisterSettlement "SET-M" (map (\(s, q) -> (s, Some q)) lots)
      transferToCarol tid pos ref qty draws = exerciseCmd registry Registry_Transfer with
        transfer_id = tid; date = dD; transferor_position = pos
        transferee = Transferee with stakeholder_id = "SH-C"; party = carol; position = None
        quantity = qty; share_price = usd 3.0
        draws = map (\(s, q) -> LotDraw with security_id = s; quantity = q) draws
        reference = ref; request_receipt = False
      lotsOf pos = do
        Some p <- queryContractId b.issuer pos
        pure p.lots

  -- migrated lots: reconstructed provenance, vesting terms kept, no holds, no snapshot
  provenanceOf b pos0 "S-102" >>= (=== ("S-100", dA, ["S-100", "S-101"], 60.0))
  provenanceOf b pos0 "S-111" >>= (=== ("S-110", dA, ["S-110"], 30.0))
  lots0 <- lotsOf pos0
  map (\l -> (l.issuance.vesting_terms_id, l.holds, l.vesting_snapshot)) (Map.values lots0) ===
    [(Some "VT-1", [], None), (None, [], None)]

  -- a migrated lot on vesting terms is unvested until a snapshot is recorded
  expectFail "P7a settlement hold on a migrated lot on vesting terms" "hold exceeds the drawable quantity of lot S-102" i $
    settlementHoldOn pos0 [("S-102", 40.0)]
  expectFail "P7b free transfer of a migrated lot on vesting terms" "draw exceeds the drawable quantity of lot S-102" i $
    transferToCarol "P7b" pos0 None 10.0 [("S-102", 10.0)]

  -- a stop locks a migrated lot until it is lifted
  stopped <- submit b.issuer $ holdOn pos0 HoldPurposeStopTransfer "STOP-M" [("S-111", None)]
  stopped.released === []
  expectFail "P7c free transfer of a stopped migrated lot" "lot S-111 is stopped" i $
    transferToCarol "P7c" stopped.position None 10.0 [("S-111", 10.0)]
  expectFail "P7d settlement hold on a stopped migrated lot" "lot S-111 is stopped" i $
    settlementHoldOn stopped.position [("S-111", 30.0)]
  lifted <- submit b.issuer $ exerciseCmd registry Registry_Release with
    position = stopped.position; purpose = HoldPurposeStopTransfer; reference = "STOP-M"
    code = ReleaseCodeStopLifted; security_ids = Some ["S-111"]
  map (.security_id) lifted.released === ["S-111"]

  -- a snapshot of 45 vested shares, then holds on both migrated lots under one reference
  vested <- submit b.issuer $ exerciseCmd registry Registry_RecordVesting with
    position = lifted.position; as_of = dC; records = []
    lots = [LotVestingSnapshot with security_id = "S-102"; vested_quantity = 45.0]
  held <- submit b.issuer $ settlementHoldOn vested.position [("S-102", 40.0), ("S-111", 30.0)]
  heldLots <- lotsOf held.position
  map (\l -> (l.issuance.security_id, map (.reference) l.holds, drawableQuantity dD l)) (Map.values heldLots) ===
    [("S-102", ["SET-M"], 5.0), ("S-111", ["SET-M"], 0.0)]

  -- held quantity is not drawable, and the transfer under the reference draws all of its holds
  expectFail "P7e free transfer of held quantity on a migrated lot" "draw exceeds the drawable quantity of lot S-102" i $
    transferToCarol "P7e" held.position None 30.0 [("S-102", 30.0)]
  expectFail "P7f transfer under the reference leaving a held migrated lot undrawn"
    "lot S-111 carries a register-settlement hold with reference SET-M but is not drawn" i $
    transferToCarol "P7f" held.position (Some "SET-M") 40.0 [("S-102", 40.0)]

  result <- submit b.issuer $ transferToCarol "P7" held.position (Some "SET-M") 70.0 [("S-102", 40.0), ("S-111", 30.0)]
  let summary l = (l.issuance.security_id, l.issuance.quantity, l.origin_security_id, l.origin_date, l.ancestry)
      vesting l = (l.holds, l.issuance.vestings, l.issuance.vesting_terms_id, l.vesting_snapshot)
      unencumbered l = vesting l == ([], [], None, None)
  -- the remainder of S-102 keeps its origin, its vesting terms and the 5 vested shares not drawn,
  -- and is free of holds; S-111 was drawn in full
  case result.transferor_position of
    None -> fail "the transferor's position should keep the remainder of S-102"
    Some from -> do
      fromLots <- lotsOf from
      map summary (Map.values fromLots) === [("P7-R-0", 20.0, "S-100", dA, ["S-100", "S-101", "S-102"])]
      map vesting (Map.values fromLots) ===
        [([], [], Some "VT-1", Some VestingSnapshot with vested_quantity = 5.0; as_of = dC)]
  -- the transferee's lots tack to the reconstructed origins
  toLots <- lotsOf result.transferee_position
  map summary (Map.values toLots) ===
    [ ("P7-B-0", 40.0, "S-100", dA, ["S-100", "S-101", "S-102"])
    , ("P7-B-1", 30.0, "S-110", dA, ["S-110", "S-111"]) ]
  map unencumbered (Map.values toLots) === [True, True]

-- | Each lot of a position as (security, quantity, share price).
lotQuantities : Book -> ContractId StockPosition -> Script [(Text, Decimal, Decimal)]
lotQuantities b position = do
  Some p <- queryContractId b.issuer position
  pure (map (\l -> (l.issuance.security_id, l.issuance.quantity, l.issuance.share_price.amount)) (Map.values p.lots))

-- P8: splits of the class recorded before EnablePositions set the migrated quantities, as v34's own
-- balance functions compute them: a later split applies to an issuance; on the issuance's own date
-- a forward split is taken as already in its recorded quantity, and a reverse split as following
-- it (the lowest balance any intra-day order allows, which also bounds what the root lets a later
-- record reduce). Securities issued after a split, such as a post-split transfer's resulting and
-- balance securities, are not multiplied again. Each lot keeps its issuance's recorded share price.
test_P8_splitsBeforeEnabling : Script ()
test_P8_splitsBeforeEnabling = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  forwardBook <- provenanceBook
    [ stock "SC" "S-1" "SH-A" dA 100.0
    , classSplit "SPLIT-F" dB 2.0 1.0
    , stock "SC" "S-2" "SH-A" dB 50.0
    , stock "SC" "S-3" "SH-B" dA 100.0
    , transferOf "TR-3" dC "S-3" 200.0 ["S-4"] None
    , stock "SC" "S-4" "SH-A" dC 200.0
    , stock "SC" "S-5" "SH-B" dA 100.0
    , transferOf "TR-5" dC "S-5" 150.0 ["S-6"] (Some "S-7")
    , stock "SC" "S-6" "SH-A" dC 150.0
    , stock "SC" "S-7" "SH-B" dC 50.0
    ]
  (fb, [fa, fbob]) <- migrate forwardBook
    [migration "SH-A" alice ["S-1", "S-2", "S-4", "S-6"], migration "SH-B" bob ["S-7"]]
  lotQuantities fb fa >>= (=== [("S-1", 200.0, 1.0), ("S-2", 50.0, 1.0), ("S-4", 200.0, 1.0), ("S-6", 150.0, 1.0)])
  lotQuantities fb fbob >>= (=== [("S-7", 50.0, 1.0)])
  provenanceOf fb fbob "S-7" >>= (=== ("S-5", dA, ["S-5"], 50.0))
  reverseBook <- provenanceBook
    [ stock "SC" "S-10" "SH-A" dA 100.0
    , classSplit "SPLIT-R" dB 1.0 4.0
    , stock "SC" "S-11" "SH-A" dB 40.0
    , stock "SC" "S-12" "SH-A" dC 8.0
    ]
  (rb, [ra]) <- migrate reverseBook [migration "SH-A" alice ["S-10", "S-11", "S-12"]]
  lotQuantities rb ra >>= (=== [("S-10", 25.0, 1.0), ("S-11", 10.0, 1.0), ("S-12", 8.0, 1.0)])
