-- | Test-only stand-in for the trading package (TradeSettlement-v01), which depends on
-- OpenCapTable; OpenCapTable knows nothing about trades or cash.
--
-- A buyer-signed acceptance of exact trade terms, co-signed by the issuer and the TA, settles the
-- cash leg (Splice token standard V2, executors = [TA, buyer]) only against a `TransferReceipt`
-- that matches those terms, and redeems it. A minimal desk mirrors `TradeDesk_Settle`: in one
-- transaction it runs `Registry_Transfer` with a receipt requested, then the acceptance's settle
-- choice with that receipt, so shares and cash move together or not at all.
module OpenCapTable.Positions.TradeStandIn where

import DA.List (sort)
import DA.Optional (fromSomeNote)

import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.HoldingV2 (Account(..))
import qualified Splice.Api.Token.AllocationV2 as V2

import Fairmint.OpenCapTable.Types.Core (Context)
import Fairmint.OpenCapTable.Types.Monetary (OcfMonetary)
import Fairmint.OpenCapTable.Positions

-- | The share terms of one trade in position language (no lots), compared field by field with
-- the transfer receipt.
data TradeShareTerms = TradeShareTerms with
    trade_id : Text
      -- ^ the settlement ID; the transfer's receipt carries it as its reference
    stock_class_id : Text
    seller_stakeholder_id : Text
    buyer_stakeholder_id : Text
    buyer : Party
    quantity : Decimal
    share_price : OcfMonetary
  deriving (Eq, Show)

-- | The cash leg the buyer accepts, with the settlement factory pinned by contract ID.
data CashLegTerms = CashLegTerms with
    cash_admin : Party
    factory : ContractId V2.SettlementFactory
    settlement : V2.SettlementInfo
    cash_leg : V2.TransferLeg
  deriving (Eq, Show)

basicAccount : Party -> Account
basicAccount p = Account with owner = Some p; provider = None; id = ""

nonIterated : ContractId V2.Allocation -> V2.FinalizedAllocation
nonIterated allocationCid = V2.FinalizedAllocation with
  allocationCid
  extraTransferLegSides = []
  nextIterationFunding = None

-- | Authenticate an allocation before the buyer's authority is passed to it.
checkAllocation : CashLegTerms -> ContractId V2.Allocation -> Update ()
checkAllocation cash cid = do
  a <- fetch cid
  let v = view a
  assertMsg "allocation is not signed by the cash admin" (cash.cash_admin `elem` signatory a)
  assertMsg "allocation admin mismatch" (v.allocation.admin == cash.cash_admin)
  assertMsg "allocation settlement mismatch" (v.settlement == cash.settlement)

-- | Compare a transfer receipt with the accepted terms, field by field. The context check covers
-- the system operator too: the issuer could otherwise sign a receipt with a party of its own in
-- that role.
checkReceipt : Context -> Party -> TradeShareTerms -> TransferReceipt -> Update ()
checkReceipt context seller terms r = do
  assertMsg "receipt issuer or system operator differs from the accepted terms" (r.context == context)
  assertMsg "receipt stock class differs from the accepted terms" (r.stock_class_id == terms.stock_class_id)
  assertMsg "receipt transferor differs from the seller" (r.transferor == seller)
  assertMsg "receipt transferor stakeholder differs from the accepted terms"
    (r.transferor_stakeholder_id == terms.seller_stakeholder_id)
  assertMsg "receipt transferee differs from the buyer" (r.transferee == terms.buyer)
  assertMsg "receipt transferee stakeholder differs from the accepted terms"
    (r.transferee_stakeholder_id == terms.buyer_stakeholder_id)
  assertMsg "receipt quantity differs from the accepted terms" (r.quantity == terms.quantity)
  assertMsg "receipt share price differs from the accepted terms" (r.share_price == terms.share_price)
  assertMsg "receipt reference differs from the settlement ID" (r.reference == Some terms.trade_id)

-- | Issuer and TA propose the exact terms; the buyer accepts in her wallet.
template BuyerAcceptanceProposal
  with
    context : Context
    ta : Party
    buyer : Party
    seller : Party
    terms : TradeShareTerms
    cash : CashLegTerms
  where
    signatory context.issuer, ta
    observer buyer

    choice Proposal_Accept : ContractId BuyerAcceptance
      controller buyer
      do create BuyerAcceptance with ..

    choice Proposal_Withdraw : ()
      controller ta
      do pure ()

template BuyerAcceptance
  with
    context : Context
    ta : Party
    buyer : Party
    seller : Party
      -- ^ the seller's party: the transferor on the receipt and the receiver of the cash leg
    terms : TradeShareTerms
    cash : CashLegTerms
  where
    signatory context.issuer, ta, buyer
    ensure
      terms.buyer == buyer
      && sort cash.settlement.executors == sort [ta, buyer]
      && cash.settlement.id == terms.trade_id
      && cash.cash_leg.sender == basicAccount buyer
      && cash.cash_leg.receiver == basicAccount seller
      && terms.quantity > 0.0
      && cash.cash_leg.amount == terms.quantity * terms.share_price.amount

    -- | Settle the cash leg on delivery of the shares. Controller: the TA, which runs it in the
    -- desk's settle choice right after `Registry_Transfer`. Only a receipt that matches the
    -- accepted terms unlocks the cash; redeeming it archives it, so it settles once.
    choice Acceptance_SettleOnDelivery : V2.SettlementFactory_SettleBatchResult
      with
        receipt : ContractId TransferReceipt
        buyer_allocation : ContractId V2.Allocation
        seller_allocation : ContractId V2.Allocation
        extra_args : ExtraArgs
      controller ta
      do
        delivered <- fetch receipt
        checkReceipt context seller terms delivered
        _ <- exercise receipt TransferReceipt_Redeem
        checkAllocation cash buyer_allocation
        checkAllocation cash seller_allocation
        exercise cash.factory V2.SettlementFactory_SettleBatch with
          settlement = cash.settlement
          transferLegs = [cash.cash_leg]
          allocations = map nonIterated [buyer_allocation, seller_allocation]
          actors = [ta, buyer]
          extraArgs = extra_args

    -- | TA cleanup without any holder action: cancel this trade's allocations (cash returns to
    -- the buyer), then the acceptance is gone.
    choice Acceptance_Cancel : [V2.AllocationResult]
      with
        allocations : [ContractId V2.Allocation]
        extra_args : ExtraArgs
      controller ta
      do
        forA allocations \cid -> do
          checkAllocation cash cid
          exercise cid V2.Allocation_Cancel with actors = [ta, buyer]; extraArgs = extra_args

    -- | The buyer may revoke before settlement.
    choice Acceptance_BuyerRevoke : ()
      controller buyer
      do pure ()

data DeskSettleResult = DeskSettleResult with
    transfer : TransferResult
    cash : V2.SettlementFactory_SettleBatchResult
  deriving (Eq, Show)

-- | Minimal stand-in for the trading package's `TradeDesk`: the TA's retained issuer authority.
template StandInDesk
  with
    context : Context
    ta : Party
  where
    signatory context.issuer, ta

    -- | Mirrors `TradeDesk_Settle` (without `TradeTerms`): transfer the shares with a receipt
    -- whose reference is the settlement ID, then settle the cash against that receipt. Any
    -- mismatch aborts both steps.
    nonconsuming choice StandInDesk_Settle : DeskSettleResult
      with
        registry : ContractId PositionRegistry
        settlement_id : Text
        date : Time
        seller_position : ContractId StockPosition
        buyer : Transferee
        quantity : Decimal
        share_price : OcfMonetary
        draws : [LotDraw]
        acceptance : ContractId BuyerAcceptance
        buyer_allocation : ContractId V2.Allocation
        seller_allocation : ContractId V2.Allocation
        extra_args : ExtraArgs
      controller ta
      do
        transfer <- exercise registry Registry_Transfer with
          transfer_id = settlement_id
          date
          transferor_position = seller_position
          transferee = buyer
          quantity
          share_price
          draws
          reference = Some settlement_id
          request_receipt = True
        let receipt = fromSomeNote "Registry_Transfer returned no receipt" transfer.receipt
        cash <- exercise acceptance Acceptance_SettleOnDelivery with
          receipt; buyer_allocation; seller_allocation; extra_args
        pure DeskSettleResult with transfer; cash
