-- Shared test vectors (test-vectors/v35.json): the derived-ID encoding, claim hashes and the shared floor function, as the SDK and apiv2 must reproduce them.
module OpenCapTable.TestVectors where

import DA.Assert ((===))
import qualified DA.Text as T
import Daml.Script

import Fairmint.OpenCapTable.Ids
import Fairmint.OpenCapTable.Numeric (floorMulDiv)
import Fairmint.OpenCapTable.Types.Core (Context(..))

contextFor : Party -> Party -> Party -> Text -> Context
contextFor i s t c = Context with cap_table_id = c; issuer = i; system_operator = s; transfer_agent = t

test_vectors_derived_ids : Script ()
test_vectors_derived_ids = do
  i <- allocateParty "I"
  s <- allocateParty "S"
  t <- allocateParty "T"
  encodeFields [namespaceTag (roleNamespace DerivedRoleEvent), "test-1", "S-A1", show (0 : Int), roleTag DerivedRoleEvent, show (0 : Int)] === "6:object6:test-14:S-A11:05:event1:0"
  deriveId (contextFor i s t "test-1") "S-A1" 0 DerivedRoleEvent 0 === "test-1:d4637bad4b025ab360f053d2ad4d6013c2a81e3bc103084e0124264abe581ce6"
  encodeFields [namespaceTag (roleNamespace DerivedRoleResultingSecurity), "test-1", "S-A1", show (0 : Int), roleTag DerivedRoleResultingSecurity, show (0 : Int)] === "8:security6:test-14:S-A11:018:resulting_security1:0"
  deriveId (contextFor i s t "test-1") "S-A1" 0 DerivedRoleResultingSecurity 0 === "test-1:0c720f481e3a9d1b0993498e19cc085c80bf336d4bc6cc0ba59c1d5c25135938"
  encodeFields [namespaceTag (roleNamespace DerivedRoleBalanceSecurity), "test-1", "S-A1", show (0 : Int), roleTag DerivedRoleBalanceSecurity, show (0 : Int)] === "8:security6:test-14:S-A11:016:balance_security1:0"
  deriveId (contextFor i s t "test-1") "S-A1" 0 DerivedRoleBalanceSecurity 0 === "test-1:f697278de25da7418591a6db00415807973e3a8c9d62ca93e4f19991e94827fd"
  encodeFields [namespaceTag (roleNamespace DerivedRoleHold), "test-1", "S-A1", show (3 : Int), roleTag DerivedRoleHold, show (0 : Int)] === "6:object6:test-14:S-A11:34:hold1:0"
  deriveId (contextFor i s t "test-1") "S-A1" 3 DerivedRoleHold 0 === "test-1:97591a01027565715c4efafa012b3d0eace31651c7b7aae1d5160872574d81f3"
  encodeFields [namespaceTag (roleNamespace DerivedRoleHoldCancellation), "test-1", "S-A1", show (3 : Int), roleTag DerivedRoleHoldCancellation, show (0 : Int)] === "6:object6:test-14:S-A11:317:hold_cancellation1:0"
  deriveId (contextFor i s t "test-1") "S-A1" 3 DerivedRoleHoldCancellation 0 === "test-1:788bdcbee2d7fd5e2008e943484e6c582261f376f9cec538dc15bca5c4b4dbe8"
  encodeFields [namespaceTag (roleNamespace DerivedRoleResultingIssuance), "test-1", "S-A1", show (7 : Int), roleTag DerivedRoleResultingIssuance, show (2 : Int)] === "6:object6:test-14:S-A11:718:resulting_issuance1:2"
  deriveId (contextFor i s t "test-1") "S-A1" 7 DerivedRoleResultingIssuance 2 === "test-1:30feb5b4dff1cea51474ba381f29ac5811a0a4cf5e1ebac747221427d8894766"
  encodeFields [namespaceTag (roleNamespace DerivedRoleBalanceIssuance), "test-1", "S-A1", show (7 : Int), roleTag DerivedRoleBalanceIssuance, show (0 : Int)] === "6:object6:test-14:S-A11:716:balance_issuance1:0"
  deriveId (contextFor i s t "test-1") "S-A1" 7 DerivedRoleBalanceIssuance 0 === "test-1:29f4764780548df549912fc4ce2e50c2577828c41161daf3534bf0a640780d7d"
  encodeFields [namespaceTag (roleNamespace DerivedRoleEvent), "ocp-devnet-12", "Ünïcødé-é", show (41 : Int), roleTag DerivedRoleEvent, show (0 : Int)] === "6:object13:ocp-devnet-1214:Ünïcødé-é2:415:event1:0"
  deriveId (contextFor i s t "ocp-devnet-12") "Ünïcødé-é" 41 DerivedRoleEvent 0 === "ocp-devnet-12:4c368d545f7244ea8d6f65e8786e733568d2d6fd4b3872b8722291f3aa78cf89"
  isDerivedForm (contextFor i s t "test-1") "test-1:d4637bad4b025ab360f053d2ad4d6013c2a81e3bc103084e0124264abe581ce6" === True
  isDerivedForm (contextFor i s t "test-1") "test-10:abc" === False

test_vectors_claim_hashes : Script ()
test_vectors_claim_hashes = do
  claimHash IdNamespaceObject "ISSUER-1" === "622a4caf8bdefab95e7083a3b39c3fc6d1c0466efea42c012d17b46201c6d6a2"
  T.take 8 (hashBits (claimHash IdNamespaceObject "ISSUER-1")) === "01100010"
  claimHash IdNamespaceObject "SH-A" === "cff84ea335e642c83dbf143344e3cb2021068ebb35e54addab8e03b09ac430f3"
  T.take 8 (hashBits (claimHash IdNamespaceObject "SH-A")) === "11001111"
  claimHash IdNamespaceSecurity "S-A1" === "9876d265d73fbc39f40abb2dc29105c8b430f5af8c0f0b2b2272ee3a03443643"
  T.take 8 (hashBits (claimHash IdNamespaceSecurity "S-A1")) === "10011000"
  claimHash IdNamespaceObject "S-A1" === "2eae07b2218189138ae05a8b2358e8e2f53369da5718ba802a77126f55ddba2a"
  T.take 8 (hashBits (claimHash IdNamespaceObject "S-A1")) === "00101110"
  claimHash IdNamespaceObject "名前" === "697494f78ab02216cbeb528df7d6df8d90d6a9ed9b53c97d1a06997656083821"
  T.take 8 (hashBits (claimHash IdNamespaceObject "名前")) === "01101001"
  T.length (hashBits (claimHash IdNamespaceObject "x")) === 256

test_vectors_floor : Script ()
test_vectors_floor = do
  floorMulDiv 1000.0 250.0 1000.0 === 250.0
  floorMulDiv 1.0 1.0 3.0 === 0.3333333333
  floorMulDiv 2.0 1.0 3.0 === 0.6666666666
  floorMulDiv 1000000000000.0 2.0 3.0 === 666666666666.6666666666
  floorMulDiv 12345678901234.5678901234 999999999.9999999999 1000000000.0 === 12345678901234.5678888888
  floorMulDiv 1000.0 2.0 1.0 === 2000.0
  floorMulDiv 999.9999999999 1.0 2.0 === 499.9999999999
  floorMulDiv 0.0000000001 1.0 3.0 === 0.0
  floorMulDiv 66.6666666666 2.0 3.0 === 44.4444444444
  pure ()
