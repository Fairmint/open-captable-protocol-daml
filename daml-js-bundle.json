{
  "generatedJsDir": "generated/js",
  "presets": ["da-internal-template", "da-time-types", "da-types", "da-set-types"],
  "rootIndex": {
    "outputDir": "lib",
    "sourcePackage": { "name": "OpenCapTable-v36" },
    "copy": ["DA", "__bundled__", "Fairmint"],
    "namespaces": ["Fairmint", "DA"],
    "templateConstants": {
      "OCP_TEMPLATES": {
        "ocpFactory": {
          "from": "./Fairmint/OpenCapTable/OcpFactory/module",
          "binding": "OcpFactory"
        },
        "issuerAuthorization": {
          "from": "./Fairmint/OpenCapTable/IssuerAuthorization/module",
          "binding": "IssuerAuthorization"
        },
        "capTable": {
          "from": "./Fairmint/OpenCapTable/CapTable/module",
          "binding": "CapTable"
        },
        "stockSecurity": {
          "from": "./Fairmint/OpenCapTable/State/module",
          "binding": "StockSecurity"
        },
        "stockClassEpoch": {
          "from": "./Fairmint/OpenCapTable/State/module",
          "binding": "StockClassEpoch"
        },
        "ocfIdShard": {
          "from": "./Fairmint/OpenCapTable/State/module",
          "binding": "OcfIdShard"
        }
      },
      "OCP_INTERFACES": {
        "ocfObject": {
          "from": "./Fairmint/OpenCapTableApi/OcfObject/module",
          "binding": "OcfObject"
        },
        "registerContract": {
          "from": "./Fairmint/OpenCapTableApi/RegisterContract/module",
          "binding": "RegisterContract"
        }
      }
    },
    "postBundlePresets": ["da-time-types", "da-types", "da-set-types"]
  }
}
