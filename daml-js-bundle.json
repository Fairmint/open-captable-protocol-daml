{
  "generatedJsDir": "generated/js",
  "presets": [
    "da-internal-template",
    "featured-app-v1",
    "featured-app-v2",
    "amulet",
    "da-time-types",
    "da-types",
    "da-set-types",
    "splice-token-v1"
  ],
  "pins": {
    "amulet": "0.1.16"
  },
  "rootIndex": {
    "outputDir": "lib",
    "sourcePackage": { "namePrefix": "OpenCapTable" },
    "copy": ["DA", "Splice", "__bundled__", "Fairmint"],
    "namespaces": ["Fairmint", "DA", "Splice"],
    "templateConstants": {
      "OCP_TEMPLATES": {
        "capTable": {
          "from": "./Fairmint/OpenCapTable/CapTable/module",
          "binding": "CapTable"
        },
        "issuerAuthorization": {
          "from": "./Fairmint/OpenCapTable/IssuerAuthorization/module",
          "binding": "IssuerAuthorization"
        },
        "ocpFactory": {
          "from": "./Fairmint/OpenCapTable/OcpFactory/module",
          "binding": "OcpFactory"
        }
      }
    },
    "postBundlePresets": ["da-time-types", "da-types", "splice-token-v1", "da-set-types"]
  }
}
