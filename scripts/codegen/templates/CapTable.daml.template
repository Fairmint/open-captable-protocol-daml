validateSourceSecurityBalances : CapTableMaps -> Update ()
validateSourceSecurityBalances maps = do
  stockEvents <- stockBalanceEventsBySecurityId maps
  warrantEvents <- warrantBalanceEventsBySecurityId maps
  equityCompensationEvents <- equityCompensationBalanceEventsBySecurityId maps
  splitEvents <- splitEventsByStockClassId maps
  validateSecurityEventReferences "Stock" maps.stock_issuances_by_security_id stockEvents
  validateSecurityEventReferences "Warrant" maps.warrant_issuances_by_security_id warrantEvents
  validateSecurityEventReferences "Equity compensation" maps.equity_compensation_issuances_by_security_id equityCompensationEvents
  mapA_
    (\issuanceCid -> do
      issuance <- fetch issuanceCid
      let events = fromOptional [] (Map.lookup issuance.issuance_data.security_id stockEvents)
          splits = filter
            (splitMayReducePostIssuanceBalance issuance.issuance_data.date)
            (fromOptional [] (Map.lookup issuance.issuance_data.stock_class_id splitEvents))
      validateSourceSecurityBalance
        issuance.issuance_data.security_id
        issuance.issuance_data.date
        issuance.issuance_data.quantity
        (events ++ splits))
    (Map.values maps.stock_issuances)
  mapA_
    (\issuanceCid -> do
      issuance <- fetch issuanceCid
      let events = fromOptional [] (Map.lookup issuance.issuance_data.security_id warrantEvents)
      case issuance.issuance_data.quantity of
        Some quantity ->
          validateSourceSecurityBalance
            issuance.issuance_data.security_id
            issuance.issuance_data.date
            quantity
            events
        None ->
          validateUnknownQuantitySecurityBalance
            issuance.issuance_data.security_id
            issuance.issuance_data.date
            events)
    (Map.values maps.warrant_issuances)
  mapA_
    (\issuanceCid -> do
      issuance <- fetch issuanceCid
      let events = fromOptional [] (Map.lookup issuance.issuance_data.security_id equityCompensationEvents)
          splits = case issuance.issuance_data.stock_class_id of
            Some stockClassId -> filter
              (splitMayReducePostIssuanceBalance issuance.issuance_data.date)
              (fromOptional [] (Map.lookup stockClassId splitEvents))
            None -> []
      validateSourceSecurityBalance
        issuance.issuance_data.security_id
        issuance.issuance_data.date
        issuance.issuance_data.quantity
        (events ++ splits))
    (Map.values maps.equity_compensation_issuances)

stockClassHasRatioConversionRight : StockClassOcfData -> Bool
stockClassHasRatioConversionRight stockClassData =
  any
    (\right -> case right.conversion_mechanism of
      OcfConversionMechanismRatioConversion -> True
      _ -> False)
    stockClassData.conversion_rights

validateStockClassConversionRatioAdjustmentTargets : CapTableMaps -> Update ()
validateStockClassConversionRatioAdjustmentTargets maps =
  mapA_
    (\adjustmentCid -> do
      adjustment <- fetch adjustmentCid
      let data_ = adjustment.adjustment_data
      case Map.lookup data_.stock_class_id maps.stock_classes of
        Some stockClassCid -> do
          stockClass <- fetch stockClassCid
          assertMsg
            ("Stock class conversion ratio adjustment " <> data_.id <> " targets a stock class without a ratio conversion right: " <> data_.stock_class_id)
            (stockClassHasRatioConversionRight stockClass.stock_class_data)
        -- Create/edit handlers validate this reference, while this final-state
        -- check also prevents deleting a class that an adjustment still targets.
        None ->
          assertMsg
            ("Stock class conversion ratio adjustment " <> data_.id <> " target not found: " <> data_.stock_class_id)
            False)
    (Map.values maps.stock_class_conversion_ratio_adjustments)

warrantExerciseTrigger : WarrantIssuanceOcfData -> Text -> Optional OcfConversionTrigger
warrantExerciseTrigger issuanceData triggerId =
  foldl
    (\matched trigger ->
      case matched of
        Some _ -> matched
        None -> if trigger.trigger_id == triggerId then Some trigger else None)
    None
    issuanceData.exercise_triggers

convertibleConversionTrigger : ConvertibleIssuanceOcfData -> Text -> Optional ConvertibleIssuance.OcfConvertibleConversionTrigger
convertibleConversionTrigger issuanceData triggerId =
  foldl
    (\matched trigger ->
      case matched of
        Some _ -> matched
        None -> if trigger.trigger_id == triggerId then Some trigger else None)
    None
    issuanceData.conversion_triggers

conversionTriggerDefinitionIsTemporallyValid :
  Optional Time ->
  OcfConversionTriggerType ->
  Optional Time ->
  Optional Time ->
  Optional Time ->
  Bool
conversionTriggerDefinitionIsTemporallyValid expirationDate triggerType startDate endDate triggerDate =
  let notAfterExpiration date = optional True (\expiration -> ocfDate date <= ocfDate expiration) expirationDate
  in case triggerType of
    OcfTriggerTypeTypeAutomaticOnDate ->
      optional False notAfterExpiration triggerDate
    OcfTriggerTypeTypeElectiveInRange -> case (startDate, endDate) of
      (Some start, Some end) ->
        ocfDate start <= ocfDate end && notAfterExpiration end
      _ -> False
    _ -> True

conversionTriggerIsEligibleAt :
  Time ->
  OcfConversionTriggerType ->
  Optional Time ->
  Optional Time ->
  Optional Time ->
  Bool
conversionTriggerIsEligibleAt eventDate triggerType startDate endDate triggerDate =
  case triggerType of
    OcfTriggerTypeTypeAutomaticOnDate -> case triggerDate of
      Some date -> ocfDate eventDate == ocfDate date
      None -> False
    OcfTriggerTypeTypeElectiveInRange -> case (startDate, endDate) of
      (Some start, Some end) ->
        ocfDate eventDate >= ocfDate start && ocfDate eventDate <= ocfDate end
      _ -> False
    _ -> True

assertConversionTriggerDefinitionIsTemporallyValid :
  Text ->
  Optional Time ->
  OcfConversionTriggerType ->
  Optional Time ->
  Optional Time ->
  Optional Time ->
  Update ()
assertConversionTriggerDefinitionIsTemporallyValid label expirationDate triggerType startDate endDate triggerDate =
  assertMsg
    (label <> " has invalid trigger timing or extends beyond the instrument expiration")
    (conversionTriggerDefinitionIsTemporallyValid expirationDate triggerType startDate endDate triggerDate)

assertConversionTriggerIsEligibleAt :
  Text ->
  Time ->
  OcfConversionTriggerType ->
  Optional Time ->
  Optional Time ->
  Optional Time ->
  Update ()
assertConversionTriggerIsEligibleAt label eventDate triggerType startDate endDate triggerDate =
  assertMsg
    (label <> " is not eligible on " <> show eventDate <> " under its selected trigger")
    (conversionTriggerIsEligibleAt eventDate triggerType startDate endDate triggerDate)

assertExpirationOnOrAfterIssuance : Text -> Time -> Optional Time -> Update ()
assertExpirationOnOrAfterIssuance label issuanceDate expirationDate =
  case expirationDate of
    Some expiration ->
      assertMsg
        (label <> " expiration " <> show expiration <> " cannot precede issuance " <> show issuanceDate)
        (ocfDate expiration >= ocfDate issuanceDate)
    None -> pure ()

assertEventOnOrAfterIssuance : Text -> Time -> Time -> Update ()
assertEventOnOrAfterIssuance label issuanceDate eventDate =
  assertMsg
    (label <> " date " <> show eventDate <> " cannot precede issuance " <> show issuanceDate)
    (ocfDate eventDate >= ocfDate issuanceDate)

assertEventOnOrBeforeExpiration : Text -> Time -> Optional Time -> Update ()
assertEventOnOrBeforeExpiration label eventDate expirationDate =
  case expirationDate of
    Some expiration ->
      assertMsg
        (label <> " date " <> show eventDate <> " cannot follow expiration " <> show expiration)
        (ocfDate eventDate <= ocfDate expiration)
    None -> pure ()

convertibleTriggerIdsAreUnique : [ConvertibleIssuance.OcfConvertibleConversionTrigger] -> Bool
convertibleTriggerIdsAreUnique triggers =
  unique (map (\trigger -> trigger.trigger_id) triggers)

warrantTriggerIdsAreUnique : [OcfConversionTrigger] -> Bool
warrantTriggerIdsAreUnique triggers =
  unique (map (\trigger -> trigger.trigger_id) triggers)

validateConvertibleIssuanceTemporalTerms : CapTableMaps -> Update ()
validateConvertibleIssuanceTemporalTerms maps =
  mapA_
    (\issuanceCid -> do
      issuance <- fetch issuanceCid
      assertMsg
        ("Convertible issuance " <> issuance.issuance_data.id <> " has duplicate conversion trigger IDs")
        (convertibleTriggerIdsAreUnique issuance.issuance_data.conversion_triggers)
      mapA_
        (\trigger -> do
          let label = "Convertible issuance " <> issuance.issuance_data.id <> " trigger " <> trigger.trigger_id
          assertMsg
            (label <> " fields do not match the declared trigger type")
            (validateOcfConversionTriggerFields
              trigger.type_
              trigger.start_date
              trigger.end_date
              trigger.trigger_condition
              trigger.trigger_date)
          assertConversionTriggerDefinitionIsTemporallyValid
            label
            None
            trigger.type_
            trigger.start_date
            trigger.end_date
            trigger.trigger_date
          case trigger.conversion_right.conversion_mechanism of
            OcfConvMechNote noteMechanism -> do
              assertMsg
                (label <> " has invalid or overlapping interest rate intervals")
                (validateOcfInterestRateSchedule noteMechanism.interest_rates)
            _ -> pure ())
        issuance.issuance_data.conversion_triggers)
    (Map.values maps.convertible_issuances)

validateWarrantIssuanceTemporalTerms : CapTableMaps -> Update ()
validateWarrantIssuanceTemporalTerms maps =
  mapA_
    (\issuanceCid -> do
      issuance <- fetch issuanceCid
      assertMsg
        ("Warrant issuance " <> issuance.issuance_data.id <> " has duplicate exercise trigger IDs")
        (warrantTriggerIdsAreUnique issuance.issuance_data.exercise_triggers)
      assertExpirationOnOrAfterIssuance
        ("Warrant issuance " <> issuance.issuance_data.id)
        issuance.issuance_data.date
        issuance.issuance_data.warrant_expiration_date
      mapA_
        (\trigger -> do
          let label = "Warrant issuance " <> issuance.issuance_data.id <> " trigger " <> trigger.trigger_id
          assertMsg
            (label <> " fields do not match the declared trigger type")
            (validateOcfConversionTriggerFields
              trigger.type_
              trigger.start_date
              trigger.end_date
              trigger.trigger_condition
              trigger.trigger_date)
          assertConversionTriggerDefinitionIsTemporallyValid
            label
            issuance.issuance_data.warrant_expiration_date
            trigger.type_
            trigger.start_date
            trigger.end_date
            trigger.trigger_date)
        issuance.issuance_data.exercise_triggers)
    (Map.values maps.warrant_issuances)

validateEquityCompensationIssuanceTemporalTerms : CapTableMaps -> Update ()
validateEquityCompensationIssuanceTemporalTerms maps =
  mapA_
    (\issuanceCid -> do
      issuance <- fetch issuanceCid
      assertExpirationOnOrAfterIssuance
        ("Equity compensation issuance " <> issuance.issuance_data.id)
        issuance.issuance_data.date
        issuance.issuance_data.expiration_date)
    (Map.values maps.equity_compensation_issuances)

validateConvertibleConversionTemporalEligibility : CapTableMaps -> Update ()
validateConvertibleConversionTemporalEligibility maps =
  mapA_
    (\conversionCid -> do
      conversion <- fetch conversionCid
      case Map.lookup conversion.conversion_data.security_id maps.convertible_issuances_by_security_id of
        Some issuanceCid -> do
          issuance <- fetch issuanceCid
          assertEventOnOrAfterIssuance
            ("Convertible conversion " <> conversion.conversion_data.id)
            issuance.issuance_data.date
            conversion.conversion_data.date
          case convertibleConversionTrigger issuance.issuance_data conversion.conversion_data.trigger_id of
            Some trigger ->
              assertConversionTriggerIsEligibleAt
                ("Convertible conversion " <> conversion.conversion_data.id)
                conversion.conversion_data.date
                trigger.type_
                trigger.start_date
                trigger.end_date
                trigger.trigger_date
            None -> assertMsg ("Convertible conversion trigger not found: " <> conversion.conversion_data.trigger_id) False
        None -> assertMsg ("Convertible conversion security not found: " <> conversion.conversion_data.security_id) False)
    (Map.values maps.convertible_conversions)

validateWarrantExerciseTemporalEligibility : CapTableMaps -> Update ()
validateWarrantExerciseTemporalEligibility maps =
  mapA_
    (\exerciseCid -> do
      exercise <- fetch exerciseCid
      case Map.lookup exercise.exercise_data.security_id maps.warrant_issuances_by_security_id of
        Some issuanceCid -> do
          issuance <- fetch issuanceCid
          assertEventOnOrBeforeExpiration
            ("Warrant exercise " <> exercise.exercise_data.id)
            exercise.exercise_data.date
            issuance.issuance_data.warrant_expiration_date
          case warrantExerciseTrigger issuance.issuance_data exercise.exercise_data.trigger_id of
            Some trigger ->
              assertConversionTriggerIsEligibleAt
                ("Warrant exercise " <> exercise.exercise_data.id)
                exercise.exercise_data.date
                trigger.type_
                trigger.start_date
                trigger.end_date
                trigger.trigger_date
            None -> assertMsg ("Warrant exercise trigger not found: " <> exercise.exercise_data.trigger_id) False
        None -> assertMsg ("Warrant exercise security not found: " <> exercise.exercise_data.security_id) False)
    (Map.values maps.warrant_exercises)

validateEquityCompensationExerciseTemporalEligibility : CapTableMaps -> Update ()
validateEquityCompensationExerciseTemporalEligibility maps =
  mapA_
    (\exerciseCid -> do
      exercise <- fetch exerciseCid
      case Map.lookup exercise.exercise_data.security_id maps.equity_compensation_issuances_by_security_id of
        Some issuanceCid -> do
          issuance <- fetch issuanceCid
          assertEventOnOrBeforeExpiration
            ("Equity compensation exercise " <> exercise.exercise_data.id)
            exercise.exercise_data.date
            issuance.issuance_data.expiration_date
        None -> assertMsg ("Equity compensation exercise security not found: " <> exercise.exercise_data.security_id) False)
    (Map.values maps.equity_compensation_exercises)

validateInstrumentTemporalEligibility : CapTableMaps -> Update ()
validateInstrumentTemporalEligibility maps = do
  validateConvertibleIssuanceTemporalTerms maps
  validateWarrantIssuanceTemporalTerms maps
  validateEquityCompensationIssuanceTemporalTerms maps
  validateConvertibleConversionTemporalEligibility maps
  validateWarrantExerciseTemporalEligibility maps
  validateEquityCompensationExerciseTemporalEligibility maps

-- OCF dates are calendar dates. A non-quantity transaction may occur on the
-- same date as a terminal transaction, but it cannot target the retired source
-- security on a later OCF date.
ocfDate : Time -> Date
ocfDate = Date.toDateUTC

isEarlierOcfDate : Time -> Time -> Bool
isEarlierOcfDate candidate target = ocfDate candidate < ocfDate target

priorStockRetirementExists : CapTableMaps -> Text -> Time -> Update Bool
priorStockRetirementExists maps securityId targetDate = do
  afterCancellations <- foldlA
    (\found cancellationCid -> do
      cancellation <- fetch cancellationCid
      pure (found ||
        (cancellation.cancellation_data.security_id == securityId &&
          isEarlierOcfDate cancellation.cancellation_data.date targetDate)))
    False
    (Map.values maps.stock_cancellations)
  afterTransfers <- foldlA
    (\found transferCid -> do
      transfer <- fetch transferCid
      pure (found ||
        (transfer.transfer_data.security_id == securityId &&
          isEarlierOcfDate transfer.transfer_data.date targetDate)))
    afterCancellations
    (Map.values maps.stock_transfers)
  afterRepurchases <- foldlA
    (\found repurchaseCid -> do
      repurchase <- fetch repurchaseCid
      pure (found ||
        (repurchase.repurchase_data.security_id == securityId &&
          isEarlierOcfDate repurchase.repurchase_data.date targetDate)))
    afterTransfers
    (Map.values maps.stock_repurchases)
  afterConversions <- foldlA
    (\found conversionCid -> do
      conversion <- fetch conversionCid
      pure (found ||
        (conversion.conversion_data.security_id == securityId &&
          isEarlierOcfDate conversion.conversion_data.date targetDate)))
    afterRepurchases
    (Map.values maps.stock_conversions)
  afterReissuances <- foldlA
    (\found reissuanceCid -> do
      reissuance <- fetch reissuanceCid
      pure (found ||
        (reissuance.reissuance_data.security_id == securityId &&
          isEarlierOcfDate reissuance.reissuance_data.date targetDate)))
    afterConversions
    (Map.values maps.stock_reissuances)
  afterConsolidations <- foldlA
    (\found consolidationCid -> do
      consolidation <- fetch consolidationCid
      pure (found ||
        (securityId `elem` consolidation.consolidation_data.security_ids &&
          isEarlierOcfDate consolidation.consolidation_data.date targetDate)))
    afterReissuances
    (Map.values maps.stock_consolidations)
  foldlA
    (\found retractionCid -> do
      retraction <- fetch retractionCid
      pure (found ||
        (retraction.retraction_data.security_id == securityId &&
          isEarlierOcfDate retraction.retraction_data.date targetDate)))
    afterConsolidations
    (Map.values maps.stock_retractions)

priorConvertibleRetirementExists : CapTableMaps -> Text -> Time -> Update Bool
priorConvertibleRetirementExists maps securityId targetDate = do
  afterCancellations <- foldlA
    (\found cancellationCid -> do
      cancellation <- fetch cancellationCid
      pure (found ||
        (cancellation.cancellation_data.security_id == securityId &&
          isEarlierOcfDate cancellation.cancellation_data.date targetDate)))
    False
    (Map.values maps.convertible_cancellations)
  afterTransfers <- foldlA
    (\found transferCid -> do
      transfer <- fetch transferCid
      pure (found ||
        (transfer.transfer_data.security_id == securityId &&
          isEarlierOcfDate transfer.transfer_data.date targetDate)))
    afterCancellations
    (Map.values maps.convertible_transfers)
  afterConversions <- foldlA
    (\found conversionCid -> do
      conversion <- fetch conversionCid
      pure (found ||
        (conversion.conversion_data.security_id == securityId &&
          isEarlierOcfDate conversion.conversion_data.date targetDate)))
    afterTransfers
    (Map.values maps.convertible_conversions)
  foldlA
    (\found retractionCid -> do
      retraction <- fetch retractionCid
      pure (found ||
        (retraction.retraction_data.security_id == securityId &&
          isEarlierOcfDate retraction.retraction_data.date targetDate)))
    afterConversions
    (Map.values maps.convertible_retractions)

priorWarrantRetirementExists : CapTableMaps -> Text -> Time -> Update Bool
priorWarrantRetirementExists maps securityId targetDate = do
  afterCancellations <- foldlA
    (\found cancellationCid -> do
      cancellation <- fetch cancellationCid
      pure (found ||
        (cancellation.cancellation_data.security_id == securityId &&
          isEarlierOcfDate cancellation.cancellation_data.date targetDate)))
    False
    (Map.values maps.warrant_cancellations)
  afterTransfers <- foldlA
    (\found transferCid -> do
      transfer <- fetch transferCid
      pure (found ||
        (transfer.transfer_data.security_id == securityId &&
          isEarlierOcfDate transfer.transfer_data.date targetDate)))
    afterCancellations
    (Map.values maps.warrant_transfers)
  afterRetractions <- foldlA
    (\found retractionCid -> do
      retraction <- fetch retractionCid
      pure (found ||
        (retraction.retraction_data.security_id == securityId &&
          isEarlierOcfDate retraction.retraction_data.date targetDate)))
    afterTransfers
    (Map.values maps.warrant_retractions)
  if afterRetractions
    then pure True
    else case Map.lookup securityId maps.warrant_issuances_by_security_id of
      Some issuanceCid -> do
        issuance <- fetch issuanceCid
        (knownExerciseTotal, unknownExerciseRetirement) <- foldlA
          (\(total, retired) exerciseCid -> do
            exercise <- fetch exerciseCid
            if exercise.exercise_data.security_id /= securityId ||
                not (isEarlierOcfDate exercise.exercise_data.date targetDate)
              then pure (total, retired)
              else case exercise.exercise_data.quantity of
                Some quantity -> pure (total + quantity, retired)
                None -> pure (total, True))
          (0.0, False)
          (Map.values maps.warrant_exercises)
        pure (unknownExerciseRetirement || case issuance.issuance_data.quantity of
          Some quantity -> knownExerciseTotal >= quantity
          None -> False)
      None -> pure False

priorEquityCompensationRetirementExists : CapTableMaps -> Text -> Time -> Update Bool
priorEquityCompensationRetirementExists maps securityId targetDate = do
  afterCancellations <- foldlA
    (\found cancellationCid -> do
      cancellation <- fetch cancellationCid
      pure (found ||
        (cancellation.cancellation_data.security_id == securityId &&
          isEarlierOcfDate cancellation.cancellation_data.date targetDate)))
    False
    (Map.values maps.equity_compensation_cancellations)
  afterTransfers <- foldlA
    (\found transferCid -> do
      transfer <- fetch transferCid
      pure (found ||
        (transfer.transfer_data.security_id == securityId &&
          isEarlierOcfDate transfer.transfer_data.date targetDate)))
    afterCancellations
    (Map.values maps.equity_compensation_transfers)
  afterRetractions <- foldlA
    (\found retractionCid -> do
      retraction <- fetch retractionCid
      pure (found ||
        (retraction.retraction_data.security_id == securityId &&
          isEarlierOcfDate retraction.retraction_data.date targetDate)))
    afterTransfers
    (Map.values maps.equity_compensation_retractions)
  if afterRetractions
    then pure True
    else case Map.lookup securityId maps.equity_compensation_issuances_by_security_id of
      Some issuanceCid -> do
        issuance <- fetch issuanceCid
        exercised <- foldlA
          (\total exerciseCid -> do
            exercise <- fetch exerciseCid
            pure (if exercise.exercise_data.security_id == securityId &&
                isEarlierOcfDate exercise.exercise_data.date targetDate
              then total + exercise.exercise_data.quantity
              else total))
          0.0
          (Map.values maps.equity_compensation_exercises)
        released <- foldlA
          (\total releaseCid -> do
            release <- fetch releaseCid
            pure (if release.release_data.security_id == securityId &&
                isEarlierOcfDate release.release_data.date targetDate
              then total + release.release_data.quantity
              else total))
          0.0
          (Map.values maps.equity_compensation_releases)
        pure (exercised + released >= issuance.issuance_data.quantity)
      None -> pure False

assertActiveStockTarget : CapTableMaps -> Text -> Time -> Text -> Update ()
assertActiveStockTarget maps label targetDate securityId = do
  retired <- priorStockRetirementExists maps securityId targetDate
  assertMsg (label <> " targets inactive stock security " <> securityId) (not retired)

assertActiveConvertibleTarget : CapTableMaps -> Text -> Time -> Text -> Update ()
assertActiveConvertibleTarget maps label targetDate securityId = do
  retired <- priorConvertibleRetirementExists maps securityId targetDate
  assertMsg (label <> " targets inactive convertible security " <> securityId) (not retired)

assertActiveWarrantTarget : CapTableMaps -> Text -> Time -> Text -> Update ()
assertActiveWarrantTarget maps label targetDate securityId = do
  retired <- priorWarrantRetirementExists maps securityId targetDate
  assertMsg (label <> " targets inactive warrant security " <> securityId) (not retired)

assertActiveEquityCompensationTarget : CapTableMaps -> Text -> Time -> Text -> Update ()
assertActiveEquityCompensationTarget maps label targetDate securityId = do
  retired <- priorEquityCompensationRetirementExists maps securityId targetDate
  assertMsg (label <> " targets inactive equity compensation security " <> securityId) (not retired)

assertActiveVestingTarget : CapTableMaps -> Text -> Time -> Text -> Update ()
assertActiveVestingTarget maps label targetDate securityId =
  case Map.lookup securityId maps.stock_issuances_by_security_id of
    Some _ -> assertActiveStockTarget maps label targetDate securityId
    None -> case Map.lookup securityId maps.warrant_issuances_by_security_id of
      Some _ -> assertActiveWarrantTarget maps label targetDate securityId
      None -> case Map.lookup securityId maps.equity_compensation_issuances_by_security_id of
        Some _ -> assertActiveEquityCompensationTarget maps label targetDate securityId
        None -> pure ()

validateActiveSecurityTargets : CapTableMaps -> Update ()
validateActiveSecurityTargets maps = do
  mapA_
    (\acceptanceCid -> do
      acceptance <- fetch acceptanceCid
      assertActiveStockTarget maps ("Stock acceptance " <> acceptance.acceptance_data.id)
        acceptance.acceptance_data.date acceptance.acceptance_data.security_id)
    (Map.values maps.stock_acceptances)
  mapA_
    (\acceptanceCid -> do
      acceptance <- fetch acceptanceCid
      assertActiveConvertibleTarget maps ("Convertible acceptance " <> acceptance.acceptance_data.id)
        acceptance.acceptance_data.date acceptance.acceptance_data.security_id)
    (Map.values maps.convertible_acceptances)
  mapA_
    (\acceptanceCid -> do
      acceptance <- fetch acceptanceCid
      assertActiveWarrantTarget maps ("Warrant acceptance " <> acceptance.acceptance_data.id)
        acceptance.acceptance_data.date acceptance.acceptance_data.security_id)
    (Map.values maps.warrant_acceptances)
  mapA_
    (\acceptanceCid -> do
      acceptance <- fetch acceptanceCid
      assertActiveEquityCompensationTarget maps ("Equity compensation acceptance " <> acceptance.acceptance_data.id)
        acceptance.acceptance_data.date acceptance.acceptance_data.security_id)
    (Map.values maps.equity_compensation_acceptances)
  mapA_
    (\repricingCid -> do
      repricing <- fetch repricingCid
      assertActiveEquityCompensationTarget maps ("Equity compensation repricing " <> repricing.repricing_data.id)
        repricing.repricing_data.date repricing.repricing_data.security_id)
    (Map.values maps.equity_compensation_repricings)
  mapA_
    (\startCid -> do
      start <- fetch startCid
      assertActiveVestingTarget maps ("Vesting start " <> start.vesting_data.id)
        start.vesting_data.date start.vesting_data.security_id)
    (Map.values maps.vesting_starts)
  mapA_
    (\eventCid -> do
      event <- fetch eventCid
      assertActiveVestingTarget maps ("Vesting event " <> event.vesting_data.id)
        event.vesting_data.date event.vesting_data.security_id)
    (Map.values maps.vesting_events)
  mapA_
    (\accelerationCid -> do
      acceleration <- fetch accelerationCid
      assertActiveVestingTarget maps ("Vesting acceleration " <> acceleration.acceleration_data.id)
        acceleration.acceleration_data.date acceleration.acceleration_data.security_id)
    (Map.values maps.vesting_accelerations)


-- =============================================================================
-- Position register support
-- =============================================================================

data PositionMigration = PositionMigration with
    stakeholder_id : Text
    holder : Party
    security_ids : [Text]
  deriving (Eq, Show)

positionManagedError : Text -> Text
positionManagedError what = "Position-managed holding: " <> what <> "; use the PositionRegistry choices"

-- | Fetch the stored version of a record (one fetch). An unknown ID has no stored version; the
-- edit or delete then fails in UpdateCapTable itself.
storedVersion
  : (HasFetch t) => Map Text (ContractId t) -> Text -> (t -> (Text, Optional Text, [Text]))
  -> Update (Optional (Text, Optional Text, [Text]))
storedVersion objects objectId refs = case Map.lookup objectId objects of
  None -> pure None
  Some cid -> Some . refs <$> fetch cid

-- | What one version of a root record says about position-managed holdings, as
-- `(label, writes_into, security_ids)`: the record's label ("stock transfer TR-1"), the stock
-- class it writes into and every stock security it names. The tables below are generated from
-- captable-config.yaml: a type is guarded on the fields its `validations` check against
-- stock_issuances_by_security_id (a stock issuance on its own security_id), and the types in
-- `position_class_writes` write into their stock_class_id.
--
-- The guard uses tuples, not a serializable data type of its own: a serializable type is upgrade
-- API, which later versions could only extend.
{{#each types_alpha}}
{{#if position_guard}}
{{position_guard.fn}} : {{data_type}} -> (Text, Optional Text, [Text])
{{position_guard.fn}} d = ("{{position_guard.label}} " <> d.id, {{position_guard.writes_into}}, {{position_guard.security_ids}})

{{/if}}
{{/each}}
-- | The proposed version of a created record (no fetch).
createdRefs : OcfCreateData -> Optional (Text, Optional Text, [Text])
createdRefs c = case c of
{{#each types_alpha}}
{{#if position_guard}}
  OcfCreate{{name}} d -> Some ({{position_guard.fn}} d)
{{/if}}
{{/each}}
  _ -> None

-- | The proposed and stored versions of an edited record (one fetch).
editedRefs
  : CapTable -> OcfEditData
  -> Update (Optional ((Text, Optional Text, [Text]), Optional (Text, Optional Text, [Text])))
editedRefs ct e = case e of
{{#each types_alpha}}
{{#if position_guard}}
  OcfEdit{{name}} d -> (\stored -> Some ({{position_guard.fn}} d, stored)) <$> storedVersion ct.{{map_field}} d.id ({{position_guard.fn}} . (.{{data_param}}))
{{/if}}
{{/each}}
  _ -> pure None

-- | The stored version of a deleted record (one fetch).
deletedRefs : CapTable -> OcfDeleteData -> Update (Optional (Text, Optional Text, [Text]))
deletedRefs ct r = case r of
{{#each types_alpha}}
{{#if position_guard}}
  OcfDelete{{name}} i -> storedVersion ct.{{map_field}} i ({{position_guard.fn}} . (.{{data_param}}))
{{/if}}
{{/each}}
  _ -> pure None

-- | Root guard for position-managed holdings. Every record a batch writes is checked in its
-- proposed version (creates and edits) and in its stored version (edits and deletes). No version
-- may be a stock issuance, split or conversion-ratio adjustment in a position-managed class, or
-- name a stock security whose root stock issuance is in one (as a migrated security's is). A
-- position-managed stock class cannot be deleted either, and vesting terms behind position lots
-- stay as they are (`validatePositionVestingTerms`). So an edit can move a root record neither
-- into nor out of a managed class, and no root write can edit, delete or extend the history of a
-- managed class. The generator picks up any OCF type whose validations name stock securities. A
-- type added in a v34 patch has an upgrade-appended (Optional) root map, which this guard does
-- not read, so codegen refuses such a type until the guard handles Optional maps.
-- Costs nothing on a root without positions. Otherwise O(batch): one fetch per edit or delete of
-- a guarded record, plus one lookup and at most one fetch (the root stock issuance) per security
-- a version names; a batch that edits or deletes vesting terms adds one fetch per root stock
-- issuance and per edited vesting terms.
validatePositionManagedWrites : CapTable -> [OcfCreateData] -> [OcfEditData] -> [OcfDeleteData] -> Update ()
validatePositionManagedWrites ct creates edits deletes = do
  let classes = fromOptional Map.empty ct.position_registries
      check version (label, writesInto, securityIds) = do
        let reject what = assertMsg (positionManagedError (label <> " (" <> version <> ") " <> what))
        forA_ writesInto \c -> reject ("is in position-managed class " <> c) (not (Map.member c classes))
        -- A record that writes into a class names only the security it issues there, and that
        -- class was checked above.
        when (isNone writesInto) $
          forA_ securityIds \s ->
            forA_ (Map.lookup s ct.stock_issuances_by_security_id) \issuanceCid -> do
              issuance <- fetch issuanceCid
              let c = issuance.issuance_data.stock_class_id
              reject ("references security " <> s <> " of position-managed class " <> c) (not (Map.member c classes))
      checkDelete r = do
        case r of
          OcfDeleteStockClass c ->
            assertMsg (positionManagedError ("stock class " <> c <> " is position-managed")) (not (Map.member c classes))
          _ -> pure ()
        stored <- deletedRefs ct r
        forA_ stored (check "stored")
  unless (Map.null classes) $ do
    forA_ creates \c -> forA_ (createdRefs c) (check "proposed")
    forA_ edits \e -> do
      versions <- editedRefs ct e
      forA_ versions \(proposed, stored) -> do
        check "proposed" proposed
        forA_ stored (check "stored")
    forA_ deletes checkDelete
    validatePositionVestingTerms ct classes edits deletes

-- | Vesting terms behind position lots. A lot keeps its issuance's vesting_terms_id, and the
-- snapshots and OCF vesting records the registry writes are computed from those terms and name
-- their conditions. So vesting terms that a root stock issuance of a managed class names (every
-- migrated lot's terms among them) can be neither edited nor deleted, and no edit of other
-- vesting terms may drop a condition ID, which a registry-written vesting start or event may
-- name. The root cannot see terms that only registry-issued lots name; root writers
-- (CapTableBatch, replication) must not edit or delete those.
validatePositionVestingTerms
  : CapTable -> Map Text (ContractId PositionRegistry) -> [OcfEditData] -> [OcfDeleteData] -> Update ()
validatePositionVestingTerms ct classes edits deletes = do
  let edited = [d | OcfEditVestingTerms d <- edits]
      touched = map (.id) edited ++ [i | OcfDeleteVestingTerms i <- deletes]
  unless (null touched) $ do
    forA_ (Map.values ct.stock_issuances) \issuanceCid -> do
      d <- (.issuance_data) <$> fetch issuanceCid
      forA_ d.vesting_terms_id \t ->
        when (t `elem` touched && Map.member d.stock_class_id classes) $
          abort (positionManagedError ("vesting terms " <> t <> " are named by security " <> d.security_id
            <> " of position-managed class " <> d.stock_class_id))
    forA_ edited \d -> forA_ (Map.lookup d.id ct.vesting_terms) \termsCid -> do
      stored <- fetch termsCid
      let kept = map (.id) d.vesting_conditions
      forA_ stored.vesting_terms_data.vesting_conditions \c ->
        unless (c.id `elem` kept) $
          abort (positionManagedError ("vesting terms " <> d.id <> " (proposed) removes vesting condition " <> c.id))

-- | Remaining balance of a root stock issuance after every recorded lifecycle event and split, under
-- v34's own balance rules: a split dated after the issuance applies; on the issuance's own date a
-- forward split is taken as already in the recorded quantity and a reverse split as following it.
-- That is the lowest balance any intra-day order allows, the same balance within which the root
-- lets later records reduce the security.
remainingStockBalance : Map Text [SecurityBalanceEvent] -> Map Text [SecurityBalanceEvent] -> StockIssuance -> Update Decimal
remainingStockBalance stockEvents splitEvents issuance = do
  let sid = issuance.issuance_data.security_id
      events = fromOptional [] (Map.lookup sid stockEvents)
      allEvents = events ++ issuanceSplits splitEvents issuance
  validateSecurityBalanceEventDates sid issuance.issuance_data.date allEvents
  foldlA (applySecurityBalanceEvent sid) issuance.issuance_data.quantity (sortOn securityBalanceEventSortKey allEvents)

-- | Whether a balance event consumes its security (a transfer, cancellation, repurchase or
-- conversion), leaving any remainder in a balance security.
isBalanceReduction : SecurityBalanceEvent -> Bool
isBalanceReduction event = case event of
  SecurityBalanceReduction {} -> True
  _ -> False

-- | Whether an issuance's tranches, when it has any, cover its quantity (as a position lot's must).
vestingsCoverQuantity : StockIssuanceOcfData -> Bool
vestingsCoverQuantity d = null d.vestings || ocfVestingAmountTotal d.vestings == d.quantity

-- | The stock securities that a transfer, cancellation, repurchase or conversion leaves a balance
-- security. One fetch per such record.
stockSecuritiesWithBalanceSecurity : CapTableMaps -> Update [Text]
stockSecuritiesWithBalanceSecurity maps = do
  let withBalance pairs = [s | (s, Some _) <- pairs]
  transfers <- forA (Map.values maps.stock_transfers)
    (fmap (\r -> (r.transfer_data.security_id, r.transfer_data.balance_security_id)) . fetch)
  cancellations <- forA (Map.values maps.stock_cancellations)
    (fmap (\r -> (r.cancellation_data.security_id, r.cancellation_data.balance_security_id)) . fetch)
  repurchases <- forA (Map.values maps.stock_repurchases)
    (fmap (\r -> (r.repurchase_data.security_id, r.repurchase_data.balance_security_id)) . fetch)
  conversions <- forA (Map.values maps.stock_conversions)
    (fmap (\r -> (r.conversion_data.security_id, r.conversion_data.balance_security_id)) . fetch)
  pure (withBalance (transfers ++ cancellations ++ repurchases ++ conversions))

-- | The splits of its class that apply to a root stock issuance (see `remainingStockBalance`), in
-- the order the balance rules apply them.
issuanceSplits : Map Text [SecurityBalanceEvent] -> StockIssuance -> [SecurityBalanceEvent]
issuanceSplits splitEvents issuance =
  sortOn securityBalanceEventSortKey (filter
    (splitMayReducePostIssuanceBalance issuance.issuance_data.date)
    (fromOptional [] (Map.lookup issuance.issuance_data.stock_class_id splitEvents)))

-- | An issuance's tranches in the units of its quantity after these splits (in this order). The
-- shares vested by each tranche date scale exactly as the quantity does, with the same arithmetic,
-- so tranches that covered the recorded quantity cover the split quantity; a tranche that rounds to
-- nothing is dropped.
splitVestings : [SecurityBalanceEvent] -> [OcfVesting] -> [OcfVesting]
splitVestings splits vestings = reverse scaled
  where
    scale x = foldl (\acc event -> case event of
        SecurityBalanceMultiplier with numerator; denominator -> acc * numerator / denominator
        _ -> acc) x splits
    (_, scaled) = foldl (\(vestedBefore, acc) v ->
        let vestedBy = vestedBefore + v.amount
            amount = scale vestedBy - scale vestedBefore
        in (vestedBy, if amount > 0.0 then (v with amount = amount) :: acc else acc))
      (0.0, []) (sortOn (.date) vestings)

-- =============================================================================
-- CapTable Template
-- =============================================================================

template CapTable
  with
    context: Context

    -- Issuer (exactly 1, edit only - no create/delete)
    issuer: ContractId Issuer

    -- OCF object/transaction maps
{{#each types_existing}}
    {{map_field}}: Map Text (ContractId {{name}})
{{/each}}

    -- Security ID index maps (for O(1) lookup by security_id)
    convertible_issuances_by_security_id: Map Text (ContractId ConvertibleIssuance)
    equity_compensation_issuances_by_security_id: Map Text (ContractId EquityCompensationIssuance)
    stock_issuances_by_security_id: Map Text (ContractId StockIssuance)
    warrant_issuances_by_security_id: Map Text (ContractId WarrantIssuance)

    -- Optional appended maps preserve compatibility with pre-support CapTable payloads.
{{#each types_appended}}
    {{map_field}}: Optional (Map Text (ContractId {{name}}))
{{/each}}

    -- Position register, appended as Optional fields (None on pre-0.0.4 payloads).
    -- stock_class_id -> registry: which classes are position-managed, for the root guard.
    position_registries: Optional (Map Text (ContractId PositionRegistry))
    -- security_id -> stakeholder_id: stops a second migration; shows readers it lives in a position.
    position_migrated_security_ids: Optional (Map Text Text)

  where
    signatory context.issuer, context.system_operator

    -- ==========================================================================
    -- BATCH UPDATE (Create/Edit/Delete including Issuer)
    -- ==========================================================================
    -- Issuer is edit-only (no create/delete) and is handled separately since
    -- it's stored as a single reference, not in a map like other entities.

    -- | Batch update choice for efficient bulk operations.
    -- This is the primary choice for cap table mutations.
    --
    -- Parameters:
    -- - creates: List of OCF objects to create (processed in tier order for dependencies)
    -- - edits: List of OCF objects to edit (ID is in the data record)
    --          Includes OcfEditIssuer for issuer updates (edit-only, no create/delete)
    -- - deletes: List of OCF object IDs to delete
    choice UpdateCapTable : UpdateCapTableResult
      with
        creates: [OcfCreateData]
        edits: [OcfEditData]
        deletes: [OcfDeleteData]
      controller context.issuer
      do
        -- Empty batches only rotate the CapTable CID; require a create, edit, or delete.
        assertMsg "UpdateCapTable requires at least one create, edit, or delete"
          (creates /= [] || edits /= [] || deletes /= [])

        -- No root writes to position-managed holdings. O(batch).
        validatePositionManagedWrites this creates edits deletes

        -- Start with current maps
        let initialMaps = toMaps this

        -- Process deletes first to free unique constraints (e.g., security_id)
        -- This allows object replacements (delete old + create new with same security_id)
        mapsAfterDeletes <- foldlA
          (\maps deleteRef -> processDelete maps deleteRef)
          initialMaps
          deletes

        -- Separate issuer edits from regular edits
        -- Issuer is edit-only and stored differently (single reference, not a map)
        let isIssuerEdit = \case
              OcfEditIssuer _ -> True
              _ -> False
        let issuerEdits = filter isIssuerEdit edits
        let regularEdits = filter (not . isIssuerEdit) edits

        -- Validate: at most one issuer edit per batch
        assertMsg "Cannot edit issuer more than once per batch" (length issuerEdits <= 1)

        -- Process regular edits (map-based entities)
        (mapsAfterEdits, regularEditedCids) <- foldlA
          (\(maps, cids) editData -> do
            (newMaps, cid) <- processEdit context issuer maps editData
            pure (newMaps, cids ++ [cid]))
          (mapsAfterDeletes, [])
          regularEdits

        -- Process issuer edit (if any) - special handling since it's a single reference
        -- Note: In editedCids output, issuer edits appear first regardless of input position
        (newIssuerCid, issuerEditedCids) <- case issuerEdits of
          [] -> pure (issuer, [])  -- No issuer edit, keep current
          [OcfEditIssuer newIssuerData] -> do
            -- Validate issuer ID matches (cannot change ID during edit)
            currentIssuer <- fetch issuer
            assertMsg "Issuer ID mismatch: cannot change issuer ID during edit"
              (newIssuerData.id == currentIssuer.issuer_data.id)
            -- Identical issuer_data is not a business change. Any no-op edit aborts the entire UpdateCapTable (DAML atomicity); do not skip or filter no-ops.
            assertMsg "Issuer update changes nothing" (newIssuerData /= currentIssuer.issuer_data)
            archive issuer
            newCid <- create Issuer with
              context = context
              issuer_data = newIssuerData
            pure (newCid, [CidIssuer newCid])
          _ -> error "Multiple issuer edits not allowed"  -- Defensive: assertMsg above prevents this

        -- Sort creates by tier for dependency ordering
        let sortedCreates = sortOn getCreateTier creates

        -- Process creates last (after deletes freed constraints)
        (finalMaps, createdCids) <- foldlA
          (\(maps, cids) createData -> do
            (newMaps, cid) <- processCreate context newIssuerCid maps createData
            pure (newMaps, cids ++ [cid]))
          (mapsAfterEdits, [])
          sortedCreates

        -- Validate Financing references only after the complete batch state is known.
        validateFinancingIssuanceReferences finalMaps
        validateActiveSecurityTargets finalMaps
        validateDocumentRelatedObjects finalMaps newIssuerCid
        validateStockClassConversionRightReferences finalMaps
        validateConvertibleIssuanceReferences finalMaps
        validateConvertibleConversionRightReferences finalMaps
        validateWarrantConversionRightReferences finalMaps
        validateValuationStockClassReferences finalMaps
        validateStockPlanReferences finalMaps
        validateStockIssuanceReferences finalMaps
        validateEquityCompensationIssuanceReferences finalMaps
        validateWarrantIssuanceReferences finalMaps
        validateVestingTransactionConditionReferences finalMaps
        validateVestingTermsConditionGraphReferences finalMaps
        validateConvertibleConversionCapitalizationReferences finalMaps
        validateConvertibleConversionTriggerReferences finalMaps
        validateWarrantExerciseTriggerReferences finalMaps
        validateStockReissuanceSplitReferences finalMaps
        validateConfiguredReferences finalMaps
        validateSourceSecurityBalances finalMaps
        validateStockClassConversionRatioAdjustmentTargets finalMaps
        validateInstrumentTemporalEligibility finalMaps

        -- Create new CapTable with updated maps and potentially new issuer
        newCapTableCid <- create this with
          issuer = newIssuerCid
{{#each types_existing}}
          {{map_field}} = finalMaps.{{map_field}}
{{/each}}
          -- Security ID index maps
          convertible_issuances_by_security_id = finalMaps.convertible_issuances_by_security_id
          equity_compensation_issuances_by_security_id = finalMaps.equity_compensation_issuances_by_security_id
          stock_issuances_by_security_id = finalMaps.stock_issuances_by_security_id
          warrant_issuances_by_security_id = finalMaps.warrant_issuances_by_security_id
{{#each types_appended}}
          {{map_field}} = finalMaps.{{map_field}}
{{/each}}

        pure UpdateCapTableResult with
          updatedCapTableCid = newCapTableCid
          createdCids = createdCids
          editedCids = issuerEditedCids ++ regularEditedCids

    -- ==========================================================================
    -- ARCHIVE CAP TABLE (system operator only)
    -- ==========================================================================
    -- Administrative choice to archive an entire cap table.
    -- Consuming choice — exercising it archives the CapTable contract.
    -- The issuer contract is explicitly archived since it's a separate contract.
    -- Caller must delete all entities via UpdateCapTable first.

    choice ArchiveCapTable : ()
      controller context.system_operator
      do
        -- Assert all entity maps are empty (caller must delete via UpdateCapTable first)
{{#each types_existing}}
        assertMsg "Cannot archive: {{map_field}} is not empty" (Map.null {{map_field}})
{{/each}}
{{#each types_appended}}
        assertMsg "Cannot archive: {{map_field}} is not empty" (Map.null (fromOptional Map.empty {{map_field}}))
{{/each}}
        -- Positions outlive no root: their teardown is not defined, so a root with position
        -- registries stays (a managed stock class cannot be deleted either).
        assertMsg "Cannot archive: position_registries is not empty" (Map.null (fromOptional Map.empty position_registries))
        -- Archive the issuer contract (separate contract referenced by CapTable)
        archive issuer
        -- CapTable self-archives (consuming choice)
        pure ()

    -- ==========================================================================
    -- Position register
    -- ==========================================================================

    -- | Make one stock class position-managed: create its registry and record it in the root. The
    -- registry keeps the date of the class's latest split. Once the class is enabled, the guard
    -- freezes its root issuances, so this refuses, by name, a root issuance of the class with a
    -- remaining balance that `MigrateToPositions` would refuse and only a root write could fix:
    -- one whose tranches do not cover its quantity, and one that a transfer, cancellation,
    -- repurchase or conversion left with a balance but no balance security to migrate. One scan
    -- of the root (O(book) fetches).
    choice EnablePositions : (ContractId CapTable, ContractId PositionRegistry)
      with
        stock_class_id : Text
      controller context.issuer
      do
        assertMsg ("Unknown stock class " <> stock_class_id) (Map.member stock_class_id stock_classes)
        let registries = fromOptional Map.empty position_registries
        assertMsg ("Positions already enabled for " <> stock_class_id) (not (Map.member stock_class_id registries))
        let maps = toMaps this
            refuse sid what = abort ("Cannot enable positions for " <> stock_class_id <> ": security " <> sid <> " " <> what)
        splitEvents <- splitEventsByStockClassId maps
        stockEvents <- stockBalanceEventsBySecurityId maps
        balanced <- stockSecuritiesWithBalanceSecurity maps
        forA_ (Map.values stock_issuances) \issuanceCid -> do
          issuance <- fetch issuanceCid
          let d = issuance.issuance_data
          when (d.stock_class_id == stock_class_id) $ do
            remaining <- remainingStockBalance stockEvents splitEvents issuance
            when (remaining > 0.0) $
              if any isBalanceReduction (fromOptional [] (Map.lookup d.security_id stockEvents))
                then unless (d.security_id `elem` balanced) $
                  refuse d.security_id "keeps a balance after a transfer, cancellation, repurchase or conversion without a balance security"
                else unless (vestingsCoverQuantity d) $
                  refuse d.security_id "has vesting tranches that do not cover its quantity"
        let last_split_date = case fromOptional [] (Map.lookup stock_class_id splitEvents) of
              [] -> None
              e :: es -> Some (foldl max (securityBalanceEventDate e) (map securityBalanceEventDate es))
        registryCid <- create PositionRegistry with context; stock_class_id; last_split_date
        rootCid <- create this with position_registries = Some (Map.insert stock_class_id registryCid registries)
        pure (rootCid, registryCid)

    -- | Build positions from the root's active stock issuances, one batch of holders at a time.
    -- Each security must be a root stock issuance of the holder in this class, not yet migrated,
    -- with no transfer, cancellation, repurchase or conversion (its resulting or balance security
    -- migrates instead) and a positive remaining balance. Its lot keeps the issuance data with the
    -- quantity set to that balance, computed by v34's own balance rules from every recorded
    -- lifecycle event and split (`remainingStockBalance`); the share price stays the recorded
    -- issuance price, the vesting terms stay, and the tranches, which cover the recorded quantity
    -- (`EnablePositions` checked), are scaled by the same splits (`splitVestings`). A lot on
    -- vesting terms starts without a vesting snapshot, so it counts as unvested until
    -- `Registry_RecordVesting` records one. The root records each migrated security, which stops a
    -- second migration. One scan of the root per batch (O(book) fetches) builds the balance
    -- events.
    choice MigrateToPositions : (ContractId CapTable, [ContractId StockPosition])
      with
        stock_class_id : Text
        migrations : [PositionMigration]
      controller context.issuer
      do
        assertMsg "Nothing to migrate" (not (null migrations))
        let registries = fromOptional Map.empty position_registries
        assertMsg ("Positions are not enabled for " <> stock_class_id) (Map.member stock_class_id registries)
        let maps = toMaps this
        stockEvents <- stockBalanceEventsBySecurityId maps
        splitEvents <- splitEventsByStockClassId maps
        (migratedFinal, positionCids) <- foldlA
          (\(migrated, cids) m -> do
            assertMsg ("Unknown stakeholder " <> m.stakeholder_id) (Map.member m.stakeholder_id stakeholders)
            assertMsg ("No securities to migrate for " <> m.stakeholder_id) (not (null m.security_ids))
            (migrated', lots) <- foldlA
              (\(mig, acc) sid -> do
                assertMsg ("Security already migrated " <> sid) (not (Map.member sid mig))
                issuanceCid <- case Map.lookup sid stock_issuances_by_security_id of
                  Some c -> pure c
                  None -> abort ("Unknown stock security " <> sid)
                issuance <- fetch issuanceCid
                assertMsg ("Security " <> sid <> " is not held by " <> m.stakeholder_id)
                  (issuance.issuance_data.stakeholder_id == m.stakeholder_id)
                assertMsg ("Security " <> sid <> " is not in class " <> stock_class_id)
                  (issuance.issuance_data.stock_class_id == stock_class_id)
                -- OCF semantics: a transfer, cancellation, repurchase or conversion consumes the
                -- source security (any remainder lives in its balance security). Only securities
                -- without such an event are active lots (`EnablePositions` refused a class with a
                -- remainder that has no balance security).
                assertMsg ("Security " <> sid <> " was transferred, cancelled, repurchased or converted; migrate its resulting or balance security")
                  (not (any isBalanceReduction (fromOptional [] (Map.lookup sid stockEvents))))
                remaining <- remainingStockBalance stockEvents splitEvents issuance
                assertMsg ("Security " <> sid <> " has no remaining balance") (remaining > 0.0)
                -- `EnablePositions` checked that the tranches cover the issuance, and the scaled
                -- tranches cover the lot (the position's ensure checks it again).
                let lot = PositionLot with
                      issuance = issuance.issuance_data with
                        quantity = remaining
                        vestings = splitVestings (issuanceSplits splitEvents issuance) issuance.issuance_data.vestings
                      holds = []
                      vesting_snapshot = None
                pure (Map.insert sid m.stakeholder_id mig, Map.insert sid lot acc))
              (migrated, Map.empty)
              m.security_ids
            positionCid <- create StockPosition with
              context
              stock_class_id
              stakeholder_id = m.stakeholder_id
              holder = m.holder
              lots
            pure (migrated', cids ++ [positionCid]))
          (fromOptional Map.empty position_migrated_security_ids, [])
          migrations
        rootCid <- create this with position_migrated_security_ids = Some migratedFinal
        pure (rootCid, positionCids)
